<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title><%= typeof title !== 'undefined' ? title : 'The Playground Pickleball - Championship Courts Reservation' %></title>
  <meta name="theme-color" content="#0B2545">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="The Playground">
  <link rel="manifest" href="/manifest.json">
  <link rel="icon" type="image/svg+xml" href="/images/app-icon.svg">
  <link rel="alternate icon" type="image/jpeg" href="/images/the-playground-logo.jpg">
  <link rel="apple-touch-icon" href="/images/the-playground-logo.jpg">
  <!-- Bootstrap 5 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Bootstrap Icons -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <!-- Google Fonts: Plus Jakarta Sans, Outfit, Cinzel -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700;800&family=Outfit:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <!-- Custom CSS -->
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="d-flex flex-column min-vh-100">
  <% if (typeof hideNavbar === 'undefined' || !hideNavbar) { %>
    <%- include('../partials/navbar') %>
  <% } %>
  <%- include('../partials/messenger-modal') %>

  <!-- Flash Messages -->
  <div class="container mt-3">
    <% if (typeof error !== 'undefined' && error && error.length > 0) { %>
      <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i><%= error %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    <% } %>
    <% if (typeof success !== 'undefined' && success && success.length > 0) { %>
      <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i><%= success %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    <% } %>
  </div>

  <!-- Real-Time Toast Notifications -->
  <div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1090;">
    <div id="liveToast" class="toast align-items-center text-bg-primary border-0 shadow-lg" role="alert" aria-live="assertive" aria-atomic="true">
      <div class="d-flex">
        <div class="toast-body d-flex align-items-center">
          <i class="bi bi-broadcast fs-5 me-2"></i>
          <span id="toastMessage">Real-time update received!</span>
        </div>
        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
      </div>
    </div>
  </div>

  <main class="flex-grow-1">
    <%- body %>
  </main>

  <%- include('../partials/footer') %>

  <!-- Install Mobile App (PWA) Guide Modal -->
  <div class="modal fade" id="installPwaModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content border-0 rounded-4 shadow-lg overflow-hidden">
        <div class="modal-header border-0 py-3 px-4 text-white" style="background: linear-gradient(135deg, #0B2545 0%, #134074 100%);">
          <div class="d-flex align-items-center gap-2.5">
            <img src="/images/app-icon.svg" alt="The Playground App" class="rounded-3 shadow-sm" style="width: 38px; height: 38px;">
            <div>
              <h6 class="modal-title fw-bold mb-0 font-display text-white">Install The Playground App</h6>
              <span class="small text-warning" style="font-size: 11px;">Full-screen mobile experience on your Home Screen</span>
            </div>
          </div>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body p-4 bg-white">
          <p class="small text-secondary mb-3">
            Add <strong>The Playground Pickleball</strong> to your phone's home screen for 1-tap court booking, digital passes, and instant account chat!
          </p>
          <div class="p-3 rounded-3 bg-light border mb-3">
            <div class="fw-bold text-dark small mb-2"><i class="bi bi-apple me-1"></i>On iPhone / iPad (Safari):</div>
            <ol class="small text-secondary mb-0 ps-3">
              <li class="mb-1">Tap the <strong>Share</strong> button <i class="bi bi-box-arrow-up text-primary"></i> at the bottom of Safari.</li>
              <li>Scroll down and tap <strong>"Add to Home Screen"</strong> <i class="bi bi-plus-square text-primary"></i>.</li>
            </ol>
          </div>
          <div class="p-3 rounded-3 bg-light border">
            <div class="fw-bold text-dark small mb-2"><i class="bi bi-android2 text-success me-1"></i>On Android (Chrome):</div>
            <ol class="small text-secondary mb-0 ps-3">
              <li class="mb-1">Tap the <strong>3-dot menu</strong> <i class="bi bi-three-dots-vertical"></i> in the top right of Chrome.</li>
              <li>Tap <strong>"Install app"</strong> or <strong>"Add to Home screen"</strong>.</li>
            </ol>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Socket.io -->
  <script src="/socket.io/socket.io.js"></script>
  <!-- Bootstrap 5 JS Bundle -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <!-- Custom Global JS -->
  <script src="/js/main.js"></script>
  <script src="/js/socket.js"></script>
  <script src="/js/image-viewer.js"></script>
  <!-- PWA Service Worker & Install Prompt Handler -->
  <script>
    let deferredPwaPrompt = null;

    if ('serviceWorker' in navigator) {
      window.addEventListener('load', function () {
        navigator.serviceWorker.register('/sw.js').catch(function () {});
      });
    }

    window.addEventListener('beforeinstallprompt', function (e) {
      e.preventDefault();
      deferredPwaPrompt = e;
      document.querySelectorAll('.pwa-install-trigger').forEach(function (btn) {
        btn.classList.remove('d-none');
      });
    });

    window.addEventListener('appinstalled', function () {
      deferredPwaPrompt = null;
      document.querySelectorAll('.pwa-install-trigger').forEach(function (btn) {
        btn.classList.add('d-none');
      });
    });

    function triggerPwaInstall() {
      if (deferredPwaPrompt) {
        deferredPwaPrompt.prompt();
        deferredPwaPrompt.userChoice.then(function () {
          deferredPwaPrompt = null;
        });
      } else {
        const modalEl = document.getElementById('installPwaModal');
        if (modalEl && typeof bootstrap !== 'undefined') {
          bootstrap.Modal.getOrCreateInstance(modalEl).show();
        }
      }
    }
  </script>
</body>
</html>
