<div class="container-fluid px-4 py-4">
  <!-- Header / Quick actions -->
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 pb-2 border-bottom">
    <div>
      <h2 class="fw-bold text-dark mb-1">The Playground Management Dashboard</h2>
      <p class="text-secondary small mb-0">Overview of 4 championship courts, live reservations, and GCash approvals</p>
    </div>
    <div class="d-flex gap-2 mt-3 mt-md-0">
      <a href="/admin/reservations?status=AWAITING_CONFIRMATION" class="btn btn-warning fw-bold rounded-pill px-3 text-dark">
        <i class="bi bi-hourglass-split me-1"></i>Review Pending Approvals
      </a>
      <a href="/admin/reports" class="btn btn-outline-secondary fw-semibold rounded-pill px-3">
        <i class="bi bi-download me-1"></i>Export Reports
      </a>
    </div>
  </div>

  <!-- Stats Row -->
  <div class="row g-3 mb-4">
    <div class="col-xl-3 col-sm-6">
      <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
        <div class="d-flex align-items-center justify-content-between">
          <div>
            <span class="text-secondary small fw-semibold">Today's Revenue</span>
            <h3 class="fw-bold text-success mb-0"><%= formatCurrency(stats.todayRevenue) %></h3>
            <span class="small text-muted">All-time: <%= formatCurrency(stats.totalRevenue) %></span>
          </div>
          <div class="badge bg-success-subtle text-success p-3 rounded-circle fs-4">
            <i class="bi bi-cash-stack"></i>
          </div>
        </div>
      </div>
    </div>

    <div class="col-xl-3 col-sm-6">
      <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
        <div class="d-flex align-items-center justify-content-between">
          <div>
            <span class="text-secondary small fw-semibold">Confirmed Bookings</span>
            <h3 class="fw-bold text-dark mb-0"><%= stats.confirmedReservations %></h3>
            <span class="small text-muted">Total: <%= stats.totalReservations %> bookings</span>
          </div>
          <div class="badge bg-primary-subtle text-primary p-3 rounded-circle fs-4">
            <i class="bi bi-calendar-check-fill"></i>
          </div>
        </div>
      </div>
    </div>

    <div class="col-xl-3 col-sm-6">
      <a href="/admin/reservations?status=AWAITING_CONFIRMATION" class="text-decoration-none">
        <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100 border-start border-warning border-4">
          <div class="d-flex align-items-center justify-content-between">
            <div>
              <span class="text-warning-emphasis small fw-bold">Awaiting Admin Approval</span>
              <h3 class="fw-bold text-warning mb-0"><%= stats.pendingReservations %></h3>
              <span class="small text-muted">
                <% if (typeof stats.unpaidReservations !== 'undefined' && stats.unpaidReservations > 0) { %>
                  <%= stats.pendingReservations %> proof(s) to verify &middot; <%= stats.unpaidReservations %> unpaid hold(s)
                <% } else { %>
                  GCash proofs to verify
                <% } %>
              </span>
            </div>
            <div class="badge bg-warning text-dark p-3 rounded-circle fs-4">
              <i class="bi bi-hourglass-split"></i>
            </div>
          </div>
        </div>
      </a>
    </div>

    <div class="col-xl-3 col-sm-6">
      <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
        <div class="d-flex align-items-center justify-content-between">
          <div>
            <span class="text-secondary small fw-semibold">Active Courts</span>
            <h3 class="fw-bold text-dark mb-0"><%= stats.activeCourts %> <span class="fs-6 text-muted fw-normal">/ <%= stats.totalCourts %></span></h3>
            <span class="small text-muted">Courts 1, 2, 3, 4</span>
          </div>
          <div class="badge bg-info-subtle text-info p-3 rounded-circle fs-4">
            <i class="bi bi-grid-3x3-gap-fill"></i>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Chart & Recent Activity Row -->
  <div class="row g-4 mb-4">
    <div class="col-lg-8">
      <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
        <h5 class="fw-bold text-dark mb-3"><i class="bi bi-graph-up text-success me-2"></i>7-Day Revenue Trend (PHP)</h5>
        <div style="height: 280px;">
          <canvas id="revenueChart"></canvas>
        </div>
      </div>
    </div>

    <div class="col-lg-4">
      <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
        <h5 class="fw-bold text-dark mb-3"><i class="bi bi-activity text-primary me-2"></i>Recent System Activity</h5>
        <div class="list-group list-group-flush small">
          <% if (recentAuditLogs && recentAuditLogs.length > 0) { %>
            <% recentAuditLogs.forEach(function(log) { %>
              <div class="list-group-item px-0 py-2 border-light">
                <div class="d-flex justify-content-between">
                  <strong class="text-dark"><%= log.action %></strong>
                  <span class="text-muted"><%= new Date(log.created_at).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}) %></span>
                </div>
                <p class="text-secondary small mb-0 text-truncate" style="max-width: 260px;"><%= log.details %></p>
              </div>
            <% }); %>
          <% } else { %>
            <p class="text-muted small">No audit logs recorded yet.</p>
          <% } %>
        </div>
      </div>
    </div>
  </div>


</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const chartData = <%- chartData %>;
    const ctx = document.getElementById('revenueChart').getContext('2d');
    new Chart(ctx, {
      type: 'line',
      data: {
        labels: chartData.map(d => d.label),
        datasets: [{
          label: 'Revenue (₱)',
          data: chartData.map(d => d.revenue),
          borderColor: '#198754',
          backgroundColor: 'rgba(25, 135, 84, 0.1)',
          tension: 0.3,
          fill: true,
          pointBackgroundColor: '#198754',
          pointRadius: 5
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        scales: {
          y: {
            beginAtZero: true,
            ticks: {
              callback: function(value) { return '₱' + value; }
            }
          }
        }
      }
    });
  });
</script>
