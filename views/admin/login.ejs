<div class="row justify-content-center">
  <div class="col-md-5 col-lg-4">
    <div class="card border-0 shadow-lg rounded-4 overflow-hidden bg-white">
      <div class="text-white text-center p-4" style="background: linear-gradient(135deg, #0B2545 0%, #07172C 100%); border-bottom: 2px solid #D4AF37;">
        <div class="d-inline-block p-2 bg-white rounded-3 shadow-sm mb-3" style="border: 2px solid #D4AF37; width: 140px; height: 90px;">
          <img src="/images/the-playground-logo.jpg" alt="The Playground Pickleball" style="width: 100%; height: 100%; object-fit: contain;">
        </div>
        <h4 class="fw-bold mb-0 text-white"><span style="font-family: 'Brush Script MT', cursive; color: #E5C365;">The</span> <span class="gold-gradient-text">PLAYGROUND</span></h4>
        <p class="small text-white-50 mb-0">Management Portal · Sign in to continue</p>
      </div>

      <div class="p-4">
        <% if (typeof error !== 'undefined' && error && error.length > 0) { %>
          <div class="alert alert-danger py-2 px-3 small rounded-3">
            <i class="bi bi-exclamation-circle me-1"></i><%= error %>
          </div>
        <% } %>

        <form action="/admin/login" method="POST" autocomplete="off">
          <div class="mb-3">
            <label class="form-label small fw-bold text-dark">Username</label>
            <div class="input-group">
              <span class="input-group-text bg-light"><i class="bi bi-person"></i></span>
              <input type="text" name="username" class="form-control" placeholder="Enter username" value="" autocomplete="off" required autofocus>
            </div>
          </div>

          <div class="mb-4">
            <label class="form-label small fw-bold text-dark">Password</label>
            <div class="input-group">
              <span class="input-group-text bg-light"><i class="bi bi-key"></i></span>
              <input type="password" name="password" class="form-control" placeholder="Enter password" value="" autocomplete="new-password" required>
            </div>
          </div>

          <button type="submit" class="btn btn-warning w-100 fw-bold py-2 rounded-pill shadow text-dark" style="background: linear-gradient(135deg, #FFF0B3 0%, #D4AF37 50%, #B8860B 100%); border: none;">
            <i class="bi bi-shield-lock-fill me-1"></i>Sign In to Dashboard
          </button>
        </form>

        <div class="text-center mt-3 pt-3 border-top">
          <a href="/" class="small text-decoration-none text-secondary">
            <i class="bi bi-arrow-left me-1"></i>Back to Public Site
          </a>
        </div>
      </div>
    </div>
  </div>
</div>
