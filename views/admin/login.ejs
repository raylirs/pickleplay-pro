<div class="row justify-content-center">
  <div class="col-md-5 col-lg-4">
    <div class="card border-0 shadow-lg rounded-4 overflow-hidden bg-white">
      <div class="bg-dark text-white text-center p-4">
        <div class="badge bg-success rounded-circle p-3 mb-2 d-inline-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
          <i class="bi bi-shield-lock-fill fs-4"></i>
        </div>
        <h4 class="fw-bold mb-0">3KS <span class="text-success">Playground</span></h4>
        <p class="small text-white-50 mb-0">Sign in to manage courts & reservations</p>
      </div>

      <div class="p-4">
        <% if (typeof error !== 'undefined' && error && error.length > 0) { %>
          <div class="alert alert-danger py-2 px-3 small rounded-3">
            <i class="bi bi-exclamation-circle me-1"></i><%= error %>
          </div>
        <% } %>

        <form action="/admin/login" method="POST" autocomplete="off">
          <div class="mb-3">
            <label class="form-label small fw-bold text-dark">Username</label>
            <div class="input-group">
              <span class="input-group-text bg-light"><i class="bi bi-person"></i></span>
              <input type="text" name="username" class="form-control" placeholder="Enter username" value="" autocomplete="off" required autofocus>
            </div>
          </div>

          <div class="mb-4">
            <label class="form-label small fw-bold text-dark">Password</label>
            <div class="input-group">
              <span class="input-group-text bg-light"><i class="bi bi-key"></i></span>
              <input type="password" name="password" class="form-control" placeholder="Enter password" value="" autocomplete="new-password" required>
            </div>
          </div>

          <button type="submit" class="btn btn-success w-100 fw-bold py-2 rounded-pill shadow">
            Sign In to Dashboard
          </button>
        </form>

        <div class="text-center mt-3 pt-3 border-top">
          <a href="/" class="small text-decoration-none text-secondary">
            <i class="bi bi-arrow-left me-1"></i>Back to Public Site
          </a>
        </div>
      </div>
    </div>
  </div>
</div>
