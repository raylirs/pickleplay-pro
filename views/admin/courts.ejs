<div class="container-fluid px-4 py-4">
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 pb-2 border-bottom">
    <div>
      <h2 class="fw-bold text-dark mb-1">Court & Pricing Management</h2>
      <p class="text-secondary small mb-0">Change hourly rates (₱), edit facility descriptions, or toggle courts active/maintenance</p>
    </div>
    <div class="mt-3 mt-md-0">
      <a href="/admin/courts/new" class="btn btn-outline-success fw-bold rounded-pill px-4 shadow-sm">
        <i class="bi bi-plus-lg me-1"></i>Add New Category
      </a>
    </div>
  </div>

  <div class="row g-4">
    <% if (categories && categories.length > 0) { %>
      <% categories.forEach(function(cat) { %>
        <div class="col-lg-8 mx-auto">
          <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
            <div class="row g-0">
              <div class="col-md-5 position-relative">
                <img src="<%= cat.image_url %>" onerror="this.src='/images/3ks-playground.jpg'" class="img-fluid h-100 w-100 object-fit-cover" style="min-height: 250px;" alt="<%= cat.name %>">
                <span class="badge bg-success position-absolute top-0 start-0 m-3 px-3 py-2 rounded-pill fs-6 shadow">
                  Current Rate: <%= formatCurrency(cat.price_per_hour) %> / hr
                </span>
              </div>
              <div class="col-md-7 p-4 d-flex flex-column">
                <div class="d-flex justify-content-between align-items-start mb-2">
                  <div>
                    <h3 class="fw-bold text-dark mb-1"><%= cat.name %></h3>
                    <span class="badge bg-success-subtle text-success fw-bold">Active Rate: <%= formatCurrency(cat.price_per_hour) %> per hour</span>
                  </div>
                  <a href="/admin/courts/<%= cat.id %>/edit" class="btn btn-sm btn-primary rounded-pill px-3 fw-bold shadow-sm">
                    <i class="bi bi-pencil-square me-1"></i>Edit Price (₱)
                  </a>
                </div>

                <p class="text-secondary small mb-3 flex-grow-1"><%= cat.description || 'Championship covered arena with 4 tournament-grade courts.' %></p>
                
                <div class="mb-3">
                  <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="small fw-bold text-dark">Courts Status (<%= cat.courts ? cat.courts.length : 0 %>):</span>
                  </div>
                  <div class="row g-2">
                    <% if (cat.courts && cat.courts.length > 0) { %>
                      <% cat.courts.forEach(function(c) { %>
                        <div class="col-sm-6">
                          <div class="d-flex justify-content-between align-items-center bg-light p-2 rounded-3 border">
                            <div class="d-flex align-items-center">
                              <i class="bi <%= c.is_active ? 'bi-circle-fill text-success' : 'bi-slash-circle-fill text-danger' %> me-2" style="font-size: 10px;"></i>
                              <strong class="small text-dark"><%= c.display_name %></strong>
                            </div>
                            <form action="/admin/courts/<%= c.id %>/toggle-status" method="POST" class="d-inline">
                              <button type="submit" class="btn btn-sm <%= c.is_active ? 'btn-outline-danger' : 'btn-outline-success' %> py-0 px-2 rounded-pill" style="font-size: 11px;">
                                <%= c.is_active ? 'Maintenance' : 'Set Active' %>
                              </button>
                            </form>
                          </div>
                        </div>
                      <% }); %>
                    <% } %>
                  </div>
                </div>

                <div class="pt-2 border-top">
                  <a href="/admin/courts/<%= cat.id %>/edit" class="btn btn-success w-100 rounded-pill fw-bold py-2 shadow-sm">
                    <i class="bi bi-tag-fill me-1"></i>Change Hourly Rate (₱) / Facility Settings
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>
      <% }); %>
    <% } %>
  </div>
</div>
