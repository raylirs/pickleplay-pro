<div class="container-fluid px-4 py-4">
  <!-- Page Header Strip -->
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 pb-2 border-bottom">
    <div>
      <div class="d-flex align-items-center gap-2 mb-1">
        <h2 class="fw-bold text-dark mb-0">Court &amp; Slot Blocking</h2>
        <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-2.5 py-1 fw-bold" style="font-size: 11px;">
          Facility Controls
        </span>
      </div>
      <p class="text-secondary small mb-0">
        Block specific court hours, entire courts, or full facility dates for maintenance, private events, or tournaments.
      </p>
    </div>
    <div class="mt-3 mt-md-0 d-flex gap-2">
      <button type="button" class="btn btn-danger fw-bold rounded-pill px-4 shadow-sm d-inline-flex align-items-center gap-1.5" data-bs-toggle="modal" data-bs-target="#newBlockModal">
        <i class="bi bi-slash-circle"></i>
        <span>Block Slots / Dates</span>
      </button>
    </div>
  </div>

  <!-- Quick Stats Metrics -->
  <div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-4">
      <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
        <div class="d-flex align-items-center justify-content-between">
          <div>
            <span class="text-secondary small fw-bold text-uppercase d-block mb-1" style="font-size: 11px; letter-spacing: 0.05em;">Total Active Blocks</span>
            <h3 class="fw-extrabold text-dark mb-0"><%= totalCount %></h3>
          </div>
          <div class="p-3 bg-danger-subtle text-danger rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
            <i class="bi bi-slash-circle fs-4"></i>
          </div>
        </div>
      </div>
    </div>

    <div class="col-sm-6 col-xl-4">
      <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
        <div class="d-flex align-items-center justify-content-between">
          <div>
            <span class="text-secondary small fw-bold text-uppercase d-block mb-1" style="font-size: 11px; letter-spacing: 0.05em;">Today's Blocks (<%= today %>)</span>
            <h3 class="fw-extrabold text-primary mb-0"><%= todayCount %></h3>
          </div>
          <div class="p-3 bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
            <i class="bi bi-calendar-event fs-4"></i>
          </div>
        </div>
      </div>
    </div>

    <div class="col-sm-6 col-xl-4">
      <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
        <div class="d-flex align-items-center justify-content-between">
          <div>
            <span class="text-secondary small fw-bold text-uppercase d-block mb-1" style="font-size: 11px; letter-spacing: 0.05em;">Full-Day Closures</span>
            <h3 class="fw-extrabold text-warning mb-0"><%= allDayCount %></h3>
          </div>
          <div class="p-3 bg-warning-subtle text-warning rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
            <i class="bi bi-door-closed fs-4"></i>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Main Active Blocks List Table Card -->
  <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white mb-4">
    <div class="card-header bg-white py-3 px-4 border-bottom d-flex align-items-center justify-content-between">
      <h5 class="fw-bold text-dark mb-0 d-flex align-items-center gap-2">
        <i class="bi bi-lock-fill text-danger"></i>
        <span>Active Court &amp; Date Blocks</span>
      </h5>
      <span class="text-muted small">Updated in real-time on player screens</span>
    </div>

    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr class="small text-uppercase text-secondary" style="font-size: 11px; letter-spacing: 0.04em;">
            <th class="ps-4">Date</th>
            <th>Court(s) Affected</th>
            <th>Time Duration</th>
            <th>Reason / Purpose</th>
            <th>Notes</th>
            <th>Created By</th>
            <th class="text-end pe-4">Action</th>
          </tr>
        </thead>
        <tbody>
          <% if (blocks && blocks.length > 0) { %>
            <% blocks.forEach(function(b) { %>
              <tr>
                <!-- Date -->
                <td class="ps-4">
                  <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-calendar3 text-primary"></i>
                    <div>
                      <strong class="text-dark d-block"><%= b.date %></strong>
                      <span class="small text-muted"><%= formatDate(b.date) %></span>
                    </div>
                  </div>
                </td>

                <!-- Courts Affected -->
                <td>
                  <% if (b.all_courts || !b.court_id) { %>
                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2.5 py-1 rounded-pill fw-bold">
                      <i class="bi bi-grid-3x3-gap-fill me-1"></i>All Courts (Facility)
                    </span>
                  <% } else if (b.court) { %>
                    <span class="badge bg-dark-subtle text-dark border px-2.5 py-1 rounded-pill fw-bold">
                      <i class="bi bi-circle-fill text-warning me-1" style="font-size: 8px;"></i><%= b.court.display_name %>
                    </span>
                  <% } else { %>
                    <span class="badge bg-secondary-subtle text-secondary px-2.5 py-1 rounded-pill">
                      Court #<%= b.court_id %>
                    </span>
                  <% } %>
                </td>

                <!-- Time Duration -->
                <td>
                  <% if (b.is_all_day) { %>
                    <span class="badge bg-danger text-white rounded-pill px-3 py-1 fw-bold">
                      <i class="bi bi-clock-fill me-1"></i>Entire Day (8AM - 12MN)
                    </span>
                  <% } else { %>
                    <span class="badge bg-light text-dark border rounded-pill px-2.5 py-1 fw-bold font-monospace">
                      <i class="bi bi-clock me-1 text-primary"></i><%= formatTime12(b.start_time) %> &ndash; <%= formatTime12(b.end_time) %>
                    </span>
                  <% } %>
                </td>

                <!-- Reason / Purpose -->
                <td>
                  <span class="badge bg-warning-subtle text-dark border border-warning px-2.5 py-1 rounded-pill fw-semibold">
                    <%= b.reason %>
                  </span>
                </td>

                <!-- Notes -->
                <td class="small text-secondary" style="max-width: 200px;">
                  <%= b.notes || '—' %>
                </td>

                <!-- Created By -->
                <td class="small text-secondary">
                  <div class="d-flex align-items-center gap-1.5">
                    <i class="bi bi-person-fill text-secondary"></i>
                    <span><%= b.creator ? (b.creator.full_name || b.creator.username) : 'Admin' %></span>
                  </div>
                  <span class="text-muted" style="font-size: 10px;"><%= b.created_at ? formatDate(b.created_at) : '' %></span>
                </td>

                <!-- Action: Unblock -->
                <td class="text-end pe-4">
                  <form action="/admin/blocks/<%= b.id %>/delete" method="POST" onsubmit="return confirm('Are you sure you want to unblock this? Selected court slots on <%= b.date %> will immediately become available for player bookings.');" class="d-inline">
                    <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3 fw-bold shadow-none" title="Remove block and open slots">
                      <i class="bi bi-unlock-fill me-1"></i>Unblock
                    </button>
                  </form>
                </td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr>
              <td colspan="7" class="text-center py-5 text-secondary">
                <div class="py-4">
                  <i class="bi bi-calendar-check fs-1 text-muted d-block mb-3"></i>
                  <h6 class="fw-bold text-dark">No Active Court Blocks</h6>
                  <p class="small text-muted mb-3">All courts are currently open for player bookings across all operating hours.</p>
                  <button type="button" class="btn btn-outline-danger btn-sm rounded-pill px-4 fw-bold shadow-sm" data-bs-toggle="modal" data-bs-target="#newBlockModal">
                    <i class="bi bi-plus-lg me-1"></i>Create a Block
                  </button>
                </div>
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- =========================================================
     MODAL: CREATE NEW COURT OR DAY BLOCK
========================================================= -->
<div class="modal fade" id="newBlockModal" tabindex="-1" aria-labelledby="newBlockModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content rounded-4 border-0 shadow-lg overflow-hidden">
      <form action="/admin/blocks" method="POST" id="courtBlockForm">
        <!-- Modal Header -->
        <div class="modal-header text-white px-4 py-3" style="background: linear-gradient(135deg, #0B2545 0%, #07172C 100%); border-bottom: 2px solid #D4AF37;">
          <div class="d-flex align-items-center gap-2">
            <div class="bg-danger text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
              <i class="bi bi-slash-circle fs-6"></i>
            </div>
            <div>
              <h5 class="modal-title fw-bold font-display mb-0" id="newBlockModalLabel">Block Court Slots / Day</h5>
              <span class="small text-white-50" style="font-size: 11px;">Prevent bookings for maintenance, events, or closures</span>
            </div>
          </div>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>

        <!-- Modal Body -->
        <div class="modal-body p-4">
          <!-- 1. Scope: Which Courts? -->
          <div class="mb-3">
            <label class="form-label small fw-bold text-dark mb-1">
              Courts Affected <span class="text-danger">*</span>
            </label>
            <select name="court_id" id="blockCourtSelect" class="form-select rounded-3" required>
              <option value="all" selected>All Courts (Entire Facility Closed)</option>
              <% if (courts && courts.length > 0) { %>
                <% courts.forEach(function(c) { %>
                  <option value="<%= c.id %>"><%= c.display_name %></option>
                <% }); %>
              <% } %>
            </select>
            <span class="small text-muted" style="font-size: 11px;">Choose a specific court or the entire facility.</span>
          </div>

          <!-- 2. Target Date -->
          <div class="mb-3">
            <label class="form-label small fw-bold text-dark mb-1">
              Date <span class="text-danger">*</span>
            </label>
            <input type="date" name="date" id="blockDateInput" class="form-control rounded-3" value="<%= today %>" required>
          </div>

          <!-- 3. Time Duration Mode -->
          <div class="mb-3">
            <label class="form-label small fw-bold text-dark mb-1 d-block">
              Duration Mode <span class="text-danger">*</span>
            </label>
            <div class="row g-2">
              <div class="col-6">
                <input type="radio" class="btn-check" name="time_mode" id="modeAllDay" value="all_day" checked onchange="toggleBlockTimeRange(false)">
                <label class="btn btn-outline-danger w-100 py-2 rounded-3 text-start small fw-bold d-flex align-items-center gap-2" for="modeAllDay">
                  <i class="bi bi-sun-fill text-warning"></i>
                  <span>Entire Day<br><span class="text-muted fw-normal" style="font-size: 10px;">8:00 AM - 12:00 MN</span></span>
                </label>
              </div>
              <div class="col-6">
                <input type="radio" class="btn-check" name="time_mode" id="modeCustom" value="custom" onchange="toggleBlockTimeRange(true)">
                <label class="btn btn-outline-danger w-100 py-2 rounded-3 text-start small fw-bold d-flex align-items-center gap-2" for="modeCustom">
                  <i class="bi bi-clock-history text-primary"></i>
                  <span>Specific Hours<br><span class="text-muted fw-normal" style="font-size: 10px;">Select time range</span></span>
                </label>
              </div>
            </div>
          </div>

          <!-- 4. Specific Time Range Pickers (Toggled) -->
          <div id="blockCustomTimeWrap" class="mb-3 p-3 bg-light rounded-3 border d-none">
            <div class="row g-2">
              <div class="col-6">
                <label class="form-label small fw-semibold text-dark mb-1">From (Start Hour)</label>
                <select name="start_time" id="blockStartTime" class="form-select form-select-sm rounded-3">
                  <option value="08:00" selected>8:00 AM</option>
                  <option value="09:00">9:00 AM</option>
                  <option value="10:00">10:00 AM</option>
                  <option value="11:00">11:00 AM</option>
                  <option value="12:00">12:00 PM</option>
                  <option value="13:00">1:00 PM</option>
                  <option value="14:00">2:00 PM</option>
                  <option value="15:00">3:00 PM</option>
                  <option value="16:00">4:00 PM</option>
                  <option value="17:00">5:00 PM</option>
                  <option value="18:00">6:00 PM</option>
                  <option value="19:00">7:00 PM</option>
                  <option value="20:00">8:00 PM</option>
                  <option value="21:00">9:00 PM</option>
                  <option value="22:00">10:00 PM</option>
                  <option value="23:00">11:00 PM</option>
                </select>
              </div>
              <div class="col-6">
                <label class="form-label small fw-semibold text-dark mb-1">To (End Hour)</label>
                <select name="end_time" id="blockEndTime" class="form-select form-select-sm rounded-3">
                  <option value="09:00">9:00 AM</option>
                  <option value="10:00">10:00 AM</option>
                  <option value="11:00">11:00 AM</option>
                  <option value="12:00" selected>12:00 PM</option>
                  <option value="13:00">1:00 PM</option>
                  <option value="14:00">2:00 PM</option>
                  <option value="15:00">3:00 PM</option>
                  <option value="16:00">4:00 PM</option>
                  <option value="17:00">5:00 PM</option>
                  <option value="18:00">6:00 PM</option>
                  <option value="19:00">7:00 PM</option>
                  <option value="20:00">8:00 PM</option>
                  <option value="21:00">9:00 PM</option>
                  <option value="22:00">10:00 PM</option>
                  <option value="23:00">11:00 PM</option>
                  <option value="24:00">12:00 MN (Closing)</option>
                </select>
              </div>
            </div>
          </div>

          <!-- 5. Reason / Preset -->
          <div class="mb-3">
            <label class="form-label small fw-bold text-dark mb-1">
              Reason / Purpose <span class="text-danger">*</span>
            </label>
            <select name="reason_preset" id="blockReasonPreset" class="form-select rounded-3 mb-2" onchange="handleBlockReasonPresetChange(this.value)">
              <option value="Court Maintenance & Surface Cleaning">Court Maintenance &amp; Surface Cleaning</option>
              <option value="Club Tournament / League Play">Club Tournament / League Play</option>
              <option value="Coaching Clinic / Private Training">Coaching Clinic / Private Training</option>
              <option value="Private Event / Venue Buyout">Private Event / Venue Buyout</option>
              <option value="Holiday Closure">Holiday Closure</option>
              <option value="Inclement Weather / Rain">Inclement Weather / Rain</option>
              <option value="VIP / Reserved Booking">VIP / Reserved Booking</option>
              <option value="OTHER">Other (Type custom reason below)</option>
            </select>
            <input type="text" name="reason" id="blockReasonInput" class="form-control rounded-3" value="Court Maintenance & Surface Cleaning" placeholder="Enter reason" required>
          </div>

          <!-- 6. Internal Notes -->
          <div class="mb-2">
            <label class="form-label small fw-semibold text-dark mb-1">
              Internal Admin Notes <span class="text-muted fw-normal">(Optional)</span>
            </label>
            <textarea name="notes" class="form-control rounded-3" rows="2" placeholder="e.g. Surface repainting on Court 1 by contractor"></textarea>
          </div>
        </div>

        <!-- Modal Footer -->
        <div class="modal-footer bg-light px-4 py-3 d-flex justify-content-between">
          <button type="button" class="btn btn-outline-secondary rounded-pill px-3.5" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-danger fw-bold rounded-pill px-4 shadow-sm d-inline-flex align-items-center gap-1.5">
            <i class="bi bi-lock-fill"></i>
            <span>Confirm &amp; Apply Block</span>
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  function toggleBlockTimeRange(showCustom) {
    const wrap = document.getElementById('blockCustomTimeWrap');
    if (!wrap) return;
    if (showCustom) {
      wrap.classList.remove('d-none');
    } else {
      wrap.classList.add('d-none');
    }
  }

  function handleBlockReasonPresetChange(val) {
    const input = document.getElementById('blockReasonInput');
    if (!input) return;
    if (val === 'OTHER') {
      input.value = '';
      input.focus();
    } else {
      input.value = val;
    }
  }
</script>
