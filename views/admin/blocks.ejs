<div class="container-fluid px-3 px-md-4 py-4">
  <!-- Executive Facility Hero Banner -->
  <div class="facility-hero-card p-4 p-md-5 mb-4 position-relative">
    <div class="facility-hero-glow"></div>
    <div class="facility-hero-watermark"><i class="bi bi-shield-shaded"></i></div>

    <div class="position-relative z-1 d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-4">
      <div class="max-w-xl">
        <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill bg-white bg-opacity-10 border border-light border-opacity-20 text-warning small fw-bold mb-2">
          <i class="bi bi-shield-lock-fill"></i>
          <span>FACILITY SCHEDULE CONTROLS &bull; THE PLAYGROUND</span>
        </div>
        <h2 class="fw-extrabold text-white font-display mb-2 display-6">Court &amp; Slot Schedule Management</h2>
        <p class="text-white-50 mb-3" style="font-size: 14.5px;">
          Inspect live court availability and block specific hours, individual courts, or full facility days for surface maintenance, club tournaments, or private buyouts.
        </p>

        <!-- Metrics Badges Row -->
        <div class="d-flex flex-wrap align-items-center gap-2">
          <span class="badge bg-white bg-opacity-10 border border-light border-opacity-20 text-white rounded-pill px-3 py-2 fw-semibold">
            <i class="bi bi-layers-fill text-warning me-1.5"></i>Active Rules: <strong class="text-white"><%= totalCount %></strong>
          </span>
          <span class="badge bg-white bg-opacity-10 border border-light border-opacity-20 text-white rounded-pill px-3 py-2 fw-semibold">
            <i class="bi bi-calendar-event-fill text-info me-1.5"></i>Today's Blocks: <strong class="text-white"><%= todayCount %></strong>
          </span>
          <span class="badge bg-white bg-opacity-10 border border-light border-opacity-20 text-white rounded-pill px-3 py-2 fw-semibold">
            <i class="bi bi-door-closed-fill text-danger me-1.5"></i>Full-Day Closures: <strong class="text-white"><%= allDayCount %></strong>
          </span>
        </div>
      </div>

      <div class="d-flex flex-column flex-sm-row align-items-stretch align-items-lg-center gap-2 flex-shrink-0">
        <button type="button" class="btn btn-warning fw-extrabold rounded-pill px-4 py-2.5 shadow-md d-inline-flex align-items-center justify-content-center gap-2 text-dark" data-bs-toggle="modal" data-bs-target="#newBlockModal">
          <i class="bi bi-plus-circle-fill fs-5"></i>
          <span>Block Slots / Date</span>
        </button>
      </div>
    </div>
  </div>

  <!-- =========================================================
       SECTION 1: INTERACTIVE LIVE COURT SCHEDULE INSPECTOR (4 COURTS)
       ========================================================= -->
  <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white mb-4">
    <!-- Inspector Header & Date Controls -->
    <div class="card-header bg-white p-3 p-md-4 border-bottom">
      <div class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3">
        <!-- Date Navigator -->
        <div class="d-flex align-items-center gap-2 flex-wrap">
          <div class="btn-group shadow-xs">
            <button type="button" class="btn btn-outline-secondary btn-sm rounded-start-pill px-3" onclick="navigateInspectorDate(-1)" title="Previous Day">
              <i class="bi bi-chevron-left"></i>
            </button>
            <button type="button" class="btn btn-outline-secondary btn-sm px-3 fw-bold text-dark" id="inspectorDateDisplayBtn" onclick="document.getElementById('inspectorDateInput').showPicker()">
              <i class="bi bi-calendar3 me-1.5 text-primary"></i>
              <span id="inspectorDateLabel"><%= today %></span>
            </button>
            <button type="button" class="btn btn-outline-secondary btn-sm rounded-end-pill px-3" onclick="navigateInspectorDate(1)" title="Next Day">
              <i class="bi bi-chevron-right"></i>
            </button>
          </div>

          <input type="date" id="inspectorDateInput" class="visually-hidden" value="<%= today %>" onchange="loadInspectorSchedule(this.value)">

          <!-- Quick Day Jump Pills -->
          <div class="d-flex align-items-center gap-1">
            <button type="button" class="btn btn-light btn-sm rounded-pill px-2.5 py-1 text-secondary fw-semibold border" onclick="jumpInspectorDate('<%= today %>')">
              Today
            </button>
            <button type="button" class="btn btn-light btn-sm rounded-pill px-2.5 py-1 text-secondary fw-semibold border" onclick="jumpInspectorOffset(1)">
              Tomorrow
            </button>
            <button type="button" class="btn btn-light btn-sm rounded-pill px-2.5 py-1 text-secondary fw-semibold border" onclick="jumpInspectorToWeekend()">
              This Weekend
            </button>
          </div>
        </div>

        <!-- Legend and Quick Full-Day Closure Button -->
        <div class="d-flex align-items-center gap-2 gap-sm-3 flex-wrap">
          <!-- Legend Pill -->
          <div class="d-flex align-items-center gap-2 small px-2.5 py-1 bg-light rounded-pill border" style="font-size: 11px;">
            <span class="d-inline-flex align-items-center gap-1"><span class="badge rounded-circle p-1 bg-success"></span> Open</span>
            <span class="d-inline-flex align-items-center gap-1"><span class="badge rounded-circle p-1 bg-danger"></span> Blocked</span>
            <span class="d-inline-flex align-items-center gap-1"><span class="badge rounded-circle p-1" style="background:#0B2545;"></span> Booked</span>
          </div>

          <button type="button" class="btn btn-outline-danger btn-sm rounded-pill px-3 py-1.5 fw-bold d-inline-flex align-items-center gap-1.5" onclick="quickBlockFullDay()">
            <i class="bi bi-door-closed-fill"></i>
            <span>Block All Courts for This Day</span>
          </button>
        </div>
      </div>

      <!-- Facility Closed Notification Banner for Inspected Date -->
      <div id="inspectorClosedBanner" class="alert alert-danger d-none align-items-center justify-content-between rounded-3 mt-3 mb-0 py-2 px-3 border-danger-subtle shadow-xs">
        <div class="d-flex align-items-center gap-2">
          <i class="bi bi-slash-circle-fill text-danger fs-5"></i>
          <div>
            <strong class="text-danger">Facility Full-Day Closure Active:</strong>
            <span id="inspectorClosedReason" class="text-danger-emphasis small ms-1">All courts are blocked today.</span>
          </div>
        </div>
        <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-2.5 py-0.5 fw-bold" onclick="unblockFullDayForInspectedDate()">
          Unblock Day
        </button>
      </div>
    </div>

    <!-- Inspector 4-Court Columns Grid Viewport -->
    <div class="p-3 p-md-4">
      <div class="text-center py-5" id="inspectorLoadingSpinner">
        <div class="spinner-border text-primary mb-2" role="status"></div>
        <p class="text-secondary small fw-semibold mb-0">Loading court schedule for date...</p>
      </div>

      <!-- Live Columns Layout (4 Courts Side-by-Side) -->
      <div class="row g-3 d-none" id="inspectorCourtsGrid">
        <!-- Injected via JavaScript -->
      </div>
    </div>
  </div>

  <!-- =========================================================
       SECTION 2: ACTIVE FACILITY RULES & BLACKOUT DATES TABLE
       ========================================================= -->
  <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
    <div class="card-header bg-white py-3 px-4 border-bottom d-flex align-items-center justify-content-between">
      <div class="d-flex align-items-center gap-2">
        <i class="bi bi-card-checklist text-primary fs-5"></i>
        <h5 class="fw-bold text-dark mb-0">Active Facility Block Rules &amp; Blackouts</h5>
      </div>
      <span class="badge bg-secondary-subtle text-secondary rounded-pill px-3 py-1 font-monospace">
        <%= blocks.length %> Rule<%= blocks.length === 1 ? '' : 's' %> Recorded
      </span>
    </div>

    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr class="small text-uppercase text-secondary" style="font-size: 11px; letter-spacing: 0.04em;">
            <th class="ps-4">Date</th>
            <th>Court(s) Affected</th>
            <th>Duration</th>
            <th>Reason / Purpose</th>
            <th>Notes</th>
            <th>Created By</th>
            <th class="text-end pe-4">Action</th>
          </tr>
        </thead>
        <tbody>
          <% if (blocks && blocks.length > 0) { %>
            <% blocks.forEach(function(b) { %>
              <tr>
                <td class="ps-4">
                  <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-calendar3 text-primary"></i>
                    <div>
                      <strong class="text-dark d-block"><%= b.date %></strong>
                      <span class="small text-muted"><%= formatDate(b.date) %></span>
                    </div>
                  </div>
                </td>

                <td>
                  <% if (b.all_courts || !b.court_id) { %>
                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2.5 py-1 rounded-pill fw-bold">
                      <i class="bi bi-grid-3x3-gap-fill me-1"></i>All 4 Courts
                    </span>
                  <% } else if (b.court) { %>
                    <span class="badge bg-dark text-white px-2.5 py-1 rounded-pill fw-bold">
                      <i class="bi bi-circle-fill text-warning me-1" style="font-size: 7px;"></i><%= b.court.display_name %>
                    </span>
                  <% } else { %>
                    <span class="badge bg-secondary-subtle text-secondary px-2.5 py-1 rounded-pill">
                      Court #<%= b.court_id %>
                    </span>
                  <% } %>
                </td>

                <td>
                  <% if (b.is_all_day) { %>
                    <span class="badge bg-danger text-white rounded-pill px-2.5 py-1 fw-bold">
                      <i class="bi bi-sun-fill me-1"></i>Entire Day (8AM - 12MN)
                    </span>
                  <% } else { %>
                    <span class="badge bg-light text-dark border rounded-pill px-2.5 py-1 fw-bold font-monospace">
                      <i class="bi bi-clock me-1 text-primary"></i><%= formatTime12(b.start_time) %> &ndash; <%= formatTime12(b.end_time) %>
                    </span>
                  <% } %>
                </td>

                <td>
                  <span class="badge bg-warning-subtle text-dark border border-warning px-2.5 py-1 rounded-pill fw-semibold">
                    <%= b.reason %>
                  </span>
                </td>

                <td class="small text-secondary" style="max-width: 220px;">
                  <%= b.notes || '—' %>
                </td>

                <td class="small text-secondary">
                  <div class="d-flex align-items-center gap-1.5">
                    <i class="bi bi-person-fill text-muted"></i>
                    <span><%= b.creator ? (b.creator.full_name || b.creator.username) : 'Admin' %></span>
                  </div>
                  <span class="text-muted" style="font-size: 10px;"><%= b.created_at ? formatDate(b.created_at) : '' %></span>
                </td>

                <td class="text-end pe-4">
                  <form action="/admin/blocks/<%= b.id %>/delete" method="POST" onsubmit="return confirm('Unblock this rule? Slots on <%= b.date %> will immediately reopen for player bookings.');" class="d-inline">
                    <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3 fw-bold shadow-none">
                      <i class="bi bi-unlock-fill me-1"></i>Unblock
                    </button>
                  </form>
                </td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr>
              <td colspan="7" class="text-center py-5 text-secondary">
                <div class="py-4">
                  <div class="p-3 bg-light rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style="width: 56px; height: 56px;">
                    <i class="bi bi-check2-circle fs-2 text-success"></i>
                  </div>
                  <h6 class="fw-bold text-dark mb-1">Facility Operating on Normal Schedule</h6>
                  <p class="small text-muted mb-3">All 4 championship courts are open for regular player bookings.</p>
                  <button type="button" class="btn btn-outline-primary btn-sm rounded-pill px-4 fw-bold shadow-xs" data-bs-toggle="modal" data-bs-target="#newBlockModal">
                    <i class="bi bi-plus-circle me-1"></i>Create a Block Rule
                  </button>
                </div>
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- =========================================================
     MODAL 1: CREATE FULL COURT OR DAY BLOCK
========================================================= -->
<div class="modal fade" id="newBlockModal" tabindex="-1" aria-labelledby="newBlockModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content rounded-4 border-0 shadow-lg overflow-hidden">
      <form action="/admin/blocks" method="POST" id="courtBlockForm">
        <div class="modal-header text-white px-4 py-3" style="background: linear-gradient(135deg, #0B2545 0%, #07172C 100%); border-bottom: 2px solid #D4AF37;">
          <div class="d-flex align-items-center gap-2">
            <div class="bg-warning text-dark rounded-circle d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
              <i class="bi bi-slash-circle-fill fs-6"></i>
            </div>
            <div>
              <h5 class="modal-title fw-bold font-display mb-0" id="newBlockModalLabel">Block Court Slots / Day</h5>
              <span class="small text-white-50" style="font-size: 11px;">Prevent bookings for maintenance, events, or closures</span>
            </div>
          </div>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>

        <div class="modal-body p-4">
          <!-- 1. Scope: Which Courts? -->
          <div class="mb-3">
            <label class="form-label small fw-bold text-dark mb-1">
              Courts Affected <span class="text-danger">*</span>
            </label>
            <select name="court_id" id="blockCourtSelect" class="form-select rounded-3" required>
              <option value="all" selected>All Courts (Entire Facility Closed)</option>
              <% if (courts && courts.length > 0) { %>
                <% courts.forEach(function(c) { %>
                  <option value="<%= c.id %>"><%= c.display_name %></option>
                <% }); %>
              <% } %>
            </select>
          </div>

          <!-- 2. Target Date -->
          <div class="mb-3">
            <label class="form-label small fw-bold text-dark mb-1">
              Date <span class="text-danger">*</span>
            </label>
            <input type="date" name="date" id="blockDateInput" class="form-control rounded-3" value="<%= today %>" required>
          </div>

          <!-- 3. Duration Mode -->
          <div class="mb-3">
            <label class="form-label small fw-bold text-dark mb-1 d-block">
              Duration Mode <span class="text-danger">*</span>
            </label>
            <div class="row g-2">
              <div class="col-6">
                <input type="radio" class="btn-check" name="time_mode" id="modeAllDay" value="all_day" checked onchange="toggleBlockTimeRange(false)">
                <label class="btn btn-outline-danger w-100 py-2 rounded-3 text-start small fw-bold d-flex align-items-center gap-2" for="modeAllDay">
                  <i class="bi bi-sun-fill text-warning"></i>
                  <span>Entire Day<br><span class="text-muted fw-normal" style="font-size: 10px;">8:00 AM - 12:00 MN</span></span>
                </label>
              </div>
              <div class="col-6">
                <input type="radio" class="btn-check" name="time_mode" id="modeCustom" value="custom" onchange="toggleBlockTimeRange(true)">
                <label class="btn btn-outline-danger w-100 py-2 rounded-3 text-start small fw-bold d-flex align-items-center gap-2" for="modeCustom">
                  <i class="bi bi-clock-history text-primary"></i>
                  <span>Specific Hours<br><span class="text-muted fw-normal" style="font-size: 10px;">Select time range</span></span>
                </label>
              </div>
            </div>
          </div>

          <!-- 4. Specific Time Range Pickers -->
          <div id="blockCustomTimeWrap" class="mb-3 p-3 bg-light rounded-3 border d-none">
            <div class="row g-2">
              <div class="col-6">
                <label class="form-label small fw-semibold text-dark mb-1">Start Time</label>
                <select name="start_time" id="blockStartTime" class="form-select form-select-sm rounded-3">
                  <% for(let h = 8; h <= 23; h++) { const hh = String(h).padStart(2, '0') + ':00'; %>
                    <option value="<%= hh %>"><%= formatTime12(hh) %></option>
                  <% } %>
                </select>
              </div>
              <div class="col-6">
                <label class="form-label small fw-semibold text-dark mb-1">End Time</label>
                <select name="end_time" id="blockEndTime" class="form-select form-select-sm rounded-3">
                  <% for(let h = 9; h <= 24; h++) { const hh = String(h).padStart(2, '0') + ':00'; %>
                    <option value="<%= hh %>" <%= h === 12 ? 'selected' : '' %>><%= formatTime12(hh) %></option>
                  <% } %>
                </select>
              </div>
            </div>
          </div>

          <!-- 5. Reason / Preset -->
          <div class="mb-3">
            <label class="form-label small fw-bold text-dark mb-1">
              Reason / Purpose <span class="text-danger">*</span>
            </label>
            <select name="reason_preset" id="blockReasonPreset" class="form-select rounded-3 mb-2" onchange="handleBlockReasonPresetChange(this.value)">
              <option value="Court Maintenance & Surface Cleaning">Court Maintenance &amp; Surface Cleaning</option>
              <option value="Club Tournament / League Play">Club Tournament / League Play</option>
              <option value="Coaching Clinic / Private Training">Coaching Clinic / Private Training</option>
              <option value="Private Event / Venue Buyout">Private Event / Venue Buyout</option>
              <option value="Holiday Closure">Holiday Closure</option>
              <option value="Inclement Weather / Rain">Inclement Weather / Rain</option>
              <option value="VIP / Reserved Booking">VIP / Reserved Booking</option>
              <option value="OTHER">Other (Type custom reason below)</option>
            </select>
            <input type="text" name="reason" id="blockReasonInput" class="form-control rounded-3" value="Court Maintenance & Surface Cleaning" placeholder="Enter reason" required>
          </div>

          <!-- 6. Internal Notes -->
          <div class="mb-2">
            <label class="form-label small fw-semibold text-dark mb-1">
              Internal Admin Notes <span class="text-muted fw-normal">(Optional)</span>
            </label>
            <textarea name="notes" class="form-control rounded-3" rows="2" placeholder="e.g. Surface repainting on Court 1 by contractor"></textarea>
          </div>
        </div>

        <div class="modal-footer bg-light px-4 py-3 d-flex justify-content-between">
          <button type="button" class="btn btn-outline-secondary rounded-pill px-3.5" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-danger fw-bold rounded-pill px-4 shadow-sm d-inline-flex align-items-center gap-1.5">
            <i class="bi bi-lock-fill"></i>
            <span>Confirm &amp; Apply Block</span>
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- =========================================================
     MODAL 2: 1-CLICK QUICK SLOT BLOCK MODAL (FROM GRID)
========================================================= -->
<div class="modal fade" id="quickSlotBlockModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-sm">
    <div class="modal-content rounded-4 border-0 shadow-lg overflow-hidden">
      <form action="/admin/blocks" method="POST">
        <input type="hidden" name="court_id" id="quickBlockCourtId">
        <input type="hidden" name="date" id="quickBlockDate">
        <input type="hidden" name="time_mode" value="custom">
        <input type="hidden" name="start_time" id="quickBlockStartTime">
        <input type="hidden" name="end_time" id="quickBlockEndTime">

        <div class="modal-header bg-dark text-white p-3 border-0">
          <h6 class="modal-title fw-bold mb-0">Block Single Time Slot</h6>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body p-3">
          <div class="p-2.5 bg-light rounded-3 border mb-3 small">
            <div><strong id="quickBlockCourtName">—</strong></div>
            <div class="text-muted" id="quickBlockTimeRange">—</div>
          </div>

          <label class="form-label small fw-bold text-dark mb-1">Reason</label>
          <select name="reason" class="form-select form-select-sm rounded-3 mb-2" required>
            <option value="Court Maintenance & Surface Cleaning">Court Maintenance</option>
            <option value="Coaching Clinic / Private Training">Coaching Clinic</option>
            <option value="Club Tournament / League Play">Tournament / League</option>
            <option value="Private Event / Venue Buyout">Private Event</option>
            <option value="Reserved / VIP Booking">VIP / Reserved</option>
          </select>
        </div>
        <div class="modal-footer p-2 bg-light d-flex justify-content-between">
          <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-danger btn-sm rounded-pill px-3.5 fw-bold">Block Slot</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  let currentInspectedDate = '<%= today %>';

  function toggleBlockTimeRange(showCustom) {
    const wrap = document.getElementById('blockCustomTimeWrap');
    if (!wrap) return;
    if (showCustom) {
      wrap.classList.remove('d-none');
    } else {
      wrap.classList.add('d-none');
    }
  }

  function handleBlockReasonPresetChange(val) {
    const input = document.getElementById('blockReasonInput');
    if (!input) return;
    if (val === 'OTHER') {
      input.value = '';
      input.focus();
    } else {
      input.value = val;
    }
  }

  function navigateInspectorDate(delta) {
    const d = new Date(currentInspectedDate + 'T00:00:00');
    d.setDate(d.getDate() + delta);
    const ymd = d.toISOString().split('T')[0];
    jumpInspectorDate(ymd);
  }

  function jumpInspectorOffset(days) {
    const d = new Date('<%= today %>T00:00:00');
    d.setDate(d.getDate() + days);
    const ymd = d.toISOString().split('T')[0];
    jumpInspectorDate(ymd);
  }

  function jumpInspectorToWeekend() {
    const d = new Date('<%= today %>T00:00:00');
    const day = d.getDay();
    const daysUntilSaturday = (6 - day + 7) % 7;
    d.setDate(d.getDate() + (daysUntilSaturday === 0 ? 7 : daysUntilSaturday));
    const ymd = d.toISOString().split('T')[0];
    jumpInspectorDate(ymd);
  }

  function jumpInspectorDate(dateYmd) {
    currentInspectedDate = dateYmd;
    document.getElementById('inspectorDateInput').value = dateYmd;
    loadInspectorSchedule(dateYmd);
  }

  async function loadInspectorSchedule(dateYmd) {
    currentInspectedDate = dateYmd;
    const labelEl = document.getElementById('inspectorDateLabel');
    const spinner = document.getElementById('inspectorLoadingSpinner');
    const grid = document.getElementById('inspectorCourtsGrid');
    const closedBanner = document.getElementById('inspectorClosedBanner');
    const closedReasonEl = document.getElementById('inspectorClosedReason');

    if (labelEl) {
      const d = new Date(dateYmd + 'T00:00:00');
      labelEl.innerText = d.toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric' });
    }

    if (spinner) spinner.classList.remove('d-none');
    if (grid) grid.classList.add('d-none');

    try {
      const res = await fetch(`/courts-availability?date=${encodeURIComponent(dateYmd)}&_t=${Date.now()}`);
      const data = await res.json();

      if (data.success && data.courts) {
        if (data.isDayClosed) {
          closedBanner.classList.remove('d-none');
          closedBanner.classList.add('d-flex');
          closedReasonEl.innerText = data.closedReason || 'All courts are blocked today.';
        } else {
          closedBanner.classList.add('d-none');
          closedBanner.classList.remove('d-flex');
        }

        renderInspectorGrid(data.courts, dateYmd);
      }
    } catch (err) {
      console.error('Inspector schedule error:', err);
    } finally {
      if (spinner) spinner.classList.add('d-none');
      if (grid) grid.classList.remove('d-none');
    }
  }

  function renderInspectorGrid(courts, dateYmd) {
    const grid = document.getElementById('inspectorCourtsGrid');
    grid.innerHTML = '';

    courts.forEach(court => {
      const col = document.createElement('div');
      col.className = 'col-12 col-md-6 col-xl-3';

      let slotsHtml = '';
      (court.slots || []).forEach(slot => {
        let statusBadge = '';
        let slotClass = 'slot-open';
        let clickAction = '';

        if (slot.status === 'BLOCKED' || slot.status === 'MAINTENANCE') {
          slotClass = 'slot-blocked';
          statusBadge = `<span class="badge bg-danger text-white rounded-pill px-2 py-0.5" style="font-size: 9.5px;">⊘ Blocked</span>`;
          if (slot.blockId) {
            clickAction = `onclick="handleUnblockClick(${slot.blockId}, '${dateYmd}')"`;
          } else {
            clickAction = `onclick="alert('This slot is part of a day or facility block rule below.')"`;
          }
        } else if (slot.status === 'CONFIRMED' || slot.status === 'BOOKED') {
          slotClass = 'slot-booked';
          statusBadge = `<span class="badge bg-light text-dark rounded-pill px-2 py-0.5" style="font-size: 9.5px;">Booked</span>`;
          clickAction = `onclick="alert('This slot has an active player reservation: ${slot.referenceNumber || ''}')"`;
        } else if (slot.status === 'AWAITING_PAYMENT' || slot.status === 'PENDING') {
          slotClass = 'slot-processing';
          statusBadge = `<span class="badge bg-warning text-dark rounded-pill px-2 py-0.5" style="font-size: 9.5px;">Held (GCash)</span>`;
          clickAction = `onclick="alert('Held by player: ${slot.referenceNumber || ''}')"`;
        } else if (slot.status === 'AWAITING_CONFIRMATION') {
          slotClass = 'slot-processing';
          statusBadge = `<span class="badge bg-info text-white rounded-pill px-2 py-0.5" style="font-size: 9.5px;">Verifying</span>`;
          clickAction = `onclick="alert('Under Admin Verification: ${slot.referenceNumber || ''}')"`;
        } else {
          // Open
          slotClass = 'slot-open';
          statusBadge = `<span class="text-success small fw-bold" style="font-size: 11px;">Open</span>`;
          clickAction = `onclick="openQuickSlotBlockModal(${court.id}, '${court.name}', '${dateYmd}', '${slot.startTime}', '${slot.endTime}', '${slot.startLabel}', '${slot.endLabel}')"`;
        }

        slotsHtml += `
          <div class="admin-court-grid-slot ${slotClass} mb-1.5" ${clickAction}>
            <div class="fw-bold" style="font-size: 11px;">${slot.startLabel}</div>
            <div>${statusBadge}</div>
          </div>
        `;
      });

      col.innerHTML = `
        <div class="card border rounded-4 bg-light p-3 shadow-xs h-100">
          <div class="d-flex align-items-center justify-content-between mb-2 pb-2 border-bottom">
            <div>
              <strong class="text-dark d-block fs-6">${court.name}</strong>
              <span class="small text-muted" style="font-size: 11px;">₱${court.pricePerHour}/hr</span>
            </div>
            <button type="button" class="btn btn-outline-danger btn-sm rounded-pill px-2.5 py-0.5 fw-bold" style="font-size: 10.5px;" onclick="quickBlockSingleCourtAllDay(${court.id}, '${court.name}', '${dateYmd}')">
              Block Court
            </button>
          </div>
          <div style="max-height: 480px; overflow-y: auto; padding-right: 2px;">
            ${slotsHtml}
          </div>
        </div>
      `;

      grid.appendChild(col);
    });
  }

  function openQuickSlotBlockModal(courtId, courtName, dateYmd, startTime, endTime, startLabel, endLabel) {
    document.getElementById('quickBlockCourtId').value = courtId;
    document.getElementById('quickBlockCourtName').innerText = courtName;
    document.getElementById('quickBlockDate').value = dateYmd;
    document.getElementById('quickBlockStartTime').value = startTime;
    document.getElementById('quickBlockEndTime').value = endTime;
    document.getElementById('quickBlockTimeRange').innerText = `${dateYmd} · ${startLabel} to ${endLabel}`;

    const modal = new bootstrap.Modal(document.getElementById('quickSlotBlockModal'));
    modal.show();
  }

  function quickBlockSingleCourtAllDay(courtId, courtName, dateYmd) {
    document.getElementById('blockCourtSelect').value = courtId;
    document.getElementById('blockDateInput').value = dateYmd;
    document.getElementById('modeAllDay').checked = true;
    toggleBlockTimeRange(false);
    const modal = new bootstrap.Modal(document.getElementById('newBlockModal'));
    modal.show();
  }

  function quickBlockFullDay() {
    document.getElementById('blockCourtSelect').value = 'all';
    document.getElementById('blockDateInput').value = currentInspectedDate;
    document.getElementById('modeAllDay').checked = true;
    toggleBlockTimeRange(false);
    const modal = new bootstrap.Modal(document.getElementById('newBlockModal'));
    modal.show();
  }

  function handleUnblockClick(blockId, dateYmd) {
    if (confirm(`Unblock this slot on ${dateYmd}? It will immediately become available for player bookings.`)) {
      const form = document.createElement('form');
      form.method = 'POST';
      form.action = `/admin/blocks/${blockId}/delete`;
      document.body.appendChild(form);
      form.submit();
    }
  }

  function unblockFullDayForInspectedDate() {
    alert('Please find the matching block rule in the table below and click "Unblock".');
  }

  // Initial Load
  document.addEventListener('DOMContentLoaded', () => {
    loadInspectorSchedule(currentInspectedDate);
  });
</script>
