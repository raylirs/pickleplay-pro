<script>
  let currentInspectedDate = '<%= typeof inspectedDate !== "undefined" && inspectedDate ? inspectedDate : today %>';
  let selectedSlotsMap = new Map(); // key: `${courtId}_${startTime}`, value: { courtId, courtName, startTime, endTime, startLabel, endLabel }
  let lastLoadedCourts = [];

  function escapeJs(str) {
    return (str || '').replace(/'/g, "\\'").replace(/"/g, '&quot;');
  }

  function toggleBlockTimeRange(showCustom) {
    const wrap = document.getElementById('blockCustomTimeWrap');
    if (!wrap) return;
    if (showCustom) {
      wrap.classList.remove('d-none');
    } else {
      wrap.classList.add('d-none');
    }
  }

  function toggleCustomTimeSubMode(mode) {
    const chipsGrid = document.getElementById('modalSlotChipsGrid');
    const presets = document.getElementById('slotQuickPresets');
    const notice = document.getElementById('modalSlotCountNotice');
    const dropdowns = document.getElementById('modalTimeRangeDropdowns');
    const btnSlots = document.getElementById('btnModeSlots');
    const btnRange = document.getElementById('btnModeRange');

    if (mode === 'slots') {
      if (chipsGrid) chipsGrid.classList.remove('d-none');
      if (presets) presets.classList.remove('d-none');
      if (notice) notice.classList.remove('d-none');
      if (dropdowns) dropdowns.classList.add('d-none');
      if (btnSlots) btnSlots.classList.add('active');
      if (btnRange) btnRange.classList.remove('active');
    } else {
      if (chipsGrid) chipsGrid.classList.add('d-none');
      if (presets) presets.classList.add('d-none');
      if (notice) notice.classList.add('d-none');
      if (dropdowns) dropdowns.classList.remove('d-none');
      if (btnSlots) btnSlots.classList.remove('active');
      if (btnRange) btnRange.classList.add('active');
      presetModalSlots('clear');
    }
  }

  function presetModalSlots(type) {
    const checkboxes = document.querySelectorAll('.modal-slot-checkbox');
    checkboxes.forEach(cb => {
      const hour = parseInt(cb.value.split(':')[0], 10);
      if (type === 'all') {
        cb.checked = true;
      } else if (type === 'morning') {
        cb.checked = hour >= 6 && hour < 12;
      } else if (type === 'afternoon') {
        cb.checked = hour >= 12 && hour < 18;
      } else if (type === 'evening') {
        cb.checked = hour >= 18 && hour <= 23;
      } else if (type === 'clear') {
        cb.checked = false;
      }
    });
    updateModalSlotCount();
  }

  function updateModalSlotCount() {
    const checked = document.querySelectorAll('.modal-slot-checkbox:checked');
    const notice = document.getElementById('modalSlotCountNotice');
    if (notice) {
      if (checked.length === 0) {
        notice.innerHTML = '<i class="bi bi-info-circle me-1"></i>Click one or more times above, or switch to Time Range.';
        notice.className = 'small text-muted mb-0';
      } else {
        notice.innerHTML = `<i class="bi bi-check2-circle text-success me-1"></i><strong>${checked.length}</strong> time slot${checked.length === 1 ? '' : 's'} selected to block.`;
        notice.className = 'small text-success mb-0';
      }
    }
  }

  function updateNotesPlaceholder(presetVal, labelId, textareaId) {
    const lbl = document.getElementById(labelId);
    const txt = document.getElementById(textareaId);
    if (!lbl || !txt) return;
    const isRes = /reserved/i.test(presetVal || '');
    if (isRes) {
      lbl.innerHTML = '<i class="bi bi-person-fill text-warning me-1"></i>Reserved For (Name / Group) <span class="text-danger">*</span>';
      txt.placeholder = 'e.g. Reserved for John Doe, Mayor Santos, or VIP Player';
    } else {
      lbl.innerHTML = 'Internal Admin Notes <span class="text-muted fw-normal">(Optional)</span>';
      txt.placeholder = 'e.g. Surface repainting on Court 1 by contractor';
    }
  }

  function handleBlockReasonPresetChange(val) {
    const hiddenInput = document.getElementById('blockReasonInput');
    const wrap = document.getElementById('blockCustomReasonWrap');
    const customInput = document.getElementById('blockCustomReasonInput');
    updateNotesPlaceholder(val, 'blockNotesLabel', 'blockNotesInput');
    if (!hiddenInput) return;

    if (val === 'OTHER') {
      if (wrap) wrap.classList.remove('d-none');
      if (customInput) {
        customInput.required = true;
        customInput.focus();
        hiddenInput.value = customInput.value.trim();
      }
    } else {
      if (wrap) wrap.classList.add('d-none');
      if (customInput) {
        customInput.required = false;
        customInput.value = '';
      }
      hiddenInput.value = val;
    }
  }

  function handleMultiBlockReasonPresetChange(val) {
    const hiddenInput = document.getElementById('multiBlockReasonInput');
    const wrap = document.getElementById('multiBlockCustomReasonWrap');
    const customInput = document.getElementById('multiBlockCustomReasonInput');
    updateNotesPlaceholder(val, 'multiBlockNotesLabel', 'multiBlockNotesInput');
    if (!hiddenInput) return;

    if (val === 'OTHER') {
      if (wrap) wrap.classList.remove('d-none');
      if (customInput) {
        customInput.required = true;
        customInput.focus();
        hiddenInput.value = customInput.value.trim();
      }
    } else {
      if (wrap) wrap.classList.add('d-none');
      if (customInput) {
        customInput.required = false;
        customInput.value = '';
      }
      hiddenInput.value = val;
    }
  }

  function formatLocalDateYmd(dateObj) {
    const y = dateObj.getFullYear();
    const m = String(dateObj.getMonth() + 1).padStart(2, '0');
    const d = String(dateObj.getDate()).padStart(2, '0');
    return `${y}-${m}-${d}`;
  }

  function parseLocalDate(ymdString) {
    if (!ymdString) return new Date();
    const parts = ymdString.split('-').map(Number);
    return new Date(parts[0], parts[1] - 1, parts[2]);
  }

  function openInspectorDatePicker() {
    const input = document.getElementById('inspectorDateInput');
    if (!input) return;
    if (typeof input.showPicker === 'function') {
      try {
        input.showPicker();
        return;
      } catch (err) {}
    }
    input.focus();
    input.click();
  }

  function navigateInspectorDate(delta) {
    const d = parseLocalDate(currentInspectedDate);
    d.setDate(d.getDate() + delta);
    const ymd = formatLocalDateYmd(d);
    jumpInspectorDate(ymd);
  }

  function jumpInspectorOffset(days) {
    const d = parseLocalDate('<%= today %>');
    d.setDate(d.getDate() + days);
    const ymd = formatLocalDateYmd(d);
    jumpInspectorDate(ymd);
  }

  function jumpInspectorToWeekend() {
    const d = parseLocalDate('<%= today %>');
    const day = d.getDay();
    const daysUntilSaturday = (6 - day + 7) % 7;
    d.setDate(d.getDate() + (daysUntilSaturday === 0 ? 7 : daysUntilSaturday));
    const ymd = formatLocalDateYmd(d);
    jumpInspectorDate(ymd);
  }

  function jumpInspectorDate(dateYmd) {
    currentInspectedDate = dateYmd;
    selectedSlotsMap.clear();
    updateMultiSelectBar();
    document.getElementById('inspectorDateInput').value = dateYmd;
    if (window.history && window.history.replaceState) {
      window.history.replaceState(null, '', `/admin/blocks?date=${encodeURIComponent(dateYmd)}`);
    }
    loadInspectorSchedule(dateYmd);
  }

  async function loadInspectorSchedule(dateYmd) {
    currentInspectedDate = dateYmd;
    const labelEl = document.getElementById('inspectorDateLabel');
    const spinner = document.getElementById('inspectorLoadingSpinner');
    const grid = document.getElementById('inspectorCourtsGrid');
    const closedBanner = document.getElementById('inspectorClosedBanner');
    const closedReasonEl = document.getElementById('inspectorClosedReason');

    if (labelEl) {
      const d = parseLocalDate(dateYmd);
      labelEl.innerText = d.toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric' });
    }

    if (spinner) spinner.classList.remove('d-none');
    if (grid) grid.classList.add('d-none');

    try {
      const res = await fetch(`/courts-availability?date=${encodeURIComponent(dateYmd)}&_t=${Date.now()}`);
      const data = await res.json();

      if (data.success && data.courts) {
        lastLoadedCourts = data.courts;
        if (data.isDayClosed) {
          closedBanner.classList.remove('d-none');
          closedBanner.classList.add('d-flex');
          closedReasonEl.innerText = data.closedReason || 'All courts are blocked today.';
        } else {
          closedBanner.classList.add('d-none');
          closedBanner.classList.remove('d-flex');
        }

        renderInspectorGrid(data.courts, dateYmd);
      }
    } catch (err) {
      console.error('Inspector schedule error:', err);
    } finally {
      if (spinner) spinner.classList.add('d-none');
      if (grid) grid.classList.remove('d-none');
    }
  }

  function renderInspectorGrid(courts, dateYmd) {
    const grid = document.getElementById('inspectorCourtsGrid');
    grid.innerHTML = '';

    courts.forEach(court => {
      const col = document.createElement('div');
      col.className = 'col-12 col-md-6 col-xl-3';

      let slotsHtml = '';
      (court.slots || []).forEach(slot => {
        let statusBadge = '';
        let slotClass = 'slot-open';
        let clickAction = '';

        let descriptionHtml = '';
        if (slot.status === 'BLOCKED' || slot.status === 'MAINTENANCE') {
          const isOpenPlay = /open\s*play/i.test(slot.blockReason || '');
          const isReserved = !isOpenPlay && /reserved/i.test(slot.blockReason || '');
          slotClass = isOpenPlay ? 'slot-open-play' : (isReserved ? 'slot-reserved' : 'slot-blocked');

          if (isOpenPlay) {
            statusBadge = `<span class="badge badge-open-play px-2 py-0.5 fw-bold" style="font-size: 9.5px;"><i class="bi bi-people-fill me-1"></i>Open Play</span>`;
          } else if (isReserved) {
            statusBadge = `<span class="badge bg-warning text-dark rounded-pill px-2 py-0.5 fw-bold" style="font-size: 9.5px;"><i class="bi bi-bookmark-fill me-0.5"></i>Reserved</span>`;
          } else {
            statusBadge = `<span class="badge bg-danger text-white rounded-pill px-2 py-0.5 fw-bold" style="font-size: 9.5px;"><i class="bi bi-slash-circle me-0.5"></i>Blocked</span>`;
          }

          if (slot.blockReason) {
            const descColor = isOpenPlay ? 'text-info-emphasis' : (isReserved ? 'text-warning-emphasis' : 'text-danger-emphasis');
            descriptionHtml = `<div class="small fw-semibold text-truncate ${descColor}" style="font-size: 9.5px; max-width: 140px;" title="${escapeJs(slot.blockReason)}">${escapeJs(slot.blockReason)}</div>`;
          }
          if (slot.blockNotes) {
            descriptionHtml += `<div class="small text-truncate fw-bold mt-0.5" style="font-size: 8.5px; max-width: 140px; color: #92400E !important;" title="Note / Reserved For: ${escapeJs(slot.blockNotes)}"><i class="bi bi-person-fill text-warning me-0.5"></i>${escapeJs(slot.blockNotes)}</div>`;
          }

          if (slot.blockId) {
            clickAction = `onclick="openEditBlockModal(${slot.blockId}, '${dateYmd}', '${escapeJs(slot.blockReason || 'Court Maintenance & Surface Cleaning')}', '${escapeJs(slot.blockNotes || '')}', '${escapeJs(court.name)}')" title="Click to edit reason / purpose or unblock"`;
          } else {
            clickAction = `onclick="alert('This slot is part of a day or facility block rule: ${escapeJs(slot.blockReason || 'Blocked')}')"`;
          }
        } else if (slot.status === 'CONFIRMED' || slot.status === 'BOOKED') {
          slotClass = 'slot-booked';
          statusBadge = `<span class="badge bg-light text-dark rounded-pill px-2 py-0.5" style="font-size: 9.5px;">Booked</span>`;
          clickAction = `onclick="alert('This slot has an active player reservation: ${slot.referenceNumber || ''}')"`;
        } else if (slot.status === 'AWAITING_PAYMENT' || slot.status === 'PENDING') {
          slotClass = 'slot-processing';
          statusBadge = `<span class="badge bg-warning text-dark rounded-pill px-2 py-0.5" style="font-size: 9.5px;">Held (GCash)</span>`;
          clickAction = `onclick="alert('Held by player: ${slot.referenceNumber || ''}')"`;
        } else if (slot.status === 'AWAITING_CONFIRMATION') {
          slotClass = 'slot-processing';
          statusBadge = `<span class="badge bg-info text-white rounded-pill px-2 py-0.5" style="font-size: 9.5px;">Verifying</span>`;
          clickAction = `onclick="alert('Under Admin Verification: ${slot.referenceNumber || ''}')"`;
        } else {
          // Open slot
          const slotKey = `${court.id}_${slot.startTime}`;
          const isSelected = selectedSlotsMap.has(slotKey);

          if (isSelected) {
            slotClass = 'slot-open slot-selected';
            statusBadge = `<span class="badge bg-warning text-dark rounded-pill px-2 py-0.5" style="font-size: 9.5px;"><i class="bi bi-check-lg me-1"></i>Selected</span>`;
          } else {
            slotClass = 'slot-open';
            statusBadge = `<span class="text-success small fw-bold" style="font-size: 11px;">Open</span>`;
          }

          clickAction = `onclick="toggleSlotSelection(${court.id}, '${escapeJs(court.name)}', '${slot.startTime}', '${slot.endTime}', '${slot.startLabel}', '${slot.endLabel}', this)"`;
        }

        slotsHtml += `
          <div class="admin-court-grid-slot ${slotClass} mb-1.5" ${clickAction}>
            <div class="d-flex flex-column min-w-0 me-1.5 text-start">
              <div class="fw-bold" style="font-size: 11px;">${slot.startLabel}</div>
              ${descriptionHtml}
            </div>
            <div class="slot-status-badge flex-shrink-0">${statusBadge}</div>
          </div>
        `;
      });

      col.innerHTML = `
        <div class="admin-court-card h-100 shadow-sm d-flex flex-column">
          <div class="admin-court-card-header d-flex align-items-center justify-content-between">
            <div>
              <strong class="text-dark d-block fs-6 lh-1 mb-1">${court.name}</strong>
              <span class="text-muted fw-semibold" style="font-size: 11px;">₱${court.pricePerHour}/hr</span>
            </div>
            <div class="d-flex align-items-center gap-1.5">
              <button type="button" class="btn btn-soft-primary btn-sm rounded-pill px-2.5 py-1 fw-bold" style="font-size: 10.5px;" onclick="selectAllOpenForCourt(${court.id})" title="Select all open slots for this court">
                <i class="bi bi-check2-square me-1"></i>Select Open
              </button>
              <button type="button" class="btn btn-soft-danger btn-sm rounded-pill px-2.5 py-1 fw-bold" style="font-size: 10.5px;" onclick="quickBlockSingleCourtAllDay(${court.id}, '${escapeJs(court.name)}', '${dateYmd}')" title="Block entire day for this court">
                <i class="bi bi-lock-fill me-0.5"></i>All Day
              </button>
            </div>
          </div>
          <div class="p-2.5 admin-slots-scroll flex-grow-1" style="max-height: 480px; overflow-y: auto; overflow-x: hidden;">
            ${slotsHtml}
          </div>
        </div>
      `;

      grid.appendChild(col);
    });
  }

  function toggleSlotSelection(courtId, courtName, startTime, endTime, startLabel, endLabel, el) {
    const key = `${courtId}_${startTime}`;
    if (selectedSlotsMap.has(key)) {
      selectedSlotsMap.delete(key);
      if (el) {
        el.classList.remove('slot-selected');
        const badgeDiv = el.querySelector('.slot-status-badge');
        if (badgeDiv) badgeDiv.innerHTML = '<span class="text-success small fw-bold" style="font-size: 11px;">Open</span>';
      }
    } else {
      selectedSlotsMap.set(key, { courtId, courtName, startTime, endTime, startLabel, endLabel });
      if (el) {
        el.classList.add('slot-selected');
        const badgeDiv = el.querySelector('.slot-status-badge');
        if (badgeDiv) badgeDiv.innerHTML = '<span class="badge bg-warning text-dark rounded-pill px-2 py-0.5" style="font-size: 9.5px;"><i class="bi bi-check-lg me-1"></i>Selected</span>';
      }
    }
    updateMultiSelectBar();
  }

  function selectAllOpenForCourt(courtId) {
    const court = (lastLoadedCourts || []).find(c => c.id === courtId);
    if (!court) return;

    const openSlots = (court.slots || []).filter(s => s.status === 'AVAILABLE' || s.status === 'OPEN' || (!s.status && s.isAvailable));
    if (openSlots.length === 0) {
      alert(`No open slots available on ${court.name} today.`);
      return;
    }

    const allAlreadySelected = openSlots.every(s => selectedSlotsMap.has(`${courtId}_${s.startTime}`));

    openSlots.forEach(s => {
      const key = `${courtId}_${s.startTime}`;
      if (allAlreadySelected) {
        selectedSlotsMap.delete(key);
      } else {
        selectedSlotsMap.set(key, {
          courtId: court.id,
          courtName: court.name,
          startTime: s.startTime,
          endTime: s.endTime,
          startLabel: s.startLabel,
          endLabel: s.endLabel
        });
      }
    });

    renderInspectorGrid(lastLoadedCourts, currentInspectedDate);
    updateMultiSelectBar();
  }

  function clearSelectedSlots() {
    selectedSlotsMap.clear();
    renderInspectorGrid(lastLoadedCourts, currentInspectedDate);
    updateMultiSelectBar();
  }

  function updateMultiSelectBar() {
    const bar = document.getElementById('inspectorMultiSelectBar');
    const countBadge = document.getElementById('multiSelectCountBadge');
    const summaryEl = document.getElementById('multiSelectSummary');

    if (!bar) return;

    const count = selectedSlotsMap.size;
    if (count === 0) {
      bar.classList.add('d-none');
      bar.classList.remove('d-flex');
      return;
    }

    bar.classList.remove('d-none');
    bar.classList.add('d-flex');

    countBadge.innerText = `${count} Slot${count === 1 ? '' : 's'} Selected`;

    const byCourt = {};
    for (const item of selectedSlotsMap.values()) {
      if (!byCourt[item.courtName]) byCourt[item.courtName] = [];
      byCourt[item.courtName].push(item.startLabel || item.startTime);
    }

    const summaryParts = Object.entries(byCourt).map(([cName, times]) => {
      return `<strong>${cName}:</strong> ${times.join(', ')}`;
    });

    summaryEl.innerHTML = summaryParts.join(' &bull; ');
  }

  function openMultiSlotBlockModal() {
    if (selectedSlotsMap.size === 0) {
      alert('Please click on at least one open time slot to select it.');
      return;
    }

    const grouped = {};
    for (const item of selectedSlotsMap.values()) {
      if (!grouped[item.courtId]) {
        grouped[item.courtId] = {
          court_id: item.courtId,
          court_name: item.courtName,
          slots: []
        };
      }
      grouped[item.courtId].slots.push(item.startTime);
    }

    const slotsDataArray = Object.values(grouped);
    document.getElementById('multiBlockSlotsData').value = JSON.stringify(slotsDataArray);
    document.getElementById('multiBlockDate').value = currentInspectedDate;

    const dateObj = parseLocalDate(currentInspectedDate);
    document.getElementById('multiBlockDateSubtitle').innerText = `${dateObj.toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric' })}`;
    document.getElementById('multiBlockTotalBadge').innerText = `${selectedSlotsMap.size} Slot${selectedSlotsMap.size === 1 ? '' : 's'}`;

    const reviewEl = document.getElementById('multiBlockReviewList');
    reviewEl.innerHTML = '';

    slotsDataArray.forEach(group => {
      const itemDiv = document.createElement('div');
      itemDiv.className = 'p-2 bg-white rounded-3 border';
      const badgesHtml = group.slots.sort().map(s => {
        const slotObj = Array.from(selectedSlotsMap.values()).find(x => x.courtId === group.court_id && x.startTime === s);
        const label = slotObj ? `${slotObj.startLabel} - ${slotObj.endLabel}` : s;
        return `<span class="badge bg-danger-subtle text-danger border border-danger-subtle font-monospace px-2 py-1 rounded-pill small">${label}</span>`;
      }).join(' ');

      itemDiv.innerHTML = `
        <div class="fw-bold text-dark small mb-1.5"><i class="bi bi-circle-fill text-warning me-1" style="font-size: 8px;"></i>${group.court_name} (${group.slots.length} slots):</div>
        <div class="d-flex flex-wrap gap-1">${badgesHtml}</div>
      `;
      reviewEl.appendChild(itemDiv);
    });

    document.getElementById('multiBlockSubmitBtn').innerHTML = `<i class="bi bi-lock-fill me-1"></i>Block ${selectedSlotsMap.size} Selected Slot${selectedSlotsMap.size === 1 ? '' : 's'}`;

    const multiPreset = document.getElementById('multiBlockReasonPreset');
    if (multiPreset) {
      handleMultiBlockReasonPresetChange(multiPreset.value);
    }

    const modal = bootstrap.Modal.getOrCreateInstance(document.getElementById('multiSlotBlockModal'));
    modal.show();
  }

  function quickBlockSingleCourtAllDay(courtId, courtName, dateYmd) {
    document.getElementById('blockCourtSelect').value = courtId;
    document.getElementById('blockDateInput').value = dateYmd;
    document.getElementById('modeAllDay').checked = true;
    toggleBlockTimeRange(false);
    const preset = document.getElementById('blockReasonPreset');
    if (preset) {
      preset.value = 'Court Maintenance & Surface Cleaning';
      handleBlockReasonPresetChange('Court Maintenance & Surface Cleaning');
    }
    const modal = new bootstrap.Modal(document.getElementById('newBlockModal'));
    modal.show();
  }

  function quickSetOpenPlay() {
    document.getElementById('blockCourtSelect').value = 'all';
    document.getElementById('blockDateInput').value = currentInspectedDate;
    document.getElementById('modeAllDay').checked = true;
    toggleBlockTimeRange(false);
    const preset = document.getElementById('blockReasonPreset');
    if (preset) {
      preset.value = 'Open Play (Walk-ins & Drop-ins Welcome)';
      handleBlockReasonPresetChange('Open Play (Walk-ins & Drop-ins Welcome)');
    }
    const modal = new bootstrap.Modal(document.getElementById('newBlockModal'));
    modal.show();
  }

  function quickBlockFullDay() {
    document.getElementById('blockCourtSelect').value = 'all';
    document.getElementById('blockDateInput').value = currentInspectedDate;
    document.getElementById('modeAllDay').checked = true;
    toggleBlockTimeRange(false);
    const preset = document.getElementById('blockReasonPreset');
    if (preset) {
      preset.value = 'Court Maintenance & Surface Cleaning';
      handleBlockReasonPresetChange('Court Maintenance & Surface Cleaning');
    }
    const modal = new bootstrap.Modal(document.getElementById('newBlockModal'));
    modal.show();
  }

  function handleUnblockClick(blockId, dateYmd) {
    if (confirm(`Unblock this slot on ${dateYmd}? It will immediately become available for player bookings.`)) {
      const form = document.createElement('form');
      form.method = 'POST';
      form.action = `/admin/blocks/${blockId}/delete`;
      document.body.appendChild(form);
      form.submit();
    }
  }

  function unblockFullDayForInspectedDate() {
    alert('Please find the matching block rule in the table below and click "Unblock".');
  }

  function openEditBlockModal(blockId, dateYmd, currentReason, currentNotes, courtDisplay) {
    const form = document.getElementById('editBlockForm');
    form.action = `/admin/blocks/${blockId}/update`;

    document.getElementById('editBlockCourtBadge').innerText = courtDisplay || 'Court';
    document.getElementById('editBlockDateText').innerText = dateYmd;
    document.getElementById('editBlockSubtitle').innerText = `${dateYmd} • ${courtDisplay || 'Court'}`;
    document.getElementById('editBlockNotesInput').value = currentNotes || '';

    const presetSelect = document.getElementById('editBlockReasonPreset');
    const hiddenInput = document.getElementById('editBlockReasonInput');
    const customWrap = document.getElementById('editBlockCustomReasonWrap');
    const customInput = document.getElementById('editBlockCustomReasonInput');

    let matched = false;
    for (let i = 0; i < presetSelect.options.length; i++) {
      if (presetSelect.options[i].value === currentReason) {
        presetSelect.selectedIndex = i;
        matched = true;
        break;
      }
    }

    if (matched) {
      if (customWrap) customWrap.classList.add('d-none');
      if (customInput) {
        customInput.required = false;
        customInput.value = '';
      }
      hiddenInput.value = currentReason;
    } else {
      presetSelect.value = 'OTHER';
      if (customWrap) customWrap.classList.remove('d-none');
      if (customInput) {
        customInput.required = true;
        customInput.value = currentReason;
      }
      hiddenInput.value = currentReason;
    }

    updateNotesPlaceholder(currentReason, 'editBlockNotesLabel', 'editBlockNotesInput');

    const unblockBtn = document.getElementById('editBlockUnblockBtn');
    if (unblockBtn) {
      unblockBtn.onclick = function() {
        if (confirm(`Unblock this rule on ${dateYmd}? Slots will immediately reopen for player bookings.`)) {
          const form = document.createElement('form');
          form.method = 'POST';
          form.action = `/admin/blocks/${blockId}/delete`;
          document.body.appendChild(form);
          form.submit();
        }
      };
    }

    const modal = bootstrap.Modal.getOrCreateInstance(document.getElementById('editBlockModal'));
    modal.show();
  }

  function handleEditBlockReasonPresetChange(val) {
    const hiddenInput = document.getElementById('editBlockReasonInput');
    const wrap = document.getElementById('editBlockCustomReasonWrap');
    const customInput = document.getElementById('editBlockCustomReasonInput');
    updateNotesPlaceholder(val, 'editBlockNotesLabel', 'editBlockNotesInput');
    if (!hiddenInput) return;

    if (val === 'OTHER') {
      if (wrap) wrap.classList.remove('d-none');
      if (customInput) {
        customInput.required = true;
        customInput.focus();
        hiddenInput.value = customInput.value.trim();
      }
    } else {
      if (wrap) wrap.classList.add('d-none');
      if (customInput) {
        customInput.required = false;
        customInput.value = '';
      }
      hiddenInput.value = val;
    }
  }

  // Initial Load & Form Submit Handlers
  document.addEventListener('DOMContentLoaded', () => {
    loadInspectorSchedule(currentInspectedDate);
    const p1 = document.getElementById('blockReasonPreset');
    if (p1) handleBlockReasonPresetChange(p1.value);
    const p2 = document.getElementById('multiBlockReasonPreset');
    if (p2) handleMultiBlockReasonPresetChange(p2.value);

    // Edit button click delegation for rules table
    document.addEventListener('click', function(e) {
      const btn = e.target.closest('.btn-edit-block');
      if (!btn) return;
      const { blockId, date, reason, notes, court } = btn.dataset;
      openEditBlockModal(blockId, date, reason, notes, court);
    });

    const f1 = document.getElementById('courtBlockForm');
    if (f1) {
      f1.addEventListener('submit', function() {
        const preset = document.getElementById('blockReasonPreset')?.value;
        const hidden = document.getElementById('blockReasonInput');
        const custom = document.getElementById('blockCustomReasonInput');
        if (preset === 'OTHER') {
          hidden.value = custom?.value.trim() || 'Custom Block';
        } else if (preset) {
          hidden.value = preset;
        }
      });
    }

    const f2 = document.getElementById('multiSlotBlockForm');
    if (f2) {
      f2.addEventListener('submit', function() {
        const preset = document.getElementById('multiBlockReasonPreset')?.value;
        const hidden = document.getElementById('multiBlockReasonInput');
        const custom = document.getElementById('multiBlockCustomReasonInput');
        if (preset === 'OTHER') {
          hidden.value = custom?.value.trim() || 'Custom Block';
        } else if (preset) {
          hidden.value = preset;
        }
      });
    }

    const f3 = document.getElementById('editBlockForm');
    if (f3) {
      f3.addEventListener('submit', function() {
        const preset = document.getElementById('editBlockReasonPreset')?.value;
        const hidden = document.getElementById('editBlockReasonInput');
        const custom = document.getElementById('editBlockCustomReasonInput');
        if (preset === 'OTHER') {
          hidden.value = custom?.value.trim() || 'Custom Block';
        } else if (preset) {
          hidden.value = preset;
        }
      });
    }
  });
</script>
