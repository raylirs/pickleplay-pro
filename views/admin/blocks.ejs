<div class="container-fluid px-3 px-md-4 py-4">
  <!-- Executive Facility Hero Banner -->
  <div class="facility-hero-card p-4 p-md-5 mb-4 position-relative">
    <div class="facility-hero-glow"></div>
    <div class="facility-hero-watermark"><i class="bi bi-shield-shaded"></i></div>

    <div class="position-relative z-1 d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-4">
      <div class="max-w-xl">
        <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill bg-white bg-opacity-10 border border-light border-opacity-20 text-warning small fw-bold mb-2">
          <i class="bi bi-shield-lock-fill"></i>
          <span>FACILITY SCHEDULE CONTROLS &bull; THE PLAYGROUND</span>
        </div>
        <h2 class="fw-extrabold text-white font-display mb-2 display-6">Court &amp; Slot Schedule Management</h2>
        <p class="text-white-50 mb-3" style="font-size: 14.5px;">
          Inspect live court availability and block specific hours, individual courts, or full facility days for surface maintenance, club tournaments, or private buyouts.
        </p>

        <!-- Metrics Badges Row -->
        <div class="d-flex flex-wrap align-items-center gap-2">
          <span class="badge bg-white bg-opacity-10 border border-light border-opacity-20 text-white rounded-pill px-3 py-2 fw-semibold">
            <i class="bi bi-layers-fill text-warning me-1.5"></i>Active Rules: <strong class="text-white"><%= totalCount %></strong>
          </span>
          <span class="badge bg-white bg-opacity-10 border border-light border-opacity-20 text-white rounded-pill px-3 py-2 fw-semibold">
            <i class="bi bi-calendar-event-fill text-info me-1.5"></i>Today's Blocks: <strong class="text-white"><%= todayCount %></strong>
          </span>
          <span class="badge bg-white bg-opacity-10 border border-light border-opacity-20 text-white rounded-pill px-3 py-2 fw-semibold">
            <i class="bi bi-door-closed-fill text-danger me-1.5"></i>Full-Day Closures: <strong class="text-white"><%= allDayCount %></strong>
          </span>
        </div>
      </div>

      <div class="d-flex flex-column flex-sm-row align-items-stretch align-items-lg-center gap-2 flex-shrink-0">
        <button type="button" class="btn btn-warning fw-extrabold rounded-pill px-4 py-2.5 shadow-md d-inline-flex align-items-center justify-content-center gap-2 text-dark" data-bs-toggle="modal" data-bs-target="#newBlockModal">
          <i class="bi bi-plus-circle-fill fs-5"></i>
          <span>Block Slots / Date</span>
        </button>
      </div>
    </div>
  </div>

  <!-- =========================================================
       SECTION 1: INTERACTIVE LIVE COURT SCHEDULE INSPECTOR (4 COURTS)
       ========================================================= -->
  <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white mb-4">
    <!-- Inspector Header & Date Controls -->
    <div class="card-header bg-white p-3 p-md-4 border-bottom">
      <!-- Top Row: Date Navigator & Primary Actions -->
      <div class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3">
        <!-- Date Navigator & Quick Day Jump -->
        <div class="d-flex align-items-center gap-2 flex-wrap">
          <div class="btn-group bg-light rounded-pill border p-0.5 shadow-xs">
            <button type="button" class="btn btn-sm btn-light rounded-pill text-dark px-2.5 py-1 border-0" onclick="navigateInspectorDate(-1)" title="Previous Day">
              <i class="bi bi-chevron-left"></i>
            </button>
            <button type="button" class="btn btn-sm btn-white bg-white rounded-pill px-3 py-1 fw-bold text-dark shadow-xs border-0" id="inspectorDateDisplayBtn" onclick="openInspectorDatePicker()">
              <i class="bi bi-calendar3 me-1.5 text-primary"></i>
              <span id="inspectorDateLabel"><%= typeof inspectedDate !== 'undefined' && inspectedDate ? inspectedDate : today %></span>
            </button>
            <button type="button" class="btn btn-sm btn-light rounded-pill text-dark px-2.5 py-1 border-0" onclick="navigateInspectorDate(1)" title="Next Day">
              <i class="bi bi-chevron-right"></i>
            </button>
          </div>

          <input type="date" id="inspectorDateInput" class="visually-hidden" value="<%= typeof inspectedDate !== 'undefined' && inspectedDate ? inspectedDate : today %>" onchange="jumpInspectorDate(this.value)">

          <!-- Quick Day Jump Pills -->
          <div class="d-flex align-items-center gap-1.5 bg-light rounded-pill border p-0.5">
            <button type="button" class="btn btn-sm rounded-pill px-3 py-1 text-secondary fw-semibold border-0" onclick="jumpInspectorDate('<%= today %>')">
              Today
            </button>
            <button type="button" class="btn btn-sm rounded-pill px-3 py-1 text-secondary fw-semibold border-0" onclick="jumpInspectorOffset(1)">
              Tomorrow
            </button>
            <button type="button" class="btn btn-sm rounded-pill px-3 py-1 text-secondary fw-semibold border-0" onclick="jumpInspectorToWeekend()">
              Weekend
            </button>
          </div>
        </div>

        <!-- Action Buttons -->
        <div class="d-flex align-items-center gap-2 flex-wrap">
          <button type="button" class="btn btn-soft-info btn-sm rounded-pill px-3.5 py-2 fw-bold d-inline-flex align-items-center gap-1.5 shadow-xs" onclick="quickSetOpenPlay()">
            <i class="bi bi-people-fill"></i>
            <span>Set Open Play for This Day</span>
          </button>

          <button type="button" class="btn btn-soft-danger btn-sm rounded-pill px-3.5 py-2 fw-bold d-inline-flex align-items-center gap-1.5 shadow-xs" onclick="quickBlockFullDay()">
            <i class="bi bi-slash-circle-fill"></i>
            <span>Block All Courts for This Day</span>
          </button>
        </div>
      </div>

      <!-- Bottom Row: Legend & Instructions -->
      <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 pt-3 mt-3 border-top">
        <div class="d-flex align-items-center gap-2 gap-sm-3 flex-wrap">
          <span class="text-secondary small fw-bold text-uppercase" style="font-size: 10px; letter-spacing: 0.05em;">Legend:</span>
          <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2.5 py-1 small fw-bold">
            <span class="badge rounded-circle bg-success p-1 me-1"></span>Available
          </span>
          <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill px-2.5 py-1 small fw-bold">
            <span class="badge rounded-circle bg-warning p-1 me-1"></span>Selected
          </span>
          <span class="badge bg-warning text-dark rounded-pill px-2.5 py-1 small fw-bold">
            <i class="bi bi-bookmark-fill me-1"></i>Reserved
          </span>
          <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-2.5 py-1 small fw-bold">
            <span class="badge rounded-circle bg-danger p-1 me-1"></span>Blocked
          </span>
          <span class="badge text-white rounded-pill px-2.5 py-1 small fw-bold" style="background:#0B2545;">
            <span class="badge rounded-circle bg-light p-1 me-1"></span>Booked
          </span>
        </div>

        <div class="text-secondary small fw-semibold d-none d-md-inline-flex align-items-center gap-1" style="font-size: 11.5px;">
          <i class="bi bi-info-circle text-primary"></i>
          <span>Click any open slot to multi-block • Click any blocked slot to edit / unblock</span>
        </div>
      </div>

      <!-- Facility Closed Notification Banner for Inspected Date -->
      <div id="inspectorClosedBanner" class="alert alert-danger d-none align-items-center justify-content-between rounded-3 mt-3 mb-0 py-2 px-3 border-danger-subtle shadow-xs">
        <div class="d-flex align-items-center gap-2">
          <i class="bi bi-slash-circle-fill text-danger fs-5"></i>
          <div>
            <strong class="text-danger">Facility Full-Day Closure Active:</strong>
            <span id="inspectorClosedReason" class="text-danger-emphasis small ms-1">All courts are blocked today.</span>
          </div>
        </div>
        <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-2.5 py-0.5 fw-bold" onclick="unblockFullDayForInspectedDate()">
          Unblock Day
        </button>
      </div>
    </div>

    <!-- Inspector 4-Court Columns Grid Viewport -->
    <div class="p-3 p-md-4">
      <div class="text-center py-5" id="inspectorLoadingSpinner">
        <div class="spinner-border text-primary mb-2" role="status"></div>
        <p class="text-secondary small fw-semibold mb-0">Loading court schedule for date...</p>
      </div>

      <!-- Live Columns Layout (4 Courts Side-by-Side) -->
      <div class="row g-3 d-none" id="inspectorCourtsGrid">
        <!-- Injected via JavaScript -->
      </div>
    </div>
  </div>

  <!-- =========================================================
       SECTION 2: ACTIVE FACILITY RULES & BLACKOUT DATES TABLE
       ========================================================= -->
  <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
    <div class="card-header bg-white py-3 px-4 border-bottom d-flex align-items-center justify-content-between">
      <div class="d-flex align-items-center gap-2">
        <i class="bi bi-card-checklist text-primary fs-5"></i>
        <h5 class="fw-bold text-dark mb-0">Active Facility Block Rules &amp; Blackouts</h5>
      </div>
      <span class="badge bg-secondary-subtle text-secondary rounded-pill px-3 py-1 font-monospace">
        <%= blocks.length %> Rule<%= blocks.length === 1 ? '' : 's' %> Recorded
      </span>
    </div>

    <div class="table-responsive">
      <table class="table admin-table table-hover align-middle mb-0">
        <thead>
          <tr class="small text-uppercase text-secondary" style="font-size: 11px; letter-spacing: 0.05em;">
            <th class="ps-4">Date</th>
            <th>Court(s) Affected</th>
            <th>Duration</th>
            <th>Reason / Purpose</th>
            <th>Notes</th>
            <th>Created By &amp; Time</th>
            <th class="text-end pe-4">Action</th>
          </tr>
        </thead>
        <tbody>
          <% if (blocks && blocks.length > 0) { %>
            <% blocks.forEach(function(b) { %>
              <tr>
                <td class="ps-4">
                  <div class="d-flex align-items-center gap-2.5">
                    <div class="bg-primary-subtle text-primary rounded-3 d-flex align-items-center justify-content-center flex-shrink-0 shadow-xs" style="width: 38px; height: 38px;">
                      <i class="bi bi-calendar3 fs-6"></i>
                    </div>
                    <div>
                      <strong class="text-dark d-block font-display" style="font-size: 13.5px;"><%= typeof formatDateFriendly === 'function' ? formatDateFriendly(b.date) : b.date %></strong>
                      <span class="small font-monospace text-muted d-inline-flex align-items-center gap-1" style="font-size: 11px;">
                        <i class="bi bi-calendar-check text-primary opacity-75"></i><%= b.date %>
                      </span>
                    </div>
                  </div>
                </td>

                <td>
                  <% if (b.all_courts || !b.court_id) { %>
                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2.5 py-1.5 rounded-pill fw-bold">
                      <i class="bi bi-grid-3x3-gap-fill me-1"></i>All 4 Courts
                    </span>
                  <% } else if (b.court) { %>
                    <span class="badge bg-dark text-white px-2.5 py-1.5 rounded-pill fw-bold d-inline-flex align-items-center gap-1.5 shadow-xs">
                      <span class="badge rounded-circle bg-warning p-1"></span>
                      <span><%= b.court.display_name %></span>
                    </span>
                  <% } else { %>
                    <span class="badge bg-secondary-subtle text-secondary px-2.5 py-1.5 rounded-pill">
                      Court #<%= b.court_id %>
                    </span>
                  <% } %>
                </td>

                <td>
                  <% if (b.is_all_day) { %>
                    <span class="badge bg-danger text-white rounded-pill px-2.5 py-1.5 fw-bold">
                      <i class="bi bi-sun-fill me-1"></i>Entire Day (6AM - 12MN)
                    </span>
                  <% } else { %>
                    <% 
                      let parsedSlots = null;
                      try {
                        if (b.slots_json) parsedSlots = JSON.parse(b.slots_json);
                      } catch(e) {}
                    %>
                    <div class="d-flex flex-column gap-1">
                      <span class="badge bg-light text-dark border rounded-pill px-2.5 py-1.5 fw-bold font-monospace" style="width: fit-content;">
                        <i class="bi bi-clock me-1 text-primary"></i><%= formatTime12(b.start_time) %> &ndash; <%= formatTime12(b.end_time) %>
                      </span>
                      <% if (parsedSlots && Array.isArray(parsedSlots) && parsedSlots.length > 0) { %>
                        <span class="text-secondary small fw-semibold" style="font-size: 11px;">
                          <i class="bi bi-grid-fill text-danger me-1"></i><%= parsedSlots.length %> Slot<%= parsedSlots.length === 1 ? '' : 's' %> Blocked
                        </span>
                      <% } %>
                    </div>
                  <% } %>
                </td>

                <td>
                  <% const isOpenPlay = /open\s*play/i.test(b.reason); %>
                  <% const isReserved = !isOpenPlay && /reserved/i.test(b.reason); %>
                  <button type="button" 
                          class="btn btn-sm p-0 border-0 text-start btn-edit-block"
                          data-block-id="<%= b.id %>"
                          data-date="<%= b.date %>"
                          data-reason="<%= b.reason %>"
                          data-notes="<%= b.notes || '' %>"
                          data-court="<%= b.all_courts || !b.court_id ? 'All 4 Courts' : (b.court ? b.court.display_name : 'Court #' + b.court_id) %>"
                          title="Click to change Reason / Purpose">
                    <span class="badge <%= isOpenPlay ? 'badge-open-play' : (isReserved ? 'bg-warning text-dark border border-warning-subtle' : 'bg-warning-subtle text-dark border border-warning') %> px-3 py-1.5 rounded-pill fw-bold d-inline-flex align-items-center gap-1.5 shadow-xs">
                      <% if (isOpenPlay) { %><i class="bi bi-people-fill"></i><% } else if (isReserved) { %><i class="bi bi-bookmark-fill"></i><% } %>
                      <span><%= b.reason %></span>
                      <i class="bi bi-pencil-fill ms-1 opacity-50" style="font-size: 8px;"></i>
                    </span>
                  </button>
                  <% if (b.notes) { %>
                    <div class="small text-truncate mt-1.5 fw-bold" style="font-size: 11px; max-width: 200px; color: #92400E;" title="Reserved for / Note: <%= b.notes %>">
                      <i class="bi bi-person-fill text-warning me-1"></i><%= b.notes %>
                    </div>
                  <% } %>
                </td>

                <td class="small" style="max-width: 220px;">
                  <% if (b.notes) { %>
                    <span class="fw-bold <%= isReserved ? 'text-warning-emphasis' : 'text-dark' %> d-inline-flex align-items-center gap-1">
                      <i class="bi bi-sticky-fill text-warning"></i>
                      <span><%= b.notes %></span>
                    </span>
                  <% } else { %>
                    <span class="text-muted fst-italic">—</span>
                  <% } %>
                </td>

                <td>
                  <div class="d-flex align-items-center gap-2">
                    <div class="bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center flex-shrink-0 fw-bold" style="width: 30px; height: 30px; font-size: 12.5px;">
                      <i class="bi bi-person-fill"></i>
                    </div>
                    <div>
                      <strong class="text-dark d-block lh-1 mb-1" style="font-size: 12.5px;"><%= b.creator ? (b.creator.full_name || b.creator.username) : 'Admin' %></strong>
                      <span class="text-muted small d-inline-flex align-items-center gap-1 font-monospace" style="font-size: 11px;">
                        <i class="bi bi-clock-history text-secondary"></i>
                        <%= b.created_at ? (typeof formatDateTime === 'function' ? formatDateTime(b.created_at) : formatDate(b.created_at)) : '—' %>
                      </span>
                    </div>
                  </div>
                </td>

                <td class="text-end pe-4">
                  <div class="d-inline-flex align-items-center gap-1.5">
                    <button type="button" 
                            class="btn btn-soft-primary btn-sm rounded-pill px-3 py-1 fw-bold btn-edit-block"
                            data-block-id="<%= b.id %>"
                            data-date="<%= b.date %>"
                            data-reason="<%= b.reason %>"
                            data-notes="<%= b.notes || '' %>"
                            data-court="<%= b.all_courts || !b.court_id ? 'All 4 Courts' : (b.court ? b.court.display_name : 'Court #' + b.court_id) %>"
                            title="Change Reason / Purpose">
                      <i class="bi bi-pencil-square me-1"></i>Edit
                    </button>
                    <form action="/admin/blocks/<%= b.id %>/delete" method="POST" onsubmit="return confirm('Unblock this rule? Slots on <%= b.date %> will immediately reopen for player bookings.');" class="d-inline">
                      <button type="submit" class="btn btn-soft-danger btn-sm rounded-pill px-3 py-1 fw-bold">
                        <i class="bi bi-unlock-fill me-1"></i>Unblock
                      </button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr>
              <td colspan="7" class="text-center py-5 text-secondary">
                <div class="py-4">
                  <div class="p-3 bg-light rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style="width: 56px; height: 56px;">
                    <i class="bi bi-check2-circle fs-2 text-success"></i>
                  </div>
                  <h6 class="fw-bold text-dark mb-1">Facility Operating on Normal Schedule</h6>
                  <p class="small text-muted mb-3">All 4 championship courts are open for regular player bookings.</p>
                  <button type="button" class="btn btn-outline-primary btn-sm rounded-pill px-4 fw-bold shadow-xs" data-bs-toggle="modal" data-bs-target="#newBlockModal">
                    <i class="bi bi-plus-circle me-1"></i>Create a Block Rule
                  </button>
                </div>
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- =========================================================
     MODAL 1: CREATE FULL COURT OR DAY BLOCK
========================================================= -->
<div class="modal fade" id="newBlockModal" tabindex="-1" aria-labelledby="newBlockModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content rounded-4 border-0 shadow-lg overflow-hidden">
      <form action="/admin/blocks" method="POST" id="courtBlockForm">
        <div class="modal-header text-white px-4 py-3" style="background: linear-gradient(135deg, #0B2545 0%, #07172C 100%); border-bottom: 2px solid #D4AF37;">
          <div class="d-flex align-items-center gap-2">
            <div class="bg-warning text-dark rounded-circle d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
              <i class="bi bi-slash-circle-fill fs-6"></i>
            </div>
            <div>
              <h5 class="modal-title fw-bold font-display mb-0" id="newBlockModalLabel">Block Court Slots / Day</h5>
              <span class="small text-white-50" style="font-size: 11px;">Prevent bookings for maintenance, events, or closures</span>
            </div>
          </div>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>

        <div class="modal-body p-4">
          <!-- 1. Scope: Which Courts? -->
          <div class="mb-3">
            <label class="form-label small fw-bold text-dark mb-1">
              Courts Affected <span class="text-danger">*</span>
            </label>
            <select name="court_id" id="blockCourtSelect" class="form-select rounded-3" required>
              <option value="all" selected>All Courts (Entire Facility Closed)</option>
              <% if (courts && courts.length > 0) { %>
                <% courts.forEach(function(c) { %>
                  <option value="<%= c.id %>"><%= c.display_name %></option>
                <% }); %>
              <% } %>
            </select>
          </div>

          <!-- 2. Target Date -->
          <div class="mb-3">
            <label class="form-label small fw-bold text-dark mb-1">
              Date <span class="text-danger">*</span>
            </label>
            <input type="date" name="date" id="blockDateInput" class="form-control rounded-3" value="<%= today %>" required>
          </div>

          <!-- 3. Duration Mode -->
          <div class="mb-3">
            <label class="form-label small fw-bold text-dark mb-1 d-block">
              Duration Mode <span class="text-danger">*</span>
            </label>
            <div class="row g-2">
              <div class="col-6">
                <input type="radio" class="btn-check" name="time_mode" id="modeAllDay" value="all_day" checked onchange="toggleBlockTimeRange(false)">
                <label class="btn btn-outline-danger w-100 py-2 rounded-3 text-start small fw-bold d-flex align-items-center gap-2" for="modeAllDay">
                  <i class="bi bi-sun-fill text-warning"></i>
                  <span>Entire Day<br><span class="text-muted fw-normal" style="font-size: 10px;">6:00 AM - 12:00 MN</span></span>
                </label>
              </div>
              <div class="col-6">
                <input type="radio" class="btn-check" name="time_mode" id="modeCustom" value="custom" onchange="toggleBlockTimeRange(true)">
                <label class="btn btn-outline-danger w-100 py-2 rounded-3 text-start small fw-bold d-flex align-items-center gap-2" for="modeCustom">
                  <i class="bi bi-clock-history text-primary"></i>
                  <span>Specific Hours<br><span class="text-muted fw-normal" style="font-size: 10px;">Select times or range</span></span>
                </label>
              </div>
            </div>
          </div>

          <!-- 4. Specific Time Range & Slot Pickers -->
          <div id="blockCustomTimeWrap" class="mb-3 p-3 bg-light rounded-3 border d-none">
            <div class="d-flex align-items-center justify-content-between mb-2">
              <span class="small fw-bold text-dark"><i class="bi bi-grid-fill text-primary me-1"></i>Select Time Slots to Block</span>
              <div class="btn-group btn-group-sm">
                <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-2 active" id="btnModeSlots" onclick="toggleCustomTimeSubMode('slots')">Pick Slots</button>
                <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-2" id="btnModeRange" onclick="toggleCustomTimeSubMode('range')">Time Range</button>
              </div>
            </div>

            <!-- Quick Presets for Slots -->
            <div class="d-flex flex-wrap gap-1 mb-2" id="slotQuickPresets">
              <button type="button" class="btn btn-sm btn-white bg-white border py-0 px-2 small text-secondary" onclick="presetModalSlots('all')">All Hours</button>
              <button type="button" class="btn btn-sm btn-white bg-white border py-0 px-2 small text-secondary" onclick="presetModalSlots('morning')">Morning (6AM–12NN)</button>
              <button type="button" class="btn btn-sm btn-white bg-white border py-0 px-2 small text-secondary" onclick="presetModalSlots('afternoon')">Afternoon (12NN–6PM)</button>
              <button type="button" class="btn btn-sm btn-white bg-white border py-0 px-2 small text-secondary" onclick="presetModalSlots('evening')">Evening (6PM–12MN)</button>
              <button type="button" class="btn btn-sm btn-white bg-white border py-0 px-2 small text-danger" onclick="presetModalSlots('clear')">Clear</button>
            </div>

            <!-- Interactive Slot Chips -->
            <div id="modalSlotChipsGrid" class="d-flex flex-wrap gap-1.5 mb-2">
              <% for(let h = 6; h <= 23; h++) { 
                const hh = String(h).padStart(2, '0') + ':00'; 
              %>
                <input type="checkbox" class="btn-check modal-slot-checkbox" name="selected_slots[]" id="modalSlot_<%= h %>" value="<%= hh %>" autocomplete="off" onchange="updateModalSlotCount()">
                <label class="btn btn-outline-secondary btn-sm rounded-pill py-1 px-2.5 font-monospace" style="font-size: 11px;" for="modalSlot_<%= h %>">
                  <%= formatTime12(hh) %>
                </label>
              <% } %>
            </div>
            <div class="small text-muted mb-0" id="modalSlotCountNotice">
              <i class="bi bi-info-circle me-1"></i>Click one or more times above, or switch to Time Range.
            </div>

            <!-- Traditional Time Range Dropdowns -->
            <div id="modalTimeRangeDropdowns" class="row g-2 d-none pt-2 border-top mt-2">
              <div class="col-6">
                <label class="form-label small fw-semibold text-dark mb-1">Start Time</label>
                <select name="start_time" id="blockStartTime" class="form-select form-select-sm rounded-3">
                  <% for(let h = 6; h <= 23; h++) { const hh = String(h).padStart(2, '0') + ':00'; %>
                    <option value="<%= hh %>"><%= formatTime12(hh) %></option>
                  <% } %>
                </select>
              </div>
              <div class="col-6">
                <label class="form-label small fw-semibold text-dark mb-1">End Time</label>
                <select name="end_time" id="blockEndTime" class="form-select form-select-sm rounded-3">
                  <% for(let h = 7; h <= 24; h++) { const hh = String(h).padStart(2, '0') + ':00'; %>
                    <option value="<%= hh %>" <%= h === 12 ? 'selected' : '' %>><%= formatTime12(hh) %></option>
                  <% } %>
                </select>
              </div>
            </div>
          </div>

          <!-- 5. Reason / Preset -->
          <div class="mb-3">
            <label class="form-label small fw-bold text-dark mb-1">
              Reason / Purpose <span class="text-danger">*</span>
            </label>
            <select id="blockReasonPreset" class="form-select rounded-3" onchange="handleBlockReasonPresetChange(this.value)">
              <option value="Open Play (Walk-ins & Drop-ins Welcome)">🏸 Open Play (Walk-ins &amp; Drop-ins Welcome)</option>
              <option value="Reserved">🔒 Reserved</option>
              <option value="Court Maintenance & Surface Cleaning">Court Maintenance &amp; Surface Cleaning</option>
