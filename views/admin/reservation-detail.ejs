<div class="container py-4">
  <div class="max-w-900 mx-auto" style="max-width: 900px;">
    <nav aria-label="breadcrumb" class="mb-3">
      <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/admin">Dashboard</a></li>
        <li class="breadcrumb-item"><a href="/admin/reservations">Reservations</a></li>
        <li class="breadcrumb-item active"><%= reservation.reference_number %></li>
      </ol>
    </nav>

    <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white mb-4">
      <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center border-bottom pb-4 mb-4 gap-3">
        <div>
          <span class="small text-secondary d-block">Reservation Details</span>
          <h2 class="fw-bold font-monospace text-primary mb-0"><%= reservation.reference_number %></h2>
        </div>
        <div>
          <% if (reservation.status === 'CONFIRMED') { %>
            <span class="badge bg-success fs-6 px-4 py-2 rounded-pill"><i class="bi bi-check-circle-fill me-1"></i>CONFIRMED</span>
          <% } else if (reservation.status === 'AWAITING_CONFIRMATION') { %>
            <span class="badge bg-warning text-dark fs-6 px-4 py-2 rounded-pill"><i class="bi bi-hourglass-split me-1"></i>AWAITING APPROVAL</span>
          <% } else if (reservation.status === 'CANCELLED') { %>
            <span class="badge bg-danger fs-6 px-4 py-2 rounded-pill"><i class="bi bi-x-circle me-1"></i>CANCELLED</span>
          <% } else { %>
            <span class="badge bg-secondary fs-6 px-4 py-2 rounded-pill"><%= reservation.status %></span>
          <% } %>
        </div>
      </div>

      <div class="row g-4 mb-4">
        <div class="col-md-6">
          <div class="p-3 bg-light rounded-3 h-100 border">
            <h6 class="fw-bold text-dark mb-3 border-bottom pb-2">Player Information</h6>
            <p class="mb-2 small"><strong>Name:</strong> <%= reservation.user_name %></p>
            <p class="mb-2 small"><strong>Contact:</strong> <%= reservation.user_contact %></p>
            <p class="mb-2 small"><strong>Email:</strong> <%= reservation.user_email || 'Not provided' %></p>
            <p class="mb-0 small"><strong>Special Requests:</strong> <%= reservation.special_requests || 'None' %></p>
          </div>
        </div>
        <div class="col-md-6">
          <div class="p-3 bg-light rounded-3 h-100 border">
            <h6 class="fw-bold text-dark mb-3 border-bottom pb-2">Court & Schedule</h6>
            <p class="mb-2 small"><strong>Court:</strong> <%= reservation.court ? reservation.court.display_name : 'N/A' %></p>
            <p class="mb-2 small"><strong>Date:</strong> <%= reservation.reservation_date %></p>
            <p class="mb-2 small"><strong>Time:</strong> <%= formatTime12(reservation.start_time) %> - <%= formatTime12(reservation.end_time) %> (<%= reservation.total_hours %> hours)</p>
            <p class="mb-0 small"><strong>Total Amount:</strong> <span class="fw-bold text-success"><%= formatCurrency(reservation.total_amount) %></span></p>
          </div>
        </div>
      </div>

      <!-- GCash Payment Proof Section -->
      <div class="p-4 bg-light rounded-4 mb-4 border">
        <h5 class="fw-bold text-dark mb-3 border-bottom pb-2"><i class="bi bi-qr-code text-primary me-2"></i>GCash Payment Verification</h5>
        <div class="row g-3">
          <div class="col-md-6">
            <div class="mb-2">
              <span class="text-secondary small d-block">Submitted GCash Reference No:</span>
              <strong class="fs-5 font-monospace text-primary"><%= reservation.gcash_reference_no || 'No reference number provided yet' %></strong>
            </div>
            <div class="mb-2">
              <span class="text-secondary small d-block">Payment Method:</span>
              <strong class="text-dark">GCash QR Code</strong>
            </div>
            <div>
              <span class="text-secondary small d-block">Booked On:</span>
              <span class="text-dark small"><%= new Date(reservation.created_at).toLocaleString() %></span>
            </div>
          </div>
          <div class="col-md-6">
            <span class="text-secondary small d-block mb-1">Receipt Screenshot:</span>
            <% if (reservation.payment_screenshot) { %>
              <a href="<%= reservation.payment_screenshot %>" target="_blank" class="d-inline-block border rounded-3 overflow-hidden shadow-sm">
                <img src="<%= reservation.payment_screenshot %>" alt="GCash Screenshot" class="img-fluid" style="max-height: 160px;">
              </a>
              <div class="small text-muted mt-1"><i class="bi bi-box-arrow-up-right me-1"></i>Click to view full image</div>
            <% } else { %>
              <div class="p-3 bg-white rounded-3 border text-muted small">No screenshot image attached.</div>
            <% } %>
          </div>
        </div>
      </div>

      <!-- Admin Approval Actions -->
      <div class="d-flex flex-wrap gap-2 pt-3 border-top">
        <% if (reservation.status !== 'CONFIRMED') { %>
          <form action="/admin/reservations/<%= reservation.id %>/confirm" method="POST" onsubmit="return confirm('Approve and confirm this reservation? The player will receive confirmation and the slot will be locked.');">
            <button type="submit" class="btn btn-success btn-lg rounded-pill fw-bold px-4 shadow-sm">
              <i class="bi bi-check2-circle me-1"></i>Approve & Confirm Reservation
            </button>
          </form>
        <% } %>

        <% if (reservation.status !== 'CANCELLED') { %>
          <button type="button" class="btn btn-outline-danger btn-lg rounded-pill fw-semibold px-4" data-bs-toggle="modal" data-bs-target="#cancelDetailModal">
            <i class="bi bi-x-circle me-1"></i>Reject / Cancel
          </button>
        <% } %>

        <a href="/admin/reservations" class="btn btn-outline-secondary btn-lg rounded-pill px-4 ms-auto">
          Back to List
        </a>
      </div>
    </div>

    <!-- Audit Trail -->
    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
      <h5 class="fw-bold text-dark mb-3"><i class="bi bi-clock-history me-2 text-primary"></i>Audit Trail</h5>
      <div class="list-group list-group-flush small">
        <% if (auditLogs && auditLogs.length > 0) { %>
          <% auditLogs.forEach(function(log) { %>
            <div class="list-group-item px-0 py-2">
              <div class="d-flex justify-content-between">
                <strong class="text-dark"><%= log.action %></strong>
                <span class="text-muted"><%= new Date(log.created_at).toLocaleString() %></span>
              </div>
              <div class="text-secondary small mt-1 font-monospace"><%= log.details %></div>
            </div>
          <% }); %>
        <% } else { %>
          <p class="text-muted small mb-0">No audit history recorded.</p>
        <% } %>
      </div>
    </div>
  </div>
</div>

<!-- Cancel Modal -->
<div class="modal fade" id="cancelDetailModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content rounded-4">
      <form action="/admin/reservations/<%= reservation.id %>/cancel" method="POST">
        <div class="modal-header">
          <h5 class="modal-title fw-bold">Reject / Cancel Reservation</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label small fw-bold">Reason</label>
            <textarea name="cancellation_reason" class="form-control" rows="3" placeholder="e.g. Unverified GCash Reference Number" required></textarea>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">Close</button>
          <button type="submit" class="btn btn-danger rounded-pill fw-bold">Confirm Rejection</button>
        </div>
      </form>
    </div>
  </div>
</div>
