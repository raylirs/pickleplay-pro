<div class="container-fluid px-4 py-4">
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 pb-2 border-bottom">
    <div>
      <h2 class="fw-bold text-dark mb-1">Reservation Manager</h2>
      <p class="text-secondary small mb-0">Review player bookings, verify GCash payment proof, and approve reservations</p>
    </div>
    <div class="mt-3 mt-md-0 d-flex gap-2">
      <a href="/admin/reports/export-csv" class="btn btn-outline-secondary fw-semibold rounded-pill px-3">
        <i class="bi bi-filetype-csv me-1"></i>Download All CSV
      </a>
    </div>
  </div>

  <!-- Filters Bar -->
  <div class="card border-0 shadow-sm rounded-4 p-3 bg-white mb-4">
    <form method="GET" action="/admin/reservations" class="row g-2 align-items-center">
      <!-- Status Filter -->
      <div class="col-md-3">
        <label class="form-label small fw-bold text-secondary mb-1">Status</label>
        <select name="status" class="form-select form-select-sm rounded-3" onchange="this.form.submit()">
          <option value="ALL" <%= filters.status === 'ALL' ? 'selected' : '' %>>All Statuses</option>
          <option value="AWAITING_CONFIRMATION" <%= filters.status === 'AWAITING_CONFIRMATION' ? 'selected' : '' %>>⏳ AWAITING APPROVAL</option>
          <option value="CONFIRMED" <%= filters.status === 'CONFIRMED' ? 'selected' : '' %>>✅ CONFIRMED</option>
          <option value="AWAITING_PAYMENT" <%= filters.status === 'AWAITING_PAYMENT' ? 'selected' : '' %>>UNPAID</option>
          <option value="CANCELLED" <%= filters.status === 'CANCELLED' ? 'selected' : '' %>>CANCELLED</option>
        </select>
      </div>

      <!-- Court Filter -->
      <div class="col-md-3">
        <label class="form-label small fw-bold text-secondary mb-1">Court</label>
        <select name="court_id" class="form-select form-select-sm rounded-3" onchange="this.form.submit()">
          <option value="ALL" <%= filters.court_id === 'ALL' ? 'selected' : '' %>>All Courts</option>
          <% courts.forEach(function(c) { %>
            <option value="<%= c.id %>" <%= filters.court_id == c.id ? 'selected' : '' %>><%= c.display_name %></option>
          <% }); %>
        </select>
      </div>

      <!-- Date Filter -->
      <div class="col-md-3">
        <label class="form-label small fw-bold text-secondary mb-1">Date</label>
        <input type="date" name="date" class="form-control form-control-sm rounded-3" value="<%= filters.date %>" onchange="this.form.submit()">
      </div>

      <!-- Search Bar -->
      <div class="col-md-3">
        <label class="form-label small fw-bold text-secondary mb-1">Search Player / Ref</label>
        <div class="input-group input-group-sm">
          <input type="text" name="search" class="form-control rounded-start-3" placeholder="Name, ref, gcash..." value="<%= filters.search %>">
          <button class="btn btn-primary" type="submit"><i class="bi bi-search"></i></button>
          <% if (filters.search || filters.date || filters.status !== 'ALL' || filters.court_id !== 'ALL') { %>
            <a href="/admin/reservations" class="btn btn-outline-secondary" title="Clear Filters"><i class="bi bi-x-lg"></i></a>
          <% } %>
        </div>
      </div>
    </form>
  </div>

  <!-- Table -->
  <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light small text-uppercase">
          <tr>
            <th>Ref Number</th>
            <th>Court</th>
            <th>Date & Time</th>
            <th>Player Info</th>
            <th>Amount</th>
            <th>GCash Ref / Proof</th>
            <th>Status</th>
            <th class="text-end">Admin Action</th>
          </tr>
        </thead>
        <tbody>
          <% if (reservations && reservations.length > 0) { %>
            <% reservations.forEach(function(res) { %>
              <tr class="<%= res.status === 'AWAITING_CONFIRMATION' ? 'table-warning' : '' %>">
                <td>
                  <a href="/admin/reservations/<%= res.id %>" class="fw-bold font-monospace text-primary text-decoration-none">
                    <%= res.reference_number %>
                  </a>
                </td>
                <td>
                  <span class="fw-semibold text-dark"><%= res.court ? res.court.display_name : 'N/A' %></span>
                </td>
                <td>
                  <div><%= res.reservation_date %></div>
                  <span class="small text-muted"><%= formatTime12(res.start_time) %> - <%= formatTime12(res.end_time) %> (<%= res.total_hours %>h)</span>
                </td>
                <td>
                  <div class="fw-semibold text-dark"><%= res.user_name %></div>
                  <span class="small text-muted"><%= res.user_contact %></span>
                </td>
                <td>
                  <span class="fw-bold text-success"><%= formatCurrency(res.total_amount) %></span>
                </td>
                <td>
                  <% if (res.gcash_reference_no) { %>
                    <span class="badge bg-light text-dark border font-monospace d-block text-start mb-1">
                      <i class="bi bi-receipt me-1"></i><%= res.gcash_reference_no %>
                    </span>
                  <% } else { %>
                    <span class="small text-muted">No proof yet</span>
                  <% } %>
                  <% if (res.payment_screenshot) { %>
                    <a href="<%= res.payment_screenshot %>" target="_blank" class="badge bg-primary text-white text-decoration-none">
                      <i class="bi bi-image me-1"></i>View Image
                    </a>
                  <% } %>
                </td>
                <td>
                  <% if (res.status === 'CONFIRMED') { %>
                    <span class="badge bg-success"><i class="bi bi-check-circle-fill me-1"></i>CONFIRMED</span>
                  <% } else if (res.status === 'AWAITING_CONFIRMATION') { %>
                    <span class="badge bg-warning text-dark"><i class="bi bi-hourglass-split me-1"></i>AWAITING APPROVAL</span>
                  <% } else if (res.status === 'CANCELLED') { %>
                    <span class="badge bg-danger">CANCELLED</span>
                  <% } else { %>
                    <span class="badge bg-secondary"><%= res.status %></span>
                  <% } %>
                </td>
                <td class="text-end">
                  <div class="d-flex justify-content-end gap-1">
                    <% if (res.status !== 'CONFIRMED') { %>
                      <form action="/admin/reservations/<%= res.id %>/confirm" method="POST" onsubmit="return confirm('Confirm and approve booking <%= res.reference_number %>?');">
                        <button type="submit" class="btn btn-sm btn-success rounded-pill px-3 fw-bold" title="Approve Booking">
                          <i class="bi bi-check-lg me-1"></i>Approve
                        </button>
                      </form>
                    <% } %>

                    <a href="/admin/reservations/<%= res.id %>" class="btn btn-sm btn-light border rounded-pill px-2" title="Details">
                      <i class="bi bi-eye"></i>
                    </a>

                    <% if (res.status !== 'CANCELLED') { %>
                      <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-2" data-bs-toggle="modal" data-bs-target="#cancelModal<%= res.id %>" title="Reject / Cancel">
                        <i class="bi bi-x-lg"></i>
                      </button>
                    <% } %>
                  </div>

                  <!-- Cancel Modal -->
                  <div class="modal fade text-start" id="cancelModal<%= res.id %>" tabindex="-1">
                    <div class="modal-dialog">
                      <div class="modal-content rounded-4">
                        <form action="/admin/reservations/<%= res.id %>/cancel" method="POST">
                          <div class="modal-header">
                            <h5 class="modal-title fw-bold">Cancel Reservation <%= res.reference_number %></h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                          </div>
                          <div class="modal-body">
                            <p class="small text-secondary">Cancelling will immediately release the time slot on <%= res.reservation_date %> for <%= res.court ? res.court.display_name : 'Court' %>.</p>
                            <div class="mb-3">
                              <label class="form-label small fw-bold">Cancellation Reason</label>
                              <textarea name="cancellation_reason" class="form-control" rows="3" placeholder="e.g. Invalid GCash Reference Number / Player request" required></textarea>
                            </div>
                          </div>
                          <div class="modal-footer">
                            <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">Close</button>
                            <button type="submit" class="btn btn-danger rounded-pill fw-bold">Confirm Cancellation</button>
                          </div>
                        </form>
                      </div>
                    </div>
                  </div>
                </td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr>
              <td colspan="8" class="text-center py-5 text-muted">No reservations found matching current filters.</td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>
