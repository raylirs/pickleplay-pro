          </div>
        `;
      }

      let actionButtons = `
        <button type="button" class="btn btn-dark btn-sm rounded-pill px-3 py-1.5 fw-bold shadow-xs" onclick="openBookingReceiptModal('${escapeChatHtml(b.reference_number)}')">
