        <div class="d-flex align-items-center gap-2 w-100 w-md-auto justify-content-center">
          <button type="button" class="matrix-date-btn" id="btnPrevDate" title="Previous Day">
            <i class="bi bi-chevron-left"></i>
          </button>

          <div class="position-relative">
            <button type="button" class="matrix-date-btn matrix-date-center-btn" id="btnDisplayDate">
              <i class="bi bi-calendar3 me-2 text-warning"></i>
              <span id="dateDisplayText">Loading date...</span>
            </button>
            <input type="date" id="nativeDatePicker" min="<%= today %>" value="<%= today %>" style="position: absolute; opacity: 0; pointer-events: none; width: 0; height: 0;">
          </div>

          <button type="button" class="matrix-date-btn" id="btnNextDate" title="Next Day">
            <i class="bi bi-chevron-right"></i>
          </button>

          <button type="button" class="btn btn-sm btn-outline-dark rounded-pill px-3 fw-bold ms-1" id="btnTodayShortcut">
            Today
          </button>
        </div>

        <!-- Legend Swatches -->
        <div class="d-flex flex-wrap align-items-center justify-content-center gap-3">
          <div class="matrix-legend-item">
            <div class="legend-swatch legend-open"></div>
            <span>Available</span>
          </div>
          <div class="matrix-legend-item">
            <div class="legend-swatch legend-selected"></div>
            <span>Your Selection</span>
          </div>
          <div class="matrix-legend-item">
            <div class="legend-swatch legend-taken"></div>
            <span>Booked</span>
          </div>
          <div class="matrix-legend-item">
            <div class="legend-swatch legend-pending"></div>
            <span>Awaiting Payment</span>
          </div>
        </div>
      </div>

      <!-- Schedule Matrix Viewport -->
      <div class="schedule-matrix-wrapper" id="scheduleMatrixWrapper">
        <div class="text-center py-5 text-muted" id="matrixLoadingSpinner">
          <div class="spinner-border text-warning mb-2" role="status"></div>
          <p class="small fw-bold mb-0">Synchronizing real-time availability...</p>
        </div>

        <table class="matrix-table" id="matrixTable" style="display: none;">
          <thead>
            <tr id="matrixHeaderRow">
              <th class="matrix-time-header">TIME</th>
              <% if (courts && courts.length > 0) { %>
                <% courts.forEach(function(c) { %>
                  <th class="matrix-header-cell" data-court-id="<%= c.id %>">
                    <span class="matrix-header-court-title"><%= c.display_name %></span>
                    <span class="matrix-header-court-rate"><%= formatCurrency(c.category ? c.category.price_per_hour : 350) %>/hr</span>
                  </th>
                <% }); %>
              <% } %>
            </tr>
          </thead>
          <tbody id="matrixTableBody">
            <!-- Dynamically populated rows via client JavaScript -->
          </tbody>
        </table>
      </div>
    </div>
  </div>

