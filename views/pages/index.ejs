  function printAccountReceipt() {
    const area = document.getElementById('printableAccountReceiptArea');
    if (!area) return;
    const win = window.open('', '_blank', 'width=680,height=800');
    if (!win) {
      window.print();
      return;
    }
    win.document.write(`
      <!DOCTYPE html>
      <html>
      <head>
        <title>Official Booking Receipt — The Playground Pickleball</title>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
        <style>
          body { padding: 24px; background: #fff; font-family: system-ui, -apple-system, sans-serif; }
          @media print { body { padding: 0; } }
        </style>
      </head>
      <body>
        ${area.outerHTML}
        <script>
          window.onload = function() { setTimeout(function() { window.print(); }, 350); };
        <\/script>
      </body>
      </html>
    `);
    win.document.close();
  }

  // =========================================================
  // IN-APP ACCOUNT CHAT & BOOKING CARDS FUNCTIONS
  // =========================================================
  function escapeChatHtml(str) {
    return String(str || '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  function updateChatUnreadBadges(count) {
    accountChatUnreadCount = Math.max(0, parseInt(count || 0, 10));
    const fabBadge = document.getElementById('floatingChatBadge');
    const dashBadge = document.getElementById('dashboardChatBadge');
    const mobChatBadge = document.getElementById('mobileNavChatBadge');
    [fabBadge, dashBadge, mobChatBadge].forEach(el => {
      if (!el) return;
      if (accountChatUnreadCount > 0) {
        el.innerText = accountChatUnreadCount > 99 ? '99+' : accountChatUnreadCount;
        el.classList.remove('d-none');
      } else {
        el.classList.add('d-none');
      }
    });
  }

  async function fetchAccountChat(markRead = false) {
    if (!currentPlayerUser) return;
    try {
      const res = await fetch('/api/account/chat' + (markRead ? '?markRead=1' : ''), {
        headers: { 'Accept': 'application/json' }
      });
      if (!res.ok) return;
      const data = await res.json();
      if (data && data.loggedIn) {
        accountChatMessages = Array.isArray(data.messages) ? data.messages : [];
        updateChatUnreadBadges(markRead ? 0 : (data.unreadCount || 0));
        renderAccountChatMessages(true);
      }
    } catch (e) {
      console.warn('Could not load account chat:', e);
    }
  }

  function openAccountChatModal(attachBookingRef = null) {
    if (!currentPlayerUser) {
      openPlayerAuthModal('login', false);
      return;
    }

    if (attachBookingRef) {
      setChatAttachedRef(attachBookingRef);
    }

    const modalEl = document.getElementById('accountChatModal');
    if (modalEl) {
      const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
      modal.show();
    }

    fetchAccountChat(true);
    setTimeout(() => {
