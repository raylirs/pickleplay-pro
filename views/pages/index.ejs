    <span>Courts</span>
  </button>

  <button type="button" class="mobile-appbar-btn" id="mobile-nav-my-bookings" onclick="switchVenueTab('my-bookings')">
    <i class="bi bi-ticket-perforated-fill"></i>
    <span>Bookings</span>
    <span id="mobileNavBookingsBadge" class="mobile-appbar-badge bg-warning text-dark <%= (typeof myBookings !== 'undefined' && myBookings.length > 0) ? '' : 'd-none' %>">
      <%= typeof myBookings !== 'undefined' ? myBookings.length : 0 %>
    </span>
  </button>

  <button type="button" class="mobile-appbar-btn" id="mobile-nav-chat" onclick="openAccountChatModal()">
    <i class="bi bi-chat-dots-fill"></i>
