        </div>
      `;
    }

    bodyEl.innerHTML = `
      <div id="printableAccountReceiptArea" class="bg-white rounded-4 p-3 p-sm-4 shadow-sm border position-relative">
        <!-- Official Venue Receipt Banner -->
        <div class="text-center pb-3 mb-3 border-bottom">
          <div class="fw-extrabold text-dark font-display fs-5">THE PLAYGROUND PICKLEBALL</div>
          <div class="text-muted small" style="font-size: 11.5px;">Camaman-an, Cagayan de Oro City · Official Court Reservation Record</div>
          <div class="mt-2">
            <span class="badge border ${stampClass} rounded-pill px-3 py-1.5 fw-bold" style="font-size: 11px; letter-spacing: 0.04em;">
              <i class="bi ${stampIcon} me-1"></i>${stampLabel}
            </span>
          </div>
