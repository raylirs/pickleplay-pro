    <div class="modal-content rounded-4 border-0 shadow-lg overflow-hidden">
      <div class="modal-header modal-checkout-header p-4">
        <div>
          <h5 class="modal-title fw-bold font-display text-white mb-0">Court Slot Awaiting Payment</h5>
          <span class="text-white-50 small">Temporary 15-Minute Reservation Hold</span>
        </div>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body p-4 text-center">
        <div class="mb-3">
          <span class="badge bg-warning-subtle text-dark border border-warning px-3 py-1.5 rounded-pill fw-bold" style="font-size: 13px;">
            <i class="bi bi-hourglass-split me-1"></i> Awaiting GCash Payment
          </span>
        </div>
        <p class="text-secondary small mb-3">
          This slot on <strong id="pendingSlotCourtName" class="text-dark">Court</strong> at <strong id="pendingSlotTime" class="text-dark">Time</strong> is currently held while the player completes their GCash QR transfer.
