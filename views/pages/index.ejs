  async function handleSendPlayerChatMessage(e) {
    e.preventDefault();
    const inputEl = document.getElementById('accountChatInput');
    const sendBtn = document.getElementById('accountChatSendBtn');
    if (!inputEl) return;

    const text = inputEl.value.trim();
    if (!text) return;

    inputEl.value = '';
    if (sendBtn) sendBtn.disabled = true;

    try {
      const res = await fetch('/api/account/chat', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        body: JSON.stringify({
          message: text,
          booking_ref: chatAttachedBookingRef || null
        })
      });
      const data = await res.json();
      if (res.ok && data.success && data.message) {
        clearChatAttachedRef();
        const exists = accountChatMessages.some(m => m.id === data.message.id);
        if (!exists) {
          accountChatMessages.push(data.message);
          renderAccountChatMessages(true);
        }
      }
    } catch (err) {
      showLiveToast('Could not send message. Please try again.');
    } finally {
      if (sendBtn) sendBtn.disabled = false;
      inputEl.focus();
    }
  }

