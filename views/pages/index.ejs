<% 
  const defaultRate = (courts && courts.length > 0 && courts[0].category) ? parseFloat(courts[0].category.price_per_hour) : 350;
  const totalCourtsCount = courts ? courts.length : 4;
%>

<!-- =========================================================
     VENUE BRAND HEADER & QUICK STATS (Courtogo Architecture)
========================================================= -->
<section class="venue-header-banner py-4 py-md-5">
  <div class="container max-w-6xl">
    <div class="d-flex flex-column flex-md-row align-items-start align-items-md-center justify-content-between gap-3 mb-4">
      <!-- Venue Identity Left -->
      <div class="d-flex align-items-center gap-3">
        <div class="venue-avatar-wrap">
          <img src="/images/the-playground-logo.jpg" alt="The Playground Pickleball" class="venue-avatar-img">
        </div>
        <div>
          <div class="d-flex align-items-center gap-2 flex-wrap">
            <h1 class="display-6 fw-bold mb-0 text-dark font-display" style="letter-spacing: -0.02em;">
              The Playground Pickleball
            </h1>
            <i class="bi bi-patch-check-fill verified-icon fs-4" title="Verified Championship Sports Venue"></i>
          </div>
          <p class="text-secondary small mb-0 mt-1 d-flex align-items-center gap-1">
            <i class="bi bi-geo-alt-fill text-warning"></i>
            <span class="fw-semibold text-dark">Camaman-an, Cagayan de Oro City</span>
            <span class="text-muted d-none d-sm-inline">· Piot Heights Compound</span>
            <a href="#location" onclick="switchVenueTab('location'); return false;" class="text-primary text-decoration-none ms-1 small fw-bold">View Map &rarr;</a>
          </p>
        </div>
      </div>

      <!-- Right: Share & Messenger Alert Quick Actions -->
      <div class="d-flex align-items-center gap-2 mt-2 mt-md-0">
        <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-3 py-2 fw-semibold" onclick="shareVenueLink()">
          <i class="bi bi-share-fill me-1"></i>Share
        </button>
        <button type="button" class="btn btn-outline-primary btn-sm rounded-pill px-3 py-2 fw-semibold" data-bs-toggle="modal" data-bs-target="#messengerModal">
          <i class="bi bi-messenger me-1 text-primary"></i>Messenger Alerts
        </button>
      </div>
    </div>

    <!-- 3-Item Quick Stat Bar (Courtogo-Inspired) -->
    <div class="stat-pill-group">
      <div class="stat-pill-cell">
        <div class="stat-pill-label">
          <i class="bi bi-coin text-warning"></i> Hourly Rate
        </div>
        <div class="stat-pill-value">
          <%= formatCurrency(defaultRate) %><span class="text-muted fs-6 fw-normal">/hr</span>
        </div>
      </div>

      <div class="stat-pill-cell">
        <div class="stat-pill-label">
          <i class="bi bi-trophy-fill text-primary"></i> Courts
        </div>
        <div class="stat-pill-value">
          <%= totalCourtsCount %> Covered <span class="badge rounded-pill bg-primary-subtle text-primary fw-bold ms-1" style="font-size: 11px;">Arena</span>
        </div>
      </div>

      <div class="stat-pill-cell">
        <div class="stat-pill-label">
          <i class="bi bi-clock-fill text-success"></i> Operating Hours
        </div>
        <div class="stat-pill-value">
          8AM – 12 Midnight <span class="badge rounded-pill bg-success-subtle text-success fw-bold ms-1" style="font-size: 11px;">Daily</span>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- =========================================================
     TAB NAVIGATION BAR (Courtogo Underline Tabs)
========================================================= -->
<div class="bg-white border-bottom sticky-top" style="top: 60px; z-index: 1020;">
  <div class="container max-w-6xl">
    <div class="courtogo-tabs-bar" role="tablist">
      <button class="courtogo-tab-btn active" id="tab-btn-book" onclick="switchVenueTab('book')">
        <i class="bi bi-calendar2-check-fill text-warning"></i>
        <span>Book Court</span>
      </button>

      <button class="courtogo-tab-btn" id="tab-btn-about" onclick="switchVenueTab('about')">
        <i class="bi bi-info-circle-fill"></i>
        <span>About Facility</span>
      </button>

      <button class="courtogo-tab-btn" id="tab-btn-photos" onclick="switchVenueTab('photos')">
        <i class="bi bi-images"></i>
        <span>Photos</span>
        <span class="courtogo-tab-badge">4</span>
      </button>

      <button class="courtogo-tab-btn" id="tab-btn-location" onclick="switchVenueTab('location')">
        <i class="bi bi-geo-alt-fill text-danger"></i>
        <span>Location & Map</span>
      </button>

      <a href="/reservations/lookup" class="courtogo-tab-btn text-decoration-none">
