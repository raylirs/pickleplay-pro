<!-- =========================================================
     LEAFLET MAP LIBS & CLIENT INTERACTION JAVASCRIPT
========================================================= -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin=""/>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>

<script>
  // Global State for Courtogo Matrix & Player Account
  let currentDate = '<%= today %>';
  let matrixCourtsData = [];
  let selectedSlotItems = []; // Array of { courtId, courtName, startTime, endTime, rate, startLabel, endLabel }
  let mapInitialized = false;
  let leafletMap = null;
  let currentPlayerUser = <%- JSON.stringify(typeof user !== 'undefined' && user ? user : null) %>;
  let myBookingsData = <%- JSON.stringify(typeof myBookings !== 'undefined' && myBookings ? myBookings : []) %>;
  let pendingCheckoutAfterAuth = false;
  let accountChatMessages = [];
  let accountChatUnreadCount = 0;
  let chatAttachedBookingRef = null;

  document.addEventListener('DOMContentLoaded', function () {
    // 1. Initialize Date picker and buttons
    initDateControls();

    // 2. Fetch Initial Availability Matrix
    fetchMatrixAvailability(currentDate);

    // 3. Listen to Socket.io for Real-Time Updates
    initMatrixSocket();

    // 4. Render initial My Bookings list, fetch Account Chat & start Session Timeout Watcher
    renderMyBookingsList();
    if (currentPlayerUser) {
      fetchAccountChat(false);
    }
    initSessionTimeoutWatcher();

    // 5. Hide floating booking rail when checkout, auth, chat, or receipt modal opens, restore when closed
    ['checkoutModal', 'playerAuthModal', 'accountChatModal', 'accountReceiptModal'].forEach(modalId => {
      const modalEl = document.getElementById(modalId);
      if (modalEl) {
        modalEl.addEventListener('show.bs.modal', function () {
          const rail = document.getElementById('bookingActionBar');
          if (rail) rail.classList.remove('is-visible');
        });
        modalEl.addEventListener('hidden.bs.modal', function () {
          const rail = document.getElementById('bookingActionBar');
          if (rail && selectedSlotItems && selectedSlotItems.length > 0) {
            rail.classList.add('is-visible');
          }
        });
      }
    });

    // 6. Handle direct tab routing via URL hash
    if (window.location.hash) {
      const targetTab = window.location.hash.replace('#', '');
      if (['book', 'my-bookings', 'about', 'photos', 'location', 'lookup'].includes(targetTab)) {
        switchVenueTab(targetTab);
      } else if (targetTab === 'chat' && currentPlayerUser) {
        openAccountChatModal();
      }
    }

    // 7. Check for active unpaid booking in localStorage to show recovery banner
    checkUnpaidBookingBanner();
  });

  // Tab Switcher
  function switchVenueTab(tabName) {
    document.querySelectorAll('.venue-tab-pane').forEach(el => el.classList.add('d-none'));
    document.querySelectorAll('.courtogo-tab-btn').forEach(btn => btn.classList.remove('active'));
    document.querySelectorAll('.mobile-appbar-btn').forEach(btn => btn.classList.remove('active'));

    const contentPane = document.getElementById('tab-content-' + tabName);
    const btn = document.getElementById('tab-btn-' + tabName);
    const mobileBtn = document.getElementById('mobile-nav-' + tabName);

    if (contentPane) contentPane.classList.remove('d-none');
    if (btn) btn.classList.add('active');
    if (mobileBtn) mobileBtn.classList.add('active');

    // Manage bottom floating booking rail visibility
    const rail = document.getElementById('bookingActionBar');
    if (rail) {
      if (tabName === 'book' && typeof selectedSlotItems !== 'undefined' && selectedSlotItems.length > 0) {
        rail.classList.add('is-visible');
      } else {
        rail.classList.remove('is-visible');
      }
    }

    if (tabName === 'location') {
      setTimeout(initLeafletMap, 200);
    } else if (tabName === 'lookup') {
      setTimeout(() => {
        const input = document.getElementById('inlineRefInput');
        if (input) input.focus();
      }, 150);
    } else if (tabName === 'my-bookings' && currentPlayerUser) {
      refreshMyBookings();
    }
    history.replaceState(null, null, '#' + tabName);
  }

  function handleMobileAccountNavClick() {
    if (currentPlayerUser) {
      switchVenueTab('my-bookings');
      document.querySelectorAll('.mobile-appbar-btn').forEach(btn => btn.classList.remove('active'));
      const accBtn = document.getElementById('mobile-nav-account');
      if (accBtn) accBtn.classList.add('active');
    } else {
      openPlayerAuthModal('login', false);
    }
  }

  // Inline Lookup Handler
  async function handleInlineLookup(e) {
    e.preventDefault();
    const input = document.getElementById('inlineRefInput');
    const errorBox = document.getElementById('inlineLookupError');
    const btn = document.getElementById('inlineLookupBtn');
    if (!input) return;
    const ref = input.value.trim();
    if (!ref) return;

    if (errorBox) errorBox.classList.add('d-none');
    if (btn) {
      btn.disabled = true;
      btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status"></span>Checking...';
    }

    try {
      const res = await fetch('/api/v1/reservations/' + encodeURIComponent(ref) + '/status');
      if (res.ok) {
        const data = await res.json();
        if (data && data.success) {
          const targetRef = data.reference || ref;
          if (data.status === 'AWAITING_PAYMENT') {
            window.location.href = '/payment/gcash?ref=' + encodeURIComponent(targetRef);
          } else {
            window.location.href = '/reservations/' + encodeURIComponent(targetRef);
          }
          return;
        }
      }
      // If 404 or reservation not found
      if (errorBox) {
        errorBox.textContent = `No reservation found for "${ref}". Please verify your reference or GCash mobile number.`;
        errorBox.classList.remove('d-none');
      } else {
        window.location.href = '/reservations/' + encodeURIComponent(ref);
      }
    } catch (err) {
      // In case of network glitch, fallback directly to the reservation pass route
      window.location.href = '/reservations/' + encodeURIComponent(ref);
    } finally {
      if (btn) {
        btn.disabled = false;
        btn.innerHTML = '<i class="bi bi-search me-1"></i>Search Reservation';
      }
    }
  }

  // =========================================================
  // STEP 1 & STEP 2: CURRENT MONTH CALENDAR -> TIME SLOT MATRIX TOGGLE
  // =========================================================
  const todayBaseDate = new Date('<%= today %>T00:00:00');
  let calendarViewYear = todayBaseDate.getFullYear();
  let calendarViewMonth = todayBaseDate.getMonth(); // 0-indexed
  let hasSelectedDayOnce = false;
  let facilityClosedDatesMap = {};
  let playerBookedDatesMap = <%- JSON.stringify(typeof playerBookedDates !== 'undefined' ? playerBookedDates : {}) %>;
  let calendarMonthStatusCache = {};

  function formatYmdLocal(year, monthZeroIndexed, dayNum) {
    const m = String(monthZeroIndexed + 1).padStart(2, '0');
    const d = String(dayNum).padStart(2, '0');
    return `${year}-${m}-${d}`;
  }

  function escapeJs(str) {
    return (str || '').replace(/'/g, "\\'").replace(/"/g, '&quot;');
  }

  async function fetchCalendarMonthStatus(year, month, forceRefresh = false) {
    const monthKey = `${year}-${String(month + 1).padStart(2, '0')}`;
    if (!forceRefresh && calendarMonthStatusCache[monthKey]) {
      renderMonthCalendar();
      return;
    }

    try {
      const res = await fetch(`/calendar-month-status?year=${year}&month=${month + 1}&_t=${Date.now()}`, {
        cache: 'no-store',
        headers: { 'Accept': 'application/json' }
      });
      const data = await res.json();
      if (data && data.success && data.days) {
        calendarMonthStatusCache[monthKey] = data.days;
        Object.entries(data.days).forEach(([d, info]) => {
          if (info.status === 'CLOSED') {
            facilityClosedDatesMap[d] = info.reason || 'Facility Closed';
          }
          if (info.hasUserBooking) {
            playerBookedDatesMap[d] = playerBookedDatesMap[d] || { status: 'CONFIRMED' };
          }
        });
        renderMonthCalendar();
      }
    } catch (e) {
      console.warn('Failed to fetch calendar month status:', e);
    }
  }

  function renderMonthCalendar() {
    const gridEl = document.getElementById('monthCalendarDaysGrid');
    const titleEl = document.getElementById('calendarMonthYearTitle');
    const prevMonthBtn = document.getElementById('btnPrevMonth');
    if (!gridEl) return;

    const firstOfMonth = new Date(calendarViewYear, calendarViewMonth, 1);
    const daysInMonth = new Date(calendarViewYear, calendarViewMonth + 1, 0).getDate();
    const startWeekday = firstOfMonth.getDay(); // 0 (Sun) - 6 (Sat)

    if (titleEl) {
      titleEl.innerText = firstOfMonth.toLocaleDateString('en-US', {
        month: 'long',
        year: 'numeric'
      });
    }

    // Disable Prev Month button if viewing current month
    if (prevMonthBtn) {
      const isCurrentOrPastMonth =
        calendarViewYear < todayBaseDate.getFullYear() ||
        (calendarViewYear === todayBaseDate.getFullYear() && calendarViewMonth <= todayBaseDate.getMonth());
      prevMonthBtn.disabled = isCurrentOrPastMonth;
    }

    const todayStr = '<%= today %>';
    const monthKey = `${calendarViewYear}-${String(calendarViewMonth + 1).padStart(2, '0')}`;
    let cellsHtml = '';

    // Leading empty cells before the 1st of the month
    for (let i = 0; i < startWeekday; i++) {
      cellsHtml += `<div class="calendar-day-cell is-empty"></div>`;
    }

    // Actual days of the month
    for (let day = 1; day <= daysInMonth; day++) {
      const dateStr = formatYmdLocal(calendarViewYear, calendarViewMonth, day);
      const isPast = dateStr < todayStr;
      const isToday = dateStr === todayStr;
      const isSelected = hasSelectedDayOnce && dateStr === currentDate;

      const dayStatus = (calendarMonthStatusCache[monthKey] && calendarMonthStatusCache[monthKey][dateStr]) || null;
      const hasPlayerBooking = Boolean(playerBookedDatesMap[dateStr] || (dayStatus && dayStatus.hasUserBooking));

      const isFacilityClosed = Boolean(facilityClosedDatesMap[dateStr] || (dayStatus && dayStatus.status === 'CLOSED'));
      const closedReason = (dayStatus && dayStatus.reason) || facilityClosedDatesMap[dateStr] || 'Facility Closed';

      const isFullyBooked = !isFacilityClosed && dayStatus && dayStatus.status === 'FULL';
      const isFewLeft = !isFacilityClosed && dayStatus && dayStatus.status === 'FEW_LEFT';

      let cellClasses = 'calendar-day-cell';
      if (isFacilityClosed) cellClasses += ' is-disabled is-closed-day';
      if (isPast) cellClasses += ' is-disabled';
      if (isFullyBooked) cellClasses += ' is-fully-booked';
      if (hasPlayerBooking) cellClasses += ' has-player-booking';
      if (isToday) cellClasses += ' is-today';
      if (isSelected) cellClasses += ' is-selected';

      let badgeHtml = '';
      if (hasPlayerBooking) {
        badgeHtml = `<span class="calendar-day-badge badge-player-booked"><i class="bi bi-star-fill text-warning me-0.5"></i>BOOKED</span>`;
      } else if (isFacilityClosed) {
        badgeHtml = `<span class="calendar-day-badge bg-secondary text-white">CLOSED</span>`;
      } else if (isFullyBooked) {
        badgeHtml = `<span class="calendar-day-badge bg-danger text-white">FULL</span>`;
      } else if (isToday) {
        badgeHtml = `<span class="calendar-day-badge ${isSelected ? 'bg-warning text-dark' : 'bg-warning-subtle text-dark border border-warning'}">TODAY</span>`;
      } else if (isSelected) {
        badgeHtml = `<span class="calendar-day-badge bg-warning text-dark">PICKED</span>`;
      }

      let ctaLabel = '';
      if (isPast) {
        ctaLabel = '';
      } else if (isFacilityClosed) {
        ctaLabel = `<span class="calendar-day-cta-desktop text-muted fw-bold"><i class="bi bi-slash-circle me-1"></i>Not Available</span><span class="calendar-day-cta-mobile text-muted">Closed</span>`;
      } else if (isFullyBooked) {
        ctaLabel = `<span class="calendar-day-cta-desktop text-danger fw-bold"><i class="bi bi-x-circle me-1"></i>Fully Booked</span><span class="calendar-day-cta-mobile text-danger">Full</span>`;
      } else if (hasPlayerBooking) {
        ctaLabel = `<span class="calendar-day-cta-desktop text-primary fw-bold"><i class="bi bi-calendar2-check-fill me-1"></i>Your Booking &bull; View</span><span class="calendar-day-cta-mobile text-primary fw-bold">Booked</span>`;
      } else if (isFewLeft) {
        ctaLabel = `<span class="calendar-day-cta-desktop text-warning-emphasis fw-bold"><i class="bi bi-exclamation-circle me-1"></i>${dayStatus.label}</span><span class="calendar-day-cta-mobile text-warning">Few</span>`;
      } else {
        ctaLabel = `<span class="calendar-day-cta-desktop text-success fw-bold"><i class="bi bi-circle-fill me-1 text-success" style="font-size: 6px; vertical-align: middle;"></i>Available <i class="bi bi-arrow-right-short"></i></span><span class="calendar-day-cta-mobile text-success">Open</span>`;
      }

      let clickAttr = '';
      if (isPast) {
        clickAttr = '';
      } else if (isFacilityClosed) {
        clickAttr = `onclick="showLiveToast('🔒 Facility is closed on this date (${escapeJs(closedReason)}).')"`;
      } else if (isFullyBooked) {
        clickAttr = `onclick="selectCalendarDay('${dateStr}'); showLiveToast('ℹ️ All courts are currently booked on ${dateStr}. You can inspect time slots or check another date.');"`;
      } else {
        clickAttr = `onclick="selectCalendarDay('${dateStr}')"`;
      }

      cellsHtml += `
        <div class="${cellClasses}" ${clickAttr} role="button" tabindex="${(isPast || isFacilityClosed) ? '-1' : '0'}" aria-label="Select ${dateStr}">
          <div class="calendar-day-top">
            <span class="calendar-day-number">${day}</span>
            ${badgeHtml}
          </div>
          <div class="calendar-day-cta">
            ${ctaLabel}
          </div>
        </div>
      `;
    }

    gridEl.innerHTML = cellsHtml;
  }

  function changeCalendarMonth(delta) {
    calendarViewMonth += delta;
    if (calendarViewMonth > 11) {
      calendarViewMonth = 0;
      calendarViewYear += 1;
    } else if (calendarViewMonth < 0) {
      calendarViewMonth = 11;
      calendarViewYear -= 1;
    }
    renderMonthCalendar();
    fetchCalendarMonthStatus(calendarViewYear, calendarViewMonth);
  }

  function jumpCalendarToToday() {
    calendarViewYear = todayBaseDate.getFullYear();
    calendarViewMonth = todayBaseDate.getMonth();
    selectCalendarDay('<%= today %>');
    fetchCalendarMonthStatus(calendarViewYear, calendarViewMonth);
  }

  function selectCalendarDay(dateStr) {
    if (!dateStr || dateStr < '<%= today %>') return;
    const dateChanged = currentDate !== dateStr;
    currentDate = dateStr;
    hasSelectedDayOnce = true;

    const dObj = new Date(dateStr + 'T00:00:00');
    calendarViewYear = dObj.getFullYear();
    calendarViewMonth = dObj.getMonth();

    updateDateDisplay(currentDate);
    renderMonthCalendar();

    // Always fetch & update court availability matrix for the selected date!
    fetchMatrixAvailability(currentDate);

    // Make sure court matrix card is visible and smooth-scroll to it
    scrollToTimeSlots();
  }

  function scrollToCalendar() {
    const calCard = document.getElementById('bookingMonthCalendarCard');
    if (calCard) {
      calCard.classList.remove('d-none');
      calCard.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  }

  function scrollToTimeSlots() {
    const matrixCard = document.getElementById('bookingTimeMatrixCard');
    if (matrixCard) {
      matrixCard.classList.remove('d-none');
      matrixCard.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  }

  function toggleBookingCalendarView(showCalendar) {
    if (showCalendar) {
      scrollToCalendar();
    } else {
      scrollToTimeSlots();
    }
  }

  // Date Controls
  function initDateControls() {
    const nativePicker = document.getElementById('nativeDatePicker');
    const displayBtn = document.getElementById('btnDisplayDate');
    const prevBtn = document.getElementById('btnPrevDate');
    const nextBtn = document.getElementById('btnNextDate');
    const todayBtn = document.getElementById('btnTodayShortcut');

    updateDateDisplay(currentDate);
    renderMonthCalendar();
    fetchCalendarMonthStatus(calendarViewYear, calendarViewMonth);
    fetchMatrixAvailability(currentDate);

    displayBtn.addEventListener('click', () => {
      scrollToCalendar();
    });

    nativePicker.addEventListener('change', (e) => {
      if (e.target.value) {
        selectCalendarDay(e.target.value);
      }
    });

    prevBtn.addEventListener('click', () => {
      const d = new Date(currentDate + 'T00:00:00');
      d.setDate(d.getDate() - 1);
      const minDate = new Date('<%= today %>T00:00:00');
      if (d >= minDate) {
        const ymd = formatYmdLocal(d.getFullYear(), d.getMonth(), d.getDate());
        selectCalendarDay(ymd);
      }
    });

    nextBtn.addEventListener('click', () => {
      const d = new Date(currentDate + 'T00:00:00');
      d.setDate(d.getDate() + 1);
      const ymd = formatYmdLocal(d.getFullYear(), d.getMonth(), d.getDate());
      selectCalendarDay(ymd);
    });

    todayBtn.addEventListener('click', () => {
      selectCalendarDay('<%= today %>');
    });
  }

  function updateDateDisplay(dateStr) {
    const d = new Date(dateStr + 'T00:00:00');
    const todayStr = '<%= today %>';
    const isToday = dateStr === todayStr;

    const options = { weekday: 'short', month: 'short', day: 'numeric' };
    const formatted = d.toLocaleDateString('en-US', options);

    document.getElementById('dateDisplayText').innerText = (isToday ? 'Today, ' : '') + formatted;
    document.getElementById('nativeDatePicker').value = dateStr;
  }

  // Fetch Matrix API Data (supports silent background & socket real-time sync)
  async function fetchMatrixAvailability(date, silent = false) {
    const spinner = document.getElementById('matrixLoadingSpinner');
    const table = document.getElementById('matrixTable');

    if (!silent) {
      if (spinner) spinner.style.display = 'block';
      if (table) table.style.display = 'none';
    }

    try {
      const res = await fetch('/courts-availability?date=' + encodeURIComponent(date) + '&_t=' + Date.now(), {
        cache: 'no-store',
        headers: { 'Accept': 'application/json' }
      });
      const data = await res.json();

      if (data.success && data.courts) {
        matrixCourtsData = data.courts;
        if (data.closedDates) {
          facilityClosedDatesMap = Object.assign(facilityClosedDatesMap || {}, data.closedDates);
          renderMonthCalendar();
        }
        renderMatrixTable(data.courts, data.isDayClosed, data.closedReason);
      }
    } catch (err) {
      console.error('Matrix error:', err);
    } finally {
      if (!silent) {
        if (spinner) spinner.style.display = 'none';
        if (table) table.style.display = 'table';
      }
    }
  }

  // Render Table Grid
  function renderMatrixTable(courts, isDayClosed = false, closedReason = null) {
    const dayBanner = document.getElementById('dayClosedBanner');
    const dayTitle = document.getElementById('dayClosedTitle');
    const dayReason = document.getElementById('dayClosedReason');
    if (dayBanner) {
      if (isDayClosed) {
        dayBanner.classList.remove('d-none');
        dayBanner.classList.add('d-flex');
        if (dayTitle) dayTitle.innerText = `Facility Closed on ${currentDate}`;
        if (dayReason) dayReason.innerText = closedReason || 'All courts are reserved or under facility maintenance today.';
      } else {
        dayBanner.classList.add('d-none');
        dayBanner.classList.remove('d-flex');
      }
    }

    const tbody = document.getElementById('matrixTableBody');
    tbody.innerHTML = '';

    if (!courts || courts.length === 0) return;

    // Prune any selected slots that were just booked/held by another player in real time
    if (selectedSlotItems.length > 0) {
      const beforeCount = selectedSlotItems.length;
      selectedSlotItems = selectedSlotItems.filter(sel => {
        const cObj = courts.find(c => Number(c.id) === Number(sel.courtId));
        if (!cObj || !cObj.slots) return true;
        const sObj = cObj.slots.find(s => s.startTime === sel.startTime);
        return sObj ? Boolean(sObj.isAvailable) : true;
      });
      if (selectedSlotItems.length !== beforeCount) {
        updateFloatingRail();
        showLiveToast('⚡ A time slot you had selected was just reserved by another player.');
      }
    }

    // Use the first court's slots as time row baseline
    const referenceSlots = courts[0].slots || [];

    referenceSlots.forEach(slot => {
      const tr = document.createElement('tr');

      // 1. Time Label Cell (Sticky Left)
      const timeTd = document.createElement('td');
      timeTd.className = 'matrix-time-cell';
      const isMidnight = slot.endTime === '24:00' || slot.endTime === '00:00';
      const endLabelFormatted = isMidnight ? '12:00 Midnight' : slot.endLabel;
      timeTd.innerHTML = `
        <span class="matrix-time-start fw-bold text-dark d-block" style="font-size: 11px;">${slot.startLabel}</span>
        <span class="matrix-time-end text-muted d-block" style="font-size: 9px; line-height: 1.1;">to ${endLabelFormatted}</span>
      `;
      tr.appendChild(timeTd);

      // 2. Court Slot Cells
      courts.forEach(court => {
        const td = document.createElement('td');
        const courtSlot = (court.slots || []).find(s => s.startTime === slot.startTime) || slot;

        let stateClass = 'state-available';
        if (!courtSlot.isAvailable) {
          if (courtSlot.status === 'BLOCKED' || courtSlot.status === 'MAINTENANCE') {
            stateClass = 'state-blocked';
          } else if (courtSlot.status === 'AWAITING_PAYMENT' || courtSlot.status === 'PENDING') {
            stateClass = 'state-processing';
          } else if (courtSlot.status === 'AWAITING_CONFIRMATION') {
            stateClass = 'state-verifying';
          } else {
            stateClass = 'state-booked';
          }
        }

        // Check if currently selected (only if still available)
        const isSelected = courtSlot.isAvailable && selectedSlotItems.some(item => item.courtId === court.id && item.startTime === slot.startTime && item.date === currentDate);
        if (isSelected) {
          stateClass = 'state-selected';
        }

        const isMine = Boolean(
          courtSlot.isMyBooking &&
          courtSlot.referenceNumber
        );

        td.className = 'matrix-slot-cell ' + stateClass + (isMine ? ' is-my-slot' : '');
        td.dataset.courtId = court.id;
        td.dataset.courtName = court.name;
        td.dataset.rate = court.pricePerHour;
        td.dataset.startTime = slot.startTime;
        td.dataset.endTime = slot.endTime;
        td.dataset.startLabel = slot.startLabel;
        td.dataset.endLabel = slot.endLabel;
        td.id = `cell-${court.id}-${slot.startTime.replace(':', '')}`;

        if (stateClass === 'state-blocked') {
          td.innerHTML = `
            <div class="slot-inner">
              <span class="small fw-bold"><i class="bi bi-slash-circle me-1 text-danger"></i>Blocked</span>
            </div>
          `;
        } else {
          td.innerHTML = `
            <div class="slot-inner">
              <span>₱${court.pricePerHour}</span>
            </div>
          `;
        }

        // Click handlers
        if (courtSlot.isAvailable) {
          td.addEventListener('click', () => handleSlotClick(court, slot));
        } else if (courtSlot.status === 'BLOCKED' || courtSlot.status === 'MAINTENANCE') {
          td.style.cursor = 'not-allowed';
          const rText = courtSlot.blockReason ? ` (${courtSlot.blockReason})` : '';
          td.title = `Unavailable: Slot blocked by facility admin${rText}`;
          td.addEventListener('click', () => {
            showLiveToast(`🔒 This court slot is unavailable${rText}.`);
          });
        } else if (courtSlot.status === 'AWAITING_PAYMENT' || courtSlot.status === 'PENDING') {
          if (isMine) {
            td.style.cursor = 'pointer';
            td.title = 'Your Pending Booking — Click to resume GCash payment';
            td.addEventListener('click', () => handlePendingSlotClick(court, courtSlot));
          } else {
            td.style.cursor = 'not-allowed';
            td.title = 'Held by another player (Awaiting Payment)';
            td.addEventListener('click', () => {
              showLiveToast('🔒 This slot is currently held by another player completing GCash payment.');
            });
          }
        } else if (courtSlot.status === 'AWAITING_CONFIRMATION') {
          if (isMine) {
            td.style.cursor = 'pointer';
            td.title = 'Your Booking — Payment under admin verification (Click to check status)';
            td.addEventListener('click', () => handleVerifyingSlotClick(court, courtSlot));
          } else {
            td.style.cursor = 'not-allowed';
            td.title = 'Reserved by another player (Verifying Payment)';
            td.addEventListener('click', () => {
              showLiveToast('🔒 This slot belongs to another player and is currently under admin verification.');
            });
          }
        } else {
          td.style.cursor = 'not-allowed';
          td.title = 'Reserved / Booked';
          td.addEventListener('click', () => {
            showLiveToast('🔒 This court slot is already booked.');
          });
        }

        tr.appendChild(td);
      });

      tbody.appendChild(tr);
    });
  }

  // Pending Slot Modal Handler (Strictly for the transaction owner)
  function handlePendingSlotClick(court, slot) {
    if (!slot || !slot.isMyBooking || !slot.referenceNumber) {
      showLiveToast('🔒 Only the player who created this booking can continue its payment.');
      return;
    }
    const modalEl = document.getElementById('pendingSlotModal');
    if (!modalEl) return;
    document.getElementById('pendingSlotCourtName').innerText = court.name;
    document.getElementById('pendingSlotTime').innerText = `${slot.startLabel} - ${slot.endLabel}`;
    document.getElementById('pendingSlotRef').innerText = slot.referenceNumber;

    const payBtn = document.getElementById('pendingSlotPayBtn');
    payBtn.href = `/payment/gcash?ref=${encodeURIComponent(slot.referenceNumber)}`;
    payBtn.classList.remove('d-none');

    const modal = new bootstrap.Modal(modalEl);
    modal.show();
  }

  // Verifying Slot Modal Handler (Strictly for the transaction owner)
  function handleVerifyingSlotClick(court, slot) {
    if (!slot || !slot.isMyBooking || !slot.referenceNumber) {
      showLiveToast('🔒 Only the player who created this booking can view its verification pass.');
      return;
    }
    const modalEl = document.getElementById('verifyingSlotModal');
    if (!modalEl) return;
    document.getElementById('verifyingSlotCourtName').innerText = court.name;
    document.getElementById('verifyingSlotTime').innerText = `${slot.startLabel} - ${slot.endLabel}`;
    document.getElementById('verifyingSlotRef').innerText = slot.referenceNumber;

    const passBtn = document.getElementById('verifyingSlotPassBtn');
    passBtn.href = `/reservations/${encodeURIComponent(slot.referenceNumber)}`;
    passBtn.classList.remove('d-none');

    const modal = new bootstrap.Modal(modalEl);
    modal.show();
  }

  // Active Unpaid Booking Recovery Banner
  async function checkUnpaidBookingBanner() {
    const pendingRef = localStorage.getItem('courtogo_pending_ref');
    if (!pendingRef) return;

    try {
      const res = await fetch('/api/v1/reservations/' + encodeURIComponent(pendingRef) + '/status');
      if (res.ok) {
        const data = await res.json();
        if (data.success && data.status === 'AWAITING_PAYMENT' && !data.isExpired) {
          const banner = document.getElementById('unpaidReservationBanner');
          const refEl = document.getElementById('unpaidBannerRef');
          const linkEl = document.getElementById('unpaidBannerLink');
          if (banner && refEl && linkEl) {
            refEl.innerText = data.reference;
            linkEl.href = '/payment/gcash?ref=' + encodeURIComponent(data.reference);
            banner.classList.remove('d-none');
            banner.classList.add('d-flex');
          }
          return;
        }
      }
      localStorage.removeItem('courtogo_pending_ref');
    } catch (e) {
      // Ignore network errors
    }
  }

  function dismissUnpaidBanner() {
    const banner = document.getElementById('unpaidReservationBanner');
    if (banner) {
      banner.classList.remove('d-flex');
      banner.classList.add('d-none');
    }
  }

  let pendingSlotAfterAuth = null;

  // Interactive Multi-Court & Multi-Time Slot Click Handler (Strict Sign-In Required — No Guest Booking)
  function handleSlotClick(court, slot) {
    if (!currentPlayerUser) {
      pendingSlotAfterAuth = { court, slot };
      showLiveToast('🔒 Please sign in or create a Player Account to book a court.');
      openPlayerAuthModal('login', true);
      return;
    }

    const existingIndex = selectedSlotItems.findIndex(
      item => item.courtId === court.id && item.startTime === slot.startTime && item.date === currentDate
    );

    if (existingIndex > -1) {
      // Toggle OFF
      selectedSlotItems.splice(existingIndex, 1);
    } else {
      // Toggle ON
      const dObj = new Date(currentDate + 'T00:00:00');
      const dLabel = dObj.toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' });
      selectedSlotItems.push({
        courtId: court.id,
        courtName: court.name,
        date: currentDate,
        dateFormatted: dLabel,
        startTime: slot.startTime,
        endTime: slot.endTime,
        startLabel: slot.startLabel,
        endLabel: slot.endLabel,
        rate: parseFloat(court.pricePerHour || 350)
      });
    }

    // Sort by date, court, then start time
    selectedSlotItems.sort((a, b) => {
      if (a.date !== b.date) return a.date.localeCompare(b.date);
      if (a.courtId !== b.courtId) return a.courtId - b.courtId;
      return a.startTime.localeCompare(b.startTime);
    });

    // Re-render visual selection and bottom action rail
    updateMatrixVisualSelection();
    updateFloatingRail();
  }

  function updateMatrixVisualSelection() {
    document.querySelectorAll('.matrix-slot-cell').forEach(cell => {
      const cId = parseInt(cell.dataset.courtId, 10);
      const sTime = cell.dataset.startTime;

      if (cell.classList.contains('state-booked') || cell.classList.contains('state-processing') || cell.classList.contains('state-verifying') || cell.classList.contains('state-blocked')) {
        return;
      }

      const isSelected = selectedSlotItems.some(item => item.courtId === cId && item.startTime === sTime && item.date === currentDate);
      if (isSelected) {
        cell.className = 'matrix-slot-cell state-selected';
      } else {
        cell.className = 'matrix-slot-cell state-available';
      }
    });
  }

  function formatSlotTimeLabel(timeStr) {
    if (timeStr === '24:00' || timeStr === '00:00') return '12:00 Midnight';
    const parts = timeStr.split(':');
    let h = parseInt(parts[0], 10);
    const m = parts[1] || '00';
    const ampm = h >= 12 ? 'PM' : 'AM';
    h = h % 12 || 12;
    return `${h}:${m} ${ampm}`;
  }

  // Expandable Selected Slots Table Drawer
  let isDrawerOpen = false;

  function toggleSelectedSlotsDrawer(forceState) {
    const drawer = document.getElementById('selectedSlotsDrawer');
    const toggleBtn = document.getElementById('drawerToggleBtn');
    const icon = document.getElementById('drawerToggleIcon');
    const textEl = document.getElementById('drawerToggleText');

    const mobileToggleBtn = document.getElementById('mobileDrawerToggleBtn');
    const mobileIcon = document.getElementById('mobileDrawerToggleIcon');
    const mobileTextEl = document.getElementById('mobileDrawerToggleText');

    if (!drawer) return;

    if (typeof forceState === 'boolean') {
      isDrawerOpen = forceState;
    } else {
      isDrawerOpen = !isDrawerOpen;
    }

    if (isDrawerOpen && selectedSlotItems.length > 0) {
      renderSelectedSlotsDrawer();
      drawer.classList.remove('d-none');
      if (toggleBtn) toggleBtn.classList.add('is-active');
      if (icon) icon.className = 'bi bi-chevron-down';
      if (textEl) textEl.innerText = 'Hide Table';

      if (mobileToggleBtn) mobileToggleBtn.classList.add('is-active');
      if (mobileIcon) mobileIcon.className = 'bi bi-chevron-down';
      if (mobileTextEl) mobileTextEl.innerText = 'Hide';
    } else {
      drawer.classList.add('d-none');
      isDrawerOpen = false;
      if (toggleBtn) toggleBtn.classList.remove('is-active');
      if (icon) icon.className = 'bi bi-chevron-up';
      if (textEl) textEl.innerText = 'View Table';

      if (mobileToggleBtn) mobileToggleBtn.classList.remove('is-active');
      if (mobileIcon) mobileIcon.className = 'bi bi-chevron-up';
      if (mobileTextEl) mobileTextEl.innerText = 'Details';
    }
  }

  function renderSelectedSlotsDrawer() {
    const container = document.getElementById('drawerSlotsTableBody');
    const subtitleEl = document.getElementById('drawerSummarySubtitle');
    const countEl = document.getElementById('drawerSlotsSummaryCount');
    const priceSummaryEl = document.getElementById('drawerTotalPriceSummary');
    if (!container) return;

    if (!selectedSlotItems || selectedSlotItems.length === 0) {
      container.innerHTML = '<div class="text-center py-3 text-white-50 small">No slots selected</div>';
      toggleSelectedSlotsDrawer(false);
      return;
    }

    const totalCount = selectedSlotItems.length;
    const totalPrice = selectedSlotItems.reduce((sum, item) => sum + item.rate, 0);
    const uniqueCourts = [...new Set(selectedSlotItems.map(item => item.courtName))];
    const uniqueDates = [...new Set(selectedSlotItems.map(item => item.date))];

    if (subtitleEl) {
      const daysText = uniqueDates.length > 1 ? `${uniqueDates.length} days & ` : '';
      subtitleEl.innerText = `${totalCount} slot${totalCount > 1 ? 's' : ''} across ${daysText}${uniqueCourts.length} court${uniqueCourts.length > 1 ? 's' : ''}`;
    }
    if (countEl) {
      countEl.innerText = `${totalCount} slot${totalCount > 1 ? 's' : ''} selected`;
    }
    if (priceSummaryEl) {
      priceSummaryEl.innerText = `Total: ₱${totalPrice.toFixed(2)}`;
    }

    // Group items by date
    const dateMap = {};
    selectedSlotItems.forEach(item => {
      const dKey = item.date || currentDate;
      if (!dateMap[dKey]) dateMap[dKey] = [];
      dateMap[dKey].push(item);
    });

    let rowsHtml = '';
    const sortedDates = Object.keys(dateMap).sort();

    sortedDates.forEach((dKey) => {
      const items = dateMap[dKey];
      const dFormatted = items[0].dateFormatted || dKey;

      if (sortedDates.length > 1) {
        rowsHtml += `
          <div class="d-flex align-items-center gap-2 mt-2 mb-1 px-1">
            <span class="badge bg-primary bg-opacity-75 text-white rounded-pill px-2.5 py-1 small fw-bold">
              <i class="bi bi-calendar-event me-1"></i>${dFormatted}
            </span>
            <span class="text-white-50 small" style="font-size: 11px;">(${items.length} slot${items.length > 1 ? 's' : ''})</span>
          </div>
        `;
      }

      items.forEach(item => {
        rowsHtml += `
          <div class="drawer-slot-card d-flex align-items-center justify-content-between p-2 px-2.5 rounded-3 border border-secondary border-opacity-25" style="background: rgba(255, 255, 255, 0.05);">
            <div class="d-flex align-items-center gap-2 flex-grow-1 min-w-0">
              <span class="badge bg-warning text-dark rounded-pill px-2 py-1 fw-bold flex-shrink-0" style="font-size: 11px;">
                ${item.courtName}
              </span>
              <div class="text-truncate">
                <span class="text-white fw-semibold small d-inline-flex align-items-center gap-1 text-truncate" style="font-size: 12px;">
                  <i class="bi bi-clock-history text-warning"></i> ${item.startLabel} – ${item.endLabel}
                </span>
                ${sortedDates.length === 1 ? '' : `<span class="text-white-50 d-block" style="font-size: 10px;">${item.dateFormatted || item.date}</span>`}
              </div>
            </div>
            <div class="d-flex align-items-center gap-2 flex-shrink-0 ms-2">
              <span class="fw-bold font-monospace text-warning small" style="font-size: 12px;">
                ₱${item.rate.toFixed(2)}
              </span>
              <button type="button" class="drawer-remove-btn" onclick="removeSingleSlot(${item.courtId}, '${item.startTime}', '${item.date}')" title="Remove this slot">
                <i class="bi bi-trash3-fill"></i>
              </button>
            </div>
          </div>
        `;
      });
    });

    container.innerHTML = rowsHtml;
  }

  function removeSingleSlot(courtId, startTime, date) {
    const idx = selectedSlotItems.findIndex(item => item.courtId === courtId && item.startTime === startTime && (!date || item.date === date));
    if (idx > -1) {
      selectedSlotItems.splice(idx, 1);
      updateMatrixVisualSelection();
      updateFloatingRail();
      if (selectedSlotItems.length === 0) {
        toggleSelectedSlotsDrawer(false);
      } else {
        renderSelectedSlotsDrawer();
      }
    }
  }

  function updateFloatingRail() {
    const rail = document.getElementById('bookingActionBar');
    if (!selectedSlotItems || selectedSlotItems.length === 0) {
      rail.classList.remove('is-visible');
      toggleSelectedSlotsDrawer(false);
      return;
    }

    const totalCount = selectedSlotItems.length;
    const totalPrice = selectedSlotItems.reduce((sum, item) => sum + item.rate, 0);

    // Group by unique courts & dates
    const uniqueCourts = [...new Set(selectedSlotItems.map(item => item.courtName))];
    const uniqueDates = [...new Set(selectedSlotItems.map(item => item.date))];
    const isMobile = window.innerWidth < 576;

    let badgeText = '';
    if (uniqueDates.length > 1) {
      badgeText = `${uniqueDates.length} Days · ${uniqueCourts.length} Court${uniqueCourts.length > 1 ? 's' : ''}`;
    } else if (uniqueCourts.length === 1) {
      badgeText = uniqueCourts[0];
    } else if (uniqueCourts.length <= 2 && !isMobile) {
      badgeText = `${uniqueCourts.length} Courts (${uniqueCourts.join(', ')})`;
    } else {
      badgeText = `${uniqueCourts.length} Courts`;
    }

    let timeSummaryText = '';
    if (totalCount === 1) {
      const item = selectedSlotItems[0];
      timeSummaryText = `${item.startLabel} - ${item.endLabel} (1 hr)`;
    } else {
      timeSummaryText = `${totalCount} Hours / Slots Selected`;
    }

    // Desktop elements
    const dBadge = document.getElementById('railCourtBadge');
    const dSlots = document.getElementById('railTimeSlotsText');
    const dPrice = document.getElementById('railTotalPrice');
    if (dBadge) dBadge.innerText = badgeText;
    if (dSlots) dSlots.innerText = timeSummaryText;
    if (dPrice) dPrice.innerText = `₱${totalPrice.toFixed(2)}`;

    // Mobile elements
    const mBadge = document.getElementById('mobileRailCourtBadge');
    const mSlots = document.getElementById('mobileRailSlotsText');
    const mPrice = document.getElementById('mobileRailTotalPrice');
    if (mBadge) {
      if (uniqueDates.length > 1) {
        mBadge.innerText = `${uniqueDates.length}D · ${uniqueCourts.length}C`;
      } else {
        mBadge.innerText = `${uniqueCourts.length} Court${uniqueCourts.length > 1 ? 's' : ''}`;
      }
    }
    if (mSlots) mSlots.innerText = `${totalCount} Slot${totalCount > 1 ? 's' : ''}`;
    if (mPrice) mPrice.innerText = `₱${totalPrice.toFixed(2)}`;

    rail.classList.add('is-visible');

    if (isDrawerOpen) {
      renderSelectedSlotsDrawer();
    }
  }

  function clearSelectedSlots() {
    selectedSlotItems = [];
    updateMatrixVisualSelection();
    toggleSelectedSlotsDrawer(false);
    document.getElementById('bookingActionBar').classList.remove('is-visible');
  }

  // Open Checkout Modal (Strict Player Login Required)
  function openCheckoutModal() {
    if (!selectedSlotItems || selectedSlotItems.length === 0) return;
    toggleSelectedSlotsDrawer(false);

    // Require player login / signup before proceeding to checkout
    if (!currentPlayerUser) {
      openPlayerAuthModal('login', true);
      return;
    }

    const totalCount = selectedSlotItems.length;
    const totalPrice = selectedSlotItems.reduce((sum, item) => sum + item.rate, 0);

    // Group items by date, then court
    const dateMap = {};
    selectedSlotItems.forEach(item => {
      const dKey = item.date || currentDate;
      if (!dateMap[dKey]) dateMap[dKey] = {};
      if (!dateMap[dKey][item.courtName]) dateMap[dKey][item.courtName] = [];
      dateMap[dKey][item.courtName].push(item);
    });

    const uniqueDates = Object.keys(dateMap).sort();
    const uniqueCourts = [...new Set(selectedSlotItems.map(item => item.courtName))];
    let slotsDetailHtml = '';

    uniqueDates.forEach((dKey, dIdx) => {
      const courtMap = dateMap[dKey];
      const courtNames = Object.keys(courtMap);
      const dObj = new Date(dKey + 'T00:00:00');
      const dLabel = dObj.toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric' });

      slotsDetailHtml += `
        <div class="p-3 rounded-4 mb-3" style="background: #f8fafc; border: 1px solid #e2e8f0;">
          <div class="d-flex align-items-center justify-content-between mb-2 pb-2 border-bottom">
            <span class="fw-bold text-dark small d-inline-flex align-items-center gap-1.5">
              <i class="bi bi-calendar3 text-primary"></i> ${dLabel}
            </span>
            <span class="badge bg-secondary-subtle text-secondary rounded-pill px-2 py-0.5 fw-semibold" style="font-size: 11px;">
              ${courtNames.length} court${courtNames.length > 1 ? 's' : ''}
            </span>
          </div>
      `;

      courtNames.forEach((cName, cIdx) => {
        const items = courtMap[cName];
        const courtTotal = items.reduce((sum, i) => sum + i.rate, 0);
        items.sort((a, b) => a.startTime.localeCompare(b.startTime));

        const slotPills = items.map(item => `
          <span class="badge bg-white text-dark border px-2.5 py-1.5 rounded-3 fw-semibold d-inline-flex align-items-center gap-1 shadow-xs" style="font-size: 11px; border-color: #cbd5e1 !important;">
            <i class="bi bi-clock-history text-primary" style="font-size: 10px;"></i>
            ${item.startLabel} – ${item.endLabel}
          </span>
        `).join('');

        slotsDetailHtml += `
          <div class="${cIdx > 0 ? 'mt-2 pt-2 border-top border-light' : ''}">
            <div class="d-flex justify-content-between align-items-center mb-1.5">
              <div class="d-flex align-items-center gap-2">
                <span class="badge bg-warning text-dark rounded-pill px-2.5 py-0.5 fw-bold" style="font-size: 11px;">${cName}</span>
                <span class="text-secondary small fw-medium" style="font-size: 11.5px;">${items.length} hr${items.length > 1 ? 's' : ''}</span>
              </div>
              <span class="fw-bold text-dark font-monospace small">₱${courtTotal.toFixed(2)}</span>
            </div>
            <div class="d-flex flex-wrap gap-1">
              ${slotPills}
            </div>
          </div>
        `;
      });

      slotsDetailHtml += `</div>`;
    });

    // Populate Modal Summary
    const hoursEl = document.getElementById('modalSummaryHours');
    if (hoursEl) hoursEl.innerText = `${totalCount} Slot${totalCount > 1 ? 's' : ''}`;

    const dateEl = document.getElementById('modalSummaryDate');
    if (dateEl) {
      if (uniqueDates.length === 1) {
        const dObj = new Date(uniqueDates[0] + 'T00:00:00');
        dateEl.innerText = dObj.toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric' });
      } else {
        dateEl.innerText = `${uniqueDates.length} Dates Combined`;
      }
    }

    const slotsEl = document.getElementById('modalSummarySlots');
    if (slotsEl) slotsEl.innerHTML = slotsDetailHtml;

    const breakdownEl = document.getElementById('modalSummaryBreakdown');
    if (breakdownEl) {
      if (uniqueDates.length > 1) {
        breakdownEl.innerText = `${totalCount} hours total across ${uniqueDates.length} dates and ${uniqueCourts.length} courts`;
      } else if (uniqueCourts.length > 1) {
        breakdownEl.innerText = `${totalCount} hours total across ${uniqueCourts.length} courts`;
      } else {
        breakdownEl.innerText = `${totalCount} hour${totalCount > 1 ? 's' : ''} on ${uniqueCourts[0]}`;
      }
    }

    const totalEl = document.getElementById('modalSummaryTotal');
    if (totalEl) totalEl.innerText = `₱${totalPrice.toFixed(2)}`;

    // Populate Hidden Form Fields
    document.getElementById('formCourtId').value = selectedSlotItems[0].courtId;
    document.getElementById('formDate').value = selectedSlotItems[0].date || currentDate;
    document.getElementById('formStartTime').value = selectedSlotItems[0].startTime;
    document.getElementById('formTotalHours').value = totalCount;
    document.getElementById('formSelectedSlots').value = JSON.stringify(selectedSlotItems);

    // Ensure player profile fields and Signed-In Account Badge are populated
    const nameInput = document.getElementById('checkoutUserName');
    const phoneInput = document.getElementById('checkoutUserContact');
    const emailInput = document.getElementById('checkoutUserEmail');
    const signedInBox = document.getElementById('checkoutSignedInAccountBox');
    const manualFieldsWrap = document.getElementById('checkoutManualFieldsWrap');
    const displayAccName = document.getElementById('checkoutAccountDisplayName');
    const displayAccContact = document.getElementById('checkoutAccountDisplayContact');
    const submitErrBox = document.getElementById('checkoutSubmitErrorBox');
    if (submitErrBox) submitErrBox.classList.add('d-none');

    if (currentPlayerUser) {
      const fullName = currentPlayerUser.full_name || currentPlayerUser.username || '';
      const phone = currentPlayerUser.phone || '';
      const email = currentPlayerUser.email || '';

      if (nameInput) nameInput.value = fullName;
      if (phoneInput) phoneInput.value = phone;
      if (emailInput) emailInput.value = email;

      if (displayAccName) displayAccName.innerText = fullName;
      if (displayAccContact) displayAccContact.innerText = phone + (email ? ' · ' + email : '');

      if (signedInBox) signedInBox.classList.remove('d-none');
      if (manualFieldsWrap) {
        if (fullName && phone) {
          manualFieldsWrap.classList.add('d-none');
        } else {
          manualFieldsWrap.classList.remove('d-none');
        }
      }
    }

    const modalEl = document.getElementById('checkoutModal');
    const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
    modal.show();
  }

  // Seamless AJAX Reservation Submit (Prevents page-reload login redirects & preserves selected slots)
  async function handleMatrixReservationSubmit(e) {
    e.preventDefault();
    const submitBtn = document.getElementById('checkoutSubmitBtn');
    const errBox = document.getElementById('checkoutSubmitErrorBox');
    if (errBox) errBox.classList.add('d-none');

    const payload = {
      court_id: document.getElementById('formCourtId').value,
      reservation_date: document.getElementById('formDate').value,
      start_time: document.getElementById('formStartTime').value,
      total_hours: document.getElementById('formTotalHours').value,
      selected_slots: document.getElementById('formSelectedSlots').value,
      user_name: (document.getElementById('checkoutUserName')?.value || currentPlayerUser?.full_name || currentPlayerUser?.username || '').trim(),
      user_contact: (document.getElementById('checkoutUserContact')?.value || currentPlayerUser?.phone || '').trim(),
      user_email: (document.getElementById('checkoutUserEmail')?.value || currentPlayerUser?.email || '').trim(),
      special_requests: (document.getElementById('checkoutSpecialRequests')?.value || '').trim()
    };

    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Reserving Court Slot...';
    }

    try {
      const res = await fetch('/reservations', {
        method: 'POST',
        credentials: 'same-origin',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        body: JSON.stringify(payload)
      });

      const data = await res.json().catch(() => ({}));

      if (res.status === 401 || data.requiresAuth) {
        // Server session timed out — transition seamlessly to Sign In modal without losing selected slots!
        handleClientSessionLogout(false);
        const checkoutEl = document.getElementById('checkoutModal');
        if (checkoutEl) {
          const inst = bootstrap.Modal.getInstance(checkoutEl);
          if (inst) inst.hide();
        }
        openPlayerAuthModal('login', true);
        showLiveToast('🔒 Your session expired. Please sign in to continue your reservation.');
        return;
      }

      if (!res.ok || !data.success) {
        const msg = data.error || 'Could not complete reservation. Another player may have just taken this slot.';
        if (errBox) {
          errBox.innerText = msg;
          errBox.classList.remove('d-none');
        }
        fetchMatrixAvailability(currentDate, true);
        return;
      }

      const targetUrl = data.redirect_url || data.paymentUrl || (`/payment/gcash?ref=${encodeURIComponent(data.reference_number || data.referenceNumber)}`);
      window.location.href = targetUrl;
    } catch (err) {
      if (errBox) {
        errBox.innerText = 'Network error while reserving slot. Please try again.';
        errBox.classList.remove('d-none');
      }
    } finally {
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.innerHTML = '<i class="bi bi-qr-code-scan me-1"></i> Proceed to GCash Payment';
      }
    }
  }

  // =========================================================
  // PLAYER ACCOUNT MODAL & MY BOOKINGS DASHBOARD FUNCTIONS
  // =========================================================
  function openPlayerAuthModal(mode = 'login', fromCheckout = false) {
    pendingCheckoutAfterAuth = !!fromCheckout;
    switchPlayerAuthModalMode(mode);

    const noticeEl = document.getElementById('playerAuthCheckoutNotice');
    if (noticeEl) {
      if (fromCheckout) {
        noticeEl.classList.remove('d-none');
      } else {
        noticeEl.classList.add('d-none');
      }
    }

    const errBox = document.getElementById('playerAuthErrorBox');
    if (errBox) errBox.classList.add('d-none');

    const modalEl = document.getElementById('playerAuthModal');
    if (modalEl) {
      const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
      modal.show();
    }
  }

  function setAuthModalAlert(type, message) {
    const ids = { error: 'playerAuthErrorBox', success: 'playerAuthSuccessBox', mock: 'playerAuthMockOtpBox' };
    const el = document.getElementById(ids[type]);
    if (!el) return;
    if (message) {
      el.innerHTML = message;
      el.classList.remove('d-none');
    } else {
      el.classList.add('d-none');
      el.innerHTML = '';
    }
  }

  function clearAuthModalAlerts() {
    setAuthModalAlert('error', null);
    setAuthModalAlert('success', null);
    setAuthModalAlert('mock', null);
  }

  // Shows the OTP on-screen ONLY when SMTP isn't configured yet (dev/testing mode)
  function showMockOtpIfAny(data) {
    if (data && data.mocked_otp) {
      setAuthModalAlert('mock', `<i class="bi bi-info-circle-fill me-1"></i><strong>Test Mode:</strong> Email (SMTP) isn't configured yet, so here is your OTP: <span class="font-monospace fw-bold fs-6">${data.mocked_otp}</span>`);
    }
  }

  function switchPlayerAuthModalMode(mode) {
    const forms = {
      login: document.getElementById('modalPlayerLoginForm'),
      register: document.getElementById('modalPlayerRegisterForm'),
      verify: document.getElementById('modalPlayerVerifyOtpForm'),
      forgot: document.getElementById('modalPlayerForgotForm'),
      reset: document.getElementById('modalPlayerResetForm')
    };
    const titles = {
      login: 'Sign In to Player Account',
      register: 'Create Player Account',
      verify: 'Verify Your Email',
      forgot: 'Recover Your Password',
      reset: 'Set a New Password'
    };
    const tabLogin = document.getElementById('modalAuthTabLogin');
    const tabReg = document.getElementById('modalAuthTabRegister');
    const titleEl = document.getElementById('playerAuthModalTitle');
    clearAuthModalAlerts();

    if (!forms[mode]) mode = 'login';
    Object.keys(forms).forEach(key => {
      if (forms[key]) forms[key].classList.toggle('d-none', key !== mode);
    });

    const activeCls = 'flex-fill btn rounded-0 py-2.5 fw-bold small border-0 bg-white text-primary border-bottom border-2 border-primary';
    const inactiveCls = 'flex-fill btn rounded-0 py-2.5 fw-bold small border-0 text-secondary';
    if (tabReg) tabReg.className = mode === 'register' ? activeCls : inactiveCls;
    if (tabLogin) tabLogin.className = (mode === 'login' || mode === 'forgot' || mode === 'reset') ? activeCls : inactiveCls;
    if (titleEl) titleEl.innerText = titles[mode];
  }

  function goToVerifyOtpStep(data) {
    switchPlayerAuthModalMode('verify');
    const emailInput = document.getElementById('modalVerifyEmailInput');
    const userIdInput = document.getElementById('modalVerifyUserId');
    const otpInput = document.getElementById('modalVerifyOtpCode');
    if (userIdInput) userIdInput.value = data.user_id || '';
    if (emailInput) {
      emailInput.value = data.email || '';
      emailInput.readOnly = !!data.email;
    }
    if (otpInput) otpInput.value = '';

    if (data.requires_email_input) {
      setAuthModalAlert('success', 'Please enter your email address, then tap <strong>Resend OTP Code</strong> to receive your verification code.');
    } else {
      setAuthModalAlert('success', data.message || 'We sent a 6-digit OTP to your email.');
      showMockOtpIfAny(data);
      if (otpInput) setTimeout(() => otpInput.focus(), 150);
    }
  }

  async function handleModalPlayerLogin(e) {
    e.preventDefault();
    const identifier = document.getElementById('modalLoginIdentifier').value.trim();
    const password = document.getElementById('modalLoginPassword').value;
    const btn = document.getElementById('modalLoginSubmitBtn');
    const errBox = document.getElementById('playerAuthErrorBox');

    if (errBox) errBox.classList.add('d-none');
    if (btn) {
      btn.disabled = true;
      btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Signing in...';
    }

    try {
      const res = await fetch('/account/login', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        body: JSON.stringify({ identifier, password })
      });
      const data = await res.json();
      if (data && data.requires_verification) {
        goToVerifyOtpStep(data);
        return;
      }
      if (!res.ok || !data.success) {
        if (errBox) {
          errBox.innerText = (data && data.error) || 'Sign in failed. Please check your credentials.';
          errBox.classList.remove('d-none');
        }
        return;
      }

      onPlayerAuthenticatedSuccess(data.user, data.message);
    } catch (err) {
      if (errBox) {
        errBox.innerText = 'Network error. Please try again.';
        errBox.classList.remove('d-none');
      }
    } finally {
      if (btn) {
        btn.disabled = false;
        btn.innerHTML = '<i class="bi bi-box-arrow-in-right me-1"></i> Sign In &amp; Continue';
      }
    }
  }

  async function handleModalPlayerRegister(e) {
    e.preventDefault();
    const full_name = document.getElementById('modalRegFullName').value.trim();
    const phone = document.getElementById('modalRegPhone').value.trim();
    const email = document.getElementById('modalRegEmail').value.trim();
    const password = document.getElementById('modalRegPassword').value;
    const confirm_password = document.getElementById('modalRegConfirm').value;
    const btn = document.getElementById('modalRegisterSubmitBtn');
    const errBox = document.getElementById('playerAuthErrorBox');

    if (errBox) errBox.classList.add('d-none');
    if (btn) {
      btn.disabled = true;
      btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Creating account...';
    }

    try {
      const res = await fetch('/account/register', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        body: JSON.stringify({ full_name, phone, email, password, confirm_password })
      });
      let data = {};
      try {
        data = await res.json();
      } catch (jsonErr) {
        data = { error: 'Server response error. Please try again.' };
      }

      if (!res.ok || !data.success) {
        const errorText = (data && data.error) || 'Could not create account. Please verify your details.';
        setAuthModalAlert('error', errorText);
        return;
      }

      if (data.requires_verification) {
        goToVerifyOtpStep(data);
        return;
      }

      onPlayerAuthenticatedSuccess(data.user, data.message);
    } catch (err) {
      console.error('[Register Error]:', err);
      setAuthModalAlert('error', 'Network error or server connection failed. Please try again.');
    } finally {
      if (btn) {
        btn.disabled = false;
        btn.innerHTML = '<i class="bi bi-envelope-check-fill me-1"></i> Send Email OTP &amp; Create Account';
      }
    }
  }

  async function postAuthJson(url, payload) {
    const res = await fetch(url, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify(payload)
    });
    let data = {};
    try { data = await res.json(); } catch (e) { /* non-JSON response */ }
    return { ok: res.ok, data };
  }

  function setBtnLoading(btn, loading, loadingText, idleHtml) {
    if (!btn) return;
    btn.disabled = loading;
    btn.innerHTML = loading ? `<span class="spinner-border spinner-border-sm me-2"></span>${loadingText}` : idleHtml;
  }

  async function handleModalVerifyEmailOtp(e) {
    e.preventDefault();
    const email = document.getElementById('modalVerifyEmailInput').value.trim();
    const user_id = document.getElementById('modalVerifyUserId').value;
    const otp_code = document.getElementById('modalVerifyOtpCode').value.trim();
    const btn = document.getElementById('modalVerifyOtpSubmitBtn');
    const idle = '<i class="bi bi-check2-circle me-1"></i> Verify Email &amp; Sign In';

    setAuthModalAlert('error', null);
    setBtnLoading(btn, true, 'Verifying...', idle);
    try {
      const { ok, data } = await postAuthJson('/account/verify-otp', { email, user_id, otp_code });
      if (!ok || !data.success) {
        setAuthModalAlert('error', (data && data.error) || 'Invalid OTP. Please try again.');
        return;
      }
      clearAuthModalAlerts();
      onPlayerAuthenticatedSuccess(data.user, data.message);
    } catch (err) {
      setAuthModalAlert('error', 'Network error. Please try again.');
    } finally {
      setBtnLoading(btn, false, '', idle);
    }
  }

  async function handleModalResendOtp(purpose) {
    const isReset = purpose === 'RESET_PASSWORD';
    const email = isReset
      ? document.getElementById('modalResetEmailHidden').value.trim()
      : document.getElementById('modalVerifyEmailInput').value.trim();
    const user_id = isReset ? '' : document.getElementById('modalVerifyUserId').value;

    if (!email) {
      setAuthModalAlert('error', 'Please enter your email address first.');
      return;
    }

    setAuthModalAlert('error', null);
    setAuthModalAlert('mock', null);
    try {
      const { ok, data } = await postAuthJson('/account/resend-otp', { email, user_id, purpose });
      if (!ok || !data.success) {
        setAuthModalAlert('error', (data && data.error) || 'Could not resend OTP. Please try again.');
        return;
      }
      if (!isReset) {
        const emailInput = document.getElementById('modalVerifyEmailInput');
        if (emailInput) emailInput.readOnly = true;
        if (data.user_id) document.getElementById('modalVerifyUserId').value = data.user_id;
      }
      setAuthModalAlert('success', data.message || 'A new OTP has been sent.');
      showMockOtpIfAny(data);
    } catch (err) {
      setAuthModalAlert('error', 'Network error. Please try again.');
    }
  }

  async function handleModalForgotPasswordRequest(e) {
    e.preventDefault();
    const identifier = document.getElementById('modalForgotIdentifier').value.trim();
    const btn = document.getElementById('modalForgotSubmitBtn');
    const idle = '<i class="bi bi-send-check-fill me-1"></i> Send Recovery OTP';

    setAuthModalAlert('error', null);
    setBtnLoading(btn, true, 'Sending code...', idle);
    try {
      const { ok, data } = await postAuthJson('/account/forgot-password', { identifier });
      if (!ok || !data.success) {
        setAuthModalAlert('error', (data && data.error) || 'Could not send recovery code.');
        return;
      }
      switchPlayerAuthModalMode('reset');
      document.getElementById('modalResetEmailHidden').value = data.email || '';
      document.getElementById('modalResetEmailDisplay').innerText = data.masked_email || data.email || 'your email';
      document.getElementById('modalResetOtpCode').value = '';
      document.getElementById('modalResetNewPassword').value = '';
      document.getElementById('modalResetConfirmPassword').value = '';
      setAuthModalAlert('success', data.message || 'Recovery code sent.');
      showMockOtpIfAny(data);
      setTimeout(() => document.getElementById('modalResetOtpCode').focus(), 150);
    } catch (err) {
      setAuthModalAlert('error', 'Network error. Please try again.');
    } finally {
      setBtnLoading(btn, false, '', idle);
    }
  }

  async function handleModalResetPasswordSubmit(e) {
    e.preventDefault();
    const email = document.getElementById('modalResetEmailHidden').value.trim();
    const otp_code = document.getElementById('modalResetOtpCode').value.trim();
    const new_password = document.getElementById('modalResetNewPassword').value;
    const confirm_password = document.getElementById('modalResetConfirmPassword').value;
    const btn = document.getElementById('modalResetSubmitBtn');
    const idle = '<i class="bi bi-check2-all me-1"></i> Reset Password &amp; Sign In';

    setAuthModalAlert('error', null);
    if (new_password !== confirm_password) {
      setAuthModalAlert('error', 'New passwords do not match.');
      return;
    }

    setBtnLoading(btn, true, 'Updating password...', idle);
    try {
      const { ok, data } = await postAuthJson('/account/reset-password', { email, otp_code, new_password, confirm_password });
      if (!ok || !data.success) {
        setAuthModalAlert('error', (data && data.error) || 'Could not reset password.');
        return;
      }
      clearAuthModalAlerts();
      onPlayerAuthenticatedSuccess(data.user, data.message);
    } catch (err) {
      setAuthModalAlert('error', 'Network error. Please try again.');
    } finally {
      setBtnLoading(btn, false, '', idle);
    }
  }

  function onPlayerAuthenticatedSuccess(userObj, welcomeMessage) {
    currentPlayerUser = userObj;
    applyAuthenticatedUserToUI(userObj);
    refreshMyBookings();
    fetchAccountChat(false);
    fetchMatrixAvailability(currentDate);

    // Hide Auth Modal
    const authModalEl = document.getElementById('playerAuthModal');
    if (authModalEl) {
      const modalInstance = bootstrap.Modal.getInstance(authModalEl);
      if (modalInstance) modalInstance.hide();
    }

    if (welcomeMessage) {
      showLiveToast(welcomeMessage);
    }

    // If user clicked a court slot while signed out, automatically select that slot now that they are signed in
    if (pendingSlotAfterAuth && pendingSlotAfterAuth.court && pendingSlotAfterAuth.slot) {
      const slotToSelect = pendingSlotAfterAuth;
      pendingSlotAfterAuth = null;
      pendingCheckoutAfterAuth = false;
      handleSlotClick(slotToSelect.court, slotToSelect.slot);
      return;
    }

    // If user clicked "Continue to Booking", immediately open Checkout Modal with pre-filled details!
    if (pendingCheckoutAfterAuth && selectedSlotItems && selectedSlotItems.length > 0) {
      pendingCheckoutAfterAuth = false;
      setTimeout(() => {
        openCheckoutModal();
      }, 220);
    }
  }

  function applyAuthenticatedUserToUI(userObj) {
    if (!userObj) return;
    const displayName = userObj.full_name || userObj.username || 'Player';

    // Show floating Account Chat button on desktop when logged in
    const fabWrap = document.getElementById('accountChatFabWrap');
    if (fabWrap) fabWrap.classList.add('d-md-block');

    // Update Mobile Bottom Nav Account button
    const mobAccIcon = document.getElementById('mobileNavAccountIcon');
    const mobAccLabel = document.getElementById('mobileNavAccountLabel');
    if (mobAccIcon) mobAccIcon.className = 'bi bi-person-check-fill';
    if (mobAccLabel) mobAccLabel.innerText = 'Account';

    // 1. Update top right header controls (1-line dynamic action pills with visible labels)
    const headerControls = document.getElementById('headerAccountControls');
    if (headerControls) {
      const adminBtn = (userObj.role === 'admin' || userObj.role === 'staff')
        ? `<a href="/admin" class="btn btn-outline-dark dynamic-action-pill" title="Admin Panel"><i class="bi bi-speedometer2"></i><span class="dynamic-pill-label">Admin</span></a>`
        : '';
      headerControls.innerHTML = `
        <button type="button" class="btn btn-dark dynamic-action-pill" onclick="switchVenueTab('my-bookings')" title="${displayName} (My Bookings)">
          <i class="bi bi-person-check-fill text-warning"></i>
          <span class="dynamic-pill-label dynamic-pill-user">${(displayName || 'Player').split(' ')[0]}</span>
        </button>
        ${adminBtn}
        <a href="/account/logout" class="btn btn-outline-danger dynamic-action-pill" title="Sign Out">
          <i class="bi bi-box-arrow-right"></i>
          <span class="dynamic-pill-label">Sign Out</span>
        </a>
      `;
    }

    // 2. Pre-fill Checkout Modal inputs
    const nameInput = document.getElementById('checkoutUserName');
    const phoneInput = document.getElementById('checkoutUserContact');
    const emailInput = document.getElementById('checkoutUserEmail');
    if (nameInput) nameInput.value = displayName;
    if (phoneInput) phoneInput.value = userObj.phone || '';
    if (emailInput) emailInput.value = userObj.email || '';

    // 3. Toggle My Bookings tab guest vs authenticated view
    const guestCard = document.getElementById('myBookingsGuestCard');
    const userDash = document.getElementById('myBookingsUserDashboard');
    if (guestCard) guestCard.classList.add('d-none');
    if (userDash) userDash.classList.remove('d-none');

    const dName = document.getElementById('dashboardPlayerName');
    const dPhone = document.getElementById('dashboardPlayerPhone');
    const dEmail = document.getElementById('dashboardPlayerEmail');
    const dAvatar = document.getElementById('dashboardPlayerAvatar');
    if (dName) dName.innerText = displayName;
    if (dAvatar) {
      const parts = displayName.trim().split(/\s+/).filter(Boolean);
      dAvatar.innerText = parts.length > 1 ? (parts[0][0] + parts[parts.length - 1][0]).toUpperCase() : displayName.slice(0, 2).toUpperCase();
    }
    if (dPhone) dPhone.innerHTML = `<i class="bi bi-phone text-warning me-1"></i>${userObj.phone || '—'}`;
    if (dEmail) {
      if (userObj.email) {
        dEmail.innerHTML = `<i class="bi bi-envelope text-info me-1"></i>${userObj.email}`;
        dEmail.classList.remove('d-none');
      } else {
        dEmail.classList.add('d-none');
      }
    }

    // 4. Update Individual Account Messenger Alerts status & modal
    const isMessengerConnected = !!userObj.fb_psid;
    const dMessengerBadge = document.getElementById('dashboardMessengerBadge');
    const dMessengerBtn = document.getElementById('dashboardMessengerBtn');
    const dMessengerBtnText = document.getElementById('dashboardMessengerBtnText');
    if (dMessengerBadge) {
      dMessengerBadge.className = `badge ${isMessengerConnected ? 'bg-success-subtle text-success border border-success' : 'bg-secondary bg-opacity-25 text-white-50 border border-secondary border-opacity-50'} rounded-pill px-2.5 py-1 small fw-semibold`;
      dMessengerBadge.innerHTML = `<i class="bi bi-messenger me-1"></i>${isMessengerConnected ? 'Messenger Active' : 'Messenger Not Linked'}`;
    }
    if (dMessengerBtn) {
      dMessengerBtn.className = `btn ${isMessengerConnected ? 'btn-outline-light' : 'btn-primary'} btn-sm rounded-pill px-3.5 py-2 fw-bold d-inline-flex align-items-center justify-content-center gap-1.5 shadow-sm flex-grow-1`;
    }
    if (dMessengerBtnText) {
      dMessengerBtnText.innerText = isMessengerConnected ? 'Messenger Active' : 'Connect Messenger';
    }

    const modalCodeEl = document.getElementById('messengerModalBindingCode');
    const modalPhoneEl = document.getElementById('messengerModalPhone');
    const modalStatusWrap = document.getElementById('messengerModalStatusWrap');
    if (modalCodeEl && userObj.binding_code) {
      modalCodeEl.innerText = userObj.binding_code;
    }
    if (modalPhoneEl) {
      modalPhoneEl.innerText = userObj.phone || '';
    }
    if (modalStatusWrap) {
      modalStatusWrap.innerHTML = isMessengerConnected
        ? `<span class="badge bg-success-subtle text-success border border-success px-3 py-1.5 rounded-pill fw-bold" id="messengerModalStatusBadge"><i class="bi bi-check-circle-fill me-1"></i> Messenger Connected to Your Account</span>`
        : `<span class="badge bg-warning-subtle text-dark border border-warning px-3 py-1.5 rounded-pill fw-bold" id="messengerModalStatusBadge"><i class="bi bi-dot me-1"></i> Not Linked Yet — Follow Step Below</span>`;
    }
  }

  async function refreshMyBookings() {
    if (!currentPlayerUser) return;
    try {
      const res = await fetch('/api/my-bookings', {
        headers: { 'Accept': 'application/json' }
      });
      if (res.ok) {
        const data = await res.json();
        if (data && data.loggedIn === false) {
          handleClientSessionLogout(true);
          return;
        }
        if (data.success) {
          if (data.user) {
            currentPlayerUser = data.user;
            applyAuthenticatedUserToUI(currentPlayerUser);
          }
          if (Array.isArray(data.bookings)) {
            myBookingsData = data.bookings;
            renderMyBookingsList();
          }
        }
      }
    } catch (e) {
      console.warn('Could not refresh bookings:', e);
    }
  }

  function renderMyBookingsList() {
    const container = document.getElementById('myBookingsListContainer');
    const badgeEl = document.getElementById('myBookingsTabBadge');
    const mobileBookingsBadgeEl = document.getElementById('mobileNavBookingsBadge');

    [badgeEl, mobileBookingsBadgeEl].forEach(el => {
      if (!el) return;
      if (myBookingsData && myBookingsData.length > 0) {
        el.innerText = myBookingsData.length;
        el.classList.remove('d-none');
      } else {
        el.classList.add('d-none');
      }
    });

    if (!container) return;

    if (!myBookingsData || myBookingsData.length === 0) {
      container.innerHTML = `
        <div class="card border-0 shadow-sm rounded-4 p-5 bg-white text-center">
          <div class="badge bg-light text-secondary rounded-circle p-3 mb-3 fs-3 d-inline-flex align-items-center justify-content-center mx-auto" style="width: 60px; height: 60px;">
            <i class="bi bi-calendar2-x"></i>
          </div>
