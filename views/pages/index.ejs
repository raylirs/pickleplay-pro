        <!-- Itemized Court & Slot Breakdown Table -->
        <div class="mb-3">
          <div class="text-uppercase fw-bold text-secondary mb-1" style="font-size: 10.5px; letter-spacing: 0.05em;">Itemized Court Schedule &amp; Rates</div>
          <div class="table-responsive">
            <table class="table table-sm mb-0">
