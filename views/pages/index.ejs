<% 
  const defaultRate = (courts && courts.length > 0 && courts[0].category) ? parseFloat(courts[0].category.price_per_hour) : 350;
  const totalCourtsCount = courts ? courts.length : 4;
%>

<!-- =========================================================
     VENUE BRAND HEADER & QUICK STATS (Courtogo Architecture)
========================================================= -->
<section class="venue-header-banner py-4 py-md-4">
  <div class="container max-w-6xl">
    <div class="d-flex flex-column flex-lg-row align-items-start align-items-lg-center justify-content-between gap-3">
      <!-- Venue Identity Left -->
      <div class="d-flex align-items-center gap-3">
        <div class="venue-avatar-wrap">
          <img src="/images/the-playground-logo.jpg" alt="The Playground Pickleball" class="venue-avatar-img">
        </div>
        <div>
          <div class="d-flex align-items-center gap-2 flex-wrap">
            <h1 class="display-6 fw-bold mb-0 text-dark font-display" style="letter-spacing: -0.02em;">
              The Playground Pickleball
            </h1>
          </div>
          <p class="text-secondary small mb-0 mt-1 d-flex align-items-center gap-1">
            <i class="bi bi-geo-alt-fill text-warning"></i>
            <span class="fw-semibold text-dark">Camaman-an, Cagayan de Oro City</span>
            <span class="text-muted d-none d-sm-inline">· Piot Heights Compound</span>
          </p>
        </div>
      </div>

      <!-- 3-Item Quick Stat Bar Beside Header (Right) -->
      <div class="stat-pill-group ms-lg-auto mt-2 mt-lg-0">
        <div class="stat-pill-cell">
          <div class="stat-pill-label">
            <i class="bi bi-coin text-warning"></i> Hourly Rate
          </div>
          <div class="stat-pill-value">
            <%= formatCurrency(defaultRate) %><span class="text-muted fs-6 fw-normal">/hr</span>
          </div>
        </div>

        <div class="stat-pill-cell">
          <div class="stat-pill-label">
            <i class="bi bi-trophy-fill text-primary"></i> Courts
          </div>
          <div class="stat-pill-value">
            <%= totalCourtsCount %> Covered
          </div>
        </div>

        <div class="stat-pill-cell">
          <div class="stat-pill-label">
            <i class="bi bi-clock-fill text-success"></i> Operating Hours
          </div>
          <div class="stat-pill-value">
            <span class="d-none d-sm-inline">6AM – 12 Midnight</span>
            <span class="d-inline d-sm-none">6AM – 12MN</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- =========================================================
     TAB NAVIGATION BAR (Desktop Underline Tabs + Mobile 1-Line Status Bar)
========================================================= -->
<div class="bg-white border-bottom venue-tabs-container">
  <style>
    .venue-action-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      padding: 8px 0;
      width: 100%;
      flex-wrap: nowrap;
      overflow-x: auto;
      scrollbar-width: none;
      -ms-overflow-style: none;
    }
    .venue-action-row::-webkit-scrollbar {
      display: none;
    }
    .venue-action-group {
      display: flex;
      align-items: center;
      gap: clamp(5px, 1.4vw, 10px);
      flex-wrap: nowrap;
      width: 100%;
      justify-content: flex-end;
    }
    .dynamic-action-pill {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: clamp(4px, 1vw, 7px);
      height: clamp(32px, 7.5vw, 36px);
      padding: 0 clamp(9px, 2.2vw, 16px);
      border-radius: 999px;
      font-size: clamp(11px, 2.6vw, 13px);
      font-weight: 700;
      line-height: 1;
      white-space: nowrap;
      text-decoration: none;
      transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
      flex: 0 1 auto;
      min-width: 0;
      box-shadow: 0 2px 6px rgba(11, 37, 69, 0.06);
    }
    .dynamic-action-pill i {
      font-size: clamp(12.5px, 3vw, 14.5px);
      line-height: 1;
      flex-shrink: 0;
    }
    .dynamic-action-pill .dynamic-pill-label {
      display: inline-block;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      line-height: 1.15;
    }
    .dynamic-action-pill .dynamic-pill-user {
      max-width: clamp(80px, 22vw, 180px);
    }
    .dynamic-action-pill:hover {
      transform: translateY(-1px);
      box-shadow: 0 5px 14px rgba(11, 37, 69, 0.14);
    }
    @media (max-width: 767.98px) {
      .venue-action-group {
        width: 100%;
        justify-content: stretch;
      }
      #headerAccountControls {
        width: 100%;
        display: flex;
        gap: 8px;
      }
      .dynamic-action-pill {
        flex: 1 1 0;
        height: 38px;
        font-size: 13px;
        padding: 0 14px;
        justify-content: center;
      }
    }
  </style>
  <div class="container max-w-6xl">
    <!-- ROW 1: Desktop Navigation Tabs -->
    <div class="courtogo-tabs-bar d-none d-md-flex border-bottom" role="tablist">
      <button class="courtogo-tab-btn active" id="tab-btn-book" onclick="switchVenueTab('book')">
        <i class="bi bi-calendar2-check-fill text-warning"></i>
        <span>Book Court</span>
      </button>

      <button class="courtogo-tab-btn" id="tab-btn-my-bookings" onclick="switchVenueTab('my-bookings')">
        <i class="bi bi-ticket-perforated-fill text-primary"></i>
        <span>My Bookings</span>
        <span class="courtogo-tab-badge <%= (typeof myBookings !== 'undefined' && myBookings.length > 0) ? '' : 'd-none' %>" id="myBookingsTabBadge">
          <%= typeof myBookings !== 'undefined' ? myBookings.length : 0 %>
        </span>
      </button>

      <button class="courtogo-tab-btn" id="tab-btn-photos" onclick="switchVenueTab('photos')">
        <i class="bi bi-images"></i>
        <span>Photos</span>
        <span class="courtogo-tab-badge">2</span>
      </button>

      <button class="courtogo-tab-btn" id="tab-btn-location" onclick="switchVenueTab('location')">
        <i class="bi bi-geo-alt-fill text-danger"></i>
        <span>Location & Map</span>
      </button>

      <button class="courtogo-tab-btn" id="tab-btn-lookup" onclick="switchVenueTab('lookup')">
        <i class="bi bi-search"></i>
        <span>Find Booking</span>
      </button>
    </div>

    <!-- ROW 2: Dedicated 1-Line Dynamic Action Row (Web & Mobile — All Icons + Text Visible) -->
    <div class="venue-action-row">
      <div class="d-none d-md-inline-flex align-items-center gap-2 text-secondary small fw-semibold flex-shrink-0">
        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2.5 py-1 fw-bold" style="font-size: 11px;">
          <i class="bi bi-circle-fill me-1" style="font-size: 7px; vertical-align: middle;"></i>Open Today · 6AM – 12MN
        </span>
      </div>

      <div class="venue-action-group">
        <div id="headerAccountControls" class="d-inline-flex align-items-center gap-1.5 flex-grow-1 flex-md-grow-0 min-w-0">
          <% if (typeof user !== 'undefined' && user) { %>
            <button type="button" class="btn btn-dark dynamic-action-pill" onclick="switchVenueTab('my-bookings')" title="<%= user.full_name || user.username %> (My Bookings)">
              <i class="bi bi-person-check-fill text-warning"></i>
              <span class="dynamic-pill-label dynamic-pill-user"><%= (user.full_name || user.username).split(' ')[0] %></span>
            </button>
            <% if (user.role === 'admin' || user.role === 'staff') { %>
              <a href="/admin" class="btn btn-outline-dark dynamic-action-pill" title="Admin Panel">
                <i class="bi bi-speedometer2"></i>
                <span class="dynamic-pill-label">Admin</span>
              </a>
            <% } %>
            <a href="/account/logout" class="btn btn-outline-danger dynamic-action-pill" title="Sign Out">
              <i class="bi bi-box-arrow-right"></i>
              <span class="dynamic-pill-label">Sign Out</span>
            </a>
          <% } else { %>
            <button type="button" class="btn btn-outline-dark dynamic-action-pill" onclick="openPlayerAuthModal('login', false)" title="Sign In">
              <i class="bi bi-box-arrow-in-right"></i>
              <span class="dynamic-pill-label">Sign In</span>
            </button>
            <button type="button" class="btn btn-book-now-gold dynamic-action-pill" onclick="openPlayerAuthModal('register', false)" title="Sign Up">
              <i class="bi bi-person-plus-fill"></i>
              <span class="dynamic-pill-label">Sign Up</span>
            </button>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- =========================================================
     TAB CONTENT SECTIONS
========================================================= -->
<div class="container max-w-6xl py-4 py-md-5">

  <!-- =========================================================
       TAB 1: BOOK COURT (Interactive Schedule Matrix)
  ========================================================= -->
  <div id="tab-content-book" class="venue-tab-pane">
    <!-- Unpaid Reservation Notice Banner (Auto-detected if player closed or reloaded during GCash payment) -->
    <div id="unpaidReservationBanner" class="alert alert-warning border-warning shadow-sm rounded-4 p-3 d-none align-items-center justify-content-between mb-3" style="background: #fffbeb; border: 1.5px solid #fde047 !important;">
      <div class="d-flex align-items-center gap-3">
        <span class="badge bg-warning text-dark rounded-circle p-2 fs-6 d-inline-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
          <i class="bi bi-clock-history"></i>
        </span>
        <div>
          <div class="d-flex align-items-center gap-2">
            <strong class="text-dark">You have an unpaid reservation in progress:</strong>
            <span class="badge bg-dark font-monospace text-warning px-2.5 py-1" id="unpaidBannerRef">PKL-XXXXXX</span>
          </div>
          <span class="text-secondary small d-block mt-0.5">Court slots are held for 15 minutes. Click to resume GCash payment.</span>
        </div>
      </div>
      <div class="d-flex align-items-center gap-2 mt-2 mt-sm-0">
        <a id="unpaidBannerLink" href="#" class="btn btn-book-now-gold btn-sm rounded-pill px-3 py-1.5 fw-bold shadow-sm">
          <i class="bi bi-qr-code-scan me-1"></i> Resume GCash Payment &rarr;
        </a>
        <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-2.5 py-1" onclick="dismissUnpaidBanner()" title="Dismiss">
          &times;
        </button>
      </div>
    </div>

    <!-- =========================================================
         STEP 1: CURRENT MONTH CALENDAR VIEW (Shown First)
    ========================================================= -->
    <style>
      html, body {
        max-width: 100%;
        overflow-x: hidden;
      }
      .month-calendar-card {
        background: #ffffff;
        border-radius: 20px;
        border: 1px solid rgba(11, 37, 69, 0.12);
        box-shadow: 0 12px 32px rgba(11, 37, 69, 0.08);
        overflow: hidden;
        width: 100%;
        max-width: 100%;
      }
      .month-calendar-header {
        background: linear-gradient(135deg, #0B2545 0%, #134074 100%);
        color: #ffffff;
        padding: 18px 24px;
        border-bottom: 2px solid #D4AF37;
      }
      .month-calendar-weekdays {
        display: grid;
        grid-template-columns: repeat(7, minmax(0, 1fr));
        background: #F8FAFC;
        border-bottom: 1px solid #E2E8F0;
        text-align: center;
        padding: 10px 8px;
        font-size: 11.5px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: #0B2545;
      }
      .month-calendar-grid {
        display: grid;
        grid-template-columns: repeat(7, minmax(0, 1fr));
        gap: 8px;
        padding: 16px;
        background: #ffffff;
        width: 100%;
        box-sizing: border-box;
      }
      .calendar-day-cell {
        min-width: 0;
        min-height: 76px;
        border-radius: 14px;
        border: 1.5px solid #E2E8F0;
        background: #ffffff;
        padding: 8px 10px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        align-items: flex-start;
        cursor: pointer;
        transition: all 0.18s ease;
        position: relative;
        user-select: none;
        text-align: left;
        overflow: hidden;
        box-sizing: border-box;
      }
      .calendar-day-cell:hover:not(.is-disabled):not(.is-empty) {
        border-color: #0284C7;
        background: #F0F9FF;
        transform: translateY(-2px);
        box-shadow: 0 6px 16px rgba(2, 132, 199, 0.14);
      }
      .calendar-day-cell.is-today {
        border-color: #D4AF37;
        background: #FFFBEB;
      }
      .calendar-day-cell.is-selected {
        background: linear-gradient(135deg, #0B2545 0%, #134074 100%) !important;
        border-color: #D4AF37 !important;
        color: #ffffff !important;
        box-shadow: 0 8px 20px rgba(11, 37, 69, 0.25);
      }
      .calendar-day-cell.is-fully-booked {
        background: #FFF1F2;
        border-color: #FECDD3;
      }
      .calendar-day-cell.is-fully-booked:hover {
        border-color: #F43F5E;
        background: #FFE4E6;
        box-shadow: 0 4px 12px rgba(244, 63, 94, 0.15);
      }
      .calendar-day-cell.is-fully-booked .calendar-day-number {
        color: #BE123C;
      }
      .calendar-day-cell.is-closed-day {
        background: #F1F5F9;
        border-color: #CBD5E1;
      }
      .calendar-day-cell.has-player-booking {
        border: 2px solid #2563EB !important;
        background: #EFF6FF;
      }
      .calendar-day-cell.has-player-booking.is-today {
        border: 2px solid #D4AF37 !important;
        background: #FEFCE8;
      }
      .calendar-day-cell.has-player-booking.is-selected {
        background: linear-gradient(135deg, #0B2545 0%, #134074 100%) !important;
        border-color: #D4AF37 !important;
      }
      .calendar-day-badge.badge-player-booked {
        background: #2563EB !important;
        color: #FFFFFF !important;
        box-shadow: 0 2px 4px rgba(37, 99, 235, 0.25);
      }
      .calendar-day-cell.is-disabled {
        background: #F8FAFC;
        border-color: #F1F5F9;
        color: #CBD5E1;
        cursor: not-allowed;
        opacity: 0.65;
      }
      .calendar-day-cell.is-empty {
        background: transparent;
        border-color: transparent;
        cursor: default;
        pointer-events: none;
      }
      .calendar-day-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        width: 100%;
        gap: 2px;
      }
      .calendar-day-number {
        font-size: 17px;
        font-weight: 800;
        color: #0B2545;
        line-height: 1.1;
      }
      .calendar-day-cell.is-selected .calendar-day-number {
        color: #FDE047;
      }
      .calendar-day-cell.is-disabled .calendar-day-number {
        color: #94A3B8;
      }
      .calendar-day-badge {
        font-size: 9px;
        padding: 2px 5px;
        border-radius: 999px;
        font-weight: 800;
        line-height: 1;
        white-space: nowrap;
      }
      .calendar-day-cta {
        font-size: 10.5px;
        font-weight: 700;
        color: #0284C7;
        display: inline-flex;
        align-items: center;
        gap: 2px;
        white-space: nowrap;
        max-width: 100%;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .calendar-day-cta-mobile {
        display: none;
      }
      .calendar-day-cell.is-selected .calendar-day-cta {
        color: #ffffff;
      }
      .calendar-day-cell.is-disabled .calendar-day-cta {
        color: #CBD5E1;
        font-weight: 500;
      }
      @media (max-width: 767.98px) {
        .month-calendar-header {
          padding: 12px 14px;
        }
        .month-calendar-weekdays {
          padding: 8px 4px;
          font-size: 10px;
          letter-spacing: 0.02em;
        }
        .month-calendar-grid {
          gap: 4px;
          padding: 8px 6px;
        }
        .calendar-day-cell {
          min-height: 54px;
          padding: 5px 3px;
          border-radius: 10px;
          align-items: center;
          justify-content: center;
          text-align: center;
          gap: 2px;
        }
        .calendar-day-top {
          flex-direction: column;
          align-items: center;
          justify-content: center;
          gap: 2px;
        }
        .calendar-day-number {
          font-size: 14px;
        }
        .calendar-day-badge {
          font-size: 7px;
          padding: 1.5px 4px;
        }
        .calendar-day-cta-desktop {
          display: none !important;
        }
        .calendar-day-cta-mobile {
          display: inline-block;
          font-size: 8.5px;
          line-height: 1.1;
        }
      }
    </style>
    <div id="bookingMonthCalendarCard" class="month-calendar-card mb-3">
      <div class="month-calendar-header d-flex align-items-center justify-content-between gap-2">
        <div class="min-w-0">
          <span class="badge bg-warning text-dark rounded-pill px-2.5 py-1 fw-bold mb-1 d-none d-sm-inline-block" style="font-size: 10.5px; letter-spacing: 0.04em;">
            <i class="bi bi-calendar-month me-1"></i>STEP 1 OF 2 · SELECT A PLAY DATE
          </span>
          <h4 class="fw-extrabold font-display text-white mb-0" id="calendarMonthYearTitle">Loading Month...</h4>
          <span class="text-white-50 small d-none d-sm-block" style="font-size: 12px;">Tap any available date below to view court time slots</span>
        </div>

        <div class="d-flex align-items-center gap-1.5 flex-shrink-0">
          <button type="button" class="btn btn-sm btn-outline-light rounded-pill px-2.5 py-1 fw-bold" id="btnPrevMonth" onclick="changeCalendarMonth(-1)" title="Previous Month">
            <i class="bi bi-chevron-left"></i>
          </button>
          <button type="button" class="btn btn-sm btn-warning text-dark rounded-pill px-3 py-1 fw-bold" onclick="jumpCalendarToToday()">
            Today
          </button>
          <button type="button" class="btn btn-sm btn-outline-light rounded-pill px-2.5 py-1 fw-bold" id="btnNextMonth" onclick="changeCalendarMonth(1)" title="Next Month">
            <i class="bi bi-chevron-right"></i>
          </button>
          <button type="button" id="btnReturnToTimeSlots" class="btn btn-sm btn-light text-dark rounded-pill px-3 py-1 fw-bold ms-1" onclick="scrollToTimeSlots()" title="Scroll down to court schedule">
            <i class="bi bi-clock-fill text-primary me-1"></i>Court Slots &darr;
          </button>
        </div>
      </div>

      <!-- Calendar Legend Row -->
      <div class="d-flex align-items-center justify-content-between px-3 px-md-4 py-2 bg-light border-bottom flex-wrap gap-2 small">
        <div class="d-flex align-items-center gap-2 gap-sm-3 flex-wrap" style="font-size: 11px;">
          <span class="d-inline-flex align-items-center gap-1.5 text-secondary fw-semibold">
            <span class="badge rounded-circle p-1 bg-success"></span> Available
          </span>
          <span class="d-inline-flex align-items-center gap-1.5 text-secondary fw-semibold">
            <span class="badge rounded-circle p-1 bg-danger"></span> Fully Booked
          </span>
          <span class="d-inline-flex align-items-center gap-1.5 text-secondary fw-semibold">
            <span class="badge rounded-circle p-1 bg-secondary"></span> Not Available / Closed
          </span>
          <% if (typeof user !== 'undefined' && user) { %>
            <span class="d-inline-flex align-items-center gap-1.5 text-primary fw-bold">
              <span class="badge rounded-pill bg-primary text-white px-2 py-0.5" style="font-size: 9.5px;"><i class="bi bi-star-fill text-warning me-1"></i>Your Booking</span>
            </span>
          <% } %>
        </div>
        <div class="small text-muted d-none d-md-block" style="font-size: 11px;">
          <i class="bi bi-info-circle me-1"></i>Select any available day to view court slots
        </div>
      </div>

      <!-- Day of Week Headers -->
      <div class="month-calendar-weekdays">
        <div>Sun</div>
        <div>Mon</div>
        <div>Tue</div>
        <div>Wed</div>
        <div>Thu</div>
        <div>Fri</div>
        <div>Sat</div>
      </div>

      <!-- Days Grid (Populated via renderMonthCalendar()) -->
      <div id="monthCalendarDaysGrid" class="month-calendar-grid"></div>
    </div>

    <!-- =========================================================
         STEP 2: COURT & TIME SCHEDULE MATRIX
    ========================================================= -->
    <div id="bookingTimeMatrixCard" class="matrix-card mt-3">
      <!-- Matrix Toolbar: Date Navigation & Quick Actions -->
      <div class="matrix-date-toolbar d-flex flex-column flex-md-row align-items-start align-items-md-center justify-content-between gap-3">
        <!-- Date Navigator Buttons (Far Left) -->
        <div class="d-flex align-items-center gap-2 flex-wrap">
          <button type="button" class="btn btn-dark btn-sm rounded-pill px-3 py-1.5 fw-bold d-inline-flex align-items-center gap-1.5 shadow-xs" onclick="scrollToCalendar()" title="Jump up to Month Calendar">
            <i class="bi bi-calendar3 text-warning"></i>
            <span>Calendar &uarr;</span>
          </button>

          <button type="button" class="matrix-date-btn" id="btnPrevDate" title="Previous Day">
            <i class="bi bi-chevron-left"></i>
          </button>

          <div class="position-relative">
            <button type="button" class="matrix-date-btn matrix-date-center-btn" id="btnDisplayDate" title="Click to toggle Month Calendar">
              <i class="bi bi-calendar2-check-fill me-2 text-warning"></i>
              <span id="dateDisplayText">Loading date...</span>
            </button>
            <input type="date" id="nativeDatePicker" min="<%= today %>" value="<%= today %>" style="position: absolute; opacity: 0; pointer-events: none; width: 0; height: 0;">
          </div>

          <button type="button" class="matrix-date-btn" id="btnNextDate" title="Next Day">
            <i class="bi bi-chevron-right"></i>
          </button>

          <button type="button" class="btn btn-sm btn-outline-dark rounded-pill px-3 fw-bold" id="btnTodayShortcut">
            Today
          </button>
        </div>

        <!-- Legend Swatches (Single-Line Row) -->
        <div class="matrix-legend-row d-flex align-items-center gap-2 gap-sm-3 flex-shrink-0">
          <div class="matrix-legend-item">
            <div class="legend-swatch legend-open"></div>
            <span>Available</span>
          </div>
          <div class="matrix-legend-item">
            <div class="legend-swatch legend-selected"></div>
            <span>Selected</span>
          </div>
          <div class="matrix-legend-item" title="Awaiting GCash Payment Transfer">
            <div class="legend-swatch legend-pending"></div>
            <span>Awaiting Pay</span>
          </div>
          <div class="matrix-legend-item" title="Payment Proof Uploaded - Admin Verifying">
            <div class="legend-swatch legend-verifying"></div>
            <span>Verifying</span>
          </div>
          <div class="matrix-legend-item" title="Confirmed Booking">
            <div class="legend-swatch legend-taken"></div>
            <span>Booked</span>
          </div>
          <div class="matrix-legend-item" title="Blocked by Facility Admin">
            <div class="legend-swatch legend-blocked"></div>
            <span>Blocked</span>
          </div>
        </div>
      </div>

      <!-- Facility Closed Alert Banner (Appears when all courts are blocked all day) -->
      <div id="dayClosedBanner" class="alert alert-danger d-none align-items-center gap-2 rounded-4 mb-3 border-danger-subtle shadow-sm px-3.5 py-2.5">
        <i class="bi bi-slash-circle-fill fs-5 text-danger flex-shrink-0"></i>
        <div class="flex-grow-1">
          <strong id="dayClosedTitle" class="d-block text-danger">Facility Closed for This Date</strong>
          <span class="small text-danger-emphasis" id="dayClosedReason">All courts are reserved or under facility maintenance.</span>
        </div>
      </div>

      <!-- Schedule Matrix Viewport -->
      <div class="schedule-matrix-wrapper" id="scheduleMatrixWrapper">
        <div class="text-center py-5 text-muted" id="matrixLoadingSpinner">
          <div class="spinner-border text-warning mb-2" role="status"></div>
          <p class="small fw-bold mb-0">Synchronizing real-time availability...</p>
        </div>

        <table class="matrix-table" id="matrixTable" style="display: none;">
          <thead>
            <tr id="matrixHeaderRow">
              <th class="matrix-time-header">TIME</th>
              <% if (courts && courts.length > 0) { %>
                <% courts.forEach(function(c) { %>
                  <th class="matrix-header-cell" data-court-id="<%= c.id %>">
                    <span class="matrix-header-court-title"><%= c.display_name %></span>
                    <span class="matrix-header-court-rate"><%= formatCurrency(c.category ? c.category.price_per_hour : 350) %>/hr</span>
                  </th>
                <% }); %>
              <% } %>
            </tr>
          </thead>
          <tbody id="matrixTableBody">
            <!-- Dynamically populated rows via client JavaScript -->
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- =========================================================
       TAB 3: PHOTOS & FACILITY BLUEPRINT
  ========================================================= -->
  <div id="tab-content-photos" class="venue-tab-pane d-none">
    <div class="row g-4">
      <div class="col-md-6">
        <div class="gallery-photo-card" onclick="openPhotoLightbox('/images/3ks-playground.jpg', 'Championship 4-Court Covered Arena')">
          <img src="/images/3ks-playground.jpg" alt="Championship Covered Arena">
          <div class="gallery-photo-caption d-flex justify-content-between align-items-center">
            <span><i class="bi bi-camera me-1"></i> Championship 4-Court Covered Arena</span>
            <span class="badge bg-white text-dark rounded-pill px-2 py-1 shadow-sm"><i class="bi bi-zoom-in me-1"></i>Preview</span>
          </div>
        </div>
      </div>

      <div class="col-md-6">
        <div class="gallery-photo-card" onclick="openPhotoLightbox('/images/3ks-layout.jpg', 'Architectural Court Layout & 5M Center Walkway')">
          <img src="/images/3ks-layout.jpg" alt="Architectural Court Layout">
          <div class="gallery-photo-caption d-flex justify-content-between align-items-center">
            <span><i class="bi bi-diagram-3 me-1"></i> Architectural Layout & Dimensions (Courts 1 to 4)</span>
            <span class="badge bg-white text-dark rounded-pill px-2 py-1 shadow-sm"><i class="bi bi-zoom-in me-1"></i>Preview</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- =========================================================
       TAB 4: LOCATION & NAVIGATION (Exact GPS Leaflet Map)
  ========================================================= -->
  <div id="tab-content-location" class="venue-tab-pane d-none">
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white mb-4">
      <div class="p-4 p-md-5 border-bottom">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
          <div>
            <h3 class="fw-bold text-dark font-display mb-1">Location & Directions</h3>
            <p class="text-secondary small mb-0">
              <i class="bi bi-geo-alt-fill text-danger me-1"></i>
              Piot Heights, Buntong, Camaman-an, Cagayan de Oro City, Philippines (Exact Coordinates: 8.467594, 124.662773)
            </p>
          </div>
          <div class="d-flex gap-2">
            <a href="https://www.google.com/maps/dir/?api=1&destination=8.467594,124.662773" target="_blank" rel="noopener noreferrer" class="btn btn-outline-primary btn-sm rounded-pill px-3 py-2 fw-bold">
              <i class="bi bi-google me-1"></i>Google Maps
            </a>
            <a href="https://waze.com/ul?ll=8.467594,124.662773&navigate=yes" target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-sm rounded-pill px-3 py-2 fw-bold">
              <i class="bi bi-cursor-fill me-1"></i>Waze Navigation
            </a>
          </div>
        </div>
      </div>

      <!-- Interactive Leaflet Map -->
      <div id="facilityMap" style="height: 480px; width: 100%;"></div>
    </div>
  </div>

  <!-- =========================================================
       TAB 5: FIND BOOKING (Inline Reservation Lookup)
  ========================================================= -->
  <div id="tab-content-lookup" class="venue-tab-pane d-none">
    <div class="row justify-content-center">
      <div class="col-lg-6 col-md-8">
        <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white mb-4">
          <div class="text-center mb-4">
            <div class="badge bg-primary-subtle text-primary rounded-circle p-3 mb-3 fs-3 d-inline-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
              <i class="bi bi-search"></i>
            </div>
            <h3 class="fw-bold text-dark font-display mb-1">Find Your Booking</h3>
            <p class="text-secondary small mb-0">Enter your booking reference (PKL-...) or GCash mobile number to view your pass or resume payment.</p>
          </div>

          <form id="inlineLookupForm" onsubmit="handleInlineLookup(event)">
            <div class="mb-3">
              <label for="inlineRefInput" class="form-label small fw-bold text-dark">Booking Reference or GCash Mobile Number</label>
              <div class="input-group input-group-lg">
                <span class="input-group-text bg-light text-primary border-end-0"><i class="bi bi-search"></i></span>
                <input type="text" class="form-control font-monospace border-start-0" id="inlineRefInput" placeholder="e.g. PKL-123456 or 09171234567" required autocomplete="off">
              </div>
              <div id="inlineLookupError" class="alert alert-danger py-2 px-3 small mt-2 d-none rounded-3" role="alert"></div>
            </div>

            <button type="submit" id="inlineLookupBtn" class="btn btn-book-now-gold btn-lg w-100 fw-bold rounded-pill shadow">
              <i class="bi bi-search me-1"></i>Search Reservation
            </button>
          </form>

          <div class="text-center mt-4 pt-3 border-top">
            <span class="small text-muted d-block mb-2">Want to see all your bookings &amp; enable Messenger alerts?</span>
            <button type="button" class="btn btn-outline-primary btn-sm rounded-pill px-3" onclick="switchVenueTab('my-bookings')">
              <i class="bi bi-person-check-fill me-1"></i>Go to My Account &amp; Bookings
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- =========================================================
       TAB 6: MY BOOKINGS (Authenticated Player Dashboard)
  ========================================================= -->
  <div id="tab-content-my-bookings" class="venue-tab-pane d-none">
    <!-- Guest Prompt (Shown when not signed in) -->
    <div id="myBookingsGuestCard" class="<%= (typeof user !== 'undefined' && user) ? 'd-none' : '' %>">
      <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">
          <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white text-center">
            <div class="badge bg-warning-subtle text-dark rounded-circle p-3 mb-3 fs-3 d-inline-flex align-items-center justify-content-center mx-auto" style="width: 64px; height: 64px;">
              <i class="bi bi-person-lock"></i>
            </div>
            <h3 class="fw-bold text-dark font-display mb-2">Player Account Required</h3>
            <p class="text-secondary small mb-4">
              Sign in or create a free player account to book courts, enable personal Messenger alerts, track active holds, and view your complete booking history.
            </p>
            <div class="d-flex flex-column flex-sm-row justify-content-center gap-2">
              <button type="button" class="btn btn-book-now-gold rounded-pill px-4 py-2.5 fw-bold" onclick="openPlayerAuthModal('login', false)">
                <i class="bi bi-box-arrow-in-right me-1"></i> Sign In to Account
              </button>
              <button type="button" class="btn btn-outline-primary rounded-pill px-4 py-2.5 fw-bold" onclick="openPlayerAuthModal('register', false)">
                <i class="bi bi-person-plus-fill me-1"></i> Create Player Account
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Authenticated Player Dashboard -->
    <div id="myBookingsUserDashboard" class="<%= (typeof user !== 'undefined' && user) ? '' : 'd-none' %>">
      <!-- Player Profile & Account Messenger Alerts Header Card -->
      <!-- Luxury Player Membership Pass Card -->
      <div class="player-membership-card mb-4 position-relative overflow-hidden">
        <!-- Ambient Gold Glow Accent Background -->
        <div class="player-pass-glow"></div>
        <div class="player-pass-watermark"><i class="bi bi-shield-shaded"></i></div>

        <div class="player-pass-content p-3 p-md-4 position-relative z-1">
          <!-- Card Header Strip -->
          <div class="d-flex align-items-center justify-content-between mb-3">
            <span class="player-pass-brand-badge">
              <i class="bi bi-patch-check-fill text-warning me-1"></i>THE PLAYGROUND &middot; MEMBER
            </span>
            <span id="dashboardMessengerBadge" class="badge <%= (typeof user !== 'undefined' && user && user.fb_psid) ? 'bg-success-subtle text-success border border-success' : 'bg-secondary bg-opacity-25 text-white-50 border border-secondary border-opacity-50' %> rounded-pill px-2.5 py-1 small fw-semibold">
              <i class="bi bi-messenger me-1"></i><%= (typeof user !== 'undefined' && user && user.fb_psid) ? 'Messenger Active' : 'Messenger Not Linked' %>
            </span>
          </div>

          <!-- Main Player Identity Row -->
          <div class="d-flex align-items-center gap-3 mb-3">
            <!-- Monogram Avatar -->
            <div class="player-pass-avatar" id="dashboardPlayerAvatar">
              <% 
                const pName = (typeof user !== 'undefined' && user) ? (user.full_name || user.username) : 'Player';
                const pParts = pName.trim().split(/\s+/).filter(Boolean);
                const initials = pParts.length > 1 ? (pParts[0][0] + pParts[pParts.length - 1][0]).toUpperCase() : pName.slice(0, 2).toUpperCase();
              %>
              <%= initials %>
            </div>

            <div class="min-w-0 flex-grow-1">
              <h4 class="fw-extrabold text-white font-display mb-1 player-pass-name" id="dashboardPlayerName">
                <%= pName %>
              </h4>
              <div class="player-pass-meta d-flex flex-wrap align-items-center gap-2 gap-sm-3">
                <span id="dashboardPlayerPhone" class="player-pass-meta-item">
                  <i class="bi bi-phone text-warning me-1"></i><%= (typeof user !== 'undefined' && user && user.phone) ? user.phone : '—' %>
                </span>
                <% if (typeof user !== 'undefined' && user && user.email) { %>
                  <span id="dashboardPlayerEmail" class="player-pass-meta-item">
                    <i class="bi bi-envelope text-info me-1"></i><%= user.email %>
                  </span>
                <% } else { %>
                  <span id="dashboardPlayerEmail" class="player-pass-meta-item d-none"></span>
                <% } %>
              </div>
            </div>
          </div>

          <!-- Card Action Buttons Strip (Sleek, Unified, High-End) -->
          <div class="player-pass-actions pt-3 border-top border-light border-opacity-10 d-flex align-items-center gap-2 flex-wrap">
            <button type="button" class="btn btn-book-now-gold btn-sm rounded-pill px-3.5 py-2 fw-bold d-inline-flex align-items-center justify-content-center gap-1.5 flex-grow-1 shadow-sm" onclick="switchVenueTab('book')">
              <i class="bi bi-plus-circle-fill"></i>
              <span>Book Court Slot</span>
            </button>

            <button type="button" id="dashboardMessengerBtn" class="btn <%= (typeof user !== 'undefined' && user && user.fb_psid) ? 'btn-outline-light' : 'btn-primary' %> btn-sm rounded-pill px-3.5 py-2 fw-bold d-inline-flex align-items-center justify-content-center gap-1.5 shadow-sm flex-grow-1" data-bs-toggle="modal" data-bs-target="#messengerModal">
              <i class="bi bi-messenger"></i>
              <span id="dashboardMessengerBtnText"><%= (typeof user !== 'undefined' && user && user.fb_psid) ? 'Messenger Active' : 'Connect Messenger' %></span>
            </button>

            <button type="button" class="btn btn-outline-light btn-sm rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" onclick="refreshMyBookings()" title="Refresh Bookings" style="width: 36px; height: 36px;">
              <i class="bi bi-arrow-clockwise"></i>
            </button>
          </div>
        </div>
      </div>

      <!-- Bookings List Container -->
      <div id="myBookingsListContainer">
        <!-- Populated by renderMyBookingsList() on load & refresh -->
      </div>
    </div>
  </div>

</div>

<!-- =========================================================
     FLOATING BOTTOM BOOKING RAIL (Courtogo Interaction)
========================================================= -->
<div class="floating-booking-rail" id="bookingActionBar">
  <!-- Expandable Selected Courts Summary Drawer -->
  <div class="selected-slots-drawer d-none" id="selectedSlotsDrawer">
    <div class="container max-w-6xl px-0 mb-3">
      <div class="card border-0 shadow-lg rounded-4 overflow-hidden" style="background: rgba(11, 37, 69, 0.98); backdrop-filter: blur(20px); border: 1.5px solid var(--gold-400) !important;">
        <!-- Drawer Header -->
        <div class="p-3 border-bottom border-secondary border-opacity-25 d-flex justify-content-between align-items-center">
          <div class="d-flex align-items-center gap-2">
            <span class="badge bg-warning text-dark rounded-pill px-2.5 py-1 fw-bold" style="font-size: 11.5px;">
              <i class="bi bi-grid-fill me-1"></i>Selected Courts & Slots
            </span>
            <span class="text-white-50 small fw-semibold" id="drawerSummarySubtitle">Selected courts summary</span>
          </div>
          <button type="button" class="btn btn-sm btn-outline-light rounded-circle d-flex align-items-center justify-content-center" onclick="toggleSelectedSlotsDrawer(false)" style="width: 30px; height: 30px;" title="Close table view">
            <i class="bi bi-x-lg"></i>
          </button>
        </div>

        <!-- Drawer Body: Responsive Card List -->
        <div class="p-2 p-sm-3" style="max-height: 270px; overflow-y: auto;">
          <div id="drawerSlotsTableBody" class="d-flex flex-column gap-2">
            <!-- Dynamic rows injected here -->
          </div>
        </div>

        <!-- Drawer Footer -->
        <div class="p-2.5 px-3 bg-dark bg-opacity-60 border-top border-secondary border-opacity-25 d-flex justify-content-between align-items-center">
          <div class="d-flex align-items-center gap-2">
            <span class="text-white-50 small" id="drawerSlotsSummaryCount">4 slots selected</span>
            <span class="text-white-50 small">·</span>
            <span class="text-warning small fw-bold" id="drawerTotalPriceSummary">Total: ₱0.00</span>
          </div>
          <button type="button" class="btn btn-sm btn-outline-light rounded-pill px-3 py-1 d-flex align-items-center gap-1.5" onclick="toggleSelectedSlotsDrawer(false)">
            <i class="bi bi-chevron-down"></i> Collapse Table
          </button>
        </div>
      </div>
    </div>
  </div>

  <div class="container max-w-6xl">
    <!-- Desktop Layout (sm and up) -->
    <div class="d-none d-sm-flex align-items-center justify-content-between gap-3">
      <div class="d-flex align-items-center gap-3">
        <div class="rail-summary-pill d-flex align-items-center gap-2" role="button" onclick="toggleSelectedSlotsDrawer()" style="cursor: pointer;" title="Click to view full table of selected courts and slots">
          <span class="badge rounded-pill bg-warning text-dark fw-bold" id="railCourtBadge">Court 1</span>
          <span class="small text-white fw-bold" id="railTimeSlotsText">Select a time</span>
          <button type="button" class="rail-table-btn" id="drawerToggleBtn" onclick="event.stopPropagation(); toggleSelectedSlotsDrawer();">
            <i class="bi bi-table"></i> <span id="drawerToggleText">View Table</span> <i class="bi bi-chevron-up" id="drawerToggleIcon"></i>
          </button>
        </div>
        <div>
          <span class="small text-white-50 d-block" style="font-size: 11px;">Total Price:</span>
          <span class="rail-price-tag" id="railTotalPrice">₱0.00</span>
        </div>
      </div>
      <div class="d-flex align-items-center gap-2">
        <button type="button" class="btn btn-sm btn-outline-light rounded-pill px-3" onclick="clearSelectedSlots()">
          Clear
        </button>
        <button type="button" class="btn-book-now-gold" onclick="openCheckoutModal()">
          <i class="bi bi-lightning-charge-fill me-1"></i> Continue to Booking &rarr;
        </button>
      </div>
    </div>

    <!-- Mobile Layout (< sm / smartphones) -->
    <div class="d-flex d-sm-none flex-column gap-2">
      <!-- Top Line: Court & Slot Count on left, Details button on right -->
      <div class="d-flex align-items-center justify-content-between">
        <div class="d-flex align-items-center gap-1.5" role="button" onclick="toggleSelectedSlotsDrawer()" style="cursor: pointer;">
          <span class="badge rounded-pill bg-warning text-dark fw-bold" id="mobileRailCourtBadge" style="font-size: 11px;">1 Court</span>
          <span class="text-white small fw-bold" id="mobileRailSlotsText" style="font-size: 12px;">1 Slot</span>
        </div>
        <button type="button" class="rail-table-btn py-1 px-2.5" id="mobileDrawerToggleBtn" onclick="event.stopPropagation(); toggleSelectedSlotsDrawer();" style="font-size: 11px;">
          <i class="bi bi-table"></i> <span id="mobileDrawerToggleText">Details</span> <i class="bi bi-chevron-up" id="mobileDrawerToggleIcon"></i>
        </button>
      </div>

      <!-- Bottom Line: Total Price and Clear link on left, Continue button on right -->
      <div class="d-flex align-items-center justify-content-between pt-1.5 border-top border-secondary border-opacity-25">
        <div class="d-flex align-items-baseline gap-2">
          <span class="rail-price-tag text-warning fw-bold mb-0" id="mobileRailTotalPrice" style="font-size: 18px; line-height: 1;">₱0.00</span>
          <button type="button" class="btn btn-link text-white-50 text-decoration-none p-0 small" onclick="clearSelectedSlots()" style="font-size: 11px;">Clear</button>
        </div>
        <button type="button" class="btn btn-book-now-gold btn-sm px-3 py-1.5 fw-bold rounded-pill" onclick="openCheckoutModal()" style="font-size: 13px;">
          <i class="bi bi-lightning-charge-fill me-1"></i> Continue &rarr;
        </button>
      </div>
    </div>
  </div>
</div>

<!-- =========================================================
     PHOTO LIGHTBOX PREVIEW MODAL
========================================================= -->
<div class="modal fade" id="photoLightboxModal" tabindex="-1" aria-hidden="true" style="backdrop-filter: blur(10px); background-color: rgba(5, 12, 22, 0.9);">
  <div class="modal-dialog modal-dialog-centered modal-xl">
    <div class="modal-content bg-transparent border-0 shadow-none text-white">
      <!-- Modal Top Toolbar -->
      <div class="d-flex justify-content-between align-items-center px-2 py-2 mb-2">
        <div class="d-flex align-items-center gap-2">
          <span class="badge bg-primary px-3 py-1 rounded-pill fw-bold" id="lightboxModalCounter">1 / 2</span>
          <h5 class="modal-title font-display fw-bold text-white mb-0 fs-6 fs-md-5" id="lightboxModalTitle">Photo Preview</h5>
        </div>
        <button type="button" class="btn btn-dark btn-sm rounded-circle d-flex align-items-center justify-content-center shadow" data-bs-dismiss="modal" aria-label="Close" style="width: 40px; height: 40px; background: rgba(255,255,255,0.15); border: 1px solid rgba(255,255,255,0.25);">
