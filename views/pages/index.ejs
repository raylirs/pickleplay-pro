<!-- =========================================================
     SLIDE-OUT / MODAL BOOKING CHECKOUT
========================================================= -->
<div class="modal fade" id="checkoutModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content rounded-4 border-0 shadow-lg overflow-hidden">
      <div class="modal-header modal-checkout-header p-4">
        <div>
          <h5 class="modal-title fw-bold font-display text-white mb-0">Confirm Your Court Reservation</h5>
          <span class="text-white-50 small">The Playground Pickleball · Official GCash QR Flow</span>
        </div>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <div class="modal-body p-4">
        <!-- Order Summary Box -->
        <div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden" style="background: #f8fafc; border: 1px solid #e2e8f0 !important;">
          <!-- Top Row: Date & Total Slots Pill -->
          <div class="px-3 py-2.5 bg-white border-bottom d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-2">
              <span class="badge bg-primary-subtle text-primary rounded-circle p-2 d-inline-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                <i class="bi bi-calendar3"></i>
              </span>
              <div>
                <span class="small text-muted d-block" style="font-size: 10px; text-transform: uppercase; letter-spacing: 0.5px; font-weight: 600;">Date</span>
                <span class="fw-bold text-dark small" id="modalSummaryDate">Today</span>
              </div>
            </div>
            <span class="badge bg-primary text-white rounded-pill px-3 py-1.5 fw-bold" id="modalSummaryHours">1 Slot</span>
          </div>

          <!-- Courts & Time Slots List -->
          <div class="p-3" id="modalSummarySlots">
            <!-- Dynamic court blocks injected here -->
          </div>

          <!-- Bottom Row: Subtotal & Total Amount Due -->
          <div class="px-3 py-2.5 bg-white border-top d-flex justify-content-between align-items-center">
            <div>
              <span class="small text-muted d-block" style="font-size: 10px; text-transform: uppercase; letter-spacing: 0.5px; font-weight: 600;">Total Amount Due</span>
              <span class="small text-secondary" id="modalSummaryBreakdown" style="font-size: 11px;">1 hour total</span>
            </div>
            <span class="fs-4 fw-extrabold text-primary font-display" id="modalSummaryTotal">₱0.00</span>
          </div>
        </div>

        <!-- Player Information Form -->
        <form id="matrixReservationForm" action="/reservations" method="POST">
          <input type="hidden" name="court_id" id="formCourtId" value="">
          <input type="hidden" name="reservation_date" id="formDate" value="<%= today %>">
          <input type="hidden" name="start_time" id="formStartTime" value="">
          <input type="hidden" name="total_hours" id="formTotalHours" value="1">
          <input type="hidden" name="selected_slots" id="formSelectedSlots" value="[]">

          <div class="mb-3">
            <label class="form-label small fw-bold text-dark">Player Full Name <span class="text-danger">*</span></label>
            <input type="text" name="user_name" id="checkoutUserName" class="form-control rounded-3" placeholder="e.g. Juan Dela Cruz" value="<%= (typeof user !== 'undefined' && user) ? (user.full_name || user.username || '') : '' %>" required>
          </div>

          <div class="row g-2 mb-3">
            <div class="col-sm-6">
              <label class="form-label small fw-bold text-dark">GCash Mobile <span class="text-danger">*</span></label>
              <input type="tel" name="user_contact" id="checkoutUserContact" class="form-control rounded-3 font-monospace" value="<%= (typeof user !== 'undefined' && user && user.phone) ? user.phone : '' %>" required>
            </div>
            <div class="col-sm-6">
              <label class="form-label small fw-bold text-dark">Email <span class="text-muted fw-normal">(Optional)</span></label>
              <input type="email" name="user_email" id="checkoutUserEmail" class="form-control rounded-3" placeholder="player@email.com" value="<%= (typeof user !== 'undefined' && user && user.email) ? user.email : '' %>">
            </div>
          </div>

          <div class="mb-4">
            <label class="form-label small fw-bold text-dark">Special Requests / Notes <span class="text-muted fw-normal">(Optional)</span></label>
            <input type="text" name="special_requests" class="form-control rounded-3" placeholder="Paddle rentals, ball tubes, coaching, etc.">
          </div>

          <div class="sticky-bottom bg-white pt-3 pb-1 border-top mt-3 d-flex gap-2" style="z-index: 10;">
            <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-book-now-gold flex-fill">
              <i class="bi bi-qr-code-scan me-1"></i> Proceed to GCash Payment
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<!-- =========================================================
     PLAYER ACCOUNT LOGIN / REGISTER MODAL (Seamless Matrix Auth)
========================================================= -->
<div class="modal fade" id="playerAuthModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content rounded-4 border-0 shadow-lg overflow-hidden">
      <div class="modal-header modal-checkout-header p-4">
        <div>
          <h5 class="modal-title fw-bold font-display text-white mb-0" id="playerAuthModalTitle">Player Account Required</h5>
          <span class="text-white-50 small">The Playground Pickleball · Sign In or Create Account</span>
        </div>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <!-- Mode Switcher Tabs -->
      <div class="d-flex border-bottom bg-light">
        <button type="button" id="modalAuthTabLogin" class="flex-fill btn rounded-0 py-2.5 fw-bold small border-0 bg-white text-primary border-bottom border-2 border-primary" onclick="switchPlayerAuthModalMode('login')">
          <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
        </button>
        <button type="button" id="modalAuthTabRegister" class="flex-fill btn rounded-0 py-2.5 fw-bold small border-0 text-secondary" onclick="switchPlayerAuthModalMode('register')">
          <i class="bi bi-person-plus-fill me-1"></i> Create Account
        </button>
      </div>

      <div class="modal-body p-4">
        <!-- Context Notice when triggered from Continue to Booking -->
        <div id="playerAuthCheckoutNotice" class="alert alert-warning border-warning py-2 px-3 small rounded-3 mb-3 d-none">
          <i class="bi bi-shield-lock-fill me-1 text-dark"></i>
          <strong>Almost there!</strong> Please sign in or create an account to reserve your selected court slots.
        </div>

        <div id="playerAuthErrorBox" class="alert alert-danger py-2 px-3 small rounded-3 mb-3 d-none"></div>

        <!-- Modal Login Form -->
        <form id="modalPlayerLoginForm" onsubmit="handleModalPlayerLogin(event)">
          <div class="mb-3">
            <label class="form-label small fw-bold text-dark">Email or GCash Mobile Number <span class="text-danger">*</span></label>
            <div class="input-group">
              <span class="input-group-text bg-light text-primary"><i class="bi bi-person-badge"></i></span>
              <input type="text" id="modalLoginIdentifier" name="identifier" class="form-control" placeholder="09171234567 or player@email.com" required>
            </div>
          </div>

          <div class="mb-4">
            <label class="form-label small fw-bold text-dark">Password <span class="text-danger">*</span></label>
            <div class="input-group">
              <span class="input-group-text bg-light text-primary"><i class="bi bi-lock-fill"></i></span>
              <input type="password" id="modalLoginPassword" name="password" class="form-control" placeholder="Enter your password" required>
            </div>
          </div>

          <button type="submit" id="modalLoginSubmitBtn" class="btn btn-book-now-gold w-100 py-2.5 fw-bold rounded-pill shadow-sm">
            <i class="bi bi-box-arrow-in-right me-1"></i> Sign In &amp; Continue
          </button>

          <div class="text-center mt-3 pt-2 border-top">
            <span class="small text-secondary">Don't have a player account yet?</span>
            <a href="javascript:void(0)" onclick="switchPlayerAuthModalMode('register')" class="small fw-bold text-primary text-decoration-none ms-1">Create Account &rarr;</a>
          </div>
        </form>

        <!-- Modal Register Form -->
        <form id="modalPlayerRegisterForm" class="d-none" onsubmit="handleModalPlayerRegister(event)">
          <div class="mb-2.5">
            <label class="form-label small fw-bold text-dark mb-1">Player Full Name <span class="text-danger">*</span></label>
            <input type="text" id="modalRegFullName" name="full_name" class="form-control rounded-3" placeholder="e.g. Juan Dela Cruz" required>
          </div>

          <div class="row g-2 mb-2.5 mt-1">
            <div class="col-sm-6">
              <label class="form-label small fw-bold text-dark mb-1">GCash Mobile <span class="text-danger">*</span></label>
              <input type="tel" id="modalRegPhone" name="phone" class="form-control rounded-3 font-monospace" placeholder="09171234567" required>
            </div>
            <div class="col-sm-6">
              <label class="form-label small fw-bold text-dark mb-1">Email <span class="text-muted fw-normal">(Optional)</span></label>
              <input type="email" id="modalRegEmail" name="email" class="form-control rounded-3" placeholder="player@email.com">
            </div>
          </div>

          <div class="row g-2 mb-4 mt-1">
            <div class="col-sm-6">
              <label class="form-label small fw-bold text-dark mb-1">Password <span class="text-danger">*</span></label>
              <input type="password" id="modalRegPassword" name="password" class="form-control rounded-3" placeholder="Min. 6 chars" minlength="6" required>
            </div>
            <div class="col-sm-6">
              <label class="form-label small fw-bold text-dark mb-1">Confirm Password <span class="text-danger">*</span></label>
              <input type="password" id="modalRegConfirm" name="confirm_password" class="form-control rounded-3" placeholder="Repeat password" minlength="6" required>
            </div>
          </div>

          <button type="submit" id="modalRegisterSubmitBtn" class="btn btn-book-now-gold w-100 py-2.5 fw-bold rounded-pill shadow-sm">
            <i class="bi bi-person-check-fill me-1"></i> Create Account &amp; Continue
          </button>

          <div class="text-center mt-3 pt-2 border-top">
            <span class="small text-secondary">Already have an account?</span>
            <a href="javascript:void(0)" onclick="switchPlayerAuthModalMode('login')" class="small fw-bold text-primary text-decoration-none ms-1">Sign In &rarr;</a>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<!-- =========================================================
     LEAFLET MAP LIBS & CLIENT INTERACTION JAVASCRIPT
========================================================= -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin=""/>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>

<script>
  // Global State for Courtogo Matrix & Player Account
  let currentDate = '<%= today %>';
  let matrixCourtsData = [];
  let selectedSlotItems = []; // Array of { courtId, courtName, startTime, endTime, rate, startLabel, endLabel }
  let mapInitialized = false;
  let leafletMap = null;
  let currentPlayerUser = <%- JSON.stringify(typeof user !== 'undefined' && user ? user : null) %>;
  let myBookingsData = <%- JSON.stringify(typeof myBookings !== 'undefined' && myBookings ? myBookings : []) %>;
  let pendingCheckoutAfterAuth = false;

  document.addEventListener('DOMContentLoaded', function () {
    // 1. Initialize Date picker and buttons
    initDateControls();

    // 2. Fetch Initial Availability Matrix
    fetchMatrixAvailability(currentDate);

    // 3. Listen to Socket.io for Real-Time Updates
    initMatrixSocket();

    // 4. Render initial My Bookings list if logged in
    renderMyBookingsList();

    // 5. Hide floating booking rail when checkout or auth modal opens, restore when closed
    ['checkoutModal', 'playerAuthModal'].forEach(modalId => {
      const modalEl = document.getElementById(modalId);
      if (modalEl) {
        modalEl.addEventListener('show.bs.modal', function () {
          const rail = document.getElementById('bookingActionBar');
          if (rail) rail.classList.remove('is-visible');
        });
        modalEl.addEventListener('hidden.bs.modal', function () {
          const rail = document.getElementById('bookingActionBar');
          if (rail && selectedSlotItems && selectedSlotItems.length > 0) {
            rail.classList.add('is-visible');
          }
        });
      }
    });

    // 6. Handle direct tab routing via URL hash
    if (window.location.hash) {
      const targetTab = window.location.hash.replace('#', '');
      if (['book', 'my-bookings', 'about', 'photos', 'location', 'lookup'].includes(targetTab)) {
        switchVenueTab(targetTab);
      }
    }

    // 7. Check for active unpaid booking in localStorage to show recovery banner
    checkUnpaidBookingBanner();
  });

  // Tab Switcher
  function switchVenueTab(tabName) {
    document.querySelectorAll('.venue-tab-pane').forEach(el => el.classList.add('d-none'));
    document.querySelectorAll('.courtogo-tab-btn').forEach(btn => btn.classList.remove('active'));

    const contentPane = document.getElementById('tab-content-' + tabName);
    const btn = document.getElementById('tab-btn-' + tabName);

    if (contentPane) contentPane.classList.remove('d-none');
    if (btn) btn.classList.add('active');

    // Manage bottom floating booking rail visibility
    const rail = document.getElementById('bookingActionBar');
    if (rail) {
      if (tabName === 'book' && typeof selectedSlotItems !== 'undefined' && selectedSlotItems.length > 0) {
        rail.classList.add('is-visible');
      } else {
        rail.classList.remove('is-visible');
      }
    }

    if (tabName === 'location') {
      setTimeout(initLeafletMap, 200);
    } else if (tabName === 'lookup') {
      setTimeout(() => {
        const input = document.getElementById('inlineRefInput');
        if (input) input.focus();
      }, 150);
    } else if (tabName === 'my-bookings' && currentPlayerUser) {
      refreshMyBookings();
    }
    history.replaceState(null, null, '#' + tabName);
  }

  // Inline Lookup Handler
  async function handleInlineLookup(e) {
    e.preventDefault();
    const input = document.getElementById('inlineRefInput');
    const errorBox = document.getElementById('inlineLookupError');
    const btn = document.getElementById('inlineLookupBtn');
    if (!input) return;
    const ref = input.value.trim();
    if (!ref) return;

    if (errorBox) errorBox.classList.add('d-none');
    if (btn) {
      btn.disabled = true;
      btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status"></span>Checking...';
    }

    try {
      const res = await fetch('/api/v1/reservations/' + encodeURIComponent(ref) + '/status');
      if (res.ok) {
        const data = await res.json();
        if (data && data.success) {
          const targetRef = data.reference || ref;
          if (data.status === 'AWAITING_PAYMENT') {
            window.location.href = '/payment/gcash?ref=' + encodeURIComponent(targetRef);
          } else {
            window.location.href = '/reservations/' + encodeURIComponent(targetRef);
          }
          return;
        }
      }
      // If 404 or reservation not found
      if (errorBox) {
        errorBox.textContent = `No reservation found for "${ref}". Please verify your reference or GCash mobile number.`;
        errorBox.classList.remove('d-none');
      } else {
        window.location.href = '/reservations/' + encodeURIComponent(ref);
      }
    } catch (err) {
      // In case of network glitch, fallback directly to the reservation pass route
      window.location.href = '/reservations/' + encodeURIComponent(ref);
    } finally {
      if (btn) {
        btn.disabled = false;
        btn.innerHTML = '<i class="bi bi-search me-1"></i>Search Reservation';
      }
    }
  }

  // Date Controls
  function initDateControls() {
    const nativePicker = document.getElementById('nativeDatePicker');
    const displayBtn = document.getElementById('btnDisplayDate');
    const prevBtn = document.getElementById('btnPrevDate');
    const nextBtn = document.getElementById('btnNextDate');
    const todayBtn = document.getElementById('btnTodayShortcut');

    updateDateDisplay(currentDate);

    displayBtn.addEventListener('click', () => {
      nativePicker.showPicker ? nativePicker.showPicker() : nativePicker.click();
    });

    nativePicker.addEventListener('change', (e) => {
      if (e.target.value) {
        currentDate = e.target.value;
        updateDateDisplay(currentDate);
        clearSelectedSlots();
        fetchMatrixAvailability(currentDate);
      }
    });

    prevBtn.addEventListener('click', () => {
      const d = new Date(currentDate);
      d.setDate(d.getDate() - 1);
      const minDate = new Date('<%= today %>');
      if (d >= minDate) {
        currentDate = d.toISOString().split('T')[0];
        updateDateDisplay(currentDate);
        clearSelectedSlots();
        fetchMatrixAvailability(currentDate);
      }
    });

    nextBtn.addEventListener('click', () => {
      const d = new Date(currentDate);
      d.setDate(d.getDate() + 1);
      currentDate = d.toISOString().split('T')[0];
      updateDateDisplay(currentDate);
      clearSelectedSlots();
      fetchMatrixAvailability(currentDate);
    });

    todayBtn.addEventListener('click', () => {
      currentDate = '<%= today %>';
      updateDateDisplay(currentDate);
      clearSelectedSlots();
      fetchMatrixAvailability(currentDate);
    });
  }

  function updateDateDisplay(dateStr) {
    const d = new Date(dateStr + 'T00:00:00');
    const todayStr = '<%= today %>';
    const isToday = dateStr === todayStr;

    const options = { weekday: 'short', month: 'short', day: 'numeric' };
    const formatted = d.toLocaleDateString('en-US', options);

    document.getElementById('dateDisplayText').innerText = (isToday ? 'Today, ' : '') + formatted;
    document.getElementById('nativeDatePicker').value = dateStr;
  }

  // Fetch Matrix API Data
  async function fetchMatrixAvailability(date) {
    const spinner = document.getElementById('matrixLoadingSpinner');
    const table = document.getElementById('matrixTable');

    spinner.style.display = 'block';
    table.style.display = 'none';

    try {
      const res = await fetch('/courts-availability?date=' + date);
      const data = await res.json();

      if (data.success && data.courts) {
        matrixCourtsData = data.courts;
        renderMatrixTable(data.courts);
      }
    } catch (err) {
      console.error('Matrix error:', err);
    } finally {
      spinner.style.display = 'none';
      table.style.display = 'table';
    }
  }

  // Render Table Grid
  function renderMatrixTable(courts) {
    const tbody = document.getElementById('matrixTableBody');
    tbody.innerHTML = '';

    if (!courts || courts.length === 0) return;

    // Use the first court's slots as time row baseline
    const referenceSlots = courts[0].slots || [];

    referenceSlots.forEach(slot => {
      const tr = document.createElement('tr');

      // 1. Time Label Cell (Sticky Left)
      const timeTd = document.createElement('td');
      timeTd.className = 'matrix-time-cell';
      const isMidnight = slot.endTime === '24:00' || slot.endTime === '00:00';
      const endLabelFormatted = isMidnight ? '12:00 Midnight' : slot.endLabel;
      timeTd.innerHTML = `
        <span class="matrix-time-start fw-bold text-dark d-block" style="font-size: 11px;">${slot.startLabel}</span>
        <span class="matrix-time-end text-muted d-block" style="font-size: 9px; line-height: 1.1;">to ${endLabelFormatted}</span>
      `;
      tr.appendChild(timeTd);

      // 2. Court Slot Cells
      courts.forEach(court => {
        const td = document.createElement('td');
        const courtSlot = (court.slots || []).find(s => s.startTime === slot.startTime) || slot;

        let stateClass = 'state-available';
        if (!courtSlot.isAvailable) {
          if (courtSlot.status === 'AWAITING_PAYMENT' || courtSlot.status === 'PENDING') {
            stateClass = 'state-processing';
          } else if (courtSlot.status === 'AWAITING_CONFIRMATION') {
            stateClass = 'state-verifying';
          } else {
            stateClass = 'state-booked';
          }
        }

        // Check if currently selected
        const isSelected = selectedSlotItems.some(item => item.courtId === court.id && item.startTime === slot.startTime);
        if (isSelected) {
          stateClass = 'state-selected';
        }

        td.className = 'matrix-slot-cell ' + stateClass;
        td.dataset.courtId = court.id;
        td.dataset.courtName = court.name;
        td.dataset.rate = court.pricePerHour;
        td.dataset.startTime = slot.startTime;
        td.dataset.endTime = slot.endTime;
        td.dataset.startLabel = slot.startLabel;
        td.dataset.endLabel = slot.endLabel;
        td.id = `cell-${court.id}-${slot.startTime.replace(':', '')}`;

        td.innerHTML = `
          <div class="slot-inner">
            <span>₱${court.pricePerHour}</span>
          </div>
        `;

        // Click handler for selection or status modals
        if (courtSlot.isAvailable) {
          td.addEventListener('click', () => handleSlotClick(court, slot));
        } else if (courtSlot.status === 'AWAITING_PAYMENT' || courtSlot.status === 'PENDING') {
          td.style.cursor = 'pointer';
          td.title = 'Awaiting GCash Payment - Click to resume payment';
          td.addEventListener('click', () => handlePendingSlotClick(court, courtSlot));
        } else if (courtSlot.status === 'AWAITING_CONFIRMATION') {
          td.style.cursor = 'pointer';
          td.title = 'Payment Received - Admin Verifying (Click to check status)';
          td.addEventListener('click', () => handleVerifyingSlotClick(court, courtSlot));
        }

        tr.appendChild(td);
      });

      tbody.appendChild(tr);
    });
  }

  // Pending Slot Modal Handler
  function handlePendingSlotClick(court, slot) {
    const modalEl = document.getElementById('pendingSlotModal');
    if (!modalEl) return;
    document.getElementById('pendingSlotCourtName').innerText = court.name;
    document.getElementById('pendingSlotTime').innerText = `${slot.startLabel} - ${slot.endLabel}`;
    document.getElementById('pendingSlotRef').innerText = slot.referenceNumber || 'Pending Order';

    const payBtn = document.getElementById('pendingSlotPayBtn');
    if (slot.referenceNumber) {
      payBtn.href = `/payment/gcash?ref=${encodeURIComponent(slot.referenceNumber)}`;
      payBtn.classList.remove('d-none');
    } else {
      payBtn.classList.add('d-none');
    }

    const modal = new bootstrap.Modal(modalEl);
    modal.show();
  }

  // Verifying Slot Modal Handler (Payment Proof Uploaded, Awaiting Admin Review)
  function handleVerifyingSlotClick(court, slot) {
    const modalEl = document.getElementById('verifyingSlotModal');
    if (!modalEl) return;
    document.getElementById('verifyingSlotCourtName').innerText = court.name;
    document.getElementById('verifyingSlotTime').innerText = `${slot.startLabel} - ${slot.endLabel}`;
    document.getElementById('verifyingSlotRef').innerText = slot.referenceNumber || 'Verification In Progress';

    const passBtn = document.getElementById('verifyingSlotPassBtn');
    if (slot.referenceNumber) {
      passBtn.href = `/reservations/${encodeURIComponent(slot.referenceNumber)}`;
      passBtn.classList.remove('d-none');
    } else {
      passBtn.classList.add('d-none');
    }

    const modal = new bootstrap.Modal(modalEl);
    modal.show();
  }

  // Active Unpaid Booking Recovery Banner
  async function checkUnpaidBookingBanner() {
    const pendingRef = localStorage.getItem('courtogo_pending_ref');
    if (!pendingRef) return;

    try {
      const res = await fetch('/api/v1/reservations/' + encodeURIComponent(pendingRef) + '/status');
      if (res.ok) {
        const data = await res.json();
        if (data.success && data.status === 'AWAITING_PAYMENT' && !data.isExpired) {
          const banner = document.getElementById('unpaidReservationBanner');
          const refEl = document.getElementById('unpaidBannerRef');
          const linkEl = document.getElementById('unpaidBannerLink');
          if (banner && refEl && linkEl) {
            refEl.innerText = data.reference;
            linkEl.href = '/payment/gcash?ref=' + encodeURIComponent(data.reference);
            banner.classList.remove('d-none');
            banner.classList.add('d-flex');
          }
          return;
        }
      }
      localStorage.removeItem('courtogo_pending_ref');
    } catch (e) {
      // Ignore network errors
    }
  }

  function dismissUnpaidBanner() {
    const banner = document.getElementById('unpaidReservationBanner');
    if (banner) {
      banner.classList.remove('d-flex');
      banner.classList.add('d-none');
    }
  }

  // Interactive Multi-Court & Multi-Time Slot Click Handler
  function handleSlotClick(court, slot) {
    const existingIndex = selectedSlotItems.findIndex(
      item => item.courtId === court.id && item.startTime === slot.startTime
    );

    if (existingIndex > -1) {
      // Toggle OFF
      selectedSlotItems.splice(existingIndex, 1);
    } else {
      // Toggle ON
      selectedSlotItems.push({
        courtId: court.id,
        courtName: court.name,
        startTime: slot.startTime,
        endTime: slot.endTime,
        startLabel: slot.startLabel,
        endLabel: slot.endLabel,
        rate: parseFloat(court.pricePerHour || 350)
      });
    }

    // Sort by court then start time
    selectedSlotItems.sort((a, b) => {
      if (a.courtId !== b.courtId) return a.courtId - b.courtId;
      return a.startTime.localeCompare(b.startTime);
    });

    // Re-render visual selection and bottom action rail
    updateMatrixVisualSelection();
    updateFloatingRail();
  }

  function updateMatrixVisualSelection() {
    document.querySelectorAll('.matrix-slot-cell').forEach(cell => {
      const cId = parseInt(cell.dataset.courtId, 10);
      const sTime = cell.dataset.startTime;

      if (cell.classList.contains('state-booked') || cell.classList.contains('state-processing') || cell.classList.contains('state-verifying')) {
        return;
      }

      const isSelected = selectedSlotItems.some(item => item.courtId === cId && item.startTime === sTime);
      if (isSelected) {
        cell.className = 'matrix-slot-cell state-selected';
      } else {
        cell.className = 'matrix-slot-cell state-available';
      }
    });
  }

  function formatSlotTimeLabel(timeStr) {
    if (timeStr === '24:00' || timeStr === '00:00') return '12:00 Midnight';
    const parts = timeStr.split(':');
    let h = parseInt(parts[0], 10);
    const m = parts[1] || '00';
    const ampm = h >= 12 ? 'PM' : 'AM';
    h = h % 12 || 12;
    return `${h}:${m} ${ampm}`;
  }

  // Expandable Selected Slots Table Drawer
  let isDrawerOpen = false;

  function toggleSelectedSlotsDrawer(forceState) {
    const drawer = document.getElementById('selectedSlotsDrawer');
    const toggleBtn = document.getElementById('drawerToggleBtn');
    const icon = document.getElementById('drawerToggleIcon');
    const textEl = document.getElementById('drawerToggleText');

    const mobileToggleBtn = document.getElementById('mobileDrawerToggleBtn');
    const mobileIcon = document.getElementById('mobileDrawerToggleIcon');
    const mobileTextEl = document.getElementById('mobileDrawerToggleText');

    if (!drawer) return;

    if (typeof forceState === 'boolean') {
      isDrawerOpen = forceState;
    } else {
      isDrawerOpen = !isDrawerOpen;
    }

    if (isDrawerOpen && selectedSlotItems.length > 0) {
      renderSelectedSlotsDrawer();
      drawer.classList.remove('d-none');
      if (toggleBtn) toggleBtn.classList.add('is-active');
      if (icon) icon.className = 'bi bi-chevron-down';
      if (textEl) textEl.innerText = 'Hide Table';

      if (mobileToggleBtn) mobileToggleBtn.classList.add('is-active');
      if (mobileIcon) mobileIcon.className = 'bi bi-chevron-down';
      if (mobileTextEl) mobileTextEl.innerText = 'Hide';
    } else {
      drawer.classList.add('d-none');
      isDrawerOpen = false;
      if (toggleBtn) toggleBtn.classList.remove('is-active');
      if (icon) icon.className = 'bi bi-chevron-up';
      if (textEl) textEl.innerText = 'View Table';

      if (mobileToggleBtn) mobileToggleBtn.classList.remove('is-active');
      if (mobileIcon) mobileIcon.className = 'bi bi-chevron-up';
      if (mobileTextEl) mobileTextEl.innerText = 'Details';
    }
  }

  function renderSelectedSlotsDrawer() {
    const container = document.getElementById('drawerSlotsTableBody');
    const subtitleEl = document.getElementById('drawerSummarySubtitle');
    const countEl = document.getElementById('drawerSlotsSummaryCount');
    const priceSummaryEl = document.getElementById('drawerTotalPriceSummary');
    if (!container) return;

    if (!selectedSlotItems || selectedSlotItems.length === 0) {
      container.innerHTML = '<div class="text-center py-3 text-white-50 small">No slots selected</div>';
      toggleSelectedSlotsDrawer(false);
      return;
    }

    const totalCount = selectedSlotItems.length;
    const totalPrice = selectedSlotItems.reduce((sum, item) => sum + item.rate, 0);
    const uniqueCourts = [...new Set(selectedSlotItems.map(item => item.courtName))];

    if (subtitleEl) {
      subtitleEl.innerText = `${totalCount} slot${totalCount > 1 ? 's' : ''} across ${uniqueCourts.length} court${uniqueCourts.length > 1 ? 's' : ''}`;
    }
    if (countEl) {
      countEl.innerText = `${totalCount} slot${totalCount > 1 ? 's' : ''} selected`;
    }
    if (priceSummaryEl) {
      priceSummaryEl.innerText = `Total: ₱${totalPrice.toFixed(2)}`;
    }

    let rowsHtml = '';
    selectedSlotItems.forEach(item => {
      rowsHtml += `
        <div class="drawer-slot-card d-flex align-items-center justify-content-between p-2 px-2.5 rounded-3 border border-secondary border-opacity-25" style="background: rgba(255, 255, 255, 0.05);">
          <div class="d-flex align-items-center gap-2 flex-grow-1 min-w-0">
            <span class="badge bg-warning text-dark rounded-pill px-2 py-1 fw-bold flex-shrink-0" style="font-size: 11px;">
              ${item.courtName}
            </span>
            <div class="text-truncate">
              <span class="text-white fw-semibold small d-inline-flex align-items-center gap-1 text-truncate" style="font-size: 12px;">
                <i class="bi bi-clock-history text-warning"></i> ${item.startLabel} – ${item.endLabel}
              </span>
            </div>
          </div>
          <div class="d-flex align-items-center gap-2 flex-shrink-0 ms-2">
            <span class="fw-bold font-monospace text-warning small" style="font-size: 12px;">
              ₱${item.rate.toFixed(2)}
            </span>
            <button type="button" class="drawer-remove-btn" onclick="removeSingleSlot(${item.courtId}, '${item.startTime}')" title="Remove this slot">
              <i class="bi bi-trash3-fill"></i>
            </button>
          </div>
        </div>
      `;
    });

    container.innerHTML = rowsHtml;
  }

  function removeSingleSlot(courtId, startTime) {
    const idx = selectedSlotItems.findIndex(item => item.courtId === courtId && item.startTime === startTime);
    if (idx > -1) {
      selectedSlotItems.splice(idx, 1);
      updateMatrixVisualSelection();
      updateFloatingRail();
      if (selectedSlotItems.length === 0) {
        toggleSelectedSlotsDrawer(false);
      } else {
        renderSelectedSlotsDrawer();
      }
    }
  }

  function updateFloatingRail() {
    const rail = document.getElementById('bookingActionBar');
    if (!selectedSlotItems || selectedSlotItems.length === 0) {
      rail.classList.remove('is-visible');
      toggleSelectedSlotsDrawer(false);
      return;
    }

    const totalCount = selectedSlotItems.length;
    const totalPrice = selectedSlotItems.reduce((sum, item) => sum + item.rate, 0);

    // Group by unique courts
    const uniqueCourts = [...new Set(selectedSlotItems.map(item => item.courtName))];
    let badgeText = '';
    const isMobile = window.innerWidth < 576;
    if (uniqueCourts.length === 1) {
      badgeText = uniqueCourts[0];
    } else if (uniqueCourts.length <= 2 && !isMobile) {
      badgeText = `${uniqueCourts.length} Courts (${uniqueCourts.join(', ')})`;
    } else {
      badgeText = `${uniqueCourts.length} Courts`;
    }

    let timeSummaryText = '';
    if (totalCount === 1) {
      const item = selectedSlotItems[0];
      timeSummaryText = `${item.startLabel} - ${item.endLabel} (1 hr)`;
    } else {
      timeSummaryText = `${totalCount} Hours / Slots Selected`;
    }

    // Desktop elements
    const dBadge = document.getElementById('railCourtBadge');
    const dSlots = document.getElementById('railTimeSlotsText');
    const dPrice = document.getElementById('railTotalPrice');
    if (dBadge) dBadge.innerText = badgeText;
    if (dSlots) dSlots.innerText = timeSummaryText;
    if (dPrice) dPrice.innerText = `₱${totalPrice.toFixed(2)}`;

    // Mobile elements
    const mBadge = document.getElementById('mobileRailCourtBadge');
    const mSlots = document.getElementById('mobileRailSlotsText');
    const mPrice = document.getElementById('mobileRailTotalPrice');
    if (mBadge) mBadge.innerText = `${uniqueCourts.length} Court${uniqueCourts.length > 1 ? 's' : ''}`;
    if (mSlots) mSlots.innerText = `${totalCount} Slot${totalCount > 1 ? 's' : ''}`;
    if (mPrice) mPrice.innerText = `₱${totalPrice.toFixed(2)}`;

    rail.classList.add('is-visible');

    if (isDrawerOpen) {
      renderSelectedSlotsDrawer();
    }
  }

  function clearSelectedSlots() {
    selectedSlotItems = [];
    updateMatrixVisualSelection();
    toggleSelectedSlotsDrawer(false);
    document.getElementById('bookingActionBar').classList.remove('is-visible');
  }

  // Open Checkout Modal (Strict Player Login Required)
  function openCheckoutModal() {
    if (!selectedSlotItems || selectedSlotItems.length === 0) return;
    toggleSelectedSlotsDrawer(false);

    // Require player login / signup before proceeding to checkout
    if (!currentPlayerUser) {
      openPlayerAuthModal('login', true);
      return;
    }

    const totalCount = selectedSlotItems.length;
    const totalPrice = selectedSlotItems.reduce((sum, item) => sum + item.rate, 0);

    // Group items by court
    const courtMap = {};
    selectedSlotItems.forEach(item => {
      if (!courtMap[item.courtName]) courtMap[item.courtName] = [];
      courtMap[item.courtName].push(item);
    });

    const courtNames = Object.keys(courtMap);
    let slotsDetailHtml = '';

    courtNames.forEach((cName, idx) => {
      const items = courtMap[cName];
      const courtTotal = items.reduce((sum, i) => sum + i.rate, 0);

      // Sort items chronologically
      items.sort((a, b) => a.startTime.localeCompare(b.startTime));

      // Build clean time slot badge pills
      const slotPills = items.map(item => `
        <span class="badge bg-white text-dark border px-2.5 py-1.5 rounded-3 fw-semibold d-inline-flex align-items-center gap-1 shadow-xs" style="font-size: 11px; border-color: #cbd5e1 !important;">
          <i class="bi bi-clock-history text-primary" style="font-size: 10px;"></i>
          ${item.startLabel} – ${item.endLabel}
        </span>
      `).join('');

      slotsDetailHtml += `
        <div class="${idx > 0 ? 'mt-3 pt-3 border-top' : ''}">
          <div class="d-flex justify-content-between align-items-center mb-2">
            <div class="d-flex align-items-center gap-2">
              <span class="badge bg-warning text-dark rounded-pill px-2.5 py-1 fw-bold" style="font-size: 11.5px;">${cName}</span>
              <span class="text-secondary small fw-medium">${items.length} hr${items.length > 1 ? 's' : ''}</span>
            </div>
            <span class="fw-bold text-dark font-monospace small">₱${courtTotal.toFixed(2)}</span>
          </div>
          <div class="d-flex flex-wrap gap-1">
            ${slotPills}
          </div>
        </div>
      `;
    });

    // Populate Modal Summary
    const hoursEl = document.getElementById('modalSummaryHours');
    if (hoursEl) hoursEl.innerText = `${totalCount} Slot${totalCount > 1 ? 's' : ''}`;

    const dateEl = document.getElementById('modalSummaryDate');
    const displayDateEl = document.getElementById('dateDisplayText');
    if (dateEl && displayDateEl) dateEl.innerText = displayDateEl.innerText;

    const slotsEl = document.getElementById('modalSummarySlots');
    if (slotsEl) slotsEl.innerHTML = slotsDetailHtml;

    const breakdownEl = document.getElementById('modalSummaryBreakdown');
    if (breakdownEl) {
      if (courtNames.length > 1) {
        breakdownEl.innerText = `${totalCount} hours total across ${courtNames.length} courts`;
      } else {
        breakdownEl.innerText = `${totalCount} hour${totalCount > 1 ? 's' : ''} on ${courtNames[0]}`;
      }
    }

    const totalEl = document.getElementById('modalSummaryTotal');
    if (totalEl) totalEl.innerText = `₱${totalPrice.toFixed(2)}`;

    // Ensure player profile fields are populated
    const nameInput = document.getElementById('checkoutUserName');
    const phoneInput = document.getElementById('checkoutUserContact');
    const emailInput = document.getElementById('checkoutUserEmail');
    if (currentPlayerUser) {
      if (nameInput && !nameInput.value) nameInput.value = currentPlayerUser.full_name || currentPlayerUser.username || '';
      if (phoneInput && !phoneInput.value) phoneInput.value = currentPlayerUser.phone || '';
      if (emailInput && !emailInput.value) emailInput.value = currentPlayerUser.email || '';
    }

    // Populate Hidden Form Fields
    document.getElementById('formCourtId').value = selectedSlotItems[0].courtId;
    document.getElementById('formDate').value = currentDate;
    document.getElementById('formStartTime').value = selectedSlotItems[0].startTime;
    document.getElementById('formTotalHours').value = totalCount;
    document.getElementById('formSelectedSlots').value = JSON.stringify(selectedSlotItems);

    const modalEl = document.getElementById('checkoutModal');
    const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
    modal.show();
  }

  // =========================================================
  // PLAYER ACCOUNT MODAL & MY BOOKINGS DASHBOARD FUNCTIONS
  // =========================================================
  function openPlayerAuthModal(mode = 'login', fromCheckout = false) {
    pendingCheckoutAfterAuth = !!fromCheckout;
    switchPlayerAuthModalMode(mode);

    const noticeEl = document.getElementById('playerAuthCheckoutNotice');
    if (noticeEl) {
      if (fromCheckout) {
        noticeEl.classList.remove('d-none');
      } else {
        noticeEl.classList.add('d-none');
      }
    }

    const errBox = document.getElementById('playerAuthErrorBox');
    if (errBox) errBox.classList.add('d-none');

    const modalEl = document.getElementById('playerAuthModal');
    if (modalEl) {
      const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
      modal.show();
    }
  }

  function switchPlayerAuthModalMode(mode) {
    const loginForm = document.getElementById('modalPlayerLoginForm');
    const regForm = document.getElementById('modalPlayerRegisterForm');
    const tabLogin = document.getElementById('modalAuthTabLogin');
    const tabReg = document.getElementById('modalAuthTabRegister');
    const titleEl = document.getElementById('playerAuthModalTitle');
    const errBox = document.getElementById('playerAuthErrorBox');
    if (errBox) errBox.classList.add('d-none');

    if (mode === 'register') {
      if (loginForm) loginForm.classList.add('d-none');
      if (regForm) regForm.classList.remove('d-none');
      if (tabReg) tabReg.className = 'flex-fill btn rounded-0 py-2.5 fw-bold small border-0 bg-white text-primary border-bottom border-2 border-primary';
      if (tabLogin) tabLogin.className = 'flex-fill btn rounded-0 py-2.5 fw-bold small border-0 text-secondary';
      if (titleEl) titleEl.innerText = 'Create Player Account';
    } else {
      if (regForm) regForm.classList.add('d-none');
      if (loginForm) loginForm.classList.remove('d-none');
      if (tabLogin) tabLogin.className = 'flex-fill btn rounded-0 py-2.5 fw-bold small border-0 bg-white text-primary border-bottom border-2 border-primary';
      if (tabReg) tabReg.className = 'flex-fill btn rounded-0 py-2.5 fw-bold small border-0 text-secondary';
      if (titleEl) titleEl.innerText = 'Sign In to Player Account';
    }
  }

  async function handleModalPlayerLogin(e) {
    e.preventDefault();
    const identifier = document.getElementById('modalLoginIdentifier').value.trim();
    const password = document.getElementById('modalLoginPassword').value;
    const btn = document.getElementById('modalLoginSubmitBtn');
    const errBox = document.getElementById('playerAuthErrorBox');

    if (errBox) errBox.classList.add('d-none');
    if (btn) {
      btn.disabled = true;
      btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Signing in...';
    }

    try {
      const res = await fetch('/account/login', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        body: JSON.stringify({ identifier, password })
      });
      const data = await res.json();
      if (!res.ok || !data.success) {
        if (errBox) {
          errBox.innerText = (data && data.error) || 'Sign in failed. Please check your credentials.';
          errBox.classList.remove('d-none');
        }
        return;
      }

      onPlayerAuthenticatedSuccess(data.user, data.message);
    } catch (err) {
      if (errBox) {
        errBox.innerText = 'Network error. Please try again.';
        errBox.classList.remove('d-none');
      }
    } finally {
      if (btn) {
        btn.disabled = false;
        btn.innerHTML = '<i class="bi bi-box-arrow-in-right me-1"></i> Sign In &amp; Continue';
      }
    }
  }

  async function handleModalPlayerRegister(e) {
    e.preventDefault();
    const full_name = document.getElementById('modalRegFullName').value.trim();
    const phone = document.getElementById('modalRegPhone').value.trim();
    const email = document.getElementById('modalRegEmail').value.trim();
    const password = document.getElementById('modalRegPassword').value;
    const confirm_password = document.getElementById('modalRegConfirm').value;
    const btn = document.getElementById('modalRegisterSubmitBtn');
    const errBox = document.getElementById('playerAuthErrorBox');

    if (errBox) errBox.classList.add('d-none');
    if (btn) {
      btn.disabled = true;
      btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Creating account...';
    }

    try {
      const res = await fetch('/account/register', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        body: JSON.stringify({ full_name, phone, email, password, confirm_password })
      });
      const data = await res.json();
      if (!res.ok || !data.success) {
        if (errBox) {
          errBox.innerText = (data && data.error) || 'Could not create account. Please verify your details.';
          errBox.classList.remove('d-none');
        }
        return;
      }

      onPlayerAuthenticatedSuccess(data.user, data.message);
    } catch (err) {
      if (errBox) {
        errBox.innerText = 'Network error. Please try again.';
        errBox.classList.remove('d-none');
      }
    } finally {
      if (btn) {
        btn.disabled = false;
        btn.innerHTML = '<i class="bi bi-person-check-fill me-1"></i> Create Account &amp; Continue';
      }
    }
  }

  function onPlayerAuthenticatedSuccess(userObj, welcomeMessage) {
    currentPlayerUser = userObj;
    applyAuthenticatedUserToUI(userObj);
    refreshMyBookings();

    // Hide Auth Modal
    const authModalEl = document.getElementById('playerAuthModal');
    if (authModalEl) {
      const modalInstance = bootstrap.Modal.getInstance(authModalEl);
      if (modalInstance) modalInstance.hide();
    }

    if (welcomeMessage) {
      showLiveToast(welcomeMessage);
    }

    // If user clicked "Continue to Booking", immediately open Checkout Modal with pre-filled details!
    if (pendingCheckoutAfterAuth && selectedSlotItems && selectedSlotItems.length > 0) {
      pendingCheckoutAfterAuth = false;
      setTimeout(() => {
        openCheckoutModal();
      }, 220);
    }
  }

  function applyAuthenticatedUserToUI(userObj) {
    if (!userObj) return;
    const displayName = userObj.full_name || userObj.username || 'Player';

    // 1. Update top right header controls
    const headerControls = document.getElementById('headerAccountControls');
    if (headerControls) {
      const adminBtn = (userObj.role === 'admin' || userObj.role === 'staff')
        ? `<a href="/admin" class="btn btn-outline-dark btn-sm rounded-pill px-2.5 py-1 fw-semibold" title="Admin Panel"><i class="bi bi-speedometer2"></i></a>`
        : '';
      headerControls.innerHTML = `
        <button type="button" class="btn btn-dark btn-sm rounded-pill px-3 py-1 fw-semibold d-inline-flex align-items-center gap-1.5 shadow-xs" onclick="switchVenueTab('my-bookings')" title="View My Bookings">
          <i class="bi bi-person-check-fill text-warning"></i>
          <span>${displayName}</span>
        </button>
        ${adminBtn}
        <a href="/account/logout" class="btn btn-outline-danger btn-sm rounded-pill px-2.5 py-1 fw-semibold" title="Sign Out">
          <i class="bi bi-box-arrow-right"></i>
        </a>
      `;
    }

    // 2. Pre-fill Checkout Modal inputs
    const nameInput = document.getElementById('checkoutUserName');
    const phoneInput = document.getElementById('checkoutUserContact');
    const emailInput = document.getElementById('checkoutUserEmail');
    if (nameInput) nameInput.value = displayName;
    if (phoneInput) phoneInput.value = userObj.phone || '';
    if (emailInput) emailInput.value = userObj.email || '';

    // 3. Toggle My Bookings tab guest vs authenticated view
    const guestCard = document.getElementById('myBookingsGuestCard');
    const userDash = document.getElementById('myBookingsUserDashboard');
    if (guestCard) guestCard.classList.add('d-none');
    if (userDash) userDash.classList.remove('d-none');

    const dName = document.getElementById('dashboardPlayerName');
    const dPhone = document.getElementById('dashboardPlayerPhone');
    const dEmail = document.getElementById('dashboardPlayerEmail');
    if (dName) dName.innerText = displayName;
    if (dPhone) dPhone.innerHTML = `<i class="bi bi-phone-fill text-primary me-1"></i>${userObj.phone || '—'}`;
    if (dEmail) {
      if (userObj.email) {
        dEmail.innerHTML = `<i class="bi bi-envelope-fill text-secondary me-1"></i>${userObj.email}`;
        dEmail.classList.remove('d-none');
      } else {
        dEmail.classList.add('d-none');
      }
    }
  }

  async function refreshMyBookings() {
    if (!currentPlayerUser) return;
    try {
      const res = await fetch('/api/my-bookings', {
        headers: { 'Accept': 'application/json' }
      });
      if (res.ok) {
        const data = await res.json();
        if (data.success && Array.isArray(data.bookings)) {
          myBookingsData = data.bookings;
          renderMyBookingsList();
        }
      }
    } catch (e) {
      console.warn('Could not refresh bookings:', e);
    }
  }

  function renderMyBookingsList() {
    const container = document.getElementById('myBookingsListContainer');
    const badgeEl = document.getElementById('myBookingsTabBadge');

    if (badgeEl) {
      if (myBookingsData && myBookingsData.length > 0) {
        badgeEl.innerText = myBookingsData.length;
        badgeEl.classList.remove('d-none');
      } else {
        badgeEl.classList.add('d-none');
      }
    }

    if (!container) return;

    if (!myBookingsData || myBookingsData.length === 0) {
      container.innerHTML = `
        <div class="card border-0 shadow-sm rounded-4 p-5 bg-white text-center">
          <div class="badge bg-light text-secondary rounded-circle p-3 mb-3 fs-3 d-inline-flex align-items-center justify-content-center mx-auto" style="width: 60px; height: 60px;">
            <i class="bi bi-calendar2-x"></i>
          </div>
          <h5 class="fw-bold text-dark font-display mb-1">No Court Reservations Yet</h5>
          <p class="text-secondary small mb-3">Once you book a court, your active holds, upcoming sessions, and digital passes will appear right here.</p>
          <div>
            <button type="button" class="btn btn-book-now-gold rounded-pill px-4 py-2 fw-bold" onclick="switchVenueTab('book')">
              <i class="bi bi-calendar2-check-fill me-1"></i> Browse Available Courts
            </button>
          </div>
        </div>
      `;
      return;
    }

    let html = '<div class="d-flex flex-column gap-3">';
    myBookingsData.forEach(b => {
      const isAwaitingPay = b.status === 'AWAITING_PAYMENT';
      const isVerifying = b.status === 'AWAITING_CONFIRMATION';
      const isConfirmed = b.status === 'CONFIRMED';
      const isExpired = b.status === 'EXPIRED' || (isAwaitingPay && b.expires_at && new Date() > new Date(b.expires_at));

      let statusBadge = '';
      if (isConfirmed) {
        statusBadge = `<span class="badge bg-success text-white rounded-pill px-3 py-1 fw-bold"><i class="bi bi-check-circle-fill me-1"></i>Confirmed</span>`;
      } else if (isVerifying) {
        statusBadge = `<span class="badge bg-info text-dark rounded-pill px-3 py-1 fw-bold"><i class="bi bi-clock-history me-1"></i>Verifying Payment</span>`;
      } else if (isAwaitingPay && !isExpired) {
        statusBadge = `<span class="badge bg-warning text-dark rounded-pill px-3 py-1 fw-bold"><i class="bi bi-hourglass-split me-1"></i>Awaiting GCash Payment</span>`;
      } else if (isExpired) {
        statusBadge = `<span class="badge bg-secondary text-white rounded-pill px-3 py-1 fw-semibold">Expired Hold</span>`;
      } else {
        statusBadge = `<span class="badge bg-danger text-white rounded-pill px-3 py-1 fw-semibold">${b.status}</span>`;
      }

      const dateFormatted = new Date(b.reservation_date + 'T00:00:00').toLocaleDateString('en-US', {
        weekday: 'short',
        month: 'short',
        day: 'numeric',
        year: 'numeric'
      });

      const courtsHtml = (b.courts || []).map(c => {
        const startLbl = formatSlotTimeLabel(c.start_time);
        const endLbl = formatSlotTimeLabel(c.end_time);
        return `
          <div class="d-flex align-items-center justify-content-between py-1.5 px-2.5 rounded-3 bg-light border mb-1">
            <div class="d-flex align-items-center gap-2">
              <span class="badge bg-warning text-dark rounded-pill px-2 py-1 fw-bold" style="font-size: 11px;">${c.court_name}</span>
              <span class="small fw-semibold text-dark">${startLbl} – ${endLbl}</span>
              <span class="text-muted small">(${c.hours} hr${c.hours > 1 ? 's' : ''})</span>
            </div>
            <span class="small fw-bold font-monospace text-dark">₱${parseFloat(c.amount || 0).toFixed(2)}</span>
          </div>
        `;
      }).join('');

      let actionButtons = '';
      if (isAwaitingPay && !isExpired) {
        actionButtons = `
          <a href="/payment/gcash?ref=${encodeURIComponent(b.reference_number)}" class="btn btn-book-now-gold btn-sm rounded-pill px-3 py-1.5 fw-bold">
            <i class="bi bi-qr-code-scan me-1"></i>Resume GCash Payment &rarr;
          </a>
        `;
      } else {
        actionButtons = `
          <a href="/reservations/${encodeURIComponent(b.reference_number)}" class="btn btn-outline-primary btn-sm rounded-pill px-3 py-1.5 fw-bold">
            <i class="bi bi-ticket-perforated me-1"></i>View Pass / Receipt &rarr;
          </a>
        `;
      }

      html += `
        <div class="card border-0 shadow-sm rounded-4 p-3 p-md-4 bg-white">
          <div class="d-flex flex-column flex-sm-row align-items-start align-items-sm-center justify-content-between gap-2 pb-3 mb-3 border-bottom">
            <div class="d-flex align-items-center gap-2 flex-wrap">
              <span class="badge bg-dark text-warning font-monospace px-2.5 py-1.5 rounded-3 fs-6">${b.reference_number}</span>
              <span class="fw-bold text-dark"><i class="bi bi-calendar3 text-primary me-1"></i>${dateFormatted}</span>
            </div>
            <div>${statusBadge}</div>
          </div>

          <div class="mb-3">
            ${courtsHtml}
          </div>

          <div class="d-flex flex-column flex-sm-row align-items-start align-items-sm-center justify-content-between gap-2 pt-2 border-top">
            <div>
              <span class="text-muted small">Total Order Amount (${b.total_hours} hr${b.total_hours > 1 ? 's' : ''}):</span>
              <span class="fw-extrabold text-primary fs-5 ms-1 font-display">₱${parseFloat(b.total_amount || 0).toFixed(2)}</span>
            </div>
            <div class="d-flex align-items-center gap-2">
              ${actionButtons}
            </div>
          </div>
        </div>
      `;
    });
    html += '</div>';
    container.innerHTML = html;
  }

  // Share venue link
  function shareVenueLink() {
    if (navigator.clipboard) {
      navigator.clipboard.writeText(window.location.origin + window.location.pathname);
      showLiveToast('Venue link copied to clipboard!');
    }
  }

  function showLiveToast(msg) {
    const toastEl = document.getElementById('liveToast');
    if (toastEl) {
      document.getElementById('toastMessage').innerText = msg;
      const toast = new bootstrap.Toast(toastEl);
      toast.show();
    }
  }

  // Real-time Socket.io listener for live matrix sync
  function initMatrixSocket() {
    if (typeof io !== 'undefined') {
      const socket = io();
      socket.on('reservation:created', function (data) {
        if (data.reservation_date === currentDate) {
          fetchMatrixAvailability(currentDate);
          showLiveToast(`New reservation on Court ${data.court_id} at ${data.start_time}`);
        }
      });
      socket.on('reservation:cancelled', function (data) {
        fetchMatrixAvailability(currentDate);
      });
      socket.on('reservation:expired', function (data) {
        fetchMatrixAvailability(currentDate);
      });
    }
  }

  // Leaflet Map Initialization
  function initLeafletMap() {
    if (mapInitialized) {
      leafletMap.invalidateSize();
      return;
    }

    const lat = 8.467594;
    const lng = 124.662773;

    const googleSatellite = L.tileLayer('https://mt1.google.com/vt/lyrs=y&x={x}&y={y}&z={z}', {
      maxZoom: 20,
      attribution: '&copy; Google Satellite'
    });

    const googleStreets = L.tileLayer('https://mt1.google.com/vt/lyrs=m&x={x}&y={y}&z={z}', {
      maxZoom: 20,
      attribution: '&copy; Google Maps'
    });

    leafletMap = L.map('facilityMap', {
      center: [lat, lng],
      zoom: 18,
      layers: [googleSatellite],
      scrollWheelZoom: false
    });

    L.control.layers({
      "🛰️ Google Satellite": googleSatellite,
      "🗺️ Google Streets": googleStreets
    }).addTo(leafletMap);

    const marker = L.marker([lat, lng]).addTo(leafletMap);
    marker.bindPopup(`
      <div style="font-family: inherit; padding: 4px; min-width: 180px;">
        <strong style="color: #0B2545; font-size: 14px;">🏓 The Playground Pickleball</strong><br>
        <span style="font-size: 11px; color: #555;">Piot Heights, Buntong, Camaman-an, CDO</span><br>
        <div style="font-size: 11px; color: #777; margin-top: 2px;">4 Tournament Covered Courts</div>
        <div class="mt-2 pt-1 border-top">
          <a href="https://www.google.com/maps/dir/?api=1&destination=${lat},${lng}" target="_blank" style="font-size: 11px; color: #0284c7; text-decoration: none; font-weight: bold;">
            <i class="bi bi-cursor-fill me-1"></i>Start Navigation &rarr;
          </a>
        </div>
      </div>
    `).openPopup();

    mapInitialized = true;
  }

  // Lightbox Photo Viewer
  const galleryItems = [
    {
      src: '/images/3ks-playground.jpg',
      title: 'Championship 4-Court Covered Arena'
    },
    {
      src: '/images/3ks-layout.jpg',
      title: 'Architectural Court Layout & 5M Center Walkway'
    }
  ];

  let currentLightboxIndex = 0;
  let lightboxModalInstance = null;

  function openPhotoLightbox(src, title) {
    const idx = galleryItems.findIndex(item => item.src === src);
    currentLightboxIndex = idx >= 0 ? idx : 0;
    updateLightboxContent();

    const modalEl = document.getElementById('photoLightboxModal');
    if (modalEl) {
      if (!lightboxModalInstance) {
        lightboxModalInstance = new bootstrap.Modal(modalEl);
      }
      lightboxModalInstance.show();
    }
  }

  function updateLightboxContent() {
    const item = galleryItems[currentLightboxIndex];
    if (!item) return;
    const imgEl = document.getElementById('lightboxModalImg');
    const titleEl = document.getElementById('lightboxModalTitle');
    const counterEl = document.getElementById('lightboxModalCounter');
    if (imgEl) {
      imgEl.src = item.src;
      imgEl.alt = item.title;
    }
    if (titleEl) titleEl.textContent = item.title;
    if (counterEl) counterEl.textContent = `${currentLightboxIndex + 1} / ${galleryItems.length}`;
  }

  function navigateLightbox(direction) {
    currentLightboxIndex = (currentLightboxIndex + direction + galleryItems.length) % galleryItems.length;
    updateLightboxContent();
  }

  // Keyboard navigation for lightbox
  document.addEventListener('keydown', function(e) {
    const modalEl = document.getElementById('photoLightboxModal');
    if (modalEl && modalEl.classList.contains('show')) {
      if (e.key === 'ArrowLeft') {
        navigateLightbox(-1);
      } else if (e.key === 'ArrowRight') {
        navigateLightbox(1);
      }
    }
  });
</script>
