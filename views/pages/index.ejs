  function triggerBrowserNotification(title, body) {
    try {
      if (!('Notification' in window)) return;
      if (Notification.permission === 'granted') {
        new Notification(title, { body, icon: '/images/logo.png' });
      } else if (Notification.permission !== 'denied') {
        Notification.requestPermission().then(function (perm) {
          if (perm === 'granted') {
            new Notification(title, { body, icon: '/images/logo.png' });
          }
        }).catch(() => {});
      }
    } catch (e) {}
  }

  // =========================================================
  // 15-MINUTE INACTIVITY SESSION TIMEOUT & AUTO-CLOSEOUT
  // =========================================================
  const CLIENT_SESSION_TIMEOUT_MS = 15 * 60 * 1000; // 15 minutes
  const CLIENT_SESSION_WARN_MS = 14 * 60 * 1000;    // Warn at 14 minutes (60s left)
  let lastUserActivityTs = Date.now();
  let sessionWarningShown = false;

  function resetUserActivityTimer() {
    lastUserActivityTs = Date.now();
    sessionWarningShown = false;
  }

  function handleClientSessionLogout(showTimeoutAlert = true) {
    if (!currentPlayerUser) return;
    currentPlayerUser = null;
    myBookingsData = [];
    accountChatMessages = [];
    updateChatUnreadBadges(0);
    if (showTimeoutAlert) {
      clearSelectedSlots();
    }

    // 1. Reset top right header controls to 1-line dynamic Sign In / Sign Up pills
    const headerControls = document.getElementById('headerAccountControls');
    if (headerControls) {
      headerControls.innerHTML = `
        <button type="button" class="btn btn-outline-dark dynamic-action-pill" onclick="openPlayerAuthModal('login', false)" title="Sign In">
          <i class="bi bi-box-arrow-in-right"></i>
          <span class="dynamic-pill-label">Sign In</span>
        </button>
        <button type="button" class="btn btn-book-now-gold dynamic-action-pill" onclick="openPlayerAuthModal('register', false)" title="Sign Up">
          <i class="bi bi-person-plus-fill"></i>
          <span class="dynamic-pill-label">Sign Up</span>
        </button>
      `;
    }

    // 2. Reset Mobile Bottom Nav Account button
    const mobAccIcon = document.getElementById('mobileNavAccountIcon');
    const mobAccLabel = document.getElementById('mobileNavAccountLabel');
    if (mobAccIcon) mobAccIcon.className = 'bi bi-person-circle';
    if (mobAccLabel) mobAccLabel.innerText = 'Sign In';

    // 3. Hide floating Account Chat button & switch My Bookings tab back to Guest card
    const fabWrap = document.getElementById('accountChatFabWrap');
    if (fabWrap) fabWrap.classList.remove('d-md-block');
    const guestCard = document.getElementById('myBookingsGuestCard');
    const userDash = document.getElementById('myBookingsUserDashboard');
    if (guestCard) guestCard.classList.remove('d-none');
    if (userDash) userDash.classList.add('d-none');

    // 4. Close any open account/checkout modals
    ['checkoutModal', 'accountChatModal', 'accountReceiptModal', 'accountMessengerModal'].forEach(id => {
      const el = document.getElementById(id);
      if (el) {
        const inst = bootstrap.Modal.getInstance(el);
        if (inst) inst.hide();
      }
    });

    renderMyBookingsList();
    fetchMatrixAvailability(currentDate, true);

    if (showTimeoutAlert) {
      const msg = '🔒 Session Timed Out: Your account session was automatically closed after 15 minutes of inactivity.';
      showLiveToast(msg);
      triggerBrowserNotification('Session Timed Out — The Playground Pickleball', msg);
    }
  }

  function initSessionTimeoutWatcher() {
    ['mousemove', 'mousedown', 'keydown', 'touchstart', 'scroll', 'click'].forEach(evt => {
      window.addEventListener(evt, resetUserActivityTimer, { passive: true });
    });

    setInterval(async function () {
      if (!currentPlayerUser) return;
      const idleMs = Date.now() - lastUserActivityTs;

      if (idleMs >= CLIENT_SESSION_TIMEOUT_MS) {
        try {
          await fetch('/account/logout?timeout=1', {
            headers: { 'Accept': 'application/json' }
          });
        } catch (e) {}
        handleClientSessionLogout(true);
      } else if (idleMs >= CLIENT_SESSION_WARN_MS && !sessionWarningShown) {
        sessionWarningShown = true;
        const warnMsg = '⏳ Session Timeout Warning: Your session will close in 60 seconds due to inactivity. Tap or move anywhere to stay signed in.';
        showLiveToast(warnMsg);
        triggerBrowserNotification('Session Expiring Soon', warnMsg);
      }
    }, 5000);
  }

  // Real-time Socket.io listener + Auto-Sync for live matrix, account Messenger sync & In-App Account Chat
  function initMatrixSocket() {
    if (typeof io !== 'undefined') {
      const socket = io();

      // Primary backend event emitted when any player books, submits GCash proof, or Admin confirms/cancels
      socket.on('court_availability_updated', function (data) {
        if (!data || !data.date || data.date === currentDate) {
          fetchMatrixAvailability(currentDate, true);
        }
        fetchCalendarMonthStatus(calendarViewYear, calendarViewMonth, true);
        if (currentPlayerUser) {
          refreshMyBookings();
        }
      });

      socket.on('court_blocks_updated', function (data) {
        fetchCalendarMonthStatus(calendarViewYear, calendarViewMonth, true);
      });

      socket.on('payment_submitted_for_approval', function (data) {
        if (!data || !data.date || data.date === currentDate) {
          fetchMatrixAvailability(currentDate, true);
        }
        fetchCalendarMonthStatus(calendarViewYear, calendarViewMonth, true);
        if (currentPlayerUser) {
          refreshMyBookings();
        }
      });

      socket.on('payment_confirmed', function (data) {
        if (!data || !data.date || data.date === currentDate) {
          fetchMatrixAvailability(currentDate, true);
        }
        fetchCalendarMonthStatus(calendarViewYear, calendarViewMonth, true);
        if (currentPlayerUser) {
          refreshMyBookings();
        }
      });

      // Emitted when an unpaid 15-minute hold times out and is automatically cancelled
      socket.on('reservation_hold_expired', function (data) {
        fetchMatrixAvailability(currentDate, true);
        if (!currentPlayerUser || !data) return;

        const isMyExpiredHold =
          (data.userId && Number(data.userId) === Number(currentPlayerUser.id)) ||
          (data.userPhone && currentPlayerUser.phone && data.userPhone === currentPlayerUser.phone) ||
          (data.reference && (myBookingsData || []).some(b => b.reference_number === data.reference));

        if (isMyExpiredHold) {
          const alertMsg = data.message || `⏰ Your unpaid court hold (#${data.reference}) timed out and was automatically cancelled.`;
          showLiveToast(alertMsg);
          triggerBrowserNotification('Unpaid Court Hold Cancelled', alertMsg);
          refreshMyBookings();
          fetchAccountChat(false);
        }
      });

      socket.on('reservation:created', function (data) {
        if (!data || !data.reservation_date || data.reservation_date === currentDate) {
          fetchMatrixAvailability(currentDate, true);
        }
      });
      socket.on('reservation:cancelled', function () {
        fetchMatrixAvailability(currentDate, true);
      });
      socket.on('reservation:expired', function () {
        fetchMatrixAvailability(currentDate, true);
      });

      socket.on('player_messenger_bound', function (data) {
        if (currentPlayerUser && (data.userId === currentPlayerUser.id || (data.bindingCode && data.bindingCode === currentPlayerUser.binding_code))) {
          currentPlayerUser.fb_psid = data.psid;
          applyAuthenticatedUserToUI(currentPlayerUser);
          showLiveToast('Messenger Alerts connected to your account!');
        }
      });

      socket.on('chat:new_message', function (msg) {
        if (!currentPlayerUser || Number(msg.user_id) !== Number(currentPlayerUser.id)) return;

        const exists = accountChatMessages.some(m => m.id === msg.id);
        if (!exists) {
          accountChatMessages.push(msg);
        }

        const chatModalEl = document.getElementById('accountChatModal');
        const isChatOpen = chatModalEl && chatModalEl.classList.contains('show');
        renderAccountChatMessages(true);

        if (isChatOpen) {
          fetch('/api/account/chat/read', { method: 'POST' }).catch(() => {});
          updateChatUnreadBadges(0);
        } else if (msg.sender_role !== 'player') {
          updateChatUnreadBadges(accountChatUnreadCount + 1);
          const toastText = msg.sender_role === 'admin'
            ? `💬 New message from ${msg.sender_name || 'The Playground Admin'} in your Account Chat!`
            : `🔔 Booking update posted to your Account Chat (${msg.booking_ref || ''})!`;
          showLiveToast(toastText);
          triggerBrowserNotification('The Playground Pickleball', toastText);
        }

        if (msg.sender_role === 'system') {
          refreshMyBookings();
          fetchMatrixAvailability(currentDate, true);
        }
      });
    }

    // Automatic silent heartbeat sync every 8s + on tab focus/visibility (catches 15-min hold expirations & mobile wakeups)
    setInterval(function () {
      if (document.visibilityState === 'visible') {
        fetchMatrixAvailability(currentDate, true);
      }
    }, 8000);

    document.addEventListener('visibilitychange', function () {
      if (document.visibilityState === 'visible') {
        fetchMatrixAvailability(currentDate, true);
        if (currentPlayerUser) {
          refreshMyBookings();
        }
      }
    });
  }

  // Leaflet Map Initialization
  function initLeafletMap() {
    if (mapInitialized) {
      leafletMap.invalidateSize();
      return;
    }

    const lat = 8.467594;
    const lng = 124.662773;

    const googleSatellite = L.tileLayer('https://mt1.google.com/vt/lyrs=y&x={x}&y={y}&z={z}', {
      maxZoom: 20,
      attribution: '&copy; Google Satellite'
    });

    const googleStreets = L.tileLayer('https://mt1.google.com/vt/lyrs=m&x={x}&y={y}&z={z}', {
      maxZoom: 20,
      attribution: '&copy; Google Maps'
    });

    leafletMap = L.map('facilityMap', {
      center: [lat, lng],
      zoom: 18,
      layers: [googleSatellite],
      scrollWheelZoom: false
    });

    L.control.layers({
      "🛰️ Google Satellite": googleSatellite,
      "🗺️ Google Streets": googleStreets
    }).addTo(leafletMap);

    const marker = L.marker([lat, lng]).addTo(leafletMap);
    marker.bindPopup(`
      <div style="font-family: inherit; padding: 4px; min-width: 180px;">
        <strong style="color: #0B2545; font-size: 14px;">🏓 The Playground Pickleball</strong><br>
        <span style="font-size: 11px; color: #555;">Piot Heights, Buntong, Camaman-an, CDO</span><br>
        <div style="font-size: 11px; color: #777; margin-top: 2px;">4 Tournament Covered Courts</div>
        <div class="mt-2 pt-1 border-top">
          <a href="https://www.google.com/maps/dir/?api=1&destination=${lat},${lng}" target="_blank" style="font-size: 11px; color: #0284c7; text-decoration: none; font-weight: bold;">
            <i class="bi bi-cursor-fill me-1"></i>Start Navigation &rarr;
          </a>
        </div>
      </div>
    `).openPopup();

    mapInitialized = true;
  }

  // Lightbox Photo Viewer
  const galleryItems = [
    {
      src: '/images/3ks-playground.jpg',
      title: 'Championship 4-Court Covered Arena'
    },
    {
      src: '/images/3ks-layout.jpg',
      title: 'Architectural Court Layout & 5M Center Walkway'
    }
  ];

  let currentLightboxIndex = 0;
  let lightboxModalInstance = null;

  function openPhotoLightbox(src, title) {
    const idx = galleryItems.findIndex(item => item.src === src);
    currentLightboxIndex = idx >= 0 ? idx : 0;
    updateLightboxContent();

    const modalEl = document.getElementById('photoLightboxModal');
    if (modalEl) {
      if (!lightboxModalInstance) {
        lightboxModalInstance = new bootstrap.Modal(modalEl);
      }
      lightboxModalInstance.show();
    }
  }

  function updateLightboxContent() {
    const item = galleryItems[currentLightboxIndex];
    if (!item) return;
    const imgEl = document.getElementById('lightboxModalImg');
    const titleEl = document.getElementById('lightboxModalTitle');
    const counterEl = document.getElementById('lightboxModalCounter');
    if (imgEl) {
      imgEl.src = item.src;
      imgEl.alt = item.title;
    }
    if (titleEl) titleEl.textContent = item.title;
    if (counterEl) counterEl.textContent = `${currentLightboxIndex + 1} / ${galleryItems.length}`;
  }

  function navigateLightbox(direction) {
    currentLightboxIndex = (currentLightboxIndex + direction + galleryItems.length) % galleryItems.length;
    updateLightboxContent();
  }

  // Keyboard navigation for lightbox
  document.addEventListener('keydown', function(e) {
    const modalEl = document.getElementById('photoLightboxModal');
    if (modalEl && modalEl.classList.contains('show')) {
      if (e.key === 'ArrowLeft') {
        navigateLightbox(-1);
      } else if (e.key === 'ArrowRight') {
        navigateLightbox(1);
      }
    }
  });
</script>
