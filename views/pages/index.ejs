<% 
  const defaultCat = (categories && categories.length > 0) ? categories[0] : null;
  const activeRate = defaultCat ? parseFloat(defaultCat.price_per_hour) : 350;
%>
<!-- Hero Section (Compact Mobile Optimized) -->
<section class="hero-section text-white py-4 py-md-5 position-relative overflow-hidden" style="background: linear-gradient(135deg, #0b3b24 0%, #157347 50%, #198754 100%);">
  <div class="container py-2 py-md-4 position-relative">
    <div class="row align-items-center g-3 g-md-5">
      <div class="col-lg-7">
        <span class="badge bg-light text-success px-3 py-1 rounded-pill fw-bold mb-2 d-inline-flex align-items-center shadow-sm">
          <i class="bi bi-star-fill text-warning me-1"></i>PLAY • TRAIN • COMPETE • HAVE FUN
        </span>
        <h1 class="display-4 fw-bold text-white mb-2" style="text-shadow: 0 2px 4px rgba(0,0,0,0.3);">
          3KS <span class="text-warning">Pickleball Playground</span>
        </h1>
        <p class="lead text-white mb-3" style="opacity: 0.95;">
          4 covered tournament courts for <strong class="text-warning"><%= formatCurrency(activeRate) %> / hour</strong>. Instant booking & GCash QR payment.
        </p>
        <div class="d-flex flex-wrap gap-2 mb-2">
          <a href="/reservations" class="btn btn-warning btn-lg px-4 py-2 rounded-pill fw-bold shadow text-dark d-flex align-items-center">
            <i class="bi bi-calendar2-plus-fill me-2"></i>Book a Court (<%= formatCurrency(activeRate) %>/hr)
          </a>
          <a href="/courts" class="btn btn-outline-light btn-lg px-3 py-2 rounded-pill fw-semibold">
            <i class="bi bi-grid-fill me-1"></i>Facility Layout
          </a>
        </div>

        <div class="row g-2 g-md-4 mt-2 pt-2 border-top border-white border-opacity-25 hero-stats-box">
          <div class="col-6 col-md-3">
            <h3 class="fw-bold mb-0 text-white"><%= defaultCat ? defaultCat.total_courts : 4 %></h3>
            <p class="small text-white text-opacity-75 mb-0">Covered Courts</p>
          </div>
          <div class="col-6 col-md-3">
            <h3 class="fw-bold mb-0 text-white"><%= formatCurrency(activeRate) %></h3>
            <p class="small text-white text-opacity-75 mb-0">Per Hour</p>
          </div>
          <div class="col-6 col-md-3">
            <h3 class="fw-bold mb-0 text-white">100%</h3>
            <p class="small text-white text-opacity-75 mb-0">Real-Time Sync</p>
          </div>
          <div class="col-6 col-md-3">
            <h3 class="fw-bold mb-0 text-white">GCash</h3>
            <p class="small text-white text-opacity-75 mb-0">Instant QR</p>
          </div>
        </div>
      </div>
      <div class="col-lg-5 d-none d-md-block">
        <div class="card border-0 shadow-lg rounded-4 overflow-hidden bg-white text-dark p-3">
          <img src="<%= (defaultCat && defaultCat.image_url) ? defaultCat.image_url : '/images/3ks-playground.jpg' %>" alt="3KS Pickleball Playground" class="rounded-3 img-fluid mb-2 object-fit-cover" style="height: 220px; width: 100%;">
          <div class="p-1">
            <div class="d-flex justify-content-between align-items-center mb-1">
              <h6 class="fw-bold mb-0 text-dark">Covered 4-Court Arena</h6>
              <span class="badge bg-success"><%= formatCurrency(activeRate) %>/hr</span>
            </div>
            <p class="small text-secondary mb-2" style="font-size: 12px;">Courts 1, 2, 3, 4 with coffee shop, lounge & dressing rooms.</p>
            <a href="/reservations" class="btn btn-primary w-100 fw-bold py-2 rounded-pill shadow-sm">
              <i class="bi bi-lightning-charge-fill me-1"></i>Check Real-Time Slots
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Facility Overview & Courts Section (Compact) -->
<section class="py-3 py-md-5 bg-light">
  <div class="container">
    <!-- Courts List Grid (Immediate Access) -->
    <div class="d-flex justify-content-between align-items-center mb-3">
      <div>
        <h4 class="fw-bold text-dark mb-0">Select Your Court</h4>
        <span class="small text-secondary">Courts 1, 2, 3, 4</span>
      </div>
      <a href="/reservations" class="btn btn-sm btn-success rounded-pill fw-bold px-3">
        Book Any Slot <i class="bi bi-arrow-right"></i>
      </a>
    </div>

    <div class="row g-2 g-md-3 mb-4">
      <% if (categories && categories.length > 0) { %>
        <% categories.forEach(function(cat) { %>
          <% if (cat.courts && cat.courts.length > 0) { %>
            <% cat.courts.forEach(function(court) { %>
              <div class="col-6 col-md-3">
                <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden bg-white court-card">
                  <div class="position-relative">
                    <img src="<%= cat.image_url || '/images/3ks-playground.jpg' %>" class="card-img-top object-fit-cover" style="height: 120px; width: 100%;" alt="<%= court.display_name %>">
                    <span class="badge bg-success position-absolute top-0 end-0 m-1 px-2 py-1 rounded-pill small" style="font-size: 11px;">
                      <%= formatCurrency(cat.price_per_hour) %>/h
                    </span>
                  </div>
                  <div class="card-body p-2 d-flex flex-column">
                    <h6 class="fw-bold text-dark mb-1"><%= court.display_name %></h6>
                    <span class="small text-muted mb-2" style="font-size: 11px;"><i class="bi bi-check-circle-fill text-success me-1"></i>Covered</span>
                    <a href="/reservations?court_id=<%= court.id %>" class="btn btn-success btn-sm rounded-pill fw-semibold py-1 mt-auto">
                      Reserve
                    </a>
                  </div>
                </div>
              </div>
            <% }); %>
          <% } %>
        <% }); %>
      <% } %>
    </div>

    <!-- Facility Layout Blueprint & Amenities -->
    <div class="row g-3">
      <div class="col-md-6">
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden h-100 bg-white">
          <img src="/images/3ks-layout.jpg" alt="3KS Overhead Layout" class="img-fluid w-100 object-fit-cover" style="max-height: 260px;">
          <div class="p-3">
            <h6 class="fw-bold text-dark mb-1">Overhead Court Blueprint</h6>
            <p class="small text-secondary mb-0" style="font-size: 12px;">Courts 1, 2, 3, 4 with 5M center walkway, coffee shop, and dressing rooms.</p>
          </div>
        </div>
      </div>

      <div class="col-md-6">
        <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100 d-flex flex-column justify-content-between">
          <div>
            <h6 class="fw-bold text-dark mb-2">Amenities Included</h6>
            <div class="row g-2 mb-3">
              <div class="col-6">
                <div class="p-2 rounded-3 bg-light border small">
                  <i class="bi bi-grid-fill text-success me-1"></i><strong>4 Courts</strong>
                  <div class="text-muted" style="font-size: 11px;">13.41M x 6.10M each</div>
                </div>
              </div>
              <div class="col-6">
                <div class="p-2 rounded-3 bg-light border small">
                  <i class="bi bi-cup-hot-fill text-warning me-1"></i><strong>Coffee & Store</strong>
                  <div class="text-muted" style="font-size: 11px;">Refreshments</div>
                </div>
              </div>
              <div class="col-6">
                <div class="p-2 rounded-3 bg-light border small">
                  <i class="bi bi-door-open-fill text-primary me-1"></i><strong>2 Dressing Rooms</strong>
                  <div class="text-muted" style="font-size: 11px;">Private Restrooms</div>
                </div>
              </div>
              <div class="col-6">
                <div class="p-2 rounded-3 bg-light border small">
                  <i class="bi bi-people-fill text-info me-1"></i><strong>Player Lounge</strong>
                  <div class="text-muted" style="font-size: 11px;">Spectator Area</div>
                </div>
              </div>
            </div>
          </div>

          <div class="p-2 rounded-3 bg-success-subtle border border-success d-flex justify-content-between align-items-center">
            <div>
              <span class="small text-secondary d-block" style="font-size: 11px;">Rate</span>
              <strong class="text-success"><%= formatCurrency(activeRate) %> / hour</strong>
            </div>
            <a href="/reservations" class="btn btn-sm btn-success fw-bold px-3 py-1 rounded-pill">
              Book Court Now
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Location & Interactive Map Section -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white mt-4">
      <div class="card-body p-3 p-md-4 border-bottom">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2">
          <div>
            <span class="badge bg-success-subtle text-success fw-bold px-2 py-1 small rounded-pill mb-1">
              <i class="bi bi-geo-alt-fill me-1"></i>Facility Location
            </span>
            <h5 class="fw-bold text-dark mb-1">Visit 3KS Pickleball Playground</h5>
            <p class="text-secondary small mb-0">
              <i class="bi bi-pin-map-fill text-danger me-1"></i>Piot Heights, Buntong, Camaman-an, Cagayan de Oro, Philippines
            </p>
          </div>
          <div class="d-flex flex-wrap gap-2">
            <a href="https://www.google.com/maps/dir/?api=1&destination=8.467594,124.662773" target="_blank" rel="noopener noreferrer" class="btn btn-outline-success btn-sm rounded-pill px-3 fw-semibold">
              <i class="bi bi-map me-1"></i>Open Google Maps
            </a>
            <a href="https://waze.com/ul?ll=8.467594,124.662773&navigate=yes" target="_blank" rel="noopener noreferrer" class="btn btn-outline-info btn-sm rounded-pill px-3 fw-semibold">
              <i class="bi bi-compass me-1"></i>Open in Waze
            </a>
          </div>
        </div>
      </div>
      <div id="facilityMap" style="height: 380px; width: 100%; z-index: 1;"></div>
    </div>
  </div>
</section>

<!-- Leaflet Map CSS & JS with Google Satellite Tiles -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin=""/>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    // Exact coordinates of 3KS Playground in Camaman-an
    const lat = 8.467594;
    const lng = 124.662773;

    // Google Satellite with road and place labels
    const googleSatellite = L.tileLayer('https://mt1.google.com/vt/lyrs=y&x={x}&y={y}&z={z}', {
      maxZoom: 20,
      attribution: '&copy; Google Satellite Maps'
    });

    // Google Standard Streets
    const googleStreets = L.tileLayer('https://mt1.google.com/vt/lyrs=m&x={x}&y={y}&z={z}', {
      maxZoom: 20,
      attribution: '&copy; Google Maps'
    });

    // OpenStreetMap
    const osm = L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 19,
      attribution: '&copy; OpenStreetMap'
    });

    const map = L.map('facilityMap', {
      center: [lat, lng],
      zoom: 18,
      layers: [googleSatellite],
      scrollWheelZoom: false
    });

    // Layer control to switch between Satellite and Street views
    const baseMaps = {
      "🛰️ Google Satellite": googleSatellite,
      "🗺️ Google Streets": googleStreets,
      "📍 OpenStreetMap": osm
    };
    L.control.layers(baseMaps).addTo(map);

    // Custom Marker for 3KS Playground
    const marker = L.marker([lat, lng]).addTo(map);
    marker.bindPopup(`
      <div style="font-family: inherit; padding: 4px; min-width: 180px;">
        <strong style="color: #198754; font-size: 13px;">🏓 3KS Pickleball Playground</strong><br>
        <span style="font-size: 11px; color: #333;">Piot Heights, Buntong, Camaman-an</span><br>
        <div style="font-size: 11px; color: #666; margin-top: 2px;">4 Tournament Courts • Covered Arena</div>
        <div class="mt-2 pt-1 border-top">
          <a href="https://www.google.com/maps/dir/?api=1&destination=${lat},${lng}" target="_blank" style="font-size: 11px; color: #0d6efd; text-decoration: none; font-weight: bold;">
            <i class="bi bi-cursor-fill me-1"></i>Start Navigation &rarr;
          </a>
        </div>
      </div>
    `).openPopup();
  });
</script>
