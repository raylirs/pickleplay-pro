        <button type="button" class="btn btn-dark rounded-circle position-absolute top-50 start-0 translate-middle-y ms-2 ms-md-4 p-3 shadow-lg d-flex align-items-center justify-content-center" id="lightboxPrevBtn" onclick="navigateLightbox(-1)" title="Previous photo" style="background: rgba(15,23,42,0.8); border: 1px solid rgba(255,255,255,0.3); width: 48px; height: 48px;">
