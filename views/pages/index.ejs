  function openBookingReceiptModal(refNumber) {
    if (!refNumber) return;
    const booking = (myBookingsData || []).find(item => item.reference_number === refNumber);
    if (!booking) {
      // Fallback to full reservation pass page if not in local array yet
      window.location.href = '/reservations/' + encodeURIComponent(refNumber);
      return;
    }

    const bodyEl = document.getElementById('accountReceiptModalBody');
    const footerEl = document.getElementById('accountReceiptModalFooter');
    if (!bodyEl || !footerEl) return;

    const isConfirmed = booking.status === 'CONFIRMED';
    const isVerifying = booking.status === 'AWAITING_CONFIRMATION';
    const isAwaitingPay = booking.status === 'AWAITING_PAYMENT';
    const isExpired = booking.status === 'EXPIRED' || (isAwaitingPay && booking.expires_at && new Date() > new Date(booking.expires_at));

    let stampClass = 'bg-secondary-subtle text-secondary border-secondary';
    let stampIcon = 'bi-hourglass';
    let stampLabel = booking.status;
    if (isConfirmed) {
      stampClass = 'bg-success-subtle text-success border-success';
      stampIcon = 'bi-patch-check-fill';
      stampLabel = 'PAID & CONFIRMED OFFICIAL RECEIPT';
    } else if (isVerifying) {
      stampClass = 'bg-info-subtle text-dark border-info';
      stampIcon = 'bi-shield-lock-fill';
      stampLabel = 'PAYMENT SUBMITTED · UNDER VERIFICATION';
    } else if (isAwaitingPay && !isExpired) {
      stampClass = 'bg-warning-subtle text-dark border-warning';
      stampIcon = 'bi-exclamation-circle-fill';
      stampLabel = 'UNPAID HOLD · AWAITING GCASH';
    } else if (isExpired) {
      stampClass = 'bg-secondary-subtle text-secondary border-secondary';
      stampIcon = 'bi-clock-history';
      stampLabel = 'EXPIRED RESERVATION HOLD';
    } else if (booking.status === 'CANCELLED') {
      stampClass = 'bg-danger-subtle text-danger border-danger';
      stampIcon = 'bi-x-octagon-fill';
      stampLabel = 'CANCELLED BOOKING RECORD';
    }

    const playDateStr = new Date(booking.reservation_date + 'T00:00:00').toLocaleDateString('en-US', {
      weekday: 'long',
      month: 'long',
      day: 'numeric',
      year: 'numeric'
    });

    const bookedAtStr = booking.created_at
      ? new Date(booking.created_at).toLocaleString('en-US', {
          month: 'short',
          day: 'numeric',
          year: 'numeric',
          hour: 'numeric',
          minute: '2-digit'
        })
      : '—';

    const playerName = booking.user_name || (currentPlayerUser && (currentPlayerUser.full_name || currentPlayerUser.username)) || 'Player';
    const playerPhone = booking.user_contact || (currentPlayerUser && currentPlayerUser.phone) || '—';
    const playerEmail = booking.user_email || (currentPlayerUser && currentPlayerUser.email) || '';

    const itemizedRowsHtml = (booking.courts || []).map(c => {
      const sLbl = formatSlotTimeLabel(c.start_time);
      const eLbl = formatSlotTimeLabel(c.end_time);
      const unitRate = c.hours > 0 ? (parseFloat(c.amount || 0) / c.hours) : parseFloat(c.amount || 0);
