<!-- Hero Section -->
<section class="hero-section text-white py-5 position-relative overflow-hidden" style="background: linear-gradient(135deg, #0b3b24 0%, #157347 50%, #198754 100%);">
  <div class="container py-5 position-relative">
    <div class="row align-items-center g-5">
      <div class="col-lg-7">
        <span class="badge bg-light text-success px-3 py-2 rounded-pill fw-bold mb-3 d-inline-flex align-items-center shadow-sm">
          <i class="bi bi-star-fill text-warning me-2"></i>#1 Pickleball Venue in the Metro
        </span>
        <h1 class="display-4 fw-bold text-white mb-3" style="text-shadow: 0 2px 4px rgba(0,0,0,0.3);">
          Book Your Pickleball Court <span class="text-warning">In Seconds</span>
        </h1>
        <p class="lead text-white mb-4" style="opacity: 0.95; text-shadow: 0 1px 2px rgba(0,0,0,0.2);">
          Experience championship-grade cushioned surfaces, professional LED illumination, and seamless real-time booking with instant GCash payment.
        </p>
        <div class="d-flex flex-wrap gap-3">
          <a href="/reservations" class="btn btn-warning btn-lg px-4 py-3 rounded-pill fw-bold shadow text-dark d-flex align-items-center">
            <i class="bi bi-calendar2-plus-fill me-2"></i>Reserve a Court Now
          </a>
          <a href="/courts" class="btn btn-outline-light btn-lg px-4 py-3 rounded-pill fw-bold">
            <i class="bi bi-grid-fill me-2"></i>Explore Courts
          </a>
        </div>

        <div class="row g-4 mt-4 pt-3 border-top border-white border-opacity-25">
          <div class="col-4">
            <h3 class="fw-bold mb-0 text-white">8+</h3>
            <p class="small text-white text-opacity-75 mb-0">Pro Courts</p>
          </div>
          <div class="col-4">
            <h3 class="fw-bold mb-0 text-white">100%</h3>
            <p class="small text-white text-opacity-75 mb-0">Real-Time Sync</p>
          </div>
          <div class="col-4">
            <h3 class="fw-bold mb-0 text-white">GCash</h3>
            <p class="small text-white text-opacity-75 mb-0">Instant Pay</p>
          </div>
        </div>
      </div>
      <div class="col-lg-5">
        <div class="card border-0 shadow-lg rounded-4 overflow-hidden bg-white text-dark p-3">
          <img src="https://images.unsplash.com/photo-1534438327276-14e5300c3a48?w=800&q=80" alt="Pickleball Court" class="rounded-3 img-fluid mb-3 object-fit-cover" style="height: 220px; width: 100%;">
          <div class="p-2">
            <div class="d-flex justify-content-between align-items-center mb-2">
              <h5 class="fw-bold mb-0 text-dark">Fast Booking Guarantee</h5>
              <span class="badge bg-success">Live Status</span>
            </div>
            <p class="small text-secondary mb-3">Pick your preferred court, select your slot, and secure your game time right now.</p>
            <a href="/reservations" class="btn btn-primary w-100 fw-bold py-2 rounded-pill shadow-sm">
              <i class="bi bi-lightning-charge-fill me-1"></i>Check Real-Time Slots
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Courts Showcase Section -->
<section class="py-5 bg-light">
  <div class="container py-4">
    <div class="text-center mx-auto mb-5" style="max-width: 700px;">
      <span class="badge bg-success-subtle text-success px-3 py-2 rounded-pill fw-bold mb-2">Facility Catalog</span>
      <h2 class="fw-bold text-dark">Pick Your Arena</h2>
      <p class="text-secondary">Choose between indoor air-conditioned tournament courts, covered premium setups, or open-air arenas.</p>
    </div>

    <div class="row g-4">
      <% if (categories && categories.length > 0) { %>
        <% categories.forEach(function(cat) { %>
          <div class="col-md-6 col-lg-4">
            <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden court-card bg-white">
              <div class="position-relative">
                <img src="<%= cat.image_url %>" onerror="this.src='https://images.unsplash.com/photo-1534438327276-14e5300c3a48?w=800&q=80'" class="card-img-top object-fit-cover" style="height: 220px; width: 100%;" alt="<%= cat.name %>">
                <span class="badge bg-dark bg-opacity-75 position-absolute top-0 end-0 m-3 px-3 py-2 rounded-pill fw-bold text-success fs-6 border border-secondary">
                  ₱<%= parseFloat(cat.price_per_hour).toFixed(2) %>/hr
                </span>
                <span class="badge bg-primary position-absolute bottom-0 start-0 m-3 px-3 py-1 rounded-pill fw-semibold">
                  <i class="bi bi-layers-fill me-1"></i><%= cat.courts ? cat.courts.length : cat.total_courts %> Sub-Courts
                </span>
              </div>
              <div class="card-body p-4 d-flex flex-column">
                <h5 class="card-title fw-bold text-dark mb-2"><%= cat.name %></h5>
                <p class="card-text text-secondary small flex-grow-1"><%= cat.description || 'Championship standard court with high-contrast playing surface, professional nets, and LED tournament lighting.' %></p>
                
                <div class="border-top pt-3 mt-3">
                  <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="small text-muted"><i class="bi bi-clock me-1"></i>8 AM - 10 PM</span>
                    <span class="badge bg-success-subtle text-success"><i class="bi bi-check2-circle me-1"></i>GCash Ready</span>
                  </div>
                  <div class="d-grid gap-2">
                    <a href="/reservations?court_id=<%= cat.courts && cat.courts.length > 0 ? cat.courts[0].id : '' %>" class="btn btn-success fw-bold rounded-pill">
                      <i class="bi bi-calendar-plus me-1"></i>Book This Court
                    </a>
                  </div>
                </div>
              </div>
            </div>
          </div>
        <% }); %>
      <% } else { %>
        <div class="col-12 text-center py-5">
          <p class="text-muted">No courts available yet. Admin can add courts in the admin panel.</p>
        </div>
      <% } %>
    </div>
  </div>
</section>

<!-- Features / Value Prop -->
<section class="py-5 bg-white border-top">
  <div class="container py-4">
    <div class="row g-4 text-center">
      <div class="col-md-4">
        <div class="p-4 rounded-4 bg-light h-100">
          <div class="bg-success text-white rounded-circle mx-auto mb-3 d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
            <i class="bi bi-lightning-charge-fill fs-3"></i>
          </div>
          <h5 class="fw-bold mb-2 text-dark">Live Availability</h5>
          <p class="text-secondary small mb-0">Zero double bookings. Court slots update instantly via WebSockets the moment a reservation is initiated.</p>
        </div>
      </div>
      <div class="col-md-4">
        <div class="p-4 rounded-4 bg-light h-100">
          <div class="bg-primary text-white rounded-circle mx-auto mb-3 d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
            <i class="bi bi-wallet2 fs-3"></i>
          </div>
          <h5 class="fw-bold mb-2 text-dark">Instant GCash Checkout</h5>
          <p class="text-secondary small mb-0">Secure your court immediately with QR or mobile payment. Confirmation sent in real-time to your mobile & email.</p>
        </div>
      </div>
      <div class="col-md-4">
        <div class="p-4 rounded-4 bg-light h-100">
          <div class="bg-warning text-dark rounded-circle mx-auto mb-3 d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
            <i class="bi bi-trophy-fill fs-3"></i>
          </div>
          <h5 class="fw-bold mb-2 text-dark">Pro Grade Facilities</h5>
          <p class="text-secondary small mb-0">Non-glare LED tournament lighting, USAPA specification net posts, air-conditioned player lounge, and showers.</p>
        </div>
      </div>
    </div>
  </div>
</section>
