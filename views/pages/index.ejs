  <button type="button" class="mobile-appbar-btn" id="mobile-nav-account" onclick="handleMobileAccountNavClick()">
    <i class="bi <%= (typeof user !== 'undefined' && user) ? 'bi-person-check-fill' : 'bi-person-circle' %>" id="mobileNavAccountIcon"></i>
    <span id="mobileNavAccountLabel"><%= (typeof user !== 'undefined' && user) ? 'Account' : 'Sign In' %></span>
  </button>
</nav>

<!-- =========================================================
     FLOATING IN-APP ACCOUNT CHAT BUTTON (Desktop Logged-in Players)
========================================================= -->
<div id="accountChatFabWrap" class="position-fixed d-none <%= (typeof user !== 'undefined' && user) ? 'd-md-block' : '' %>" style="bottom: 24px; right: 24px; z-index: 1030; transition: bottom 0.25s ease;">
  <button type="button" id="accountChatFabBtn" onclick="openAccountChatModal()" class="btn btn-dark rounded-pill shadow-lg px-3.5 py-2.5 d-flex align-items-center gap-2 border border-warning" style="background: linear-gradient(135deg, #0B2545 0%, #134074 100%);">
    <span class="position-relative d-inline-flex align-items-center justify-content-center bg-warning text-dark rounded-circle" style="width: 32px; height: 32px;">
      <i class="bi bi-chat-dots-fill fs-6"></i>
      <span id="floatingChatBadge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger border border-light d-none" style="font-size: 10px;">0</span>
    </span>
    <div class="text-start d-none d-sm-block pe-1">
      <div class="fw-bold text-white lh-1" style="font-size: 12.5px;">Account Chat</div>
      <div class="text-warning lh-1 mt-0.5" style="font-size: 10px;">Bookings &amp; Admin Support</div>
    </div>
  </button>
</div>

