<!-- =========================================================
     SLOT AWAITING PAYMENT INFO MODAL
========================================================= -->
<div class="modal fade" id="pendingSlotModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content rounded-4 border-0 shadow-lg overflow-hidden">
      <div class="modal-header modal-checkout-header p-4">
        <div>
          <h5 class="modal-title fw-bold font-display text-white mb-0">Court Slot Awaiting Payment</h5>
          <span class="text-white-50 small">Temporary 15-Minute Reservation Hold</span>
        </div>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body p-4 text-center">
        <div class="mb-3">
          <span class="badge bg-warning-subtle text-dark border border-warning px-3 py-1.5 rounded-pill fw-bold" style="font-size: 13px;">
            <i class="bi bi-hourglass-split me-1"></i> Awaiting GCash Payment
          </span>
        </div>
        <p class="text-secondary small mb-3">
          This slot on <strong id="pendingSlotCourtName" class="text-dark">Court</strong> at <strong id="pendingSlotTime" class="text-dark">Time</strong> is currently held while the player completes their GCash QR transfer.
        </p>
        <div class="bg-light p-3 rounded-4 border mb-4 text-start">
          <div class="d-flex justify-content-between align-items-center mb-1">
            <span class="text-muted small">Booking Reference:</span>
            <span class="fw-bold font-monospace text-primary" id="pendingSlotRef">PKL-XXXXXX</span>
          </div>
          <div class="d-flex justify-content-between align-items-center">
            <span class="text-muted small">Hold Expiration:</span>
            <span class="text-dark small fw-semibold">Auto-releases if unpaid in 15 mins</span>
          </div>
        </div>
        <div class="d-flex flex-column gap-2">
          <a id="pendingSlotPayBtn" href="#" class="btn btn-book-now-gold fw-bold rounded-pill py-2.5">
            <i class="bi bi-qr-code-scan me-1"></i> Resume Your GCash Payment &rarr;
          </a>
          <button type="button" class="btn btn-outline-secondary rounded-pill" data-bs-dismiss="modal">Close</button>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- =========================================================
     SLOT VERIFYING INFO MODAL (Awaiting Admin Review)
========================================================= -->
<div class="modal fade" id="verifyingSlotModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content rounded-4 border-0 shadow-lg overflow-hidden">
      <div class="modal-header modal-checkout-header p-4">
        <div>
          <h5 class="modal-title fw-bold font-display text-white mb-0">Payment Received & Verifying</h5>
          <span class="text-white-50 small">The Playground Pickleball · Admin Review</span>
        </div>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body p-4 text-center">
        <div class="mb-3">
          <span class="badge bg-primary-subtle text-primary border border-primary px-3 py-1.5 rounded-pill fw-bold" style="font-size: 13px;">
            <i class="bi bi-clock-history me-1"></i> Under Admin Verification
          </span>
        </div>
        <p class="text-secondary small mb-3">
          This slot on <strong id="verifyingSlotCourtName" class="text-dark">Court</strong> at <strong id="verifyingSlotTime" class="text-dark">Time</strong> has been submitted with GCash payment proof and is currently awaiting admin verification.
        </p>
        <div class="bg-light p-3 rounded-4 border mb-4 text-start">
          <div class="d-flex justify-content-between align-items-center mb-1">
            <span class="text-muted small">Booking Reference:</span>
            <span class="fw-bold font-monospace text-primary" id="verifyingSlotRef">PKL-XXXXXX</span>
          </div>
          <div class="d-flex justify-content-between align-items-center">
            <span class="text-muted small">Current Status:</span>
            <span class="badge bg-info-subtle text-info-emphasis fw-bold">Awaiting Admin Confirmation</span>
          </div>
        </div>
        <div class="d-flex flex-column gap-2">
          <a id="verifyingSlotPassBtn" href="#" class="btn btn-outline-primary fw-bold rounded-pill py-2.5">
            <i class="bi bi-ticket-perforated me-1"></i> View Booking Pass / Check Status &rarr;
          </a>
          <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">Close</button>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- =========================================================
     SLIDE-OUT / MODAL BOOKING CHECKOUT
========================================================= -->
<div class="modal fade" id="checkoutModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content rounded-4 border-0 shadow-lg overflow-hidden">
      <div class="modal-header modal-checkout-header p-4">
        <div>
          <h5 class="modal-title fw-bold font-display text-white mb-0">Confirm Your Court Reservation</h5>
          <span class="text-white-50 small">The Playground Pickleball · Official GCash QR Flow</span>
        </div>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <div class="modal-body p-4">
        <!-- Order Summary Box -->
        <div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden" style="background: #f8fafc; border: 1px solid #e2e8f0 !important;">
          <!-- Top Row: Date & Total Slots Pill -->
          <div class="px-3 py-2.5 bg-white border-bottom d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-2">
              <span class="badge bg-primary-subtle text-primary rounded-circle p-2 d-inline-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                <i class="bi bi-calendar3"></i>
              </span>
              <div>
                <span class="small text-muted d-block" style="font-size: 10px; text-transform: uppercase; letter-spacing: 0.5px; font-weight: 600;">Date</span>
                <span class="fw-bold text-dark small" id="modalSummaryDate">Today</span>
              </div>
            </div>
            <span class="badge bg-primary text-white rounded-pill px-3 py-1.5 fw-bold" id="modalSummaryHours">1 Slot</span>
          </div>

          <!-- Courts & Time Slots List -->
          <div class="p-3" id="modalSummarySlots">
            <!-- Dynamic court blocks injected here -->
          </div>

          <!-- Bottom Row: Subtotal & Total Amount Due -->
          <div class="px-3 py-2.5 bg-white border-top d-flex justify-content-between align-items-center">
            <div>
              <span class="small text-muted d-block" style="font-size: 10px; text-transform: uppercase; letter-spacing: 0.5px; font-weight: 600;">Total Amount Due</span>
              <span class="small text-secondary" id="modalSummaryBreakdown" style="font-size: 11px;">1 hour total</span>
            </div>
            <span class="fs-4 fw-extrabold text-primary font-display" id="modalSummaryTotal">₱0.00</span>
          </div>
        </div>

        <!-- Player Information Form (Auto-bound to Signed-In Account) -->
        <form id="matrixReservationForm" action="/reservations" method="POST" onsubmit="handleMatrixReservationSubmit(event)">
          <input type="hidden" name="court_id" id="formCourtId" value="">
          <input type="hidden" name="reservation_date" id="formDate" value="<%= today %>">
          <input type="hidden" name="start_time" id="formStartTime" value="">
          <input type="hidden" name="total_hours" id="formTotalHours" value="1">
          <input type="hidden" name="selected_slots" id="formSelectedSlots" value="[]">

          <!-- Signed-In Player Account Badge (No need to re-enter details when logged in) -->
          <div id="checkoutSignedInAccountBox" class="rounded-4 p-3 mb-3 border d-flex align-items-center justify-content-between gap-2" style="background: #F0FDF4; border-color: #BBF7D0 !important;">
            <div class="d-flex align-items-center gap-2.5 min-w-0">
              <div class="bg-success text-white rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width: 36px; height: 36px;">
                <i class="bi bi-person-check-fill"></i>
              </div>
              <div class="min-w-0">
                <div class="text-uppercase fw-bold text-success" style="font-size: 10px; letter-spacing: 0.05em;">Booking Under Your Signed-In Account</div>
                <div class="fw-bold text-dark small text-truncate" id="checkoutAccountDisplayName">
                  <%= (typeof user !== 'undefined' && user) ? (user.full_name || user.username || '') : '' %>
                </div>
                <div class="text-secondary font-monospace" style="font-size: 11.5px;" id="checkoutAccountDisplayContact">
                  <%= (typeof user !== 'undefined' && user && user.phone) ? user.phone : '' %><%= (typeof user !== 'undefined' && user && user.email) ? (' · ' + user.email) : '' %>
                </div>
              </div>
            </div>
            <span class="badge bg-success-subtle text-success border border-success rounded-pill px-2.5 py-1 fw-bold flex-shrink-0" style="font-size: 10.5px;">
              <i class="bi bi-shield-check me-1"></i>Verified
            </span>
          </div>

          <!-- Hidden / Auto-Populated Profile Fields -->
          <div id="checkoutManualFieldsWrap" class="<%= (typeof user !== 'undefined' && user && user.phone) ? 'd-none' : '' %>">
            <div class="mb-3">
              <label class="form-label small fw-bold text-dark">Player Full Name <span class="text-danger">*</span></label>
              <input type="text" name="user_name" id="checkoutUserName" class="form-control rounded-3" placeholder="e.g. Juan Dela Cruz" value="<%= (typeof user !== 'undefined' && user) ? (user.full_name || user.username || '') : '' %>" required>
            </div>

            <div class="row g-2 mb-3">
              <div class="col-sm-6">
                <label class="form-label small fw-bold text-dark">GCash Mobile <span class="text-danger">*</span></label>
                <input type="tel" name="user_contact" id="checkoutUserContact" class="form-control rounded-3 font-monospace" value="<%= (typeof user !== 'undefined' && user && user.phone) ? user.phone : '' %>" required>
              </div>
              <div class="col-sm-6">
                <label class="form-label small fw-bold text-dark">Email <span class="text-muted fw-normal">(Optional)</span></label>
                <input type="email" name="user_email" id="checkoutUserEmail" class="form-control rounded-3" placeholder="player@email.com" value="<%= (typeof user !== 'undefined' && user && user.email) ? user.email : '' %>">
              </div>
            </div>
          </div>

          <div id="checkoutSubmitErrorBox" class="alert alert-danger py-2 px-3 small rounded-3 mb-3 d-none"></div>

          <div class="mb-4">
            <label class="form-label small fw-bold text-dark">Special Requests / Notes <span class="text-muted fw-normal">(Optional)</span></label>
            <input type="text" name="special_requests" id="checkoutSpecialRequests" class="form-control rounded-3" placeholder="Paddle rentals, ball tubes, coaching, etc.">
          </div>

          <div class="sticky-bottom bg-white pt-3 pb-1 border-top mt-3 d-flex gap-2" style="z-index: 10;">
            <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" id="checkoutSubmitBtn" class="btn btn-book-now-gold flex-fill">
              <i class="bi bi-qr-code-scan me-1"></i> Proceed to GCash Payment
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<!-- =========================================================
     PLAYER ACCOUNT LOGIN / REGISTER MODAL (Seamless Matrix Auth)
========================================================= -->
<div class="modal fade" id="playerAuthModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content rounded-4 border-0 shadow-lg overflow-hidden">
      <div class="modal-header modal-checkout-header p-4">
        <div>
          <h5 class="modal-title fw-bold font-display text-white mb-0" id="playerAuthModalTitle">Player Account Required</h5>
          <span class="text-white-50 small">The Playground Pickleball · Sign In or Create Account</span>
        </div>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <!-- Mode Switcher Tabs -->
      <div class="d-flex border-bottom bg-light">
        <button type="button" id="modalAuthTabLogin" class="flex-fill btn rounded-0 py-2.5 fw-bold small border-0 bg-white text-primary border-bottom border-2 border-primary" onclick="switchPlayerAuthModalMode('login')">
          <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
        </button>
        <button type="button" id="modalAuthTabRegister" class="flex-fill btn rounded-0 py-2.5 fw-bold small border-0 text-secondary" onclick="switchPlayerAuthModalMode('register')">
          <i class="bi bi-person-plus-fill me-1"></i> Create Account
        </button>
      </div>

      <div class="modal-body p-4">
        <!-- Context Notice when triggered from Continue to Booking -->
        <div id="playerAuthCheckoutNotice" class="alert alert-warning border-warning py-2 px-3 small rounded-3 mb-3 d-none">
          <i class="bi bi-shield-lock-fill me-1 text-dark"></i>
          <strong>Almost there!</strong> Please sign in or create an account to reserve your selected court slots.
        </div>

        <div id="playerAuthSuccessBox" class="alert alert-success py-2 px-3 small rounded-3 mb-3 d-none"></div>
        <div id="playerAuthErrorBox" class="alert alert-danger py-2 px-3 small rounded-3 mb-3 d-none"></div>
        <div id="playerAuthMockOtpBox" class="alert alert-info border-info py-2 px-3 small rounded-3 mb-3 d-none"></div>

        <!-- 1. Modal Login Form -->
        <form id="modalPlayerLoginForm" onsubmit="handleModalPlayerLogin(event)">
          <div class="mb-3">
            <label class="form-label small fw-bold text-dark">Email or GCash Mobile Number <span class="text-danger">*</span></label>
            <div class="input-group">
              <span class="input-group-text bg-light text-primary"><i class="bi bi-person-badge"></i></span>
              <input type="text" id="modalLoginIdentifier" name="identifier" class="form-control" placeholder="09171234567 or player@email.com" required>
            </div>
          </div>

          <div class="mb-4">
            <div class="d-flex justify-content-between align-items-center mb-1">
              <label class="form-label small fw-bold text-dark mb-0">Password <span class="text-danger">*</span></label>
              <a href="javascript:void(0)" onclick="switchPlayerAuthModalMode('forgot')" class="small fw-semibold text-primary text-decoration-none" style="font-size: 12px;">
                <i class="bi bi-key-fill me-1"></i>Forgot Password?
              </a>
            </div>
            <div class="input-group">
              <span class="input-group-text bg-light text-primary"><i class="bi bi-lock-fill"></i></span>
              <input type="password" id="modalLoginPassword" name="password" class="form-control" placeholder="Enter your password" required>
            </div>
          </div>

          <button type="submit" id="modalLoginSubmitBtn" class="btn btn-book-now-gold w-100 py-2.5 fw-bold rounded-pill shadow-sm">
            <i class="bi bi-box-arrow-in-right me-1"></i> Sign In &amp; Continue
          </button>

          <div class="text-center mt-3 pt-2 border-top">
            <span class="small text-secondary">Don't have a player account yet?</span>
            <a href="javascript:void(0)" onclick="switchPlayerAuthModalMode('register')" class="small fw-bold text-primary text-decoration-none ms-1">Create Account &rarr;</a>
          </div>
        </form>

        <!-- 2. Modal Register Form -->
        <form id="modalPlayerRegisterForm" class="d-none" onsubmit="handleModalPlayerRegister(event)">
          <div class="mb-2.5">
            <label class="form-label small fw-bold text-dark mb-1">Player Full Name <span class="text-danger">*</span></label>
            <input type="text" id="modalRegFullName" name="full_name" class="form-control rounded-3" placeholder="e.g. Juan Dela Cruz" required>
          </div>

          <div class="row g-2 mb-2.5 mt-1">
            <div class="col-sm-6">
              <label class="form-label small fw-bold text-dark mb-1">GCash Mobile <span class="text-danger">*</span></label>
              <input type="tel" id="modalRegPhone" name="phone" class="form-control rounded-3 font-monospace" placeholder="09171234567" required>
            </div>
            <div class="col-sm-6">
              <label class="form-label small fw-bold text-dark mb-1">Email Address <span class="text-danger">*</span></label>
              <input type="email" id="modalRegEmail" name="email" class="form-control rounded-3" placeholder="player@email.com" required>
            </div>
          </div>
          <div class="form-text mb-2" style="font-size: 11px;">
            <i class="bi bi-envelope-check-fill text-primary me-1"></i>We'll send a 6-digit OTP to confirm your email so you can recover your password anytime.
          </div>

          <div class="row g-2 mb-4 mt-1">
            <div class="col-sm-6">
              <label class="form-label small fw-bold text-dark mb-1">Password <span class="text-danger">*</span></label>
              <input type="password" id="modalRegPassword" name="password" class="form-control rounded-3" placeholder="Min. 6 chars" minlength="6" required>
            </div>
            <div class="col-sm-6">
              <label class="form-label small fw-bold text-dark mb-1">Confirm Password <span class="text-danger">*</span></label>
              <input type="password" id="modalRegConfirm" name="confirm_password" class="form-control rounded-3" placeholder="Repeat password" minlength="6" required>
            </div>
          </div>

          <button type="submit" id="modalRegisterSubmitBtn" class="btn btn-book-now-gold w-100 py-2.5 fw-bold rounded-pill shadow-sm">
            <i class="bi bi-envelope-check-fill me-1"></i> Send Email OTP &amp; Create Account
          </button>

          <div class="text-center mt-3 pt-2 border-top">
            <span class="small text-secondary">Already have an account?</span>
            <a href="javascript:void(0)" onclick="switchPlayerAuthModalMode('login')" class="small fw-bold text-primary text-decoration-none ms-1">Sign In &rarr;</a>
          </div>
        </form>

        <!-- 3. Modal Email OTP Verification Form -->
        <form id="modalPlayerVerifyOtpForm" class="d-none" onsubmit="handleModalVerifyEmailOtp(event)">
          <input type="hidden" id="modalVerifyUserId" value="">
          <div class="text-center mb-3">
            <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-primary bg-opacity-10 text-primary mb-2" style="width: 52px; height: 52px;">
              <i class="bi bi-shield-check fs-3"></i>
            </div>
            <h6 class="fw-bold text-dark mb-1">Confirm Your Email Address</h6>
            <p class="small text-secondary mb-0">Enter the 6-digit verification code sent to your email to confirm your account.</p>
          </div>

          <div class="mb-3">
            <label class="form-label small fw-bold text-dark mb-1">Email Address <span class="text-danger">*</span></label>
            <div class="input-group">
              <span class="input-group-text bg-light text-primary"><i class="bi bi-envelope-fill"></i></span>
              <input type="email" id="modalVerifyEmailInput" class="form-control" placeholder="player@email.com" required>
            </div>
          </div>

          <div class="mb-4">
            <label class="form-label small fw-bold text-dark mb-1">6-Digit OTP Verification Code <span class="text-danger">*</span></label>
            <input type="text" id="modalVerifyOtpCode" class="form-control form-control-lg text-center font-monospace fw-bold" style="letter-spacing: 6px; font-size: 1.35rem;" placeholder="------" maxlength="6" pattern="\d{6}" inputmode="numeric" required>
          </div>

          <button type="submit" id="modalVerifyOtpSubmitBtn" class="btn btn-book-now-gold w-100 py-2.5 fw-bold rounded-pill shadow-sm">
            <i class="bi bi-check2-circle me-1"></i> Verify Email &amp; Sign In
          </button>

          <div class="d-flex justify-content-between align-items-center mt-3 pt-2 border-top small">
            <a href="javascript:void(0)" onclick="handleModalResendOtp('VERIFY_EMAIL')" id="modalResendVerifyOtpBtn" class="fw-bold text-primary text-decoration-none">
              <i class="bi bi-arrow-clockwise me-1"></i>Resend OTP Code
            </a>
            <a href="javascript:void(0)" onclick="switchPlayerAuthModalMode('login')" class="text-secondary text-decoration-none">
              &larr; Back to Sign In
            </a>
          </div>
        </form>

        <!-- 4. Modal Forgot Password Step 1 (Request Recovery OTP) -->
        <form id="modalPlayerForgotForm" class="d-none" onsubmit="handleModalForgotPasswordRequest(event)">
          <div class="text-center mb-3">
            <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-warning bg-opacity-25 text-dark mb-2" style="width: 52px; height: 52px;">
              <i class="bi bi-key-fill fs-3"></i>
            </div>
            <h6 class="fw-bold text-dark mb-1">Forgot Your Password?</h6>
            <p class="small text-secondary mb-0">Enter your registered Email or GCash Mobile Number and we'll send a 6-digit recovery OTP to your confirmed email.</p>
          </div>

          <div class="mb-4">
            <label class="form-label small fw-bold text-dark">Registered Email or GCash Mobile <span class="text-danger">*</span></label>
            <div class="input-group">
              <span class="input-group-text bg-light text-primary"><i class="bi bi-envelope-at-fill"></i></span>
              <input type="text" id="modalForgotIdentifier" class="form-control" placeholder="player@email.com or 09171234567" required>
            </div>
          </div>

          <button type="submit" id="modalForgotSubmitBtn" class="btn btn-book-now-gold w-100 py-2.5 fw-bold rounded-pill shadow-sm">
            <i class="bi bi-send-check-fill me-1"></i> Send Recovery OTP
          </button>

          <div class="text-center mt-3 pt-2 border-top">
            <a href="javascript:void(0)" onclick="switchPlayerAuthModalMode('login')" class="small fw-bold text-secondary text-decoration-none">
              &larr; Back to Sign In
            </a>
          </div>
        </form>

        <!-- 5. Modal Forgot Password Step 2 (Enter Recovery OTP + New Password) -->
        <form id="modalPlayerResetForm" class="d-none" onsubmit="handleModalResetPasswordSubmit(event)">
          <input type="hidden" id="modalResetEmailHidden" value="">
          <div class="text-center mb-3">
            <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-success bg-opacity-10 text-success mb-2" style="width: 48px; height: 48px;">
              <i class="bi bi-shield-lock-fill fs-4"></i>
            </div>
            <h6 class="fw-bold text-dark mb-1">Set a New Password</h6>
            <p class="small text-secondary mb-0">Enter the 6-digit recovery code sent to <strong id="modalResetEmailDisplay" class="text-dark">your email</strong> and choose a new password.</p>
          </div>

          <div class="mb-3">
            <label class="form-label small fw-bold text-dark mb-1">6-Digit Recovery OTP <span class="text-danger">*</span></label>
            <input type="text" id="modalResetOtpCode" class="form-control text-center font-monospace fw-bold" style="letter-spacing: 6px; font-size: 1.25rem;" placeholder="------" maxlength="6" pattern="\d{6}" inputmode="numeric" required>
          </div>

          <div class="row g-2 mb-4">
            <div class="col-sm-6">
              <label class="form-label small fw-bold text-dark mb-1">New Password <span class="text-danger">*</span></label>
              <input type="password" id="modalResetNewPassword" class="form-control rounded-3" placeholder="Min. 6 chars" minlength="6" required>
            </div>
            <div class="col-sm-6">
              <label class="form-label small fw-bold text-dark mb-1">Confirm New Password <span class="text-danger">*</span></label>
              <input type="password" id="modalResetConfirmPassword" class="form-control rounded-3" placeholder="Repeat password" minlength="6" required>
            </div>
          </div>

          <button type="submit" id="modalResetSubmitBtn" class="btn btn-book-now-gold w-100 py-2.5 fw-bold rounded-pill shadow-sm">
            <i class="bi bi-check2-all me-1"></i> Reset Password &amp; Sign In
          </button>

          <div class="d-flex justify-content-between align-items-center mt-3 pt-2 border-top small">
            <a href="javascript:void(0)" onclick="handleModalResendOtp('RESET_PASSWORD')" class="fw-bold text-primary text-decoration-none">
              <i class="bi bi-arrow-clockwise me-1"></i>Resend Recovery OTP
            </a>
            <a href="javascript:void(0)" onclick="switchPlayerAuthModalMode('login')" class="text-secondary text-decoration-none">
              &larr; Back to Sign In
            </a>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<!-- =========================================================
     NATIVE-STYLE MOBILE BOTTOM NAVIGATION BAR (< 768px)
========================================================= -->
<nav id="mobileBottomAppBar" class="mobile-bottom-appbar d-flex d-md-none" aria-label="Mobile App Navigation">
