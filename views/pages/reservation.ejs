<div class="container py-3 py-md-5">
  <div class="max-w-900 mx-auto">
    <!-- Compact Title -->
    <div class="text-center mb-3">
      <h2 class="fw-bold text-dark mb-1 fs-3">Reserve Your 3KS Court</h2>
      <p class="text-secondary small mb-0">Select court & time slots, then pay with GCash QR</p>
    </div>

    <form id="reservationForm" action="/reservations" method="POST" class="needs-validation" novalidate>
      <div class="row g-3">
        <!-- Step 1: Court & Schedule Selection -->
        <div class="col-lg-7">
          <div class="card border-0 shadow-sm rounded-4 p-3 p-md-4 mb-3 bg-white">
            <div class="d-flex justify-content-between align-items-center mb-2">
              <h6 class="fw-bold text-dark mb-0 d-flex align-items-center">
                <span class="badge bg-success me-2 rounded-circle p-1 d-inline-flex align-items-center justify-content-center" style="width: 22px; height: 22px; font-size: 11px;">1</span>
                Court & Time Slots
              </h6>
              <div class="d-flex align-items-center gap-2">
                <span class="small text-muted" id="slotLoadingText" style="font-size: 11px;"><i class="bi bi-arrow-repeat spin me-1"></i>Loading...</span>
                <button type="button" id="clearSlotsBtn" class="btn btn-sm btn-outline-secondary rounded-pill py-0 px-2 small" style="font-size: 11px; display: none;">
                  Clear
                </button>
              </div>
            </div>

            <!-- Court & Date in 1 Row on Mobile -->
            <div class="row g-2 mb-2">
              <div class="col-6">
                <label for="courtSelect" class="form-label small fw-semibold text-dark mb-1">Court</label>
                <select class="form-select form-select-sm rounded-3 fw-bold text-success" id="courtSelect" name="court_id" required>
                  <% courts.forEach(function(c) { %>
                    <option value="<%= c.id %>" 
                      data-price="<%= c.category ? c.category.price_per_hour : 350 %>" 
                      data-name="<%= c.display_name %>"
                      <%= selectedCourtId === c.id ? 'selected' : '' %>>
                      <%= c.display_name %> (<%= formatCurrency(c.category ? c.category.price_per_hour : 350) %>/h)
                    </option>
                  <% }); %>
                </select>
              </div>
              <div class="col-6">
                <label for="dateSelect" class="form-label small fw-semibold text-dark mb-1">Date</label>
                <input type="date" class="form-control form-control-sm rounded-3" id="dateSelect" name="reservation_date" value="<%= selectedDate %>" min="<%= today %>" required>
              </div>
            </div>

            <!-- Time Slots Matrix (Compact 3-col on mobile, 4-col on desktop) -->
            <div class="mb-1">
              <div id="slotsGrid" class="row g-1 p-2 border rounded-3 bg-light" style="max-height: 240px; overflow-y: auto;">
                <!-- Dynamically populated via JavaScript -->
              </div>
              <input type="hidden" name="selected_slots" id="selectedSlotsInput" value="[]" required>
              <input type="hidden" name="start_time" id="selectedStartTime" value="<%= initialSlot %>">
              <input type="hidden" name="total_hours" id="totalHoursInput" value="1">
              
              <div class="invalid-feedback d-block small" id="slotFeedback" style="display: none; font-size: 11px;">
                Please tap at least one available slot.
              </div>
            </div>
          </div>

          <!-- Step 2: Player Information (Compact) -->
          <div class="card border-0 shadow-sm rounded-4 p-3 p-md-4 bg-white mb-3 mb-lg-0">
            <h6 class="fw-bold text-dark mb-2 d-flex align-items-center">
              <span class="badge bg-success me-2 rounded-circle p-1 d-inline-flex align-items-center justify-content-center" style="width: 22px; height: 22px; font-size: 11px;">2</span>
              Player Information
            </h6>

            <div class="row g-2">
              <div class="col-12">
                <label for="userName" class="form-label small fw-semibold text-dark mb-1">Full Name <span class="text-danger">*</span></label>
                <input type="text" class="form-control form-control-sm rounded-3" id="userName" name="user_name" placeholder="e.g. Juan Dela Cruz" required>
              </div>

              <div class="col-6">
                <label for="userContact" class="form-label small fw-semibold text-dark mb-1">GCash Mobile <span class="text-danger">*</span></label>
                <input type="tel" class="form-control form-control-sm rounded-3" id="userContact" name="user_contact" placeholder="09171234567" required>
              </div>

              <div class="col-6">
                <label for="userEmail" class="form-label small fw-semibold text-dark mb-1">Email <span class="text-muted small">(Opt)</span></label>
                <input type="email" class="form-control form-control-sm rounded-3" id="userEmail" name="user_email" placeholder="juan@email.com">
              </div>

              <div class="col-12">
                <input type="text" class="form-control form-control-sm rounded-3" id="specialRequests" name="special_requests" placeholder="Special Requests / Notes (optional)">
              </div>
            </div>
          </div>
        </div>

        <!-- Step 3: Order Summary & Checkout -->
        <div class="col-lg-5">
          <div class="card border-0 shadow-sm rounded-4 p-3 p-md-4 sticky-top bg-white" style="top: 80px;">
            <h6 class="fw-bold text-dark mb-2">Order Summary</h6>

            <div class="p-2 bg-light rounded-3 mb-2 small">
              <div class="d-flex justify-content-between mb-1">
                <span class="text-secondary">Court / Date:</span>
                <span class="fw-bold text-dark"><span id="summaryCourtName">-</span> | <span id="summaryDate">-</span></span>
              </div>
              <div class="mb-1">
                <span class="text-secondary d-block" style="font-size: 11px;">Slots:</span>
                <div id="summarySlotsList" class="d-flex flex-wrap gap-1 mt-1">
                  <span class="text-muted small">None selected</span>
                </div>
              </div>
              <div class="d-flex justify-content-between align-items-center border-top pt-1 mt-1">
                <span class="text-secondary">Total (<span id="summaryDuration">0 Hours</span>):</span>
                <span class="fs-5 fw-extrabold text-success" id="summaryTotal">₱0.00</span>
              </div>
            </div>

            <button type="submit" id="submitBtn" class="btn btn-success btn-lg w-100 fw-bold rounded-pill shadow-sm d-flex align-items-center justify-content-center" disabled>
              <i class="bi bi-wallet2 me-2"></i>Proceed to GCash
            </button>

            <div class="text-center mt-2 small text-muted" style="font-size: 11px;">
              <i class="bi bi-shield-lock-fill text-success me-1"></i>Official 3KS Playground System
            </div>
          </div>
        </div>
      </div>

      <!-- Mobile Sticky Floating Bottom Bar (Appears on phones for instant 1-tap checkout) -->
      <div class="mobile-sticky-bar">
        <div>
          <span class="small text-muted d-block" style="font-size: 11px;" id="mobileStickyCount">0 slots selected</span>
          <strong class="fs-6 text-success" id="mobileStickyTotal">₱0.00</strong>
        </div>
        <button type="submit" id="mobileSubmitBtn" class="btn btn-success fw-bold rounded-pill px-4 py-2" disabled>
          Proceed <i class="bi bi-arrow-right ms-1"></i>
        </button>
      </div>
    </form>
  </div>
</div>

<script src="/js/reservation.js"></script>
