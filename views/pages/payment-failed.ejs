<div class="container py-5 text-center">
  <div class="max-w-600 mx-auto" style="max-width: 600px;">
    <div class="card border-0 shadow-lg rounded-4 p-5 bg-white">
      <div class="badge bg-danger text-white rounded-circle p-4 mb-3 mx-auto d-inline-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
        <i class="bi bi-x-lg fs-1"></i>
      </div>
      <h2 class="fw-bold text-dark mb-2">Payment Unsuccessful</h2>
      <p class="text-secondary mb-4">
        <%= reason || 'The payment could not be verified or was cancelled.' %>
      </p>

      <div class="d-grid gap-3">
        <a href="/reservations" class="btn btn-success btn-lg rounded-pill fw-bold">
          <i class="bi bi-arrow-repeat me-2"></i>Try Booking Again
        </a>
        <a href="/" class="btn btn-outline-secondary rounded-pill">
          Return to Home
        </a>
      </div>
    </div>
  </div>
</div>
