<div class="container py-5">
  <div class="max-w-700 mx-auto" style="max-width: 750px;">
    <div class="card border-0 shadow-lg rounded-4 overflow-hidden bg-white">
      <% if (reservation.status === 'CONFIRMED') { %>
        <div class="bg-success text-white p-4 text-center">
          <div class="badge bg-white text-success rounded-circle p-3 mb-2 d-inline-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
            <i class="bi bi-check2-circle fs-2"></i>
          </div>
          <h2 class="fw-bold mb-1">Reservation Confirmed!</h2>
          <p class="mb-0 opacity-90">Your court is booked and locked. See you at 3KS Playground!</p>
        </div>
      <% } else if (reservation.status === 'AWAITING_CONFIRMATION') { %>
        <div class="bg-primary text-white p-4 text-center" style="background: linear-gradient(135deg, #0d6efd 0%, #0a58ca 100%) !important;">
          <div class="badge bg-white text-primary rounded-circle p-3 mb-2 d-inline-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
            <i class="bi bi-hourglass-split fs-2"></i>
          </div>
          <h2 class="fw-bold mb-1">Payment Proof Submitted!</h2>
          <p class="mb-0 opacity-90">Awaiting Admin Confirmation. Your slot is held while the admin verifies your GCash payment.</p>
        </div>
      <% } else { %>
        <div class="bg-warning text-dark p-4 text-center">
          <div class="badge bg-dark text-warning rounded-circle p-3 mb-2 d-inline-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
            <i class="bi bi-wallet2 fs-2"></i>
          </div>
          <h2 class="fw-bold mb-1">Awaiting GCash Payment</h2>
          <p class="mb-0">Please scan the GCash QR code to complete your booking.</p>
        </div>
      <% } %>

      <div class="p-4 p-md-5">
        <!-- Reference & Status -->
        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center bg-light p-3 rounded-3 mb-4 border">
          <div>
            <span class="small text-secondary d-block">Booking Reference</span>
            <span class="fs-5 fw-bold font-monospace text-primary"><%= reservation.reference_number %></span>
          </div>
          <div class="mt-2 mt-sm-0">
            <% if (reservation.status === 'CONFIRMED') { %>
              <span class="badge bg-success px-3 py-2 fs-6 rounded-pill">
                <i class="bi bi-check-circle-fill me-1"></i>CONFIRMED
              </span>
            <% } else if (reservation.status === 'AWAITING_CONFIRMATION') { %>
              <span class="badge bg-primary px-3 py-2 fs-6 rounded-pill">
                <i class="bi bi-clock-history me-1"></i>AWAITING APPROVAL
              </span>
            <% } else { %>
              <span class="badge bg-warning text-dark px-3 py-2 fs-6 rounded-pill">
                <i class="bi bi-wallet2 me-1"></i>UNPAID
              </span>
            <% } %>
          </div>
        </div>

        <!-- Booking Details Grid -->
        <h5 class="fw-bold text-dark mb-3 border-bottom pb-2">Court & Schedule Details</h5>
        <div class="row g-3 mb-4">
          <div class="col-6">
            <span class="small text-secondary d-block">Court Assigned</span>
            <strong class="text-dark"><%= reservation.court ? reservation.court.display_name : 'Pickleball Court' %></strong>
          </div>
          <div class="col-6">
            <span class="small text-secondary d-block">Venue</span>
            <strong class="text-dark">3KS Pickleball Playground</strong>
          </div>
          <div class="col-6">
            <span class="small text-secondary d-block">Date</span>
            <strong class="text-dark"><%= reservation.reservation_date %></strong>
          </div>
          <div class="col-6">
            <span class="small text-secondary d-block">Time Slot / Duration</span>
            <% 
              let slotDisplay = `${formatTime12(reservation.start_time)} - ${formatTime12(reservation.end_time)}`;
              if (reservation.slots_json) {
                try {
                  const arr = JSON.parse(reservation.slots_json);
                  if (Array.isArray(arr) && arr.length > 0) {
                    slotDisplay = arr.map(t => formatTime12(t)).join(', ');
                  }
                } catch (e) {}
              }
            %>
            <strong class="text-dark"><%= slotDisplay %> (<%= reservation.total_hours %> hr<%= reservation.total_hours > 1 ? 's' : '' %>)</strong>
          </div>
        </div>

        <h5 class="fw-bold text-dark mb-3 border-bottom pb-2">Player Information</h5>
        <div class="row g-3 mb-4">
          <div class="col-6">
            <span class="small text-secondary d-block">Full Name</span>
            <strong class="text-dark"><%= reservation.user_name %></strong>
          </div>
          <div class="col-6">
            <span class="small text-secondary d-block">Contact Number</span>
            <strong class="text-dark"><%= reservation.user_contact %></strong>
          </div>
          <div class="col-6">
            <span class="small text-secondary d-block">Email</span>
            <strong class="text-dark"><%= reservation.user_email || 'Not provided' %></strong>
          </div>
          <div class="col-6">
            <span class="small text-secondary d-block">Special Requests</span>
            <span class="text-muted small"><%= reservation.special_requests || 'None' %></span>
          </div>
        </div>

        <!-- Messenger Alert Binding Card -->
        <div class="card border-0 shadow-sm rounded-4 p-3 mb-4 bg-primary-subtle border-primary border">
          <div class="d-flex flex-column flex-md-row align-items-center gap-3">
            <div class="text-center">
              <img src="https://api.qrserver.com/v1/create-qr-code/?size=140x140&data=https://m.me/1224751467396635" alt="Messenger Binding QR" class="rounded-3 shadow-sm bg-white p-1" width="100" height="100">
              <span class="small d-block text-muted mt-1" style="font-size: 10px;">Scan to open chat</span>
            </div>
            <div class="flex-grow-1 text-center text-md-start">
              <div class="d-flex align-items-center justify-content-center justify-content-md-start gap-2 mb-1">
                <i class="bi bi-messenger text-primary fs-5"></i>
                <h6 class="fw-bold text-dark mb-0">Get Booking Pass & Alerts on Messenger</h6>
              </div>
              <p class="small text-secondary mb-2" style="font-size: 12px;">
                Scan QR or tap below, then send code: <strong class="text-primary font-monospace fs-6"><%= reservation.binding_code || reservation.reference_number %></strong>
              </p>
              <div class="d-flex flex-wrap gap-2 justify-content-center justify-content-md-start align-items-center">
                <a href="https://m.me/1224751467396635" target="_blank" class="btn btn-sm btn-primary rounded-pill px-3 fw-bold">
                  <i class="bi bi-chat-dots-fill me-1"></i>Open Messenger
                </a>
                <span id="messengerBindStatus" class="badge <%= reservation.fb_psid ? 'bg-success' : 'bg-warning text-dark' %> px-3 py-2 rounded-pill small">
                  <i class="bi <%= reservation.fb_psid ? 'bi-check-circle-fill' : 'bi-hourglass-split' %> me-1"></i>
                  <%= reservation.fb_psid ? 'Connected to Messenger' : 'Waiting for Messenger link' %>
                </span>
              </div>
            </div>
          </div>
        </div>

        <h5 class="fw-bold text-dark mb-3 border-bottom pb-2">Payment Details</h5>
        <div class="bg-light p-3 rounded-3 mb-4 border">
          <div class="d-flex justify-content-between mb-2">
            <span class="text-secondary small">Payment Method:</span>
            <span class="fw-bold text-dark small"><i class="bi bi-qr-code text-primary me-1"></i>GCash QR Code</span>
          </div>
          <div class="d-flex justify-content-between mb-2">
            <span class="text-secondary small">Submitted GCash Ref No:</span>
            <span class="fw-bold font-monospace text-primary small"><%= reservation.gcash_reference_no || 'Pending Submission' %></span>
          </div>
          <% if (reservation.payment_screenshot) { %>
            <div class="d-flex justify-content-between align-items-center mb-2">
              <span class="text-secondary small">Uploaded Receipt:</span>
              <a href="<%= reservation.payment_screenshot %>" target="_blank" class="btn btn-sm btn-outline-primary rounded-pill py-0 px-2 small">
                <i class="bi bi-image me-1"></i>View Screenshot
              </a>
            </div>
          <% } %>
          <hr class="my-2">
          <div class="d-flex justify-content-between align-items-center">
            <span class="fw-bold text-dark">Total Amount:</span>
            <span class="fs-5 fw-bold text-success"><%= formatCurrency(reservation.total_amount) %></span>
          </div>
        </div>

        <!-- Actions -->
        <div class="d-flex flex-wrap gap-2 d-print-none">
          <% if (reservation.status === 'AWAITING_PAYMENT') { %>
            <a href="/payment/gcash-checkout?ref=<%= reservation.reference_number %>" class="btn btn-primary flex-fill rounded-pill py-2 fw-semibold">
              <i class="bi bi-qr-code me-1"></i>Pay via GCash QR Now
            </a>
          <% } %>
          <button onclick="window.print()" class="btn btn-outline-secondary flex-fill rounded-pill py-2 fw-semibold">
            <i class="bi bi-printer me-1"></i>Print Pass
          </button>
          <a href="/reservations" class="btn btn-success flex-fill rounded-pill py-2 fw-semibold">
            <i class="bi bi-plus-circle me-1"></i>Book Another Court
          </a>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
  if (typeof io !== 'undefined') {
    const socket = io();
    socket.on('player_messenger_bound', (data) => {
      if (data && data.reference === '<%= reservation.reference_number %>') {
        const badge = document.getElementById('messengerBindStatus');
        if (badge) {
          badge.className = 'badge bg-success px-3 py-2 rounded-pill small';
          badge.innerHTML = '<i class="bi bi-check-circle-fill me-1"></i>Connected to Messenger!';
        }
      }
    });
  }
});
</script>
