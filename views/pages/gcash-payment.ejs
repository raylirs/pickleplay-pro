<div class="container py-5">
  <div class="max-w-900 mx-auto" style="max-width: 850px;">
    <div class="card border-0 shadow-lg rounded-4 overflow-hidden bg-white">
      <!-- Header -->
      <div class="bg-primary text-white p-4" style="background: linear-gradient(135deg, #005ce6 0%, #003d99 100%) !important;">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
          <div>
            <span class="badge bg-white text-primary px-3 py-1 rounded-pill fw-bold mb-2">Step 2: Payment via GCash QR</span>
            <h2 class="fw-bold mb-1"><i class="bi bi-qr-code-scan me-2"></i>Pay via GCash QR</h2>
            <p class="mb-0 text-white-50 small">Scan the QR code below with your GCash app and submit your reference number.</p>
          </div>
          <div class="bg-white bg-opacity-10 p-3 rounded-4 border border-white border-opacity-25 text-md-end">
            <span class="small text-white-50 d-block">Total Amount to Pay</span>
            <h2 class="fw-extrabold text-warning mb-0"><%= formatCurrency(reservation.total_amount) %></h2>
          </div>
        </div>
      </div>

      <div class="p-4 p-md-5">
        <div class="row g-4">
          <!-- Left: QR Code and Merchant Details -->
          <div class="col-md-6 text-center border-end-md">
            <div class="p-3 bg-light rounded-4 border mb-3">
              <img src="/images/gcash-qr.svg" alt="3KS GCash QR Code" class="img-fluid rounded-3 shadow-sm" style="max-width: 260px; width: 100%;">
            </div>
            <div class="small text-secondary">
              <p class="fw-bold text-dark mb-1">3KS PICKLEBALL PLAYGROUND</p>
              <p class="mb-0">GCash Mobile: <strong class="text-primary font-monospace">0917-800-3577</strong></p>
            </div>
          </div>

          <!-- Right: Instructions & Submission Form -->
          <div class="col-md-6">
            <div class="bg-light p-3 rounded-3 mb-4 small border">
              <div class="d-flex justify-content-between mb-1">
                <span class="text-secondary">Booking Ref:</span>
                <strong class="font-monospace text-primary"><%= reservation.reference_number %></strong>
              </div>
              <div class="d-flex justify-content-between mb-1">
                <span class="text-secondary">Court:</span>
                <strong class="text-dark"><%= reservation.court ? reservation.court.display_name : 'Court' %></strong>
              </div>
              <div class="d-flex justify-content-between mb-1">
                <span class="text-secondary">Date & Time:</span>
                <strong class="text-dark"><%= reservation.reservation_date %> (<%= formatTime12(reservation.start_time) %>)</strong>
              </div>
              <div class="d-flex justify-content-between">
                <span class="text-secondary">Player Name:</span>
                <strong class="text-dark"><%= reservation.user_name %></strong>
              </div>
            </div>

            <h6 class="fw-bold text-dark mb-2"><i class="bi bi-info-circle-fill text-primary me-1"></i>How to Pay:</h6>
            <ol class="small text-secondary ps-3 mb-4">
              <li class="mb-1">Open your <strong>GCash App</strong> and tap <strong>QR</strong> / <strong>Scan QR</strong>.</li>
              <li class="mb-1">Enter the exact amount: <strong class="text-dark"><%= formatCurrency(reservation.total_amount) %></strong>.</li>
              <li class="mb-1">Include your reference: <strong class="text-dark font-monospace"><%= reservation.reference_number %></strong>.</li>
              <li>Submit your <strong>GCash Reference No.</strong> below.</li>
            </ol>

            <form action="/payment/submit-proof" method="POST" enctype="multipart/form-data">
              <input type="hidden" name="reference_number" value="<%= reservation.reference_number %>">
              
              <div class="mb-3">
                <label class="form-label small fw-bold text-dark">GCash Reference No. <span class="text-danger">*</span></label>
                <div class="input-group">
                  <span class="input-group-text bg-light"><i class="bi bi-receipt"></i></span>
                  <input type="text" name="gcash_reference_no" class="form-control" placeholder="e.g. 1002 8394 1928" required autofocus>
                </div>
                <div class="form-text small">Found on your GCash transaction confirmation receipt.</div>
              </div>

              <div class="mb-4">
                <label class="form-label small fw-bold text-dark">Payment Screenshot <span class="text-muted small">(Optional)</span></label>
                <input type="file" name="screenshot" class="form-control form-control-sm" accept=".jpg,.jpeg,.png,.webp">
              </div>

              <button type="submit" class="btn btn-primary btn-lg w-100 fw-bold rounded-pill shadow-sm" style="background-color: #005ce6; border-color: #005ce6;">
                <i class="bi bi-send-check-fill me-1"></i>Submit Payment for Admin Approval
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
