<!-- =========================================================
     VENUE BRAND HEADER & NAVIGATION (Courtogo Architecture)
========================================================= -->
<section class="venue-header-banner py-3 py-md-4 border-bottom">
  <div class="container max-w-6xl">
    <div class="d-flex flex-column flex-lg-row align-items-start align-items-lg-center justify-content-between gap-3">
      <!-- Venue Identity Left -->
      <a href="/" class="text-decoration-none d-flex align-items-center gap-3">
        <div class="venue-avatar-wrap">
          <img src="/images/the-playground-logo.jpg" alt="The Playground Pickleball" class="venue-avatar-img">
        </div>
        <div>
          <h1 class="h3 fw-bold mb-0 text-dark font-display" style="letter-spacing: -0.02em;">
            The Playground Pickleball
          </h1>
          <p class="text-secondary small mb-0 mt-1 d-flex align-items-center gap-1">
            <i class="bi bi-geo-alt-fill text-warning"></i>
            <span class="fw-semibold text-dark">Camaman-an, Cagayan de Oro City</span>
            <span class="text-muted">· Piot Heights Compound</span>
          </p>
        </div>
      </a>

      <!-- Quick Actions Right -->
      <div class="d-flex align-items-center gap-2 mt-2 mt-lg-0">
        <a href="/" class="btn btn-outline-secondary btn-sm rounded-pill px-3 py-1.5 fw-semibold d-inline-flex align-items-center gap-1 shadow-none">
          <i class="bi bi-arrow-left"></i>
          <span>Back to Court Matrix</span>
        </a>
      </div>
    </div>
  </div>
</section>

<div class="container py-5">
  <div class="max-w-600 mx-auto" style="max-width: 600px;">
    <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
      <div class="text-center mb-4">
        <span class="badge gold-badge px-3 py-2 rounded-pill fw-bold mb-2">Reservation Lookup</span>
        <h2 class="fw-bold text-dark font-display">Find Your Booking</h2>
        <p class="text-secondary small">Enter your booking reference number (e.g. PLAY2026...) to view receipt and status.</p>
      </div>

      <form id="lookupForm" onsubmit="event.preventDefault(); const ref = document.getElementById('refInput').value.trim(); if(ref) window.location.href='/reservations/' + encodeURIComponent(ref);">
        <div class="mb-4">
          <label for="refInput" class="form-label fw-semibold text-dark">Reference Number</label>
          <div class="input-group input-group-lg">
            <span class="input-group-text bg-light text-primary"><i class="bi bi-search"></i></span>
            <input type="text" class="form-control font-monospace" id="refInput" placeholder="PLAY2026..." required>
          </div>
        </div>

        <button type="submit" class="btn btn-book-now-gold btn-lg w-100 fw-bold rounded-pill shadow">
          Search Booking
        </button>
      </form>
    </div>
  </div>
</div>
