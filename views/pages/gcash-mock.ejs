<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>GCash Payment Portal</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    body {
      background-color: #005ce6;
      font-family: 'Plus Jakarta Sans', sans-serif;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .gcash-card {
      max-width: 440px;
      width: 100%;
      background: #ffffff;
      border-radius: 20px;
      box-shadow: 0 15px 35px rgba(0, 40, 120, 0.3);
      overflow: hidden;
    }
    .gcash-header {
      background: #005ce6;
      color: #ffffff;
      padding: 24px;
      text-align: center;
    }
    .gcash-btn {
      background-color: #005ce6;
      color: #ffffff;
      border: none;
      font-weight: 700;
      border-radius: 50px;
      padding: 14px;
      width: 100%;
      transition: 0.2s;
    }
    .gcash-btn:hover {
      background-color: #0047b3;
      color: #ffffff;
    }
    .timer-badge {
      background: rgba(255,255,255,0.2);
      border-radius: 30px;
      padding: 4px 12px;
      font-size: 13px;
    }
  </style>
</head>
<body class="p-3">
  <div class="gcash-card">
    <div class="gcash-header">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="fw-bold mb-0 text-white"><i class="bi bi-wallet2 me-2"></i>GCash</h4>
        <span class="timer-badge" id="countdownTimer"><i class="bi bi-clock me-1"></i>15:00</span>
      </div>
      <p class="mb-1 small text-white-50">Merchant Payment</p>
      <h3 class="fw-bold text-white mb-0"><%= formatCurrency(reservation.total_amount) %></h3>
      <p class="small text-white-50 mt-1 mb-0">Merchant: <strong>PicklePlay Pro Courts</strong></p>
    </div>

    <div class="p-4">
      <div class="bg-light p-3 rounded-3 mb-4 small">
        <div class="d-flex justify-content-between mb-1">
          <span class="text-secondary">Ref No:</span>
          <span class="fw-bold font-monospace text-dark"><%= reservation.reference_number %></span>
        </div>
        <div class="d-flex justify-content-between mb-1">
          <span class="text-secondary">Court:</span>
          <span class="fw-bold text-dark"><%= reservation.court ? reservation.court.display_name : 'Court' %></span>
        </div>
        <div class="d-flex justify-content-between">
          <span class="text-secondary">Date & Time:</span>
          <span class="fw-bold text-dark"><%= reservation.reservation_date %> (<%= formatTime12(reservation.start_time) %>)</span>
        </div>
      </div>

      <form action="/payment/gcash-mock-pay" method="POST" id="gcashForm">
        <input type="hidden" name="reference_number" value="<%= reservation.reference_number %>">
        
        <div class="mb-3">
          <label class="form-label small fw-bold text-dark">GCash Mobile Number</label>
          <div class="input-group">
            <span class="input-group-text bg-light fw-bold text-secondary">+63</span>
            <input type="text" class="form-control form-control-lg" name="gcash_mobile" value="<%= reservation.user_contact.replace(/^(0|\+63)/, '') %>" required>
          </div>
        </div>

        <div class="mb-3">
          <label class="form-label small fw-bold text-dark">6-Digit Authentication Code (OTP)</label>
          <input type="text" class="form-control form-control-lg text-center" style="letter-spacing: 4px; font-weight: bold;" name="otp" value="584920" maxlength="6" required>
          <div class="form-text small text-success"><i class="bi bi-shield-check me-1"></i>Pre-filled for simulation demo</div>
        </div>

        <div class="mb-4">
          <label class="form-label small fw-bold text-dark">4-Digit MPIN</label>
          <input type="password" class="form-control form-control-lg text-center font-monospace" name="mpin" value="1234" maxlength="4" required>
        </div>

        <button type="submit" class="gcash-btn mb-2 shadow">
          <i class="bi bi-lock-fill me-1"></i>Pay <%= formatCurrency(reservation.total_amount) %>
        </button>

        <button type="submit" name="simulate_failure" value="true" class="btn btn-outline-danger btn-sm w-100 rounded-pill mt-2">
          Simulate Payment Failure
        </button>
      </form>
    </div>
  </div>

  <script>
    const expiresAt = new Date("<%= reservation.expires_at %>").getTime();
    function updateTimer() {
      const now = new Date().getTime();
      const distance = expiresAt - now;

      if (distance <= 0) {
        document.getElementById("countdownTimer").innerHTML = "EXPIRED";
        window.location.href = "/payment/failed?ref=<%= reservation.reference_number %>&reason=Payment%20expired";
        return;
      }

      const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
      const seconds = Math.floor((distance % (1000 * 60)) / 1000);
      document.getElementById("countdownTimer").innerHTML = 
        `<i class="bi bi-clock me-1"></i>${minutes}:${seconds < 10 ? '0' : ''}${seconds}`;
    }
    setInterval(updateTimer, 1000);
    updateTimer();
  </script>
</body>
</html>
