<section class="py-5" style="min-height: 82vh; display: flex; align-items: center; background: linear-gradient(180deg, #f8fafc 0%, #eef2f6 100%);">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-lg-5 col-md-7">
        <!-- Back to Venue Header -->
        <div class="mb-3 d-flex align-items-center justify-content-between">
          <a href="/" class="text-decoration-none text-secondary small fw-semibold d-inline-flex align-items-center gap-1">
            <i class="bi bi-arrow-left"></i> Back to Court Schedule
          </a>
          <span class="badge bg-warning text-dark rounded-pill px-2.5 py-1 fw-bold" style="font-size: 11px;">
            <i class="bi bi-shield-lock-fill me-1"></i>Player Account
          </span>
        </div>

        <div class="card border-0 shadow-lg rounded-4 overflow-hidden bg-white">
          <!-- Brand Header -->
          <div class="p-4 text-white text-center" style="background: linear-gradient(135deg, #0B2545 0%, #134074 100%); border-bottom: 3px solid #E5C365;">
            <img src="/images/the-playground-logo.jpg" alt="The Playground Pickleball" class="rounded-circle mb-2 border border-2 border-warning shadow-sm" style="width: 58px; height: 58px; object-fit: cover;">
            <h4 class="fw-bold font-display mb-1 text-white">The Playground Pickleball</h4>
            <p class="small text-white-50 mb-0">Sign in or create an account to book courts &amp; manage reservations</p>
          </div>

          <!-- Toggle Tabs -->
          <div class="d-flex border-bottom bg-light">
            <button type="button" id="authPageTabLogin" class="flex-fill btn rounded-0 py-2.5 fw-bold small border-0 <%= mode !== 'register' ? 'bg-white text-primary border-bottom border-2 border-primary' : 'text-secondary' %>" onclick="switchAuthPageMode('login')">
              <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
            </button>
            <button type="button" id="authPageTabRegister" class="flex-fill btn rounded-0 py-2.5 fw-bold small border-0 <%= mode === 'register' ? 'bg-white text-primary border-bottom border-2 border-primary' : 'text-secondary' %>" onclick="switchAuthPageMode('register')">
              <i class="bi bi-person-plus-fill me-1"></i> Create Account
            </button>
          </div>

          <div class="card-body p-4">
            <!-- LOGIN FORM -->
            <form id="authPageLoginForm" action="/account/login" method="POST" class="<%= (mode && mode !== 'login') ? 'd-none' : '' %>">
              <div class="mb-3">
                <label class="form-label small fw-bold text-dark">Email or GCash Mobile Number <span class="text-danger">*</span></label>
                <div class="input-group">
                  <span class="input-group-text bg-light text-primary"><i class="bi bi-person-badge"></i></span>
                  <input type="text" name="identifier" class="form-control" placeholder="09171234567 or player@email.com" required autofocus>
                </div>
              </div>

              <div class="mb-4">
                <div class="d-flex justify-content-between align-items-center mb-1">
                  <label class="form-label small fw-bold text-dark mb-0">Password <span class="text-danger">*</span></label>
                  <a href="javascript:void(0)" onclick="switchAuthPageMode('forgot')" class="small fw-semibold text-primary text-decoration-none" style="font-size: 12px;">
                    <i class="bi bi-key-fill me-1"></i>Forgot Password?
                  </a>
                </div>
                <div class="input-group">
                  <span class="input-group-text bg-light text-primary"><i class="bi bi-lock-fill"></i></span>
                  <input type="password" name="password" class="form-control" placeholder="Enter your password" required>
                </div>
              </div>

              <button type="submit" class="btn btn-book-now-gold w-100 py-2.5 fw-bold rounded-pill shadow-sm">
                <i class="bi bi-box-arrow-in-right me-1"></i> Sign In &amp; Continue
              </button>

              <div class="text-center mt-3 pt-2 border-top">
                <span class="small text-secondary">New player at The Playground?</span>
                <a href="javascript:void(0)" onclick="switchAuthPageMode('register')" class="small fw-bold text-primary text-decoration-none ms-1">Create an account &rarr;</a>
              </div>
            </form>

            <!-- REGISTER FORM -->
            <form id="authPageRegisterForm" action="/account/register" method="POST" class="<%= mode === 'register' ? '' : 'd-none' %>">
              <div class="mb-3">
                <label class="form-label small fw-bold text-dark">Player Full Name <span class="text-danger">*</span></label>
                <div class="input-group">
                  <span class="input-group-text bg-light text-primary"><i class="bi bi-person-fill"></i></span>
                  <input type="text" name="full_name" class="form-control" placeholder="e.g. Juan Dela Cruz" required>
                </div>
              </div>

              <div class="mb-3">
                <label class="form-label small fw-bold text-dark">GCash Mobile Number <span class="text-danger">*</span></label>
                <div class="input-group">
                  <span class="input-group-text bg-light text-primary"><i class="bi bi-phone-fill"></i></span>
                  <input type="tel" name="phone" class="form-control font-monospace" placeholder="09171234567" required>
                </div>
                <div class="form-text" style="font-size: 11px;">Used to log in and link your GCash court reservations automatically.</div>
              </div>

              <div class="mb-3">
                <label class="form-label small fw-bold text-dark">Email Address <span class="text-danger">*</span></label>
                <div class="input-group">
                  <span class="input-group-text bg-light text-primary"><i class="bi bi-envelope-fill"></i></span>
                  <input type="email" name="email" class="form-control" placeholder="player@email.com" required>
                </div>
                <div class="form-text" style="font-size: 11px;">We'll send a 6-digit OTP to confirm your email so you can recover your password anytime.</div>
              </div>

              <div class="row g-2 mb-4">
                <div class="col-sm-6">
                  <label class="form-label small fw-bold text-dark">Password <span class="text-danger">*</span></label>
                  <input type="password" name="password" class="form-control" placeholder="Min. 6 characters" minlength="6" required>
                </div>
                <div class="col-sm-6">
                  <label class="form-label small fw-bold text-dark">Confirm Password <span class="text-danger">*</span></label>
                  <input type="password" name="confirm_password" class="form-control" placeholder="Re-enter password" minlength="6" required>
                </div>
              </div>

              <button type="submit" class="btn btn-book-now-gold w-100 py-2.5 fw-bold rounded-pill shadow-sm">
                <i class="bi bi-envelope-check-fill me-1"></i> Send Email OTP &amp; Create Account
              </button>

              <div class="text-center mt-3 pt-2 border-top">
                <span class="small text-secondary">Already have an account?</span>
                <a href="javascript:void(0)" onclick="switchAuthPageMode('login')" class="small fw-bold text-primary text-decoration-none ms-1">Sign in here &rarr;</a>
              </div>
            </form>

            <% const _vEmail = (typeof verifyEmail !== 'undefined' && verifyEmail) ? verifyEmail : ''; %>

            <!-- VERIFY EMAIL OTP FORM -->
            <form id="authPageVerifyForm" action="/account/verify-otp" method="POST" class="<%= mode === 'verify' ? '' : 'd-none' %>">
              <div class="text-center mb-3">
                <i class="bi bi-shield-check text-primary fs-2"></i>
                <h6 class="fw-bold text-dark mb-1">Confirm Your Email Address</h6>
                <p class="small text-secondary mb-0">Enter the 6-digit code we sent to your email.</p>
              </div>
              <div class="mb-3">
                <label class="form-label small fw-bold text-dark">Email Address <span class="text-danger">*</span></label>
                <input type="email" name="email" class="form-control" value="<%= _vEmail %>" placeholder="player@email.com" required>
              </div>
              <div class="mb-4">
                <label class="form-label small fw-bold text-dark">6-Digit OTP Code <span class="text-danger">*</span></label>
                <input type="text" name="otp_code" class="form-control form-control-lg text-center font-monospace fw-bold" style="letter-spacing: 6px;" placeholder="------" maxlength="6" pattern="\d{6}" inputmode="numeric" required>
              </div>
              <button type="submit" class="btn btn-book-now-gold w-100 py-2.5 fw-bold rounded-pill shadow-sm">
                <i class="bi bi-check2-circle me-1"></i> Verify Email &amp; Sign In
              </button>
              <div class="d-flex justify-content-between mt-3 pt-2 border-top small">
                <button type="submit" formaction="/account/resend-otp" formnovalidate class="btn btn-link p-0 fw-bold text-primary text-decoration-none small">
                  <i class="bi bi-arrow-clockwise me-1"></i>Resend OTP
                </button>
                <a href="javascript:void(0)" onclick="switchAuthPageMode('login')" class="text-secondary text-decoration-none">&larr; Back to Sign In</a>
              </div>
            </form>

            <!-- FORGOT PASSWORD FORM -->
            <form id="authPageForgotForm" action="/account/forgot-password" method="POST" class="<%= mode === 'forgot' ? '' : 'd-none' %>">
              <div class="text-center mb-3">
                <i class="bi bi-key-fill text-warning fs-2"></i>
                <h6 class="fw-bold text-dark mb-1">Forgot Your Password?</h6>
                <p class="small text-secondary mb-0">We'll send a 6-digit recovery code to your confirmed email.</p>
              </div>
              <div class="mb-4">
                <label class="form-label small fw-bold text-dark">Registered Email or GCash Mobile <span class="text-danger">*</span></label>
                <input type="text" name="identifier" class="form-control" placeholder="player@email.com or 09171234567" required>
              </div>
              <button type="submit" class="btn btn-book-now-gold w-100 py-2.5 fw-bold rounded-pill shadow-sm">
                <i class="bi bi-send-check-fill me-1"></i> Send Recovery OTP
              </button>
              <div class="text-center mt-3 pt-2 border-top">
                <a href="javascript:void(0)" onclick="switchAuthPageMode('login')" class="small fw-bold text-secondary text-decoration-none">&larr; Back to Sign In</a>
              </div>
            </form>

            <!-- RESET PASSWORD FORM -->
            <form id="authPageResetForm" action="/account/reset-password" method="POST" class="<%= mode === 'reset' ? '' : 'd-none' %>">
              <input type="hidden" name="email" value="<%= _vEmail %>">
              <input type="hidden" name="purpose" value="RESET_PASSWORD">
              <div class="text-center mb-3">
                <i class="bi bi-shield-lock-fill text-success fs-2"></i>
                <h6 class="fw-bold text-dark mb-1">Set a New Password</h6>
                <p class="small text-secondary mb-0">Enter the recovery code sent to your email and choose a new password.</p>
              </div>
              <div class="mb-3">
                <label class="form-label small fw-bold text-dark">6-Digit Recovery OTP <span class="text-danger">*</span></label>
                <input type="text" name="otp_code" class="form-control text-center font-monospace fw-bold" style="letter-spacing: 6px;" placeholder="------" maxlength="6" pattern="\d{6}" inputmode="numeric" required>
              </div>
              <div class="row g-2 mb-4">
                <div class="col-sm-6">
                  <label class="form-label small fw-bold text-dark">New Password <span class="text-danger">*</span></label>
                  <input type="password" name="new_password" class="form-control" placeholder="Min. 6 characters" minlength="6" required>
                </div>
                <div class="col-sm-6">
                  <label class="form-label small fw-bold text-dark">Confirm Password <span class="text-danger">*</span></label>
                  <input type="password" name="confirm_password" class="form-control" placeholder="Re-enter password" minlength="6" required>
                </div>
              </div>
              <button type="submit" class="btn btn-book-now-gold w-100 py-2.5 fw-bold rounded-pill shadow-sm">
                <i class="bi bi-check2-all me-1"></i> Reset Password &amp; Sign In
              </button>
              <div class="d-flex justify-content-between mt-3 pt-2 border-top small">
                <button type="submit" formaction="/account/resend-otp" formnovalidate class="btn btn-link p-0 fw-bold text-primary text-decoration-none small">
                  <i class="bi bi-arrow-clockwise me-1"></i>Resend Recovery OTP
                </button>
                <a href="javascript:void(0)" onclick="switchAuthPageMode('login')" class="text-secondary text-decoration-none">&larr; Back to Sign In</a>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  function switchAuthPageMode(mode) {
    const forms = {
      login: document.getElementById('authPageLoginForm'),
      register: document.getElementById('authPageRegisterForm'),
      verify: document.getElementById('authPageVerifyForm'),
      forgot: document.getElementById('authPageForgotForm'),
      reset: document.getElementById('authPageResetForm')
    };
    if (!forms[mode]) mode = 'login';
    Object.keys(forms).forEach(key => {
      if (forms[key]) forms[key].classList.toggle('d-none', key !== mode);
    });

    const tabLogin = document.getElementById('authPageTabLogin');
    const tabRegister = document.getElementById('authPageTabRegister');
    const activeCls = 'flex-fill btn rounded-0 py-2.5 fw-bold small border-0 bg-white text-primary border-bottom border-2 border-primary';
    const inactiveCls = 'flex-fill btn rounded-0 py-2.5 fw-bold small border-0 text-secondary';
    tabRegister.className = mode === 'register' ? activeCls : inactiveCls;
    tabLogin.className = mode === 'register' || mode === 'verify' ? inactiveCls : activeCls;
  }
</script>
