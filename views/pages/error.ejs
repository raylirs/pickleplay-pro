<section class="venue-header-banner py-3 py-md-4 border-bottom">
  <div class="container max-w-6xl">
    <div class="d-flex flex-column flex-lg-row align-items-start align-items-lg-center justify-content-between gap-3">
      <!-- Venue Identity Left -->
      <a href="/" class="text-decoration-none d-flex align-items-center gap-3">
        <div class="venue-avatar-wrap">
          <img src="/images/the-playground-logo.jpg" alt="The Playground Pickleball" class="venue-avatar-img">
        </div>
        <div>
          <h1 class="h3 fw-bold mb-0 text-dark font-display" style="letter-spacing: -0.02em;">
            The Playground Pickleball
          </h1>
          <p class="text-secondary small mb-0 mt-1 d-flex align-items-center gap-1">
            <i class="bi bi-geo-alt-fill text-warning"></i>
            <span class="fw-semibold text-dark">Camaman-an, Cagayan de Oro City</span>
            <span class="text-muted">· Piot Heights Compound</span>
          </p>
        </div>
      </a>

      <!-- Quick Actions Right -->
      <div class="d-flex align-items-center gap-2 mt-2 mt-lg-0">
        <a href="/" class="btn btn-outline-secondary btn-sm rounded-pill px-3 py-1.5 fw-semibold d-inline-flex align-items-center gap-1 shadow-none">
          <i class="bi bi-arrow-left"></i>
          <span>Back to Court Matrix</span>
        </a>
      </div>
    </div>
  </div>
</section>

<div class="container py-5 text-center">
  <div class="max-w-600 mx-auto" style="max-width: 600px;">
    <div class="card border-0 shadow-lg rounded-4 p-5 bg-white">
      <div class="badge bg-danger-subtle text-danger rounded-circle p-3 mb-3 fs-3 d-inline-flex align-items-center justify-content-center mx-auto" style="width: 70px; height: 70px;">
        <i class="bi bi-exclamation-triangle"></i>
      </div>
      <h1 class="display-3 fw-bold text-dark font-display mb-1"><%= typeof statusCode !== 'undefined' ? statusCode : 404 %></h1>
      <h4 class="fw-bold text-dark font-display mb-2"><%= typeof title !== 'undefined' ? title : 'Page Not Found' %></h4>
      <p class="text-secondary mb-4"><%= typeof message !== 'undefined' ? message : 'The page or resource you requested could not be found.' %></p>
      <div>
        <a href="/" class="btn btn-book-now-gold px-4 py-2 rounded-pill fw-bold shadow">
          <i class="bi bi-house-door-fill me-1"></i>Back to Booking Matrix
        </a>
      </div>
    </div>
  </div>
</div>
