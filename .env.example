# Server Configuration
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# Database (Supports sqlite or postgres)
DB_DIALECT=sqlite
DB_STORAGE=./database.sqlite
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=pickleplay
# DB_USER=postgres
# DB_PASSWORD=your_password

# Session
SESSION_SECRET=pickleplay_pro_secret_session_key_2026_super_secure

# Admin User Defaults for Seeding
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# GCash Payment
GCASH_API_KEY=mock_gcash_key_pk_test_992384
GCASH_BASE_URL=http://localhost:3000/mock-gcash
GCASH_WEBHOOK_SECRET=mock_webhook_secret_xyz123
WEBHOOK_URL=http://localhost:3000/webhook/gcash-payment

# Email Configuration (for notifications)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=mock_user@pickleplay.com
SMTP_PASS=mock_password

# SMS Configuration (for notifications)
SMS_API_KEY=mock_sms_api_key
